@namespace Tempo.Blazor.Components.DocumentEditor
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.JSInterop
@using Tempo.Blazor.Components.DocumentEditor.Clipboard
@using Tempo.Blazor.DocumentEditor.Interfaces
@using Tempo.Blazor.DocumentEditor.Models
@using Tempo.Blazor.DocumentEditor.Services
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div @ref="_host"
     class="@HostClass"
     data-testid="document-canvas-engine-host"
     data-canvas-engine-ready="@(_ready ? "true" : "false")"
     data-canvas-engine-readonly="@ReadOnly.ToString().ToLowerInvariant()"
     data-canvas-engine-can-edit="@EffectiveCanEdit.ToString().ToLowerInvariant()"
     data-canvas-source-document-id="@(Document?.DocumentId ?? string.Empty)"
     data-canvas-source-block-count="@(Document?.Blocks.Count ?? 0)"
     data-canvas-source-hyphenation-enabled="@((Document?.Hyphenation?.Enabled == true).ToString().ToLowerInvariant())"
     data-canvas-source-hyphenation-mode="@(Document?.Hyphenation?.Mode ?? string.Empty)"
     data-canvas-source-page-background-color="@(Document?.PageBackground?.Color ?? string.Empty)"
     data-canvas-source-watermark-text="@(Document?.PageBackground?.Watermark?.Text ?? string.Empty)"
     data-canvas-content-control-render-mode="@EffectiveContentControlRenderMode"
     data-canvas-source-math-count="@CountDocumentMathRuns(Document)">
    <div @ref="_mount"
         class="tm-document-canvas-engine-host__mount"
         data-testid="document-canvas-engine-mount">
        <div class="tm-document-canvas-engine-host__root"
             data-testid="document-canvas-engine-root"
             data-canvas-engine-owned="blazor-shell">
            <div class="tm-document-canvas-engine-host__page"
                 data-testid="document-canvas-page"
                 style="@PageStyle">
                @foreach (var layer in CanvasLayerKinds)
                {
                    <canvas class="tm-document-canvas-engine-host__canvas"
                            data-canvas-layer="@layer"
                            width="@PagePixelWidth"
                            height="@PagePixelHeight"
                            aria-hidden="true"></canvas>
                }
            </div>
        </div>
        <div class="tm-document-canvas-engine-host__a11y"
             data-testid="document-canvas-a11y-mirror"
             id="document-canvas-a11y-mirror"
             role="document"
             aria-label="@EffectiveAriaLabel"></div>
        <div class="tm-document-canvas-engine-host__live"
             data-testid="document-canvas-live-region"
             id="document-canvas-live-region"
             role="status"
             aria-live="polite"
             aria-atomic="true"
             aria-label="@Loc["TmDocumentEditor_CanvasLiveRegionLabel"]"></div>
        <textarea class="tm-document-canvas-engine-host__input"
                  data-testid="document-canvas-hidden-input"
                  role="textbox"
                  aria-multiline="true"
                  aria-controls="document-canvas-a11y-mirror"
                  aria-describedby="document-canvas-live-region"
                  aria-label="@EffectiveInputAriaLabel"
                  readonly="@ReadOnly"></textarea>
    </div>
</div>

@code {
    private static readonly IReadOnlyList<string> CanvasLayerKinds =
    [
        "page-background",
        "content",
        "objects",
        "selection-caret",
        "annotations",
        "diagnostics"
    ];

    private const string InteropModulePath = "./_content/Tempo.Blazor/js/document-editor-canvas/interop.mjs";
    private const double PointsToCssPixels = 96d / 72d;
    private static readonly JsonSerializerOptions CanvasJsonOptions = new(JsonSerializerDefaults.Web)
    {
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
        Converters = { new JsonStringEnumConverter(JsonNamingPolicy.CamelCase, allowIntegerValues: true) }
    };

    private ElementReference _host;
    private ElementReference _mount;
    private IJSObjectReference? _module;
    private string? _handle;
    private string? _lastModelJson;
    private string? _lastParameterModelJson;
    private string? _lastOptionsJson;
    private object? _lastMountedDocumentRef;
    private DotNetObjectReference<TmDocumentCanvasEngineHost>? _selfRef;
    private bool _ready;
    private bool _disposed;

    /// <summary>The document accepted by the canvas engine host.</summary>
    [Parameter] public DocumentEditorDocument? Document { get; set; }

    /// <summary>Whether editing should be disabled for the canvas host.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Host-controlled permissions used to expose the canvas shell state.</summary>
    [Parameter] public DocumentEditorPermissions? Permissions { get; set; }

    /// <summary>Optional resolver for provider-managed document image assets.</summary>
    [Parameter] public IDocumentImageUrlResolver? ImageUrlResolver { get; set; }

    /// <summary>Optional image provider used by canvas upload and clipboard image flows.</summary>
    [Parameter] public IDocumentImageProvider? ImageProvider { get; set; }

    /// <summary>Validation policy for provider-backed canvas image uploads.</summary>
    [Parameter] public DocumentImageValidationOptions ImageValidation { get; set; } = new();

    /// <summary>Canvas content-control rendering mode. Use <c>form</c> for plain fill mode or <c>design</c> for structured-tag chrome.</summary>
    [Parameter] public string? ContentControlRenderMode { get; set; }

    /// <summary>Host-supplied proofing options used by the canvas diagnostics overlay.</summary>
    [Parameter] public DocumentProofingOptions? ProofingOptions { get; set; }

    /// <summary>Current document author used by tracked canvas changes.</summary>
    [Parameter] public DocumentEditorAuthor? Author { get; set; }

    /// <summary>Whether canvas tracked changes are enabled.</summary>
    [Parameter] public bool TrackChangesEnabled { get; set; }

    /// <summary>Current canvas review display mode for tracked revisions.</summary>
    [Parameter] public DocumentReviewDisplayMode ReviewDisplayMode { get; set; } = DocumentReviewDisplayMode.AllMarkup;

    /// <summary>Accessible label for the canvas document surface.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Accessible label for the hidden keyboard and IME bridge.</summary>
    [Parameter] public string? InputAriaLabel { get; set; }

    /// <summary>Raised when the JavaScript canvas host has mounted and reported readiness.</summary>
    [Parameter] public EventCallback<TmDocumentCanvasEngineHost> OnReady { get; set; }

    /// <summary>
    /// Raised when the canvas engine reports a model change. This is a plain delegate rather than an
    /// <see cref="EventCallback{T}"/> ON PURPOSE: it fires on every keystroke, and an EventCallback would
    /// auto-invoke StateHasChanged on the (very large) parent editor after every keystroke, re-rendering
    /// the whole toolbar/ribbon/chrome and freezing typing. The parent owns its own (debounced) re-render.
    /// </summary>
    [Parameter] public Func<CanvasEngineChangedState, Task>? OnChanged { get; set; }

    /// <summary>Raised when the canvas engine requests a context menu at the pointer location.</summary>
    [Parameter] public EventCallback<CanvasEngineContextMenuRequest> OnContextMenu { get; set; }

    /// <summary>
    /// Raised when the canvas selection changes (mini toolbar show/hide). A plain delegate, NOT an
    /// EventCallback, for the same reason as <see cref="OnChanged"/>: the selection changes on every
    /// keystroke (the caret moves), and an EventCallback would auto-render the whole parent editor each
    /// time. The parent re-renders itself only when the selection-driven state actually changes.
    /// </summary>
    [Parameter] public Func<WysiwygMiniToolbarRequest?, Task>? OnMiniToolbarChanged { get; set; }

    /// <summary>Raised when a canvas comment or revision marker is selected.</summary>
    [Parameter] public EventCallback<CanvasEngineAnnotationSelection> OnAnnotationSelected { get; set; }

    /// <summary>Raised when a canvas keyboard shortcut requests the command palette.</summary>
    [Parameter] public EventCallback OnCommandPaletteRequested { get; set; }

    /// <summary>Raised when a canvas keyboard shortcut requests focus to move to the ribbon.</summary>
    [Parameter] public EventCallback OnRibbonFocusRequested { get; set; }

    /// <summary>Raised when a canvas keyboard shortcut requests the versions side panel.</summary>
    [Parameter] public EventCallback OnVersionsPanelRequested { get; set; }

    /// <summary>Whether the host has completed its JavaScript mount lifecycle.</summary>
    public bool IsReady => _ready;

    private bool EffectiveCanEdit => !ReadOnly && (Permissions?.CanEdit ?? true);

    private string EffectiveAriaLabel => string.IsNullOrWhiteSpace(AriaLabel)
        ? Loc["TmDocumentEditor_CanvasSurfaceLabel"]
        : AriaLabel!;

    private string EffectiveInputAriaLabel => string.IsNullOrWhiteSpace(InputAriaLabel)
        ? Loc["TmDocumentEditor_CanvasInputLabel"]
        : InputAriaLabel!;

    private string HostClass => EffectiveCanEdit
        ? "tm-document-canvas-engine-host"
        : "tm-document-canvas-engine-host tm-document-canvas-engine-host--readonly";

    private string EffectiveContentControlRenderMode
        => (string.Equals(ContentControlRenderMode, "design", StringComparison.OrdinalIgnoreCase)
            || string.Equals(ContentControlRenderMode, "designMode", StringComparison.OrdinalIgnoreCase))
                ? "design"
                : "form";

    private int PagePixelWidth => Math.Max(1, (int)Math.Round(PageWidthPoints * PointsToCssPixels));

    private int PagePixelHeight => Math.Max(1, (int)Math.Round(PageHeightPoints * PointsToCssPixels));

    private double PageWidthPoints
    {
        get
        {
            var size = Document?.PageSettings?.Size ?? DocumentPageSize.A4;
            return Document?.PageSettings?.Landscape == true
                ? Math.Max(size.Width, size.Height)
                : size.Width;
        }
    }

    private double PageHeightPoints
    {
        get
        {
            var size = Document?.PageSettings?.Size ?? DocumentPageSize.A4;
            return Document?.PageSettings?.Landscape == true
                ? Math.Min(size.Width, size.Height)
                : size.Height;
        }
    }

    private string PageStyle =>
        $"--tm-document-canvas-page-width:{PagePixelWidth}px;--tm-document-canvas-page-height:{PagePixelHeight}px";

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Document is null || _disposed)
        {
            return;
        }

        if (_handle is not null)
        {
            await UpdateMountedModelAsync();
            return;
        }

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", InteropModulePath);
        _selfRef = DotNetObjectReference.Create(this);
        _lastModelJson = JsonSerializer.Serialize(BuildCanvasModel(), CanvasJsonOptions);
        _lastParameterModelJson = _lastModelJson;
        _lastMountedDocumentRef = Document;
        _lastOptionsJson = JsonSerializer.Serialize(BuildCanvasOptions(), CanvasJsonOptions);
        try
        {
            _handle = await _module.InvokeAsync<string>(
                "mount",
                _host,
                _mount,
                _lastModelJson,
                _lastOptionsJson,
                _selfRef);
        }
        catch (JSException ex) when (_disposed || ex.Message.Contains("Canvas engine host element is required.", StringComparison.Ordinal))
        {
            return;
        }

        await MarkReadyAsync();
    }

    /// <summary>Returns the canonical document currently owned by the host boundary.</summary>
    public async Task<DocumentEditorDocument?> RequestDocumentAsync()
    {
        if (_module is null || _handle is null)
        {
            return Document;
        }

        var modelJson = await _module.InvokeAsync<string?>("getModelJson", _handle);
        if (string.IsNullOrWhiteSpace(modelJson))
        {
            return Document;
        }

        var model = JsonSerializer.Deserialize<CanvasDocumentModel>(modelJson, CanvasJsonOptions);
        if (model is null)
        {
            return Document;
        }

        // Reuse the JSON the engine already produced instead of re-serializing the whole model (the extra
        // O(document) Serialize was pure overhead on the per-pause reconcile path). The mounted-model
        // reference-gate in UpdateMountedModelAsync — primed via MarkDocumentMounted after a reconcile —
        // prevents this from triggering a spurious replaceModel even if the JS/C# JSON form differs.
        _lastModelJson = modelJson;
        return CanvasDocumentModelConverter.FromCanvasModel(model, Document);
    }

    /// <summary>Replaces the mounted canvas engine model with an imported or provider-loaded document.</summary>
    public async Task ReplaceDocumentAsync(DocumentEditorDocument document)
    {
        ArgumentNullException.ThrowIfNull(document);

        var modelJson = JsonSerializer.Serialize(CanvasDocumentModelConverter.ToCanvasModel(document), CanvasJsonOptions);
        _lastModelJson = modelJson;
        _lastParameterModelJson = modelJson;
        if (_module is not null && _handle is not null)
        {
            await _module.InvokeVoidAsync("replaceModel", _handle, modelJson);
        }
    }

    /// <summary>
    /// Marks <paramref name="document"/> as the model already mounted in the engine, so the next render's
    /// <see cref="UpdateMountedModelAsync"/> reference-gate skips re-serializing and re-pushing it. The
    /// parent calls this right after it reconciles its canonical document out of the engine, which breaks
    /// the reconcile -> re-render -> replaceModel -> change-notify -> reconcile feedback loop.
    /// </summary>
    internal void MarkDocumentMounted(DocumentEditorDocument document)
    {
        _lastMountedDocumentRef = document;
    }

    /// <summary>Returns the canvas runtime debug snapshot as JSON.</summary>
    public async Task<string> GetRuntimeDebugSnapshotJsonAsync()
    {
        if (_module is null || _handle is null)
        {
            return string.Empty;
        }

        return await _module.InvokeAsync<string>("getRuntimeDebugSnapshotJson", _handle);
    }

    /// <summary>Returns the canvas offline runtime state as JSON.</summary>
    public async Task<string?> RequestOfflineStateJsonAsync()
    {
        if (_module is null || _handle is null)
        {
            return null;
        }

        return await _module.InvokeAsync<string?>("getOfflineStateJson", _handle);
    }

    /// <summary>Returns the canvas collaboration op-log state as JSON.</summary>
    public async Task<string?> RequestCollaborationStateJsonAsync()
    {
        if (_module is null || _handle is null)
        {
            return null;
        }

        return await _module.InvokeAsync<string?>("getCollaborationStateJson", _handle);
    }

    /// <summary>Returns whether the JavaScript canvas engine has local changes since the last save mark.</summary>
    public async Task<bool> IsDirtyAsync()
    {
        if (_disposed || _module is null || _handle is null)
        {
            return false;
        }

        try
        {
            return await _module.InvokeAsync<bool>("isDirty", _handle);
        }
        catch (ObjectDisposedException)
        {
            return false;
        }
    }

    /// <summary>Marks the current JavaScript canvas engine state as saved.</summary>
    public async Task MarkSavedAsync()
    {
        if (_module is not null && _handle is not null)
        {
            await _module.InvokeVoidAsync("markSaved", _handle);
        }
    }

    /// <summary>Applies a remote collaboration batch to the mounted canvas runtime.</summary>
    public async Task<CanvasEngineRemoteApplyResult> ApplyRemoteOperationBatchAsync(DocumentCollaborationOperationBatch batch)
    {
        ArgumentNullException.ThrowIfNull(batch);

        if (_module is null || _handle is null)
        {
            return new CanvasEngineRemoteApplyResult { Success = false };
        }

        var json = JsonSerializer.Serialize(batch, CanvasJsonOptions);
        var resultJson = await _module.InvokeAsync<string?>("applyRemoteOperationBatch", _handle, json);
        var result = DeserializeState(resultJson, new CanvasEngineRemoteApplyResult());
        if (result.Success)
        {
            var modelJson = await _module.InvokeAsync<string?>("getModelJson", _handle);
            if (!string.IsNullOrWhiteSpace(modelJson))
            {
                _lastModelJson = modelJson;
                _lastParameterModelJson = modelJson;
            }
        }

        return result;
    }

    /// <summary>Applies a remote collaboration cursor to the mounted canvas runtime.</summary>
    public async Task<CanvasEnginePresenceState> ApplyRemoteCursorAsync(DocumentCollaborationCursor cursor)
    {
        ArgumentNullException.ThrowIfNull(cursor);

        if (_module is null || _handle is null)
        {
            return new CanvasEnginePresenceState();
        }

        var json = JsonSerializer.Serialize(cursor, CanvasJsonOptions);
        var resultJson = await _module.InvokeAsync<string?>("applyRemoteCursor", _handle, json);
        return DeserializeState(resultJson, new CanvasEnginePresenceState());
    }

    /// <summary>Replaces the remote collaboration cursors rendered by the mounted canvas runtime.</summary>
    public async Task<CanvasEnginePresenceState> ApplyRemoteCursorsAsync(IReadOnlyList<DocumentCollaborationCursor> cursors)
    {
        ArgumentNullException.ThrowIfNull(cursors);

        if (_module is null || _handle is null)
        {
            return new CanvasEnginePresenceState();
        }

        var json = JsonSerializer.Serialize(cursors, CanvasJsonOptions);
        var resultJson = await _module.InvokeAsync<string?>("applyRemoteCursors", _handle, json);
        return DeserializeState(resultJson, new CanvasEnginePresenceState());
    }

    /// <summary>Moves focus to the canvas engine hidden input bridge.</summary>
    public async Task FocusAsync()
    {
        if (_module is not null && _handle is not null)
        {
            await _module.InvokeVoidAsync("focus", _handle);
        }
    }

    /// <summary>Executes a command through the canvas engine dispatcher.</summary>
    public async Task<CanvasEngineCommandResult> ExecCommandAsync(string commandId, object? argument = null)
    {
        if (_module is null || _handle is null)
        {
            return new CanvasEngineCommandResult { Handled = false, CommandId = commandId };
        }

        var argumentJson = argument is null ? null : JsonSerializer.Serialize(argument, CanvasJsonOptions);
        var json = await _module.InvokeAsync<string?>("execCommand", _handle, commandId, argumentJson);
        return DeserializeState(json, new CanvasEngineCommandResult { CommandId = commandId });
    }

    /// <summary>Queries a command state through the canvas engine dispatcher.</summary>
    public Task<CanvasEngineCommandState> QueryCommandAsync(string commandId)
        => ReadStateAsync<CanvasEngineCommandState>("queryCommand", new CanvasEngineCommandState(), commandId);

    /// <summary>Reads the current formatting state from the canvas engine boundary.</summary>
    public Task<CanvasEngineFormattingState> GetFormattingStateAsync()
        => ReadStateAsync<CanvasEngineFormattingState>("getFormattingStateJson", new CanvasEngineFormattingState());

    /// <summary>Reads the current undo state from the canvas engine boundary.</summary>
    public Task<CanvasEngineUndoState> GetUndoStateAsync()
        => ReadStateAsync<CanvasEngineUndoState>("getUndoStateJson", new CanvasEngineUndoState());

    /// <summary>Reads the current selection state from the canvas engine boundary.</summary>
    public Task<CanvasEngineSelectionState> GetSelectionStateAsync()
        => ReadStateAsync<CanvasEngineSelectionState>("getSelectionStateJson", new CanvasEngineSelectionState());

    /// <summary>Captures a comment anchor from the current canvas selection.</summary>
    public async Task<DocumentCommentAnchor?> CaptureCommentAnchorAsync()
    {
        if (_module is null || _handle is null)
        {
            return null;
        }

        var json = await _module.InvokeAsync<string?>("captureCommentAnchorJson", _handle);
        var anchor = DeserializeState(json, new CanvasCommentAnchorState());
        if (string.IsNullOrWhiteSpace(anchor.BlockId))
        {
            return null;
        }

        var start = Math.Min(anchor.StartOffset, anchor.EndOffset);
        var end = Math.Max(anchor.StartOffset, anchor.EndOffset);
        return new DocumentCommentAnchor
        {
            Type = anchor.Type.Equals("textRange", StringComparison.OrdinalIgnoreCase) && end > start
                ? DocumentCommentAnchorType.TextRange
                : DocumentCommentAnchorType.Block,
            BlockId = anchor.BlockId,
            StartOffset = start,
            EndOffset = end
        };
    }

    /// <summary>Synchronizes the canvas track-changes runtime flag.</summary>
    public async Task SetTrackChangesEnabledAsync(bool enabled)
    {
        if (_module is not null && _handle is not null)
        {
            var authorJson = JsonSerializer.Serialize(Author, CanvasJsonOptions);
            await _module.InvokeAsync<string?>("setTrackChangesEnabled", _handle, enabled, authorJson);
        }
    }

    /// <summary>Synchronizes the canvas review display mode.</summary>
    public async Task SetReviewDisplayModeAsync(DocumentReviewDisplayMode mode)
    {
        if (_module is not null && _handle is not null)
        {
            await _module.InvokeAsync<string?>("setReviewDisplayMode", _handle, mode.ToString());
        }
    }

    /// <summary>Selects and scrolls to a canvas comment marker.</summary>
    public async Task SelectCommentAsync(string commentId)
    {
        if (_module is not null && _handle is not null && !string.IsNullOrWhiteSpace(commentId))
        {
            await _module.InvokeAsync<string?>("selectComment", _handle, commentId);
        }
    }

    /// <summary>Upserts a comment into the live canvas model and synchronizes its anchor mark.</summary>
    public async Task UpsertCommentAsync(DocumentComment comment)
    {
        ArgumentNullException.ThrowIfNull(comment);

        if (_module is not null && _handle is not null)
        {
            await ExecCommandAsync("upsertComment", new { comment });
        }
    }

    /// <summary>Removes a comment from the live canvas model and clears its anchor mark.</summary>
    public async Task RemoveCommentAsync(string commentId)
    {
        if (_module is not null && _handle is not null && !string.IsNullOrWhiteSpace(commentId))
        {
            await ExecCommandAsync("deleteComment", new { commentId });
        }
    }

    /// <summary>Selects and scrolls to a canvas revision marker.</summary>
    public async Task SelectRevisionAsync(string revisionId)
    {
        if (_module is not null && _handle is not null && !string.IsNullOrWhiteSpace(revisionId))
        {
            await _module.InvokeAsync<string?>("selectRevision", _handle, revisionId);
        }
    }

    /// <summary>Reads diagnostics from the canvas engine boundary.</summary>
    public Task<CanvasEngineDiagnosticsState> GetDiagnosticsAsync()
        => ReadStateAsync<CanvasEngineDiagnosticsState>("getDiagnosticsJson", new CanvasEngineDiagnosticsState());

    /// <summary>Reads the current canvas search state from the JavaScript runtime.</summary>
    public Task<CanvasEngineSearchState> GetSearchStateAsync()
        => ReadStateAsync<CanvasEngineSearchState>("getSearchStateJson", new CanvasEngineSearchState());

    /// <summary>Reads the current canvas navigation state from the JavaScript runtime.</summary>
    public Task<CanvasEngineNavigationState> GetNavigationStateAsync()
        => ReadStateAsync<CanvasEngineNavigationState>("getNavigationStateJson", new CanvasEngineNavigationState());

    /// <summary>Reads the latest print preview snapshot from the canvas runtime.</summary>
    public Task<CanvasEnginePrintPreviewState> GetPrintPreviewStateAsync()
        => ReadStateAsync<CanvasEnginePrintPreviewState>("getPrintPreviewStateJson", new CanvasEnginePrintPreviewState());

    /// <summary>Reads the latest clipboard debug snapshot from the canvas runtime.</summary>
    public async Task<DocumentClipboardDebugSnapshot> GetClipboardDebugSnapshotAsync()
    {
        if (_module is null || _handle is null)
        {
            return new DocumentClipboardDebugSnapshot();
        }

        var json = await _module.InvokeAsync<string?>("getClipboardDebugSnapshotJson", _handle);
        var state = DeserializeState(json, new CanvasEngineClipboardDebugState());
        return new DocumentClipboardDebugSnapshot
        {
            RawHtml = state.RawHtml,
            PlainText = state.PlainText,
            Source = DocumentClipboardSource.Unknown,
            NormalizedJson = state.NormalizedJson,
            Warnings = state.Warnings
                .Select(message => new DocumentClipboardWarning
                {
                    Code = message,
                    Message = message
                })
                .ToList(),
            CapturedAt = state.CapturedAt ?? DateTimeOffset.UtcNow
        };
    }

    /// <summary>JavaScript callback for canvas engine readiness.</summary>
    [JSInvokable]
    public Task OnCanvasEngineReady(string? stateJson)
        => MarkReadyAsync();

    /// <summary>JavaScript callback for canvas engine model changes.</summary>
    [JSInvokable]
    public async Task OnCanvasEngineChanged(string? stateJson)
    {
        if (_disposed)
        {
            return;
        }

        var state = DeserializeState(stateJson, new CanvasEngineChangedState());
        // Phase 6.5: do NOT marshal the full model JSON across the JS<->.NET boundary on every edit.
        // The engine is the source of truth; the canonical model is fetched lazily only on save /
        // RequestDocumentAsync. Invalidating the cached parameter snapshot keeps parameter-driven
        // re-sync correct (a later Document parameter change always re-applies via UpdateMountedModel).
        _lastModelJson = null;

        if (OnChanged is not null)
        {
            await OnChanged(state);
        }
    }

    /// <summary>JavaScript callback for canvas context menu requests.</summary>
    [JSInvokable]
    public Task OnCanvasContextMenuRequested(string? stateJson)
    {
        var request = DeserializeState(stateJson, new CanvasEngineContextMenuRequest());
        return OnContextMenu.HasDelegate ? OnContextMenu.InvokeAsync(request) : Task.CompletedTask;
    }

    /// <summary>JavaScript callback for canvas mini toolbar placement changes.</summary>
    [JSInvokable]
    public Task OnCanvasMiniToolbarChanged(string? stateJson)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        var request = DeserializeState<WysiwygMiniToolbarRequest?>(stateJson, null);
        return OnMiniToolbarChanged is not null ? OnMiniToolbarChanged(request) : Task.CompletedTask;
    }

    /// <summary>JavaScript callback for canvas comment or revision marker selection.</summary>
    [JSInvokable]
    public Task OnCanvasAnnotationSelected(string? stateJson)
    {
        var request = DeserializeState(stateJson, new CanvasEngineAnnotationSelection());
        return OnAnnotationSelected.HasDelegate ? OnAnnotationSelected.InvokeAsync(request) : Task.CompletedTask;
    }

    /// <summary>JavaScript callback for the canvas command palette shortcut.</summary>
    [JSInvokable]
    public Task OnCanvasCommandPaletteRequested(string? stateJson)
        => OnCommandPaletteRequested.HasDelegate ? OnCommandPaletteRequested.InvokeAsync() : Task.CompletedTask;

    /// <summary>JavaScript callback for canvas ribbon activation shortcuts.</summary>
    [JSInvokable]
    public Task OnCanvasRibbonFocusRequested(string? stateJson)
        => OnRibbonFocusRequested.HasDelegate ? OnRibbonFocusRequested.InvokeAsync() : Task.CompletedTask;

    /// <summary>JavaScript callback for canvas versions panel shortcuts.</summary>
    [JSInvokable]
    public Task OnCanvasVersionsPanelRequested(string? stateJson)
        => OnVersionsPanelRequested.HasDelegate ? OnVersionsPanelRequested.InvokeAsync() : Task.CompletedTask;

    /// <summary>Uploads a canvas clipboard image through the configured host image provider.</summary>
    [JSInvokable]
    public async Task<CanvasClipboardImageUploadResult> UploadCanvasClipboardImage(
        CanvasClipboardImageUploadRequest request,
        IJSStreamReference streamReference)
    {
        if (ImageProvider is null)
        {
            return new CanvasClipboardImageUploadResult
            {
                Success = false,
                ErrorMessage = "Image provider is not available."
            };
        }

        var contentType = string.IsNullOrWhiteSpace(request.ContentType) ? "image/png" : request.ContentType;
        var sizeBytes = Math.Max(0, request.SizeBytes);
        if (!ImageValidation.IsAllowed(contentType, sizeBytes))
        {
            return new CanvasClipboardImageUploadResult
            {
                Success = false,
                ErrorMessage = "Image content type or size is not allowed."
            };
        }

        await using var stream = await streamReference.OpenReadStreamAsync(ImageValidation.MaxFileSizeBytes);
        var upload = await ImageProvider.UploadAsync(
            new DocumentImageUploadRequest
            {
                DocumentId = string.IsNullOrWhiteSpace(request.DocumentId)
                    ? Document?.DocumentId ?? string.Empty
                    : request.DocumentId,
                FileName = string.IsNullOrWhiteSpace(request.FileName)
                    ? "clipboard-image.png"
                    : request.FileName,
                ContentType = contentType,
                SizeBytes = sizeBytes
            },
            stream);

        return new CanvasClipboardImageUploadResult
        {
            Success = upload.Success,
            AssetId = upload.AssetId,
            Url = upload.Url,
            ContentType = contentType,
            FileName = request.FileName,
            ErrorMessage = upload.ErrorMessage
        };
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        try
        {
            if (_module is not null && _handle is not null)
            {
                await _module.InvokeVoidAsync("dispose", _handle);
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }

        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }

        _selfRef?.Dispose();
    }

    private async Task<TState> ReadStateAsync<TState>(string identifier, TState fallback, params object?[] args)
    {
        if (_module is null || _handle is null)
        {
            return fallback;
        }

        var invocationArgs = new object?[args.Length + 1];
        invocationArgs[0] = _handle;
        Array.Copy(args, 0, invocationArgs, 1, args.Length);
        var json = await _module.InvokeAsync<string?>(identifier, invocationArgs);
        return DeserializeState(json, fallback);
    }

    private static TState DeserializeState<TState>(string? json, TState fallback)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return fallback;
        }

        // MUST reuse the cached options instance: a fresh JsonSerializerOptions rebuilds its reflection
        // metadata cache on first use, and this runs on every change callback (per keystroke) — constructing
        // new options each time cost ~170 ms/keystroke on WASM.
        return JsonSerializer.Deserialize<TState>(json, CanvasJsonOptions) ?? fallback;
    }

    private CanvasDocumentModel BuildCanvasModel()
        => CanvasDocumentModelConverter.ToCanvasModel(Document ?? DocumentEditorDocument.Empty());

    private static int CountDocumentMathRuns(DocumentEditorDocument? document)
        => document?.Blocks.Sum(block => block.Content switch
        {
            ParagraphBlockContent paragraph => paragraph.Inlines.OfType<DocumentMathRun>().Count(),
            HeadingBlockContent heading => heading.Inlines.OfType<DocumentMathRun>().Count(),
            ListBlockContent list => list.Inlines.OfType<DocumentMathRun>().Count(),
            QuoteBlockContent quote => quote.Inlines.OfType<DocumentMathRun>().Count(),
            TableBlockContent table => table.Rows.Sum(row => row.Cells.Sum(cell => cell.Blocks.Sum(CountDocumentMathRuns))),
            _ => 0
        }) ?? 0;

    private static int CountDocumentMathRuns(DocumentBlock block)
        => block.Content switch
        {
            ParagraphBlockContent paragraph => paragraph.Inlines.OfType<DocumentMathRun>().Count(),
            HeadingBlockContent heading => heading.Inlines.OfType<DocumentMathRun>().Count(),
            ListBlockContent list => list.Inlines.OfType<DocumentMathRun>().Count(),
            QuoteBlockContent quote => quote.Inlines.OfType<DocumentMathRun>().Count(),
            TableBlockContent table => table.Rows.Sum(row => row.Cells.Sum(cell => cell.Blocks.Sum(CountDocumentMathRuns))),
            _ => 0
        };

    private async Task UpdateMountedModelAsync()
    {
        if (_module is null || _handle is null)
        {
            return;
        }

        var optionsJson = JsonSerializer.Serialize(BuildCanvasOptions(), CanvasJsonOptions);
        if (!string.Equals(_lastOptionsJson, optionsJson, StringComparison.Ordinal))
        {
            _lastOptionsJson = optionsJson;
            await _module.InvokeVoidAsync("setOptions", _handle, optionsJson);
        }

        // OnAfterRenderAsync fires after EVERY render — and a render happens after every keystroke. Building
        // and serializing the whole canvas model in C# here (heavy on large documents) per keystroke froze
        // typing. The host app only swaps the model by handing us a new Document parameter reference; the
        // canvas engine owns in-place edits. So when the Document reference is unchanged there is nothing to
        // push and we must skip the serialization entirely.
        if (ReferenceEquals(Document, _lastMountedDocumentRef))
        {
            return;
        }

        _lastMountedDocumentRef = Document;

        var modelJson = JsonSerializer.Serialize(BuildCanvasModel(), CanvasJsonOptions);
        if (string.Equals(_lastParameterModelJson, modelJson, StringComparison.Ordinal))
        {
            return;
        }

        _lastParameterModelJson = modelJson;
        if (string.Equals(_lastModelJson, modelJson, StringComparison.Ordinal))
        {
            return;
        }

        _lastModelJson = modelJson;
        await _module.InvokeVoidAsync("replaceModel", _handle, modelJson);
    }

    private object BuildCanvasOptions()
        => new
        {
            ariaLabel = EffectiveAriaLabel,
            inputAriaLabel = EffectiveInputAriaLabel,
            readOnly = ReadOnly,
            canEdit = EffectiveCanEdit,
            contentControlRenderMode = EffectiveContentControlRenderMode,
            accessibility = new
            {
                liveRegionLabel = Loc["TmDocumentEditor_CanvasLiveRegionLabel"],
                caretAnnouncement = Loc["TmDocumentEditor_CanvasCaretAnnouncement"],
                searchResultAnnouncement = Loc["TmDocumentEditor_CanvasSearchResultAnnouncement"],
                searchNoResultsAnnouncement = Loc["TmDocumentEditor_CanvasSearchNoResultsAnnouncement"],
                commentAnnouncement = Loc["TmDocumentEditor_CanvasCommentAnnouncement"],
                revisionAnnouncement = Loc["TmDocumentEditor_CanvasRevisionAnnouncement"],
                saveAnnouncement = Loc["TmDocumentEditor_CanvasSaveAnnouncement"],
                mathSlotAnnouncement = Loc["TmDocumentEditor_CanvasMathSlotAnnouncement"],
                mathExitAnnouncement = Loc["TmDocumentEditor_CanvasMathExitAnnouncement"]
            },
            providerCapabilities = new
            {
                hasImageProvider = ImageProvider is not null,
                hasImageUrlResolver = ImageUrlResolver is not null
            },
            proofing = BuildProofingOptions(),
            author = Author,
            trackChanges = new
            {
                enabled = TrackChangesEnabled,
                reviewDisplayMode = ReviewDisplayMode.ToString(),
                author = Author
            },
            pageSettings = new
            {
                width = PagePixelWidth,
                height = PagePixelHeight,
                marginTop = ToCssPixels(Document?.PageSettings?.Margins?.Top ?? DocumentPageMargins.Default.Top),
                marginRight = ToCssPixels(Document?.PageSettings?.Margins?.Right ?? DocumentPageMargins.Default.Right),
                marginBottom = ToCssPixels(Document?.PageSettings?.Margins?.Bottom ?? DocumentPageMargins.Default.Bottom),
                marginLeft = ToCssPixels(Document?.PageSettings?.Margins?.Left ?? DocumentPageMargins.Default.Left)
            }
        };

    private object BuildProofingOptions()
        => new
        {
            enabled = ProofingOptions?.Enabled == true,
            defaultLanguage = ProofingOptions?.DefaultLanguage ?? string.Empty,
            flaggedWords = ProofingOptions?.FlaggedWords ?? Array.Empty<string>(),
            suggestions = ProofingOptions?.Suggestions ?? new Dictionary<string, IReadOnlyList<string>>(StringComparer.OrdinalIgnoreCase)
        };

    private static int ToCssPixels(double points)
        => Math.Max(0, (int)Math.Round(points * PointsToCssPixels));

    private async Task MarkReadyAsync()
    {
        if (_ready)
