@namespace Tempo.Blazor.Components.DocumentEditor
@using System.Text.Json
@using Microsoft.JSInterop
@using Tempo.Blazor.DocumentEditor.Models
@using Tempo.Blazor.DocumentEditor.Interfaces
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@*
    R.4.8 cutover — hosts the new model-owned core engine inside Blazor via the
    core-engine-interop shim. Renders the positioned-DOM (real text, no contenteditable);
    keystrokes/IME go through the engine's off-screen input surface. Behind the
    CoreEnginePreview flag until parity (planning/r48-cutover-plan.md).
*@
<div @ref="_root"
     class="tm-document-core-engine-host"
     data-testid="document-core-engine-host"
     data-core-engine-ready="@(_handle is not null ? "true" : "false")"
     tabindex="0"></div>

@code {
    /// <summary>The document to render/edit with the core engine.</summary>
    [Parameter] public DocumentEditorDocument? Document { get; set; }

    /// <summary>Accessible label for the editor surface.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Document editor";

    /// <summary>Page geometry passed to the engine layout.</summary>
    [Parameter] public DocumentPageSettings? PageSettings { get; set; }

    /// <summary>Raised (JS→.NET) when an image object is selected/deselected in the engine.</summary>
    [Parameter] public EventCallback<CoreObjectSelection?> OnObjectSelected { get; set; }

    /// <summary>Raised (JS→.NET, debounced) when the engine's model changes — drives autosave (R.5.3).</summary>
    [Parameter] public EventCallback OnModelChanged { get; set; }

    /// <summary>Raised (JS→.NET) on right-click — carries the engine context + viewport position (R.5.23).</summary>
    [Parameter] public EventCallback<CoreContextMenuRequest> OnContextMenu { get; set; }

    /// <summary>Raised (JS→.NET) when a local edit produces a text operation — broadcast for collaboration (R.5.22).</summary>
    [Parameter] public EventCallback<CoreOperation> OnOperation { get; set; }

    /// <summary>Raised once the engine has mounted (the handle exists) — wire collaboration here (R.5.22).</summary>
    [Parameter] public EventCallback<TmDocumentCoreEngineHost> OnReady { get; set; }

    /// <summary>Debounce (ms) before <see cref="OnModelChanged"/> fires after the last edit.</summary>
    [Parameter] public int ChangeDebounceMs { get; set; } = 800;

    private ElementReference _root;
    private IJSObjectReference? _module;
    private string? _handle;
    private DotNetObjectReference<TmDocumentCoreEngineHost>? _selfRef;

    private const string InteropModulePath = "./_content/Tempo.Blazor/js/document-editor/core-engine-interop.js";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Document is null || _handle is not null) return;
        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", InteropModulePath);
        var model = CoreEngineModelConverter.ToCoreModel(Document);
        var options = new
        {
            ariaLabel = AriaLabel,
            autoFocus = false,
            pageSettings = BuildPageSettings(),
            changeDebounceMs = ChangeDebounceMs,
        };
        _selfRef = DotNetObjectReference.Create(this);
        _handle = await _module.InvokeAsync<string>(
            "mount", _root, JsonSerializer.Serialize(model), JsonSerializer.Serialize(options), _selfRef);
        StateHasChanged();
        if (OnReady.HasDelegate) await OnReady.InvokeAsync(this); // R.5.22 — collab can connect now
    }

    private object BuildPageSettings()
    {
        // Defaults mirror the harness (A4-ish @96dpi with 72px margins). A future revision
        // can map DocumentPageSettings (mm) → px here.
        return new { width = 794, height = 1123, marginTop = 72, marginBottom = 72, marginLeft = 72, marginRight = 72 };
    }

    /// <summary>Runs a toolbar command on the engine (bold/align/heading/link/…); see core-editor.mjs.</summary>
    public async Task<bool> ExecCommandAsync(string command, object? argument = null)
    {
        if (_module is null || _handle is null) return false;
        var argJson = argument is null ? null : JsonSerializer.Serialize(argument);
        return await _module.InvokeAsync<bool>("exec", _handle, command, argJson);
    }

    /// <summary>Toggle/pressed state for a command (toolbar highlight).</summary>
    public async Task<bool> QueryCommandAsync(string command)
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("query", _handle, command);

    /// <summary>Pulls the current engine model back into a <see cref="DocumentEditorDocument"/> (for save).</summary>
    public async Task<DocumentEditorDocument?> RequestDocumentAsync()
    {
        if (_module is null || _handle is null) return Document;
        var json = await _module.InvokeAsync<string?>("getModelJson", _handle);
        if (string.IsNullOrEmpty(json)) return Document;
        using var parsed = JsonDocument.Parse(json);
        return CoreEngineModelConverter.FromCoreModel(parsed.RootElement, Document);
    }

    public async Task<bool> IsDirtyAsync()
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("isDirty", _handle);

    public async Task MarkSavedAsync()
    {
        if (_module is not null && _handle is not null) await _module.InvokeVoidAsync("markSaved", _handle);
    }

    public async Task<bool> CanUndoAsync()
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("canUndo", _handle);

    public async Task<bool> CanRedoAsync()
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("canRedo", _handle);

    /// <summary>Active inline formatting + alignment for the engine's current selection.</summary>
    public async Task<CoreFormattingState?> GetFormattingStateAsync()
    {
        if (_module is null || _handle is null) return null;
        var json = await _module.InvokeAsync<string?>("getFormattingStateJson", _handle);
        if (string.IsNullOrEmpty(json)) return null;
        return JsonSerializer.Deserialize<CoreFormattingState>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
    }

    /// <summary>JS→.NET — the engine selected/deselected an image object (inspector panel).</summary>
    [JSInvokable]
    public Task OnCoreObjectSelected(string? json)
    {
        CoreObjectSelection? selection = null;
        if (!string.IsNullOrEmpty(json))
        {
            selection = JsonSerializer.Deserialize<CoreObjectSelection>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        return OnObjectSelected.InvokeAsync(selection);
    }

    /// <summary>JS→.NET — the engine's model changed (debounced); the editor reacts by autosaving.</summary>
    [JSInvokable]
    public Task OnCoreModelChanged() => OnModelChanged.InvokeAsync();

    /// <summary>JS→.NET — right-click in the engine; surfaces a contextual menu (R.5.23).</summary>
    [JSInvokable]
    public Task OnCoreContextMenu(string? infoJson, int x, int y)
    {
        CoreContextInfo? info = null;
        if (!string.IsNullOrEmpty(infoJson))
        {
            info = JsonSerializer.Deserialize<CoreContextInfo>(infoJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }

        return OnContextMenu.InvokeAsync(new CoreContextMenuRequest { Info = info ?? new CoreContextInfo(), X = x, Y = y });
    }

    /// <summary>R.5.23 — engine context at the pointer plus where to anchor the menu.</summary>
    public sealed class CoreContextMenuRequest
    {
        public CoreContextInfo Info { get; set; } = new();
        public int X { get; set; }
        public int Y { get; set; }
    }

    /// <summary>R.5.23 — what the engine found under the pointer (selection / link / image / comment / table / misspelling).</summary>
    public sealed class CoreContextInfo
    {
        public string? BlockId { get; set; }
        public int? Offset { get; set; }
        public bool HasSelection { get; set; }
        public string? Link { get; set; }
        public string? ObjectId { get; set; }
        public List<string> CommentIds { get; set; } = new();
        public bool InTable { get; set; }
        public string? TableId { get; set; }
        public CoreMisspelling? Misspelling { get; set; }
    }

    /// <summary>R.5.23c — a misspelled word under the pointer + suggestions.</summary>
    public sealed class CoreMisspelling
    {
        public string? Word { get; set; }
        public int Start { get; set; }
        public int End { get; set; }
        public string? BlockId { get; set; }
        public List<string> Suggestions { get; set; } = new();
    }

    /// <summary>Sets the selected image's alt text in the engine (inspector edit).</summary>
    public async Task<bool> SetObjectAltTextAsync(string text)
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("setObjectAltText", _handle, text);

    /// <summary>Sets the selected image's wrap mode in the engine (inspector edit).</summary>
    public async Task<bool> SetObjectWrapModeAsync(string mode)
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("setObjectWrapMode", _handle, mode);

    /// <summary>Resizes the selected image in the engine (inspector size edit).</summary>
    public async Task<bool> SetObjectSizeAsync(double width, double height)
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("setObjectSize", _handle, width, height);

    /// <summary>Horizontal alignment of the selected floating image (Left/Center/Right).</summary>
    public async Task<bool> SetObjectAlignmentAsync(string align)
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("setObjectAlignment", _handle, align);

    /// <summary>Caption text for the selected image (rendered below it).</summary>
    public async Task<bool> SetObjectCaptionAsync(string caption)
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("setObjectCaption", _handle, caption);

    /// <summary>Absolute x/y offset of the selected floating image.</summary>
    public async Task<bool> SetObjectPositionAsync(double x, double y)
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("setObjectPosition", _handle, x, y);

    /// <summary>Z-order: bring the selected image one step forward.</summary>
    public async Task<bool> BringObjectForwardAsync()
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("bringObjectForward", _handle);

    /// <summary>Z-order: send the selected image one step backward.</summary>
    public async Task<bool> SendObjectBackwardAsync()
        => _module is not null && _handle is not null && await _module.InvokeAsync<bool>("sendObjectBackward", _handle);

    /// <summary>The engine's currently selected image object (or null).</summary>
    public sealed class CoreObjectSelection
    {
        public string? ObjectId { get; set; }
        public string? Url { get; set; }
        public string? WrapMode { get; set; }
        public string? AltText { get; set; }
        public string? Caption { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
        public double X { get; set; }
        public double Y { get; set; }
    }

    /// <summary>Adds a comment over the engine's current selection (R.4.6g comments). The
    /// engine stores the record in its model + renders the anchor highlight.</summary>
    public Task<bool> AddCommentAsync(string text, string? author = null)
        => ExecCommandAsync("comment", new { text, author });

    /// <summary>Reads the engine's comments back (for the comment rail / count).</summary>
    public async Task<IReadOnlyList<CoreComment>> GetCommentsAsync()
    {
        if (_module is null || _handle is null) return Array.Empty<CoreComment>();
        var json = await _module.InvokeAsync<string?>("getCommentsJson", _handle);
        if (string.IsNullOrEmpty(json)) return Array.Empty<CoreComment>();
        return JsonSerializer.Deserialize<List<CoreComment>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true })
            ?? (IReadOnlyList<CoreComment>)Array.Empty<CoreComment>();
    }

    /// <summary>R.5.12 — appends a reply to a comment's thread.</summary>
    public Task<bool> ReplyToCommentAsync(string id, string text, string? author = null)
        => ExecCommandAsync("replycomment", new { id, text, author });

    /// <summary>R.5.12 — moves the caret to a comment's anchor and scrolls it into view.</summary>
    public Task<bool> GoToCommentAsync(string id)
        => ExecCommandAsync("gotocomment", new { id });

    /// <summary>R.5.12 — marks a comment resolved (clears its anchor highlight, keeps the record).</summary>
    public Task<bool> ResolveCommentAsync(string id)
        => ExecCommandAsync("resolvecomment", new { id });

    /// <summary>R.5.12 — reopens a resolved comment thread (anchor highlight is not restored).</summary>
    public Task<bool> ReopenCommentAsync(string id)
        => ExecCommandAsync("reopencomment", new { id });

    /// <summary>R.5.23c — installs a word-list spell checker (red squiggles + suggestions); null disables it.</summary>
    public Task<bool> SetSpellCheckAsync(IEnumerable<string>? flagged, IDictionary<string, string[]>? suggestions = null)
        => flagged is null
            ? ExecCommandAsync("setspellcheck", new { enabled = false })
            : ExecCommandAsync("setspellcheck", new { flagged = flagged.ToArray(), suggestions });

    /// <summary>R.5.22 — applies a remote collaborator's text operation (caller transforms it first).</summary>
    public async Task<bool> ApplyRemoteOperationAsync(CoreOperation op)
        => _module is not null && _handle is not null
            && await _module.InvokeAsync<bool>("applyRemoteOperation", _handle, JsonSerializer.Serialize(op));

    /// <summary>R.5.22 — sets the collaborators' remote cursors (presence overlay).</summary>
    public async Task<int> SetRemoteCursorsAsync(IEnumerable<CoreRemoteCursor> cursors)
        => _module is not null && _handle is not null
            ? await _module.InvokeAsync<int>("setRemoteCursors", _handle, JsonSerializer.Serialize(cursors))
            : 0;

    // R.5.22 — realtime collaboration wiring over the existing SignalR relay provider.
    private IDocumentCollaborationRealtimeProvider? _collabProvider;
    private DocumentCollaborationSession? _collabSession;
    private DocumentEditorAuthor? _collabAuthor;
    private string _collabColor = "#16a34a";
    private readonly Dictionary<string, CoreRemoteCursor> _remoteCursors = new();
    private static readonly JsonSerializerOptions CollabJson = new() { PropertyNameCaseInsensitive = true };

    /// <summary>R.5.22 — joins a realtime collaboration session and wires local edits ↔ the relay
    /// (the engine's OT control keeps every client convergent over the sequencer).</summary>
    public async Task<DocumentCollaborationSession?> ConnectCollaborationAsync(
        IDocumentCollaborationRealtimeProvider provider, string documentId, DocumentEditorAuthor author, string? color = null)
    {
        if (_module is null || _handle is null) return null;
        _collabProvider = provider;
        _collabAuthor = author;
        if (!string.IsNullOrEmpty(color)) _collabColor = color!;
        _collabSession = await provider.JoinAsync(new DocumentCollaborationJoinRequest
        {
            DocumentId = documentId,
            ClientId = string.IsNullOrEmpty(author.Id) ? Guid.NewGuid().ToString("N") : author.Id,
            Author = author,
        });
        provider.RemoteOperationBatchReceived += OnRemoteBatchAsync;
        provider.RemoteCursorReceived += OnRemoteCursorAsync;
        await _module.InvokeAsync<bool>("connectCollab", _handle, _collabSession.ClientId);
        return _collabSession;
    }

    /// <summary>JS→.NET — the engine's OT control wants to broadcast a local change to the relay.</summary>
    [JSInvokable]
    public async Task OnCollabSend(string? msgJson)
    {
        if (_collabProvider is null || _collabSession is null || string.IsNullOrEmpty(msgJson)) return;
        var msg = JsonSerializer.Deserialize<CollabMessage>(msgJson, CollabJson);
        if (msg is null) return;
        var batch = new DocumentOperationBatch
        {
            DocumentId = _collabSession.DocumentId,
            ClientId = msg.ClientId,
            BaseVersionId = msg.Base.ToString(System.Globalization.CultureInfo.InvariantCulture),
            Operations = msg.Ops.Select(ToDocumentOperation).ToList(),
        };
        var broadcast = await _collabProvider.BroadcastOperationBatchAsync(_collabSession.Id, batch);
        // Ack the sender's own change (the relay echoes it back tagged with the server sequence).
        await FeedServerChangeAsync(msg.Ops, msg.Base, broadcast.Sequence, msg.ClientId);
    }

    private async Task OnRemoteBatchAsync(DocumentCollaborationOperationBatch broadcast, CancellationToken ct)
    {
        try
        {
            var batch = broadcast.Batch;
            long.TryParse(batch.BaseVersionId, out var baseSeq);
            var ops = batch.Operations.Select(FromDocumentOperation).Where(o => o is not null).Select(o => o!).ToList();
            if (ops.Count == 0) return; // non-text op (mark/block) — not on the core text channel
            await InvokeAsync(() => FeedServerChangeAsync(ops, baseSeq, broadcast.Sequence, batch.ClientId ?? string.Empty));
        }
        catch (Exception)
        {
            // The hub raises this fire-and-forget; swallow so a single bad batch can't break the stream.
        }
    }

    private Task FeedServerChangeAsync(IReadOnlyList<CoreOperation> ops, long baseSeq, long sequence, string clientId)
    {
        if (_module is null || _handle is null) return Task.CompletedTask;
        // The engine's op shape is camelCase (type/blockId/offset/text) — serialize to match,
        // NOT the C# PascalCase default, or applyRemoteOperation silently ignores the op.
        var change = new
        {
            ops = ops.Select(o => new { type = o.Type, blockId = o.BlockId, offset = o.Offset, text = o.Text }),
            @base = baseSeq,
            sequence,
            clientId,
        };
        return _module.InvokeVoidAsync("collabReceiveServerChange", _handle, JsonSerializer.Serialize(change)).AsTask();
    }

    private async Task OnRemoteCursorAsync(DocumentCollaborationCursor cursor, CancellationToken ct)
    {
        if (_collabSession is not null && cursor.ClientId == _collabSession.ClientId) return; // skip our own
        if (cursor.Offset is null or < 0 || string.IsNullOrEmpty(cursor.BlockId))
        {
            _remoteCursors.Remove(cursor.ClientId); // a leave / cleared cursor
        }
        else
        {
            _remoteCursors[cursor.ClientId] = new CoreRemoteCursor
            {
                Id = cursor.ClientId,
                BlockId = cursor.BlockId,
                Offset = cursor.Offset ?? 0,
                Color = string.IsNullOrEmpty(cursor.Color) ? "#2563eb" : cursor.Color,
                Label = cursor.DisplayName,
            };
        }
        await InvokeAsync(() => SetRemoteCursorsAsync(_remoteCursors.Values.ToList()));
    }

    /// <summary>R.5.22 — broadcasts this client's caret to collaborators (presence).</summary>
    public Task BroadcastCursorAsync(string blockId, int offset)
        => _collabProvider is null || _collabSession is null
            ? Task.CompletedTask
            : _collabProvider.BroadcastCursorAsync(new DocumentCollaborationCursor
            {
                DocumentId = _collabSession.DocumentId,
                SessionId = _collabSession.Id,
                ClientId = _collabSession.ClientId,
                DisplayName = _collabAuthor?.DisplayName ?? "You",
                BlockId = blockId,
                Offset = offset,
                Color = _collabColor,
            });

    private static DocumentOperation ToDocumentOperation(CoreOperation op) => new()
    {
        Type = op.Type == "delete" ? DocumentOperationType.DeleteText : DocumentOperationType.InsertText,
        Target = new DocumentOperationTarget { BlockId = op.BlockId, Offset = op.Offset, Length = op.Type == "delete" ? (op.Text ?? string.Empty).Length : null },
        Text = op.Text,
    };

    private static CoreOperation? FromDocumentOperation(DocumentOperation op)
    {
        var type = op.Type == DocumentOperationType.DeleteText ? "delete"
            : op.Type == DocumentOperationType.InsertText ? "insert" : null;
        if (type is null) return null; // only text ops travel the core-engine collab channel
        return new CoreOperation { Type = type, BlockId = op.Target.BlockId, Offset = op.Target.Offset ?? 0, Text = op.Text };
    }

    /// <summary>Wire shape of a collab change emitted by the engine's OT control (collab-client.mjs).</summary>
    private sealed class CollabMessage
    {
        public string? Kind { get; set; }
        public List<CoreOperation> Ops { get; set; } = new();
        public long Base { get; set; }
        public string ClientId { get; set; } = string.Empty;
    }

    /// <summary>JS→.NET — a local edit emitted a text operation (broadcast for collaboration).</summary>
    [JSInvokable]
    public Task OnCoreOperation(string? opJson)
    {
        if (string.IsNullOrEmpty(opJson)) return Task.CompletedTask;
        var op = JsonSerializer.Deserialize<CoreOperation>(opJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        return op is null ? Task.CompletedTask : OnOperation.InvokeAsync(op);
    }

    /// <summary>R.5.18/R.5.22 — a text operation (insert/delete) in the operation algebra.</summary>
    public sealed class CoreOperation
    {
        public string? Type { get; set; }       // "insert" | "delete"
        public string? BlockId { get; set; }
        public int Offset { get; set; }
        public string? Text { get; set; }
    }

    /// <summary>R.5.22 — a collaborator's caret position + identity for the presence overlay.</summary>
    public sealed class CoreRemoteCursor
    {
        public string? Id { get; set; }
        public string? BlockId { get; set; }
        public int Offset { get; set; }
        public string? Color { get; set; }
        public string? Label { get; set; }
    }

    /// <summary>R.5.12 — removes a comment and its anchor entirely.</summary>
    public Task<bool> RemoveCommentAsync(string id)
        => ExecCommandAsync("removecomment", new { id });

    /// <summary>An engine comment record (model.comments + anchor text + thread).</summary>
    public sealed class CoreComment
    {
        public string? Id { get; set; }
        public string? Author { get; set; }
        public string? Text { get; set; }
        public bool Resolved { get; set; }
        public string? AnchorText { get; set; }
        public string? AnchorBlockId { get; set; }
        public int? AnchorOffset { get; set; }
        public long CreatedAt { get; set; }
        public List<CoreCommentReply> Replies { get; set; } = new();
    }

    /// <summary>A reply within a comment thread (R.5.12).</summary>
    public sealed class CoreCommentReply
    {
        public string? Author { get; set; }
        public string? Text { get; set; }
        public long CreatedAt { get; set; }
    }

    /// <summary>Toolbar-facing formatting snapshot from the core engine.</summary>
    public sealed class CoreFormattingState
    {
        public bool Bold { get; set; }
        public bool Italic { get; set; }
        public bool Underline { get; set; }
        public bool Strikethrough { get; set; }
        public bool Link { get; set; }
        public string? Alignment { get; set; }
        public bool BulletList { get; set; }
        public bool NumberedList { get; set; }
        public string? ListType { get; set; }
        public string? ParagraphStyle { get; set; }
    }

    public async Task FocusAsync()
    {
        if (_module is not null && _handle is not null) await _module.InvokeVoidAsync("focus", _handle);
    }

    public async ValueTask DisposeAsync()
    {
        if (_collabProvider is not null)
        {
            _collabProvider.RemoteOperationBatchReceived -= OnRemoteBatchAsync;
            _collabProvider.RemoteCursorReceived -= OnRemoteCursorAsync;
            try { if (_collabSession is not null) await _collabProvider.LeaveAsync(_collabSession.Id); }
            catch (Exception) { /* best effort */ }
        }

        try
        {
            if (_module is not null && _handle is not null) await _module.InvokeVoidAsync("dispose", _handle);
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
        catch (Exception) { /* best effort */ }
        try { if (_module is not null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { /* circuit gone */ }
        catch (Exception) { /* best effort */ }
        _selfRef?.Dispose();
    }
}
