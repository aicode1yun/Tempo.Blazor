@namespace Tempo.Blazor.Components.DocumentEditor
@using Tempo.Blazor.Components.Activity
@using Tempo.Blazor.DocumentEditor.Models
@using Tempo.Blazor.DocumentEditor.Interfaces
@using Tempo.Blazor.DocumentEditor.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Buffers
@using System.Globalization
@using System.IO
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div @ref="_rootElement"
     class="@RootClass"
     style="@RootStyle"
     data-testid="document-wysiwyg-host"
     data-surface-mode="wysiwyg"
     data-instance-id="@_instanceId"
     data-ruler-visible="@ShowRuler.ToString().ToLowerInvariant()"
     data-zoom-percent="@ZoomPercent"
     data-zoom-mode="@(ZoomPageWidth ? "page-width" : "percent")"
     data-active-table-cell-id="@(_lastSelectionSnapshot?.ActiveTableCellId ?? string.Empty)"
     data-table-properties-open="@_tablePropertiesPanelOpen.ToString().ToLowerInvariant()"
     data-cell-properties-open="@_cellPropertiesPanelOpen.ToString().ToLowerInvariant()"
     data-active-table-cell-resolved="@((ActiveTableCell is not null).ToString().ToLowerInvariant())"
     data-active-region="@ActiveRegion"
     data-focus-owner="@FocusOwner"
     role="textbox"
     aria-label="@Loc["TmDocumentEditor_WysiwygSurfaceLabel"]"
     aria-describedby="@_accessibilityDescriptionId"
     aria-multiline="true"
     aria-readonly="@(ReadOnly ? "true" : "false")"
     aria-keyshortcuts="Control+B Control+I Control+U Control+Z Control+Y Control+S Shift+F10 Alt+Shift+O Alt+Shift+P Control+Alt+O Control+Alt+P F10 Delete Escape"
     tabindex="@(_jsReady && !_jsFailed ? "0" : "-1")">
    <span id="@_accessibilityDescriptionId"
          class="tm-document-wysiwyg-host__sr-only"
          data-testid="document-wysiwyg-accessibility-help">
        @Loc["TmDocumentEditor_WysiwygScreenReaderHelp"]
    </span>
    @if (_jsFailed)
    {
        <div class="tm-document-wysiwyg-host__fallback" role="alert">
            <TmAlert Severity="AlertSeverity.Warning"
                     Title="@Loc["TmDocumentEditor_WysiwygFallbackTitle"]">
                @Loc["TmDocumentEditor_WysiwygFallbackMessage"]
            </TmAlert>
        </div>
    }
    else if (!_jsReady)
    {
        <div class="tm-document-wysiwyg-host__loading" aria-busy="true">
            <TmSkeleton Variant="SkeletonVariant.Rect" Height="40px" Width="100%" />
            <TmSkeleton Variant="SkeletonVariant.Rect" Height="520px" Width="min(100%, 760px)" />
            <span class="tm-document-wysiwyg-host__sr-only">@Loc["TmDocumentEditor_Loading"]</span>
        </div>
    }
    <div @ref="_engineRootElement"
         class="tm-document-wysiwyg-host__engine-root"
         data-testid="document-wysiwyg-engine-root"></div>
</div>

@if (_pasteReportWarnings.Count > 0)
{
    <TmDocumentPasteReport Warnings="@_pasteReportWarnings"
                           OnClose="ClosePasteReportAsync" />
}

@if (!ReadOnly && (_imageDialogOpen || _autocompleteMenuOpen || ActiveTableCell is not null || ActiveImageContent is not null))
{
    <div class="tm-document-editor__floating-root tm-document-editor__floating-root--wysiwyg"
         data-testid="document-wysiwyg-floating-root"
         @onclick:stopPropagation="true">
        @if (ActiveImageContent is { } activeImage)
        {
            <TmDocumentImageWrapPanel CurrentWrapMode="@GetImageWrapMode(activeImage)"
                                      CurrentHorizontalPosition="@GetImageHorizontalPosition(activeImage)"
                                      DistanceLeft="@activeImage.Layout.Wrap.DistanceLeft"
                                      DistanceRight="@activeImage.Layout.Wrap.DistanceRight"
                                      DistanceTop="@activeImage.Layout.Wrap.DistanceTop"
                                      DistanceBottom="@activeImage.Layout.Wrap.DistanceBottom"
                                      LockAnchor="@activeImage.Layout.Anchor.LockAnchor"
                                      OnWrapModeChanged="SetActiveImageWrapModeAsync"
                                      OnHorizontalPositionChanged="SetActiveImageHorizontalPositionAsync"
                                      OnDistanceLeftChanged="value => SetActiveImageWrapDistanceAsync(nameof(DocumentObjectWrap.DistanceLeft), value)"
                                      OnDistanceRightChanged="value => SetActiveImageWrapDistanceAsync(nameof(DocumentObjectWrap.DistanceRight), value)"
                                      OnDistanceTopChanged="value => SetActiveImageWrapDistanceAsync(nameof(DocumentObjectWrap.DistanceTop), value)"
                                      OnDistanceBottomChanged="value => SetActiveImageWrapDistanceAsync(nameof(DocumentObjectWrap.DistanceBottom), value)"
                                      OnLockAnchorChanged="SetActiveImageLockAnchorAsync"
                                      OnCaptionToggle="ToggleActiveImageCaptionAsync"
                                      OnReplaceRequested="OpenImageDialogAsync"
                                      OnDelete="DeleteActiveImageAsync"
                                      OnAltTextRequested="FocusActiveImageOptionsAsync"
                                      OnMoreOptionsRequested="FocusActiveImageOptionsAsync" />
        }

        @if (ActiveTableCell is { } activeCell)
        {
            <TmDocumentTableToolbar InsertRowBefore="InsertActiveTableRowBeforeAsync"
                                    InsertRowAfter="InsertActiveTableRowAfterAsync"
                                    InsertColumnBefore="InsertActiveTableColumnBeforeAsync"
                                    InsertColumnAfter="InsertActiveTableColumnAfterAsync"
                                    DeleteRow="DeleteActiveTableRowAsync"
                                    DeleteColumn="DeleteActiveTableColumnAsync"
                                    MergeCells="MergeActiveTableCellsAsync"
                                    SplitCell="SplitActiveTableCellAsync"
                                    TableProperties="OpenActiveTablePropertiesPanelAsync"
                                    CellProperties="OpenActiveCellPropertiesPanelAsync" />

            @if (_tablePropertiesPanelOpen && ActiveTableContent is { } activeTable)
            {
                <TmDocumentTablePropertiesPanel Layout="activeTable.Layout"
                                                LayoutChanged="SetActiveTablePropertiesAsync" />
            }

            @if (_cellPropertiesPanelOpen)
            {
                <TmDocumentCellPropertiesPanel Cell="activeCell"
                                               CellChanged="SetActiveCellPropertiesAsync" />
            }
        }

        @if (_imageDialogOpen)
        {
            <section class="tm-document-image-dialog" data-testid="document-wysiwyg-image-dialog">
                @if (!string.IsNullOrWhiteSpace(_imageError))
                {
                    <div class="tm-document-paste-error" role="alert">@_imageError</div>
                }
                @if (_pendingImageUpload)
                {
                    <div class="tm-document-paste-status">@Loc["TmDocumentEditor_ImageUploading"]</div>
                }
                <label>
                    <span>@Loc["TmDocumentEditor_ImageUrl"]</span>
                    <input data-testid="document-wysiwyg-image-url-input"
                           value="@_pendingImageUrl"
                           @oninput="args => _pendingImageUrl = args.Value?.ToString()" />
                </label>
                <label>
                    <span>@Loc["TmDocumentEditor_ImageAltText"]</span>
                    <input data-testid="document-wysiwyg-image-alt-input"
                           value="@_pendingImageAltText"
                           @oninput="args => _pendingImageAltText = args.Value?.ToString()" />
                </label>
                <button type="button"
                        data-testid="document-wysiwyg-insert-image-url"
                        @onclick="InsertImageUrlAsync">
                    @Loc["TmDocumentEditor_InsertImage"]
                </button>
                <button type="button"
                        data-testid="document-wysiwyg-upload-demo-image"
                        @onclick="InsertProviderImageAsync"
                        disabled="@(ImageProvider is null || _pendingImageUpload)">
                    @Loc["TmDocumentEditor_UploadImage"]
                </button>
            </section>
        }

        @if (_autocompleteMenuOpen)
        {
            <section class="tm-document-token-popover"
                     data-autocomplete-kind="@_autocompleteTrigger?.Kind.ToString().ToLowerInvariant()"
                     data-testid="@AutocompletePopoverTestId"
                     @onkeydown="HandleAutocompletePopoverKeyDownAsync"
                     @onkeydown:stopPropagation="true">
                <div class="tm-document-token-popover__header">
                    <input class="tm-document-token-popover__search"
                           @ref="_autocompleteSearchInput"
                           data-testid="@AutocompleteSearchTestId"
                           placeholder="@AutocompleteSearchPlaceholder"
                           aria-label="@AutocompleteSearchPlaceholder"
                           value="@_autocompleteQuery"
                           @oninput="HandleAutocompleteQueryInputAsync" />
                    <button type="button"
                            class="tm-document-token-popover__close"
                            data-testid="@AutocompleteCloseTestId"
                            aria-label="@Loc["TmDocumentEditor_Close"]"
                            @onclick="CloseAutocompleteMenu">
                        <TmIcon Name="x" Size="IconSize.Sm" />
                    </button>
                </div>
                <TmDocumentAutocompleteMenu IsVisible="true"
                                            Items="@FilteredAutocompleteItems"
                                            Query="@_autocompleteQuery"
                                            Trigger="@_autocompleteTrigger"
                                            HighlightedIndex="@_autocompleteHighlightedIndex"
                                            IsLoading="@_autocompleteMenuLoading"
                                            ErrorMessage="@_autocompleteWarning"
                                            LoadingText="@Loc["TmDocumentEditor_AutocompleteLoading"]"
                                            EmptyText="@Loc["TmDocumentEditor_AutocompleteEmpty"]"
                                            OnItemSelected="InsertAutocompleteItemAsync"
                                            OnHighlightedIndexChanged="SetAutocompleteHighlightedIndex" />
            </section>
        }
    </div>
}

@code {
    private ElementReference _rootElement;
    private ElementReference _engineRootElement;
    private string _instanceId = Guid.NewGuid().ToString("N");
    private string _accessibilityDescriptionId = $"tm-wysiwyg-a11y-{Guid.NewGuid():N}";
    private bool _jsReady;
    private bool _jsReadySnapshotInitialized;
    private bool _jsFailed;
    private bool _disposed;
    private DotNetObjectReference<TmDocumentWysiwygHost>? _dotNetRef;
    private WysiwygSelectionSnapshot? _lastSelectionSnapshot;
    private bool _imageDialogOpen;
    private bool _pendingImageUpload;
    private string? _imageError;
    private string? _pendingImageUrl;
    private string? _pendingImageAltText;
    private string? _lastSentSnapshotJson;
    private DocumentEditorDocument? _lastSnapshotDocument;
    // Phase C1 — last document Version we sent over JS interop. Defaults to long.MinValue so
    // the first send always fires (even if Document.Version starts at 0).
    private long _lastSnapshotVersion = long.MinValue;
    private IReadOnlyList<DocumentSuggestion>? _lastSnapshotSuggestions;
    private bool _lastSnapshotReadOnly;
    private bool _lastTrackChangesEnabled;
    private DocumentReviewDisplayMode _lastReviewDisplayMode = DocumentReviewDisplayMode.AllMarkup;
    private bool _hasSentSnapshot;
    // Phase C4 — bounded LRU cache for ImageUrlResolver / ImageProvider results.
    private readonly Performance.ImageResolveCache _imageResolveCache = new(capacity: 256, ttl: TimeSpan.FromMinutes(5));
    private string? _lastAppliedRuntimeDraftStateJson;
    private bool _autocompleteMenuOpen;
    private bool _autocompleteMenuLoading;
    private bool _tablePropertiesPanelOpen;
    private bool _cellPropertiesPanelOpen;
    private bool _focusAutocompleteSearchOnRender;
    private string _autocompleteQuery = string.Empty;
    private string? _autocompleteWarning;
    private int _autocompleteHighlightedIndex;
    private List<DocumentAutocompleteItem> _autocompleteItems = [];
    private DocumentAutocompleteTrigger? _autocompleteTrigger;
    private readonly DocumentAutocompleteProviderRunner _autocompleteRunner = new();
    private IReadOnlyList<Clipboard.DocumentClipboardWarning> _pasteReportWarnings = [];
    private Clipboard.DocumentClipboardDebugSnapshot _lastClipboardDebugSnapshot = new();
    private ElementReference _autocompleteSearchInput;

    /// <summary>Document snapshot to render in the WYSIWYG surface.</summary>
    [Parameter] public DocumentEditorDocument? Document { get; set; }

    /// <summary>Whether the surface is read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Host-controlled permissions for the current user.</summary>
    [Parameter] public DocumentEditorPermissions Permissions { get; set; } = new();

    /// <summary>Optional image URL resolver for provider-managed assets.</summary>
    [Parameter] public IDocumentImageUrlResolver? ImageUrlResolver { get; set; }

    /// <summary>Optional image provider for upload and clipboard flows.</summary>
    [Parameter] public IDocumentImageProvider? ImageProvider { get; set; }

    /// <summary>Provider-managed image assets available for direct insertion or replacement.</summary>
    [Parameter] public IReadOnlyList<DocumentImageAsset> ImageAssetOptions { get; set; } = [];

    /// <summary>Image validation options used by upload and clipboard image flows.</summary>
    [Parameter] public DocumentImageValidationOptions ImageValidation { get; set; } = new();

    /// <summary>Whether clipboard images can be kept as local draft assets when no image provider is available.</summary>
    [Parameter] public bool AllowOfflineClipboardImages { get; set; }

    /// <summary>Optional token provider for document token autocomplete.</summary>
    [Parameter] public ITokenDataProvider? TokenProvider { get; set; }

    /// <summary>Optional mention provider for document mention autocomplete.</summary>
    [Parameter] public IMentionDataProvider? MentionProvider { get; set; }

    /// <summary>Current editing author used for JS-owned runtime revisions.</summary>
    [Parameter] public DocumentEditorAuthor? Author { get; set; }

    /// <summary>Font families allowed by the host editor.</summary>
    [Parameter] public IReadOnlyList<DocumentFontFamily> FontFamilies { get; set; } = [];

    /// <summary>Whether the page ruler should be visible.</summary>
    [Parameter] public bool ShowRuler { get; set; } = true;

    /// <summary>Current page zoom percentage.</summary>
    [Parameter] public int ZoomPercent { get; set; } = 100;

    /// <summary>Whether page-width zoom mode is active.</summary>
    [Parameter] public bool ZoomPageWidth { get; set; }

    /// <summary>Pending provider-backed suggestions to decorate in the WYSIWYG surface.</summary>
    [Parameter] public IReadOnlyList<DocumentSuggestion> Suggestions { get; set; } = [];

    /// <summary>Whether live track-changes decorations are enabled in the JS-owned surface.</summary>
    [Parameter] public bool TrackChangesEnabled { get; set; }

    /// <summary>How tracked changes should be displayed in the JS-owned surface.</summary>
    [Parameter] public DocumentReviewDisplayMode ReviewDisplayMode { get; set; } = DocumentReviewDisplayMode.AllMarkup;

    /// <summary>Raised when the JS engine generates a patch that should be applied to the document.</summary>
    [Parameter] public EventCallback<WysiwygPatch> DocumentPatchGenerated { get; set; }

    /// <summary>Raised when the JS engine reports a new document snapshot (e.g. after explicit save or export).</summary>
    [Parameter] public EventCallback<DocumentEditorDocument> DocumentSnapshotChanged { get; set; }

    /// <summary>Raised when the JS engine reports selection change.</summary>
    [Parameter] public EventCallback<WysiwygSelectionSnapshot?> DocumentSelectionChanged { get; set; }

    /// <summary>Raised when the JS engine requests a text context menu.</summary>
    [Parameter] public EventCallback<WysiwygTextContextMenuRequest> TextContextMenuRequested { get; set; }

    /// <summary>Raised when the JS engine requests a table context menu.</summary>
    [Parameter] public EventCallback<WysiwygTableContextMenuRequest> TableContextMenuRequested { get; set; }

    /// <summary>Raised when the JS engine shows or hides the inline mini toolbar.</summary>
    [Parameter] public EventCallback<WysiwygMiniToolbarRequest?> MiniToolbarChanged { get; set; }

    /// <summary>Raised when the JS runtime publishes canonical formatting state for the current selection.</summary>
    [Parameter] public EventCallback<WysiwygFormattingState> FormattingStateChanged { get; set; }

    /// <summary>Raised when the JS-owned inline revision UI requests accept or reject.</summary>
    [Parameter] public EventCallback<WysiwygRevisionReviewRequest> RevisionReviewRequested { get; set; }

    /// <summary>Raised when the JS-owned runtime revision list changes.</summary>
    [Parameter] public EventCallback<IReadOnlyList<DocumentRevision>> RevisionsChanged { get; set; }

    /// <summary>Raised when the JS-owned runtime comment list changes.</summary>
    [Parameter] public EventCallback<IReadOnlyList<DocumentComment>> CommentsChanged { get; set; }

    /// <summary>Raised when the user selects a comment anchor inside the JS-owned surface.</summary>
    [Parameter] public EventCallback<string> CommentSelected { get; set; }

    /// <summary>Raised when the user selects a revision marker inside the JS-owned surface.</summary>
    [Parameter] public EventCallback<string> RevisionSelected { get; set; }

    /// <summary>Raised when a typing transaction is committed.</summary>
    [Parameter] public EventCallback TransactionCommitted { get; set; }

    /// <summary>Raised when the JS-owned undo/redo stack state changes.</summary>
    [Parameter] public EventCallback<WysiwygUndoState> UndoStateChanged { get; set; }

    /// <summary>Raised when the JS-owned dirty/save state changes.</summary>
    [Parameter] public EventCallback<WysiwygDirtyState> DirtyStateChanged { get; set; }

    /// <summary>Raised when the JS-owned editor has an accessibility status announcement.</summary>
    [Parameter] public EventCallback<string> AccessibilityAnnouncementChanged { get; set; }

    /// <summary>Serialized JS-owned offline runtime state to restore after loading an offline draft.</summary>
    [Parameter] public string? RuntimeDraftStateJson { get; set; }

    /// <summary>Raised when the user requests undo via keyboard.</summary>
    [Parameter] public EventCallback UndoRequested { get; set; }

    /// <summary>Raised when the user requests redo via keyboard.</summary>
    [Parameter] public EventCallback RedoRequested { get; set; }

    /// <summary>Raised when the user requests save via keyboard.</summary>
    [Parameter] public EventCallback SaveRequested { get; set; }

    /// <summary>Raised when the JS editor surface owns a keyboard shortcut that must run through the command registry.</summary>
    [Parameter] public EventCallback<string> KeyboardCommandRequested { get; set; }

    /// <summary>Fired when an image upload starts (<c>true</c>) or finishes (<c>false</c>).</summary>
    [Parameter] public EventCallback<bool> ImageUploadStateChanged { get; set; }

    /// <summary>Fired when the JS watchdog successfully recovers the runtime after an error.</summary>
    [Parameter] public EventCallback RuntimeRecovered { get; set; }

    /// <summary>Fired when the JS watchdog fails to recover the runtime after an error.</summary>
    [Parameter] public EventCallback RuntimeRecoveryFailed { get; set; }

    /// <summary>Fired when the JS watchdog reports recovery telemetry or debug detail.</summary>
    [Parameter] public EventCallback<WysiwygRuntimeRecoveryDetail> RuntimeRecoveryDetailChanged { get; set; }

    /// <summary>Fired when the WYSIWYG runtime reports page metrics.</summary>
    [Parameter] public EventCallback<WysiwygPageMetrics> PageMetricsChanged { get; set; }

    /// <summary>Fired when the WYSIWYG runtime detects a new active heading during scroll.</summary>
    [Parameter] public EventCallback<string?> ActiveHeadingChanged { get; set; }

    private string RootClass
    {
        get
        {
            var classes = new List<string> { "tm-document-wysiwyg-host" };
            if (ShowRuler)
            {
                classes.Add("tm-document-wysiwyg-host--ruler");
            }

            if (ZoomPageWidth)
            {
                classes.Add("tm-document-wysiwyg-host--zoom-page-width");
            }

            return string.Join(" ", classes);
        }
    }

    private string RootStyle
    {
        get
        {
            var zoom = Math.Clamp(ZoomPercent, 50, 200) / 100d;
            return string.Create(CultureInfo.InvariantCulture, $"--tm-document-zoom: {zoom:0.##};");
        }
    }

    private string ActiveRegion => string.IsNullOrWhiteSpace(_lastSelectionSnapshot?.Region)
        ? "Body"
        : _lastSelectionSnapshot.Region;

    private string FocusOwner
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(GetActiveImageSelectionObjectId()))
            {
                return "image";
            }

            if (!string.IsNullOrWhiteSpace(_lastSelectionSnapshot?.ActiveTableCellId))
            {
                return "tablecell";
            }

            return ActiveRegion.ToLowerInvariant();
        }
    }

    private DocumentDrawingRun? ActiveImageDrawingRun => FindDrawingRunByObjectId(Document, GetActiveImageSelectionObjectId());

    private ImageBlockContent? ActiveImageContent => CreateImageBlockContentFromDrawingRun(ActiveImageDrawingRun);

    private string? GetActiveImageSelectionObjectId()
    {
        if (!string.IsNullOrWhiteSpace(_lastSelectionSnapshot?.ObjectSelection?.ObjectId))
        {
            return _lastSelectionSnapshot.ObjectSelection.ObjectId;
        }

        if (!string.IsNullOrWhiteSpace(_lastSelectionSnapshot?.ActiveObjectId))
        {
            return _lastSelectionSnapshot.ActiveObjectId;
        }

        return null;
    }

    private string? GetActiveImageSelectionBlockId()
    {
        if (!string.IsNullOrWhiteSpace(_lastSelectionSnapshot?.ObjectSelection?.AnchorBlockId))
        {
            return _lastSelectionSnapshot.ObjectSelection.AnchorBlockId;
        }

        if (string.Equals(_lastSelectionSnapshot?.Region, "Image", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_lastSelectionSnapshot?.HitTargetKind, "image", StringComparison.OrdinalIgnoreCase)
            || string.Equals(_lastSelectionSnapshot?.HitTargetKind, "object", StringComparison.OrdinalIgnoreCase))
        {
            return !string.IsNullOrWhiteSpace(_lastSelectionSnapshot?.AnchorBlockId)
                ? _lastSelectionSnapshot.AnchorBlockId
                : _lastSelectionSnapshot?.FocusBlockId;
        }

        return null;
    }

    private static ImageBlockContent? CreateImageBlockContentFromDrawingRun(DocumentDrawingRun? drawing)
    {
        if (drawing is null)
        {
            return null;
        }

        return new ImageBlockContent
        {
            Source = drawing.Source,
            Url = drawing.Url,
            AssetId = drawing.AssetId,
            AltText = drawing.AltText,
            IsDecorative = drawing.IsDecorative,
            Caption = drawing.Caption,
            Size = drawing.Size,
            NaturalSize = drawing.NaturalSize,
            Layout = drawing.Layout,
            LinkUrl = drawing.LinkUrl
        };
    }

    private static DocumentDrawingRun? FindDrawingRunByObjectId(DocumentEditorDocument? document, string? objectId)
    {
        if (document is null || string.IsNullOrWhiteSpace(objectId))
        {
            return null;
        }

        foreach (var block in EnumerateDocumentBlocksForObjectSelection(document))
        {
            var inlines = block.Content switch
            {
                ParagraphBlockContent paragraph => paragraph.Inlines,
                HeadingBlockContent heading => heading.Inlines,
                ListBlockContent list => list.Inlines,
                QuoteBlockContent quote => quote.Inlines,
                _ => null
            };
            var drawing = inlines?.OfType<DocumentDrawingRun>()
                .FirstOrDefault(run => string.Equals(run.ObjectId, objectId, StringComparison.Ordinal));
            if (drawing is not null)
            {
                return drawing;
            }
        }

        return null;
    }

    private static IEnumerable<DocumentBlock> EnumerateDocumentBlocksForObjectSelection(DocumentEditorDocument document)
    {
        foreach (var block in document.Blocks)
        {
            yield return block;

            if (block.Content is TableBlockContent table)
            {
                foreach (var nestedBlock in table.Rows.SelectMany(row => row.Cells).SelectMany(cell => cell.Blocks))
                {
                    yield return nestedBlock;
                }
            }
        }

        foreach (var headerFooter in document.HeadersFooters)
        {
            foreach (var block in headerFooter.Blocks)
            {
                yield return block;
            }
        }
    }

    private TableBlockContent? ActiveTableContent
    {
        get
        {
            var active = FindActiveTableCell();
            if (active.Table is not null)
            {
                return active.Table;
            }

            return string.IsNullOrWhiteSpace(_lastSelectionSnapshot?.ActiveTableCellId)
                ? null
                : new TableBlockContent();
        }
    }

    private TableCellContent? ActiveTableCell
    {
        get
        {
            var active = FindActiveTableCell();
            if (active.Cell is not null)
            {
                return active.Cell;
            }

            return string.IsNullOrWhiteSpace(_lastSelectionSnapshot?.ActiveTableCellId)
                ? null
                : new TableCellContent { Id = _lastSelectionSnapshot.ActiveTableCellId };
        }
    }

    private (TableBlockContent? Table, TableCellContent? Cell) FindActiveTableCell()
    {
        var cellId = _lastSelectionSnapshot?.ActiveTableCellId;
        if (string.IsNullOrWhiteSpace(cellId) || Document is null)
        {
            return (null, null);
        }

        foreach (var table in EnumerateTables(Document.Blocks))
        {
            var cell = table.Rows.SelectMany(row => row.Cells)
                .FirstOrDefault(candidate => string.Equals(candidate.Id, cellId, StringComparison.Ordinal));
            if (cell is not null)
            {
                return (table, cell);
            }
        }

        return (null, null);
    }

    private static IEnumerable<TableBlockContent> EnumerateTables(IEnumerable<DocumentBlock> blocks)
    {
        foreach (var block in blocks)
        {
            if (block.Content is TableBlockContent table)
            {
                yield return table;
                foreach (var nested in table.Rows.SelectMany(row => row.Cells).SelectMany(cell => EnumerateTables(cell.Blocks)))
                {
                    yield return nested;
                }
            }
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            await InitializeJsEngineAsync();
        }

        if (_focusAutocompleteSearchOnRender)
        {
            _focusAutocompleteSearchOnRender = false;
            try
            {
                await _autocompleteSearchInput.FocusAsync(preventScroll: true);
            }
            catch
            {
                // Element focus can fail during prerender or if the popover closed before render.
            }
        }
    }

    private async Task InitializeJsEngineAsync()
    {
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            var options = new WysiwygEditorOptions
            {
                InstanceId = _instanceId,
                ReadOnly = ReadOnly,
                ProtocolVersion = 1,
                EnableMutationGuard = true,
                TypingBatchMs = 500,
                AccessibilityHelp = Loc["TmDocumentEditor_WysiwygScreenReaderHelp"],
                PageLabel = Loc["TmDocumentEditor_WysiwygPageLabel"],
                BodyLabel = Loc["TmDocumentEditor_WysiwygBodyLabel"],
                HeaderLabel = Loc["TmDocumentEditor_WysiwygHeaderLabel"],
                FooterLabel = Loc["TmDocumentEditor_WysiwygFooterLabel"],
                BodyPlaceholder = Loc["TmDocumentEditor_WysiwygBodyPlaceholder"],
                HeaderPlaceholder = Loc["TmDocumentEditor_WysiwygHeaderPlaceholder"],
                FooterPlaceholder = Loc["TmDocumentEditor_WysiwygFooterPlaceholder"],
                TableCellPlaceholder = Loc["TmDocumentEditor_WysiwygTableCellPlaceholder"],
                PageOverflowWarning = Loc["TmDocumentEditor_WysiwygPageOverflowWarning"],
                InsertPageBreakLabel = Loc["TmDocumentEditor_InsertPageBreak"],
                ImageResizeHandleLabel = Loc["TmDocumentEditor_WysiwygImageResizeHandleLabel"],
                ImageAltMissing = Loc["TmDocumentEditor_ImageAltMissing"],
                ImageRetryLabel = Loc["TmDocumentEditor_Retry"],
                HasImageAssetOptions = ImageAssetOptions.Count > 0,
                FontFamilies = FontFamilies,
                Author = Author,
                SuggestionInsertLabel = Loc["TmDocumentEditor_SuggestionInsertAria"],
                SuggestionDeleteLabel = Loc["TmDocumentEditor_SuggestionDeleteAria"],
                TrackChangesEnabled = TrackChangesEnabled,
                ReviewDisplayMode = ReviewDisplayMode
            };

            await JSRuntime.InvokeVoidAsync(
                "tmDocumentEditorRuntime.create",
                _engineRootElement,
                options,
                _dotNetRef);
        }
        catch (JSException)
        {
            _jsFailed = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
            // JS runtime not available (e.g. prerendering).
            _jsFailed = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Called by the JS engine when it is ready.</summary>
    [JSInvokable]
    public async Task HandleJsEngineReady(WysiwygEngineReadyEventArgs args)
    {
        if (_jsReadySnapshotInitialized)
        {
            _jsReady = true;
            await ApplyRuntimeDraftStateIfNeededAsync();
            await InvokeAsync(StateHasChanged);
            return;
        }

        _jsReadySnapshotInitialized = true;
        _jsReady = true;
        await SendSnapshotAsync(force: true);
        await ApplyRuntimeDraftStateIfNeededAsync(force: true);
        await InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (!_jsReady || _jsFailed || _disposed)
        {
            return;
        }

        var readOnlyChanged = ReadOnly != _lastSnapshotReadOnly;
        if (readOnlyChanged)
        {
            await SetReadOnlyAsync(ReadOnly);
        }

        if (TrackChangesEnabled != _lastTrackChangesEnabled)
        {
            await SetTrackChangesEnabledAsync(TrackChangesEnabled);
        }

        if (ReviewDisplayMode != _lastReviewDisplayMode)
        {
            await SetReviewDisplayModeAsync(ReviewDisplayMode);
        }

        if (ShouldSendParameterSnapshot())
        {
            await SendSnapshotAsync(force: readOnlyChanged);
        }

        await ApplyRuntimeDraftStateIfNeededAsync();
    }

