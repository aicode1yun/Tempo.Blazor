    /// <summary>Called by the JS engine with raw clipboard HTML and plain text.
    /// Runs the C# clipboard pipeline for normalization and returns processed blocks as JSON.</summary>
    [JSInvokable]
    public async Task<string> HandleClipboardPasteRequested(string html, string plain)
    {
        var pipeline = new Clipboard.DocumentClipboardPipeline([
            new Clipboard.Normalizers.WordClipboardNormalizer(),
            new Clipboard.Normalizers.GoogleDocsClipboardNormalizer(),
            new Clipboard.Normalizers.GoogleSheetsClipboardNormalizer(),
            new Clipboard.Normalizers.UrlClipboardNormalizer(),
            new Clipboard.Normalizers.RawHtmlClipboardNormalizer()
        ]);

        var region = DocumentEditorSchemaNames.ParseRegion(_lastSelectionSnapshot?.Region);
        var raw = new Clipboard.DocumentClipboardRawInput { Html = html, PlainText = plain };
        var result = pipeline.ProcessForInsertion(raw, region);

        _pasteReportWarnings = result.Warnings;
        _lastClipboardDebugSnapshot = new Clipboard.DocumentClipboardDebugSnapshot
        {
            RawHtml = html,
            PlainText = plain,
            Source = result.Source,
            Region = result.Region,
            NormalizedJson = JsonSerializer.Serialize(result.Blocks, new JsonSerializerOptions(DocumentEditorJson.Options)
            {
                WriteIndented = true
            }),
            Warnings = result.Warnings,
            CapturedAt = DateTimeOffset.UtcNow
        };
        if (_pasteReportWarnings.Count > 0)
        {
            _ = AutoHidePasteReportAsync();
        }

        await InvokeAsync(StateHasChanged);
        return JsonSerializer.Serialize(result.Blocks);
    }

    private Task ClosePasteReportAsync()
    {
        _pasteReportWarnings = [];
        return InvokeAsync(StateHasChanged);
    }

    private async Task AutoHidePasteReportAsync()
    {
        await Task.Delay(TimeSpan.FromSeconds(8));
        if (_disposed) return;
        _pasteReportWarnings = [];
        await InvokeAsync(StateHasChanged);
    }

    private static JsonElement? TryGetJsonProperty(JsonElement element, params string[] names)
    {
        foreach (var name in names)
        {
            if (element.TryGetProperty(name, out var value))
            {
                return value;
            }
        }

        return null;
    }

