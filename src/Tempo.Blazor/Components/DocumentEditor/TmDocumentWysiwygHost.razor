    /// <summary>Called by the JS engine when a runtime boundary patch carries a synchronized document snapshot.</summary>
    [JSInvokable("HandleJsBoundaryPatchGenerated")]
    public async Task HandleBoundaryPatchGenerated(JsonElement patch)
    {
        if (patch.ValueKind is JsonValueKind.Undefined or JsonValueKind.Null)
        {
            return;
        }

        var documentElement = TryGetJsonProperty(patch, "csharpDocument", "CSharpDocument");
        if (documentElement?.ValueKind is not JsonValueKind.Object)
        {
            await TransactionCommitted.InvokeAsync();
            return;
        }

        var options = new JsonSerializerOptions(DocumentEditorJson.Options)
        {
            PropertyNameCaseInsensitive = true
        };
        var document = documentElement.Value.Deserialize<DocumentEditorDocument>(options);
        if (document is not null)
        {
            RememberSynchronizedSnapshot(document);
            await DocumentSnapshotChanged.InvokeAsync(document);
        }

        await TransactionCommitted.InvokeAsync();
    }

