@namespace Tempo.Blazor.Components.DocumentEditor
@using Tempo.Blazor.Components.Activity
@using Tempo.Blazor.DocumentEditor.Models
@using Tempo.Blazor.DocumentEditor.Interfaces
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div @ref="_rootElement"
     class="@RootClass"
     style="@RootStyle"
     data-testid="document-wysiwyg-host"
     data-surface-mode="wysiwyg"
     data-instance-id="@_instanceId"
     data-ruler-visible="@ShowRuler.ToString().ToLowerInvariant()"
     data-zoom-percent="@ZoomPercent"
     data-zoom-mode="@(ZoomPageWidth ? "page-width" : "percent")"
     role="textbox"
     aria-label="@Loc["TmDocumentEditor_WysiwygSurfaceLabel"]"
     aria-describedby="@_accessibilityDescriptionId"
     aria-multiline="true"
     aria-readonly="@(ReadOnly ? "true" : "false")"
     tabindex="@(_jsReady && !_jsFailed ? "0" : "-1")">
    <span id="@_accessibilityDescriptionId"
          class="tm-document-wysiwyg-host__sr-only"
          data-testid="document-wysiwyg-accessibility-help">
        @Loc["TmDocumentEditor_WysiwygScreenReaderHelp"]
    </span>
    @if (_jsFailed)
    {
        <div class="tm-document-wysiwyg-host__fallback" role="alert">
            <TmAlert Severity="AlertSeverity.Warning"
                     Title="@Loc["TmDocumentEditor_WysiwygFallbackTitle"]">
                @Loc["TmDocumentEditor_WysiwygFallbackMessage"]
            </TmAlert>
        </div>
    }
    else if (!_jsReady)
    {
        <div class="tm-document-wysiwyg-host__loading" aria-busy="true">
            <TmSkeleton Variant="SkeletonVariant.Rect" Height="40px" Width="100%" />
            <TmSkeleton Variant="SkeletonVariant.Rect" Height="520px" Width="min(100%, 760px)" />
            <span class="tm-document-wysiwyg-host__sr-only">@Loc["TmDocumentEditor_Loading"]</span>
        </div>
    }
</div>

@if (_imageDialogOpen && !ReadOnly)
{
    <section class="tm-document-image-dialog" data-testid="document-wysiwyg-image-dialog" @onclick:stopPropagation="true">
        @if (!string.IsNullOrWhiteSpace(_imageError))
        {
            <div class="tm-document-paste-error" role="alert">@_imageError</div>
        }
        @if (_pendingImageUpload)
        {
            <div class="tm-document-paste-status">@Loc["TmDocumentEditor_ImageUploading"]</div>
        }
        <label>
            <span>@Loc["TmDocumentEditor_ImageUrl"]</span>
            <input data-testid="document-wysiwyg-image-url-input"
                   value="@_pendingImageUrl"
                   @oninput="args => _pendingImageUrl = args.Value?.ToString()" />
        </label>
        <label>
            <span>@Loc["TmDocumentEditor_ImageAltText"]</span>
            <input data-testid="document-wysiwyg-image-alt-input"
                   value="@_pendingImageAltText"
                   @oninput="args => _pendingImageAltText = args.Value?.ToString()" />
        </label>
        <button type="button"
                data-testid="document-wysiwyg-insert-image-url"
                @onclick="InsertImageUrlAsync">
            @Loc["TmDocumentEditor_InsertImage"]
        </button>
        <button type="button"
                data-testid="document-wysiwyg-upload-demo-image"
                @onclick="InsertProviderImageAsync"
                disabled="@(ImageProvider is null || _pendingImageUpload)">
            @Loc["TmDocumentEditor_UploadImage"]
        </button>
    </section>
}

@if (_tokenMenuOpen && !ReadOnly)
{
    <section class="tm-document-token-popover" data-testid="document-wysiwyg-token-popover" @onclick:stopPropagation="true">
        <div class="tm-document-token-popover__header">
            <input class="tm-document-token-popover__search"
                   data-testid="document-token-search"
                   placeholder="@Loc["TmRichEditor_TokenSearch"]"
                   aria-label="@Loc["TmRichEditor_TokenSearch"]"
                   value="@_tokenQuery"
                   @oninput="HandleTokenQueryInputAsync" />
            <button type="button"
                    class="tm-document-token-popover__close"
                    data-testid="document-token-close"
                    aria-label="@Loc["TmDocumentEditor_Close"]"
                    @onclick="CloseTokenMenu">
                <TmIcon Name="x" Size="IconSize.Sm" />
            </button>
        </div>
        <TmDocumentTokenMenu IsVisible="true"
                             Tokens="@_tokenItems"
                             Query="@_tokenQuery"
                             HighlightedIndex="@_tokenHighlightedIndex"
                             IsLoading="@_tokenMenuLoading"
                             OnTokenSelected="InsertTokenAsync"
                             OnHighlightedIndexChanged="SetTokenHighlightedIndex" />
    </section>
}

@code {
    private ElementReference _rootElement;
    private string _instanceId = Guid.NewGuid().ToString("N");
    private string _accessibilityDescriptionId = $"tm-wysiwyg-a11y-{Guid.NewGuid():N}";
    private bool _jsReady;
    private bool _jsFailed;
    private bool _disposed;
    private DotNetObjectReference<TmDocumentWysiwygHost>? _dotNetRef;
    private WysiwygSelectionSnapshot? _lastSelectionSnapshot;
    private bool _imageDialogOpen;
    private bool _pendingImageUpload;
    private string? _imageError;
    private string? _pendingImageUrl;
    private string? _pendingImageAltText;
    private string? _lastSentSnapshotJson;
    private DocumentEditorDocument? _lastSnapshotDocument;
    private IReadOnlyList<DocumentSuggestion>? _lastSnapshotSuggestions;
    private bool _lastSnapshotReadOnly;
    private bool _lastTrackChangesEnabled;
    private DocumentReviewDisplayMode _lastReviewDisplayMode = DocumentReviewDisplayMode.AllMarkup;
    private bool _hasSentSnapshot;
    private bool _tokenMenuOpen;
    private bool _tokenMenuLoading;
    private string _tokenQuery = string.Empty;
    private int _tokenHighlightedIndex;
    private List<TokenItem> _tokenItems = [];

    /// <summary>Document snapshot to render in the WYSIWYG surface.</summary>
    [Parameter] public DocumentEditorDocument? Document { get; set; }

    /// <summary>Whether the surface is read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Host-controlled permissions for the current user.</summary>
    [Parameter] public DocumentEditorPermissions Permissions { get; set; } = new();

    /// <summary>Optional image URL resolver for provider-managed assets.</summary>
    [Parameter] public IDocumentImageUrlResolver? ImageUrlResolver { get; set; }

    /// <summary>Optional image provider for upload and clipboard flows.</summary>
    [Parameter] public IDocumentImageProvider? ImageProvider { get; set; }

    /// <summary>Image validation options used by upload and clipboard image flows.</summary>
    [Parameter] public DocumentImageValidationOptions ImageValidation { get; set; } = new();

    /// <summary>Whether clipboard images can be kept as local draft assets when no image provider is available.</summary>
    [Parameter] public bool AllowOfflineClipboardImages { get; set; }

    /// <summary>Optional token provider for document token autocomplete.</summary>
    [Parameter] public ITokenDataProvider? TokenProvider { get; set; }

    /// <summary>Font families allowed by the host editor.</summary>
    [Parameter] public IReadOnlyList<DocumentFontFamily> FontFamilies { get; set; } = [];

    /// <summary>Whether the page ruler should be visible.</summary>
    [Parameter] public bool ShowRuler { get; set; } = true;

    /// <summary>Current page zoom percentage.</summary>
    [Parameter] public int ZoomPercent { get; set; } = 100;

    /// <summary>Whether page-width zoom mode is active.</summary>
    [Parameter] public bool ZoomPageWidth { get; set; }

    /// <summary>Pending provider-backed suggestions to decorate in the WYSIWYG surface.</summary>
    [Parameter] public IReadOnlyList<DocumentSuggestion> Suggestions { get; set; } = [];

    /// <summary>Whether live track-changes decorations are enabled in the JS-owned surface.</summary>
    [Parameter] public bool TrackChangesEnabled { get; set; }

    /// <summary>How tracked changes should be displayed in the JS-owned surface.</summary>
    [Parameter] public DocumentReviewDisplayMode ReviewDisplayMode { get; set; } = DocumentReviewDisplayMode.AllMarkup;

    /// <summary>Raised when the JS engine generates a patch that should be applied to the document.</summary>
    [Parameter] public EventCallback<WysiwygPatch> DocumentPatchGenerated { get; set; }

    /// <summary>Raised when the JS engine reports a new document snapshot (e.g. after explicit save or export).</summary>
    [Parameter] public EventCallback<DocumentEditorDocument> DocumentSnapshotChanged { get; set; }

    /// <summary>Raised when the JS engine reports selection change.</summary>
    [Parameter] public EventCallback<WysiwygSelectionSnapshot?> DocumentSelectionChanged { get; set; }

    /// <summary>Raised when the JS engine requests a text context menu.</summary>
    [Parameter] public EventCallback<WysiwygTextContextMenuRequest> TextContextMenuRequested { get; set; }

    /// <summary>Raised when the JS engine requests a table context menu.</summary>
    [Parameter] public EventCallback<WysiwygTableContextMenuRequest> TableContextMenuRequested { get; set; }

    /// <summary>Raised when the JS engine shows or hides the inline mini toolbar.</summary>
    [Parameter] public EventCallback<WysiwygMiniToolbarRequest?> MiniToolbarChanged { get; set; }

    /// <summary>Raised when the JS-owned inline revision UI requests accept or reject.</summary>
    [Parameter] public EventCallback<WysiwygRevisionReviewRequest> RevisionReviewRequested { get; set; }

    /// <summary>Raised when a typing transaction is committed.</summary>
    [Parameter] public EventCallback TransactionCommitted { get; set; }

    /// <summary>Raised when the user requests undo via keyboard.</summary>
    [Parameter] public EventCallback UndoRequested { get; set; }

    /// <summary>Raised when the user requests redo via keyboard.</summary>
    [Parameter] public EventCallback RedoRequested { get; set; }

    /// <summary>Raised when the user requests save via keyboard.</summary>
    [Parameter] public EventCallback SaveRequested { get; set; }

    private string RootClass
    {
        get
        {
            var classes = new List<string> { "tm-document-wysiwyg-host" };
            if (ShowRuler)
            {
                classes.Add("tm-document-wysiwyg-host--ruler");
            }

            if (ZoomPageWidth)
            {
                classes.Add("tm-document-wysiwyg-host--zoom-page-width");
            }

            return string.Join(" ", classes);
        }
    }

    private string RootStyle
    {
        get
        {
            var zoom = Math.Clamp(ZoomPercent, 50, 200) / 100d;
            return string.Create(CultureInfo.InvariantCulture, $"--tm-document-zoom: {zoom:0.##};");
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            await InitializeJsEngineAsync();
        }
    }

    private async Task InitializeJsEngineAsync()
    {
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            var options = new WysiwygEditorOptions
            {
                InstanceId = _instanceId,
                ReadOnly = ReadOnly,
                ProtocolVersion = 1,
                EnableMutationGuard = true,
                TypingBatchMs = 500,
                AccessibilityHelp = Loc["TmDocumentEditor_WysiwygScreenReaderHelp"],
                PageLabel = Loc["TmDocumentEditor_WysiwygPageLabel"],
                BodyLabel = Loc["TmDocumentEditor_WysiwygBodyLabel"],
                HeaderLabel = Loc["TmDocumentEditor_WysiwygHeaderLabel"],
                FooterLabel = Loc["TmDocumentEditor_WysiwygFooterLabel"],
                ImageResizeHandleLabel = Loc["TmDocumentEditor_WysiwygImageResizeHandleLabel"],
                ImageRetryLabel = Loc["TmDocumentEditor_Retry"],
                FontFamilies = FontFamilies,
                SuggestionInsertLabel = Loc["TmDocumentEditor_SuggestionInsertAria"],
                SuggestionDeleteLabel = Loc["TmDocumentEditor_SuggestionDeleteAria"],
                TrackChangesEnabled = TrackChangesEnabled,
                ReviewDisplayMode = ReviewDisplayMode
            };

            await JSRuntime.InvokeVoidAsync(
                "tmDocumentWysiwyg.create",
                _rootElement,
                options,
                _dotNetRef);
        }
        catch (JSException)
        {
            _jsFailed = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
            // JS runtime not available (e.g. prerendering).
            _jsFailed = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Called by the JS engine when it is ready.</summary>
    [JSInvokable]
    public async Task HandleJsEngineReady(WysiwygEngineReadyEventArgs args)
    {
        _jsReady = true;
        await InvokeAsync(StateHasChanged);
        await SendSnapshotAsync(force: true);
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (!_jsReady || _jsFailed || _disposed)
        {
            return;
        }

        var readOnlyChanged = ReadOnly != _lastSnapshotReadOnly;
        if (readOnlyChanged)
        {
            await SetReadOnlyAsync(ReadOnly);
        }

        if (TrackChangesEnabled != _lastTrackChangesEnabled)
        {
            await SetTrackChangesEnabledAsync(TrackChangesEnabled);
        }

        if (ReviewDisplayMode != _lastReviewDisplayMode)
        {
            await SetReviewDisplayModeAsync(ReviewDisplayMode);
        }

        if (ShouldSendParameterSnapshot())
        {
            await SendSnapshotAsync(force: readOnlyChanged);
        }
    }

    /// <summary>Forces the current document parameters into the JS-owned WYSIWYG DOM.</summary>
    public Task RefreshSnapshotAsync()
    {
        return SendSnapshotAsync(force: true);
    }

    /// <summary>Forces a synchronized document into the JS-owned WYSIWYG DOM.</summary>
    public Task RefreshSnapshotAsync(DocumentEditorDocument synchronizedDocument)
    {
        return SendSnapshotAsync(force: true, documentOverride: synchronizedDocument);
    }

    /// <summary>Applies a remote granular operation batch directly to the JS-owned DOM.</summary>
    public async Task<WysiwygRemoteOperationBatchApplyResult> ApplyRemoteOperationBatchAsync(
        IReadOnlyList<DocumentOperation> operations,
        DocumentEditorDocument synchronizedDocument)
    {
        if (_jsFailed || _disposed || !_jsReady)
        {
            return WysiwygRemoteOperationBatchApplyResult.Failed("wysiwyg-engine-unavailable");
        }

        if (operations.Count == 0)
        {
            RememberSynchronizedSnapshot(synchronizedDocument);
            return WysiwygRemoteOperationBatchApplyResult.Ok();
        }

        try
        {
            var result = await JSRuntime.InvokeAsync<WysiwygRemoteOperationBatchApplyResult>(
                "tmDocumentWysiwyg.applyRemoteOperationBatch",
                _instanceId,
                new { Operations = operations });

            if (result is null)
            {
                return WysiwygRemoteOperationBatchApplyResult.Failed("wysiwyg-remote-apply-null-result");
            }

            if (result.Success)
            {
                RememberSynchronizedSnapshot(synchronizedDocument);
            }

            return result;
        }
        catch (JSException)
        {
            return WysiwygRemoteOperationBatchApplyResult.Failed(
                operations.FirstOrDefault()?.OperationId ?? "wysiwyg-remote-apply-js-error");
        }
    }

    /// <summary>Applies remote granular operations directly to the JS-owned DOM.</summary>
    public async Task<bool> ApplyRemoteOperationsAsync(
        IReadOnlyList<DocumentOperation> operations,
        DocumentEditorDocument synchronizedDocument)
    {
        var result = await ApplyRemoteOperationBatchAsync(operations, synchronizedDocument);
        return result.Success && (result.Applied > 0 || result.Skipped > 0 || operations.Count == 0);
    }

    private async Task SetTrackChangesEnabledAsync(bool enabled)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("tmDocumentWysiwyg.setTrackChangesEnabled", _instanceId, enabled);
            _lastTrackChangesEnabled = enabled;
        }
        catch (JSException)
        {
            // Best-effort; the next JS initialization or snapshot will carry the option.
        }
    }

    /// <summary>Updates tracked-change display mode in the JS-owned DOM.</summary>
    public async Task SetReviewDisplayModeAsync(DocumentReviewDisplayMode mode)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("tmDocumentWysiwyg.setReviewDisplayMode", _instanceId, mode.ToString());
            _lastReviewDisplayMode = mode;
        }
        catch (JSException)
        {
            // Best-effort; the next JS initialization or snapshot will carry the option.
        }
    }

    /// <summary>Scrolls to a tracked revision in the JS-owned DOM.</summary>
    public async Task ScrollToRevisionAsync(string revisionId)
    {
        if (_jsFailed || _disposed || !_jsReady || string.IsNullOrWhiteSpace(revisionId))
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("tmDocumentWysiwyg.scrollToRevision", _instanceId, revisionId);
        }
        catch (JSException)
        {
            // Best-effort; selection state still reflects the chosen revision.
        }
    }

    private async Task SetReadOnlyAsync(bool readOnly)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("tmDocumentWysiwyg.setReadOnly", _instanceId, readOnly);
        }
        catch (JSException)
        {
            // Best-effort; the forced snapshot below will reconcile the DOM when possible.
        }
    }

    /// <summary>Clears revision decorations from the JS-owned DOM after a review action.</summary>
    public async Task ClearRevisionDecorationsAsync(string revisionId, bool removeContent)
    {
        if (_jsFailed || _disposed || !_jsReady || string.IsNullOrWhiteSpace(revisionId))
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("tmDocumentWysiwyg.clearRevisionDecorations", _instanceId, revisionId, removeContent);
        }
        catch (JSException)
        {
            // Best-effort; the next snapshot render will reconcile the DOM.
        }
    }

    private bool ShouldSendParameterSnapshot()
    {
        return !_hasSentSnapshot
            || !ReferenceEquals(Document, _lastSnapshotDocument)
            || !ReferenceEquals(Suggestions, _lastSnapshotSuggestions)
            || ReadOnly != _lastSnapshotReadOnly;
    }

    private async Task SendSnapshotAsync(bool force = false, DocumentEditorDocument? documentOverride = null)
    {
        var document = documentOverride ?? Document;
        if (_disposed || _jsFailed || document is null) return;

        try
        {
            var displayDocument = await PrepareDocumentForDisplayAsync(document);
            var snapshot = new WysiwygDocumentSnapshot
            {
                ProtocolVersion = 1,
                Document = displayDocument,
                Suggestions = Suggestions
            };

            var snapshotJson = JsonSerializer.Serialize(snapshot, DocumentEditorJson.Options);
            if (!force && string.Equals(snapshotJson, _lastSentSnapshotJson, StringComparison.Ordinal))
            {
                RememberSentSnapshot(snapshotJson, document);
                return;
            }

            await JSRuntime.InvokeVoidAsync("tmDocumentWysiwyg.applySnapshot", _instanceId, snapshot, force);
            RememberSentSnapshot(snapshotJson, document);
        }
        catch (JSException)
        {
            // Best-effort; guard will catch divergence.
        }
    }

    private async Task<DocumentEditorDocument> PrepareDocumentForDisplayAsync(DocumentEditorDocument document)
    {
        if (ImageProvider is null && ImageUrlResolver is null)
        {
            return document;
        }

        var clone = CloneDocument(document);
        var changed = false;
        foreach (var image in EnumerateImages(clone))
        {
            if (image.Source == DocumentImageSource.Url || string.IsNullOrWhiteSpace(image.AssetId))
            {
                continue;
            }

            if (IsSafeImageUrl(image.Url))
            {
                continue;
            }

            string? resolvedUrl;
            try
            {
                resolvedUrl = await ResolveImageUrlAsync(clone.DocumentId, image.AssetId);
            }
            catch
            {
                continue;
            }

            if (!string.IsNullOrWhiteSpace(resolvedUrl) && IsSafeImageUrl(resolvedUrl))
            {
                image.Url = resolvedUrl;
                changed = true;
            }
        }

        return changed ? clone : document;
    }

    private async Task<string?> ResolveImageUrlAsync(string documentId, string assetId)
    {
        if (ImageProvider is not null)
        {
            var result = await ImageProvider.ResolveAsync(new DocumentImageResolveRequest
            {
                DocumentId = documentId,
                AssetId = assetId
            });

            if (result.Success && !string.IsNullOrWhiteSpace(result.Url))
            {
                return result.Url;
            }
        }

        return ImageUrlResolver is null
            ? null
            : await ImageUrlResolver.ResolveUrlAsync(documentId, assetId);
    }

    private static IEnumerable<ImageBlockContent> EnumerateImages(DocumentEditorDocument document)
    {
        foreach (var block in EnumerateBlocks(document.Blocks))
        {
            if (block.Content is ImageBlockContent image)
            {
                yield return image;
            }
        }
    }

    private static IEnumerable<DocumentBlock> EnumerateBlocks(IEnumerable<DocumentBlock> blocks)
    {
        foreach (var block in blocks)
        {
            yield return block;
            if (block.Content is TableBlockContent table)
            {
                foreach (var nested in table.Rows.SelectMany(row => row.Cells).SelectMany(cell => EnumerateBlocks(cell.Blocks)))
                {
                    yield return nested;
                }
            }
        }
    }

    private static DocumentEditorDocument CloneDocument(DocumentEditorDocument document)
    {
        var json = JsonSerializer.Serialize(document, DocumentEditorJson.Options);
        return JsonSerializer.Deserialize<DocumentEditorDocument>(json, DocumentEditorJson.Options)!;
    }

    private void RememberSynchronizedSnapshot(DocumentEditorDocument synchronizedDocument)
    {
        var snapshot = new WysiwygDocumentSnapshot
        {
            ProtocolVersion = 1,
            Document = synchronizedDocument,
            Suggestions = Suggestions
        };
        RememberSentSnapshot(JsonSerializer.Serialize(snapshot, DocumentEditorJson.Options), synchronizedDocument);
    }

    private void RememberSentSnapshot(string snapshotJson, DocumentEditorDocument? document)
    {
        _lastSentSnapshotJson = snapshotJson;
        _lastSnapshotDocument = document;
        _lastSnapshotSuggestions = Suggestions;
        _lastSnapshotReadOnly = ReadOnly;
        _lastTrackChangesEnabled = TrackChangesEnabled;
        _lastReviewDisplayMode = ReviewDisplayMode;
        _hasSentSnapshot = true;
    }

    /// <summary>Captures the current text selection as a document comment anchor.</summary>
    public async Task<DocumentCommentAnchor?> CaptureTextSelectionAnchorAsync()
    {
        if (_jsFailed || _disposed || !_jsReady) return null;
        try
        {
            return await JSRuntime.InvokeAsync<DocumentCommentAnchor?>(
                "tmDocumentWysiwyg.captureCommentAnchor", _instanceId);
        }
        catch { return null; }
    }

    /// <summary>Requests a snapshot of the current DOM state from the JS engine.</summary>
    public async Task<DocumentEditorDocument?> RequestSnapshotAsync()
    {
        if (_jsFailed || _disposed || !_jsReady) return null;

        try
        {
            var json = await JSRuntime.InvokeAsync<string>("tmDocumentWysiwyg.getSnapshot", _instanceId);
            if (string.IsNullOrWhiteSpace(json)) return null;

            var options = new JsonSerializerOptions(DocumentEditorJson.Options)
            {
                PropertyNameCaseInsensitive = true
            };
            var snapshot = JsonSerializer.Deserialize<WysiwygDocumentSnapshot>(json, options);
            return snapshot?.Document;
        }
        catch
        {
            return null;
        }
    }

    /// <summary>Requests a diagnostic snapshot of the live JS editor state.</summary>
    public async Task<WysiwygDebugSnapshot?> RequestDebugSnapshotAsync()
    {
        if (_jsFailed || _disposed || !_jsReady) return null;

        try
        {
            return await JSRuntime.InvokeAsync<WysiwygDebugSnapshot?>(
                "tmDocumentWysiwyg.getDebugSnapshot",
                _instanceId);
        }
        catch
        {
            return null;
        }
    }

    /// <summary>Requests the current selection formatting state from the JS engine.</summary>
    public async Task<WysiwygFormattingState?> RequestFormattingStateAsync()
    {
        if (_jsFailed || _disposed || !_jsReady) return null;

        try
        {
            return await JSRuntime.InvokeAsync<WysiwygFormattingState?>(
                "tmDocumentWysiwyg.getFormattingState",
                _instanceId);
        }
        catch
        {
            return null;
        }
    }

    /// <summary>Requests the current selection snapshot from the JS engine.</summary>
    public async Task<WysiwygSelectionSnapshot?> RequestSelectionSnapshotAsync()
    {
        if (_jsFailed || _disposed || !_jsReady) return null;

        try
        {
            return await JSRuntime.InvokeAsync<WysiwygSelectionSnapshot?>(
                "tmDocumentWysiwyg.getSelectionSnapshot",
                _instanceId);
        }
        catch
        {
            return null;
        }
    }

    /// <summary>Requests current hyperlink metadata from the JS engine selection.</summary>
    public async Task<WysiwygLinkInfo?> RequestLinkInfoAsync()
    {
        if (_jsFailed || _disposed || !_jsReady) return null;

        try
        {
            return await JSRuntime.InvokeAsync<WysiwygLinkInfo?>(
                "tmDocumentWysiwyg.getLinkInfo",
                _instanceId);
        }
        catch
        {
            return null;
        }
    }

    /// <summary>Called by the JS engine when a patch is generated.</summary>
    [JSInvokable]
    public Task HandlePatchGenerated(WysiwygPatch patch)
    {
        return DocumentPatchGenerated.InvokeAsync(patch);
    }

    /// <summary>Called by the JS engine when selection changes.</summary>
    [JSInvokable]
    public Task HandleSelectionChanged(WysiwygSelectionSnapshot? snapshot)
    {
        _lastSelectionSnapshot = snapshot;
        return DocumentSelectionChanged.InvokeAsync(snapshot);
    }

    /// <summary>Called by the JS engine when the text context menu should open.</summary>
    [JSInvokable]
    public Task HandleTextContextMenuRequested(WysiwygTextContextMenuRequest request)
    {
        _lastSelectionSnapshot = request.Selection ?? _lastSelectionSnapshot;
        return TextContextMenuRequested.InvokeAsync(request);
    }

    /// <summary>Called by the JS engine when the table context menu should open.</summary>
    [JSInvokable]
    public Task HandleTableContextMenuRequested(WysiwygTableContextMenuRequest request)
    {
        _lastSelectionSnapshot = request.Selection ?? _lastSelectionSnapshot;
        return TableContextMenuRequested.InvokeAsync(request);
    }

    /// <summary>Called by the JS engine when the inline mini toolbar changes visibility or position.</summary>
    [JSInvokable]
    public Task HandleMiniToolbarChanged(WysiwygMiniToolbarRequest? request)
    {
        if (request?.Selection is not null)
        {
            _lastSelectionSnapshot = request.Selection;
        }

        return MiniToolbarChanged.InvokeAsync(request);
    }

    /// <summary>Called by the JS engine when an inline revision action is requested.</summary>
    [JSInvokable]
    public Task HandleRevisionReviewRequested(string revisionId, string action)
    {
        if (!Enum.TryParse<DocumentRevisionAction>(action, ignoreCase: true, out var reviewAction))
        {
            reviewAction = DocumentRevisionAction.Pending;
        }

        return RevisionReviewRequested.InvokeAsync(new WysiwygRevisionReviewRequest
        {
            RevisionId = revisionId,
            Action = reviewAction
        });
    }

