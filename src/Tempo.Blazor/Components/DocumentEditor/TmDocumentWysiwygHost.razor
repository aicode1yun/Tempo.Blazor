    private async Task OpenAutocompleteMenuAsync(
        DocumentAutocompleteTrigger trigger,
        string query = "",
        bool focusSearch = true)
    {
        if (ReadOnly || !CanServeAutocomplete(trigger))
        {
            return;
        }

        _autocompleteMenuOpen = true;
        _autocompleteTrigger = trigger;
        _autocompleteQuery = query;
        _autocompleteHighlightedIndex = 0;
        _autocompleteWarning = null;
        await LoadAutocompleteItemsAsync(query);
        _focusAutocompleteSearchOnRender = focusSearch;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleAutocompleteQueryInputAsync(ChangeEventArgs args)
    {
        _autocompleteQuery = args.Value?.ToString() ?? string.Empty;
        _autocompleteHighlightedIndex = 0;
        await LoadAutocompleteItemsAsync(_autocompleteQuery);
    }

    private async Task LoadAutocompleteItemsAsync(string query)
    {
        if (_autocompleteTrigger is null || !CanServeAutocomplete(_autocompleteTrigger))
        {
            _autocompleteItems = [];
            return;
        }

        if (!_autocompleteTrigger.CanSearch(query))
        {
            _autocompleteItems = [];
            return;
        }

        var provider = CreateAutocompleteProvider(_autocompleteTrigger);
        if (provider is null)
        {
            _autocompleteItems = [];
            return;
        }

        _autocompleteMenuLoading = true;
        _autocompleteWarning = null;
        await InvokeAsync(StateHasChanged);

        var result = await _autocompleteRunner.SearchAsync(
            provider,
            new DocumentAutocompleteRequest
            {
                Trigger = _autocompleteTrigger,
                Query = query,
                Limit = _autocompleteTrigger.Limit
            },
            Loc["TmDocumentEditor_AutocompleteProviderError"]);

        if (result.IsStale || result.IsCanceled)
        {
            return;
        }

        _autocompleteItems = result.Items.ToList();
        _autocompleteWarning = result.WarningMessage;
        _autocompleteMenuLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private Task SetAutocompleteHighlightedIndex(int index)
    {
        _autocompleteHighlightedIndex = index;
        return Task.CompletedTask;
    }

    private void CloseAutocompleteMenu()
    {
        _autocompleteRunner.Cancel();
        _autocompleteMenuOpen = false;
        _focusAutocompleteSearchOnRender = false;
        _autocompleteQuery = string.Empty;
        _autocompleteItems = [];
        _autocompleteWarning = null;
        _autocompleteTrigger = null;
        _autocompleteMenuLoading = false;
    }

    private async Task HandleAutocompletePopoverKeyDownAsync(KeyboardEventArgs args)
    {
        if (!_autocompleteMenuOpen)
        {
            return;
        }

        switch (args.Key)
        {
            case "Escape":
                await CloseRuntimeAutocompleteQueryAsync();
                CloseAutocompleteMenu();
                await InvokeAsync(StateHasChanged);
                break;
            case "ArrowDown":
                _autocompleteHighlightedIndex = Math.Min(
                    _autocompleteHighlightedIndex + 1,
                    Math.Max(FilteredAutocompleteItems.Count - 1, 0));
                await InvokeAsync(StateHasChanged);
                break;
            case "ArrowUp":
                _autocompleteHighlightedIndex = Math.Max(_autocompleteHighlightedIndex - 1, 0);
                await InvokeAsync(StateHasChanged);
                break;
            case "Enter":
                var item = FilteredAutocompleteItems.ElementAtOrDefault(_autocompleteHighlightedIndex);
                if (item is not null)
                {
                    await InsertAutocompleteItemAsync(item);
                }
                break;
        }
    }

    private IReadOnlyList<DocumentAutocompleteItem> FilteredAutocompleteItems
        => string.IsNullOrWhiteSpace(_autocompleteQuery)
            ? _autocompleteItems
            : _autocompleteItems
                .Where(item =>
                    item.Label.Contains(_autocompleteQuery, StringComparison.OrdinalIgnoreCase) ||
                    item.Id.Contains(_autocompleteQuery, StringComparison.OrdinalIgnoreCase) ||
                    (item.Description?.Contains(_autocompleteQuery, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();

    private async Task InsertAutocompleteItemAsync(DocumentAutocompleteItem item)
    {
        if (ReadOnly)
        {
            return;
        }

        switch (item.Kind)
        {
            case DocumentAutocompleteKind.Token:
                await InsertTokenItemAsync(item);
                break;
            case DocumentAutocompleteKind.Mention:
                await InsertMentionItemAsync(item);
                break;
            case DocumentAutocompleteKind.SlashCommand:
                await ExecuteSlashCommandItemAsync(item);
                break;
        }
    }

    private async Task InsertTokenItemAsync(DocumentAutocompleteItem item)
    {
        var key = item.Metadata.GetValueOrDefault("key") ?? item.Value ?? item.Id;
        var displayName = item.Metadata.GetValueOrDefault("displayName") ?? item.Label;
        var typeLabel = item.Metadata.GetValueOrDefault("typeLabel");
        var tokenRun = new TokenRun
        {
            Id = Guid.NewGuid().ToString("N"),
            Key = key,
            DisplayName = string.IsNullOrWhiteSpace(displayName) ? key : displayName,
            Description = item.Metadata.GetValueOrDefault("description") ?? item.Description,
            ColorClass = item.Metadata.GetValueOrDefault("colorClass"),
            TypeLabel = typeLabel,
            TokenType = NormalizeTokenType(typeLabel)
        };

        var patch = new WysiwygPatch
        {
            Type = "InsertInline",
            Inline = tokenRun,
            Selection = _lastSelectionSnapshot,
            ProtocolVersion = 1
        };

        await RemoveRuntimeAutocompleteQueryAsync();
        await DocumentPatchGenerated.InvokeAsync(patch);
        CloseAutocompleteMenu();
        await InvokeAsync(StateHasChanged);
    }

    private async Task InsertMentionItemAsync(DocumentAutocompleteItem item)
    {
        var userName = item.Metadata.GetValueOrDefault("userName");
        var label = string.IsNullOrWhiteSpace(userName) ? item.Label : userName;
        var mentionText = label.StartsWith('@') ? label : "@" + label;
        await RemoveRuntimeAutocompleteQueryAsync();
        if (await InsertRuntimeAutocompleteTextAsync(mentionText))
        {
            CloseAutocompleteMenu();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var patch = new WysiwygPatch
        {
            Type = "InsertText",
            Data = mentionText,
            Selection = _lastSelectionSnapshot,
            ProtocolVersion = 1
        };

        await DocumentPatchGenerated.InvokeAsync(patch);
        CloseAutocompleteMenu();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ExecuteSlashCommandItemAsync(DocumentAutocompleteItem item)
    {
        var command = item.Metadata.GetValueOrDefault("command");
        if (string.IsNullOrWhiteSpace(command))
        {
            return;
        }

        await RemoveRuntimeAutocompleteQueryAsync();
        CloseAutocompleteMenu();

        switch (command)
        {
            case "insertTable":
                await ExecuteRuntimeCommandAsync("insertTable", new { Rows = 2, Columns = 2 });
                break;
            case "insertImage":
                await OpenImageDialogAsync();
                break;
            case "insertPageBreak":
                await ExecuteRuntimeCommandAsync("insertPageBreak");
                break;
        }

        await InvokeAsync(StateHasChanged);
    }

