    private bool ShouldSendParameterSnapshot()
    {
        // Phase C1 — primary fast path: same document reference + matching Version + same
        // suggestion list reference + read-only unchanged means nothing to send.
        if (_hasSentSnapshot
            && ReferenceEquals(Document, _lastSnapshotDocument)
            && Document is not null
            && Document.Version == _lastSnapshotVersion
            && ReferenceEquals(Suggestions, _lastSnapshotSuggestions)
            && ReadOnly == _lastSnapshotReadOnly)
        {
            return false;
        }
        return !_hasSentSnapshot
            || !ReferenceEquals(Document, _lastSnapshotDocument)
            || (Document is not null && Document.Version != _lastSnapshotVersion)
            || !ReferenceEquals(Suggestions, _lastSnapshotSuggestions)
            || ReadOnly != _lastSnapshotReadOnly;
    }

    private async Task SendSnapshotAsync(bool force = false, DocumentEditorDocument? documentOverride = null)
    {
        var document = documentOverride ?? Document;
        if (_disposed || _jsFailed || document is null) return;

        try
        {
            // Phase C2 — fast path: caller did not force, document reference + Version are
            // unchanged since the last successful send. Skip serialization entirely.
            if (!force
                && _hasSentSnapshot
                && ReferenceEquals(document, _lastSnapshotDocument)
                && document.Version == _lastSnapshotVersion
                && ReferenceEquals(Suggestions, _lastSnapshotSuggestions))
            {
                return;
            }

            var displayDocument = await PrepareDocumentForDisplayAsync(document);
            var snapshot = new WysiwygDocumentSnapshot
            {
                ProtocolVersion = 1,
                Document = displayDocument,
                Suggestions = Suggestions
            };

            // Phase C2 — only fall back to JSON-equality compare when no Version is available
            // or the displayDocument was cloned (different reference than `document`).
            var needsJsonCompare = !ReferenceEquals(displayDocument, document) || document.Version == 0;
            string? snapshotJson = null;
            if (needsJsonCompare)
            {
                snapshotJson = JsonSerializer.Serialize(snapshot, DocumentEditorJson.Options);
                if (!force && string.Equals(snapshotJson, _lastSentSnapshotJson, StringComparison.Ordinal))
                {
                    RememberSentSnapshot(snapshotJson, document);
                    return;
                }
            }

            // Phase C2 — when we can avoid the string round-trip entirely (no JSON compare
            // needed), use the pooled UTF-8 writer and the loadDocumentFromBytes bridge.
            // This bypasses one full snapshot string allocation on the C# side.
            if (!needsJsonCompare)
            {
                using var pooled = Performance.PooledSnapshotSerializer.SerializeUtf8(snapshot, DocumentEditorJson.Options);
                // Materialize once for the interop call. Blazor JS interop currently does not
                // accept ReadOnlySpan<byte> directly so we copy out, but at least the writer
                // itself used a pooled internal buffer (no intermediate string allocation).
                var bytes = pooled.WrittenSpan.ToArray();
                await JSRuntime.InvokeVoidAsync(
                    "tmDocumentEditorRuntime.loadDocumentFromBytes",
                    _instanceId, bytes, force);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("tmDocumentEditorRuntime.loadDocument", _instanceId, snapshot, force);
            }
            RememberSentSnapshot(snapshotJson, document);
        }
        catch (JSException)
        {
            // Best-effort; guard will catch divergence.
        }
    }

    private async Task<DocumentEditorDocument> PrepareDocumentForDisplayAsync(DocumentEditorDocument document)
    {
        var hasLegacyImageBlocks = EnumerateImages(document).Any();
        var shouldResolveImages = ImageProvider is not null || ImageUrlResolver is not null;
        if (!hasLegacyImageBlocks && !shouldResolveImages)
        {
            return document;
        }

        var clone = CloneDocument(document);
        var changed = hasLegacyImageBlocks;
        if (hasLegacyImageBlocks)
        {
            DocumentImagePersistence.ConvertImageBlocksToDrawingRuns(clone);
        }

        if (!shouldResolveImages)
        {
            return clone;
        }

        foreach (var drawing in DocumentImagePersistence.EnumerateDrawingRuns(clone))
        {
            if (drawing.Source == DocumentImageSource.Url || string.IsNullOrWhiteSpace(drawing.AssetId))
            {
                continue;
            }

            if (IsSafeImageUrl(drawing.Url))
            {
                continue;
            }

            string? resolvedUrl;
            try
            {
                resolvedUrl = await ResolveImageUrlAsync(clone.DocumentId, drawing.AssetId);
            }
            catch
            {
                continue;
            }

            if (!string.IsNullOrWhiteSpace(resolvedUrl) && IsSafeImageUrl(resolvedUrl))
            {
                drawing.Url = resolvedUrl;
                changed = true;
            }
        }

        foreach (var image in EnumerateImages(clone))
        {
            if (image.Source == DocumentImageSource.Url || string.IsNullOrWhiteSpace(image.AssetId))
            {
                continue;
            }

            if (IsSafeImageUrl(image.Url))
            {
                continue;
            }

            string? resolvedUrl;
            try
            {
                resolvedUrl = await ResolveImageUrlAsync(clone.DocumentId, image.AssetId);
            }
            catch
            {
                continue;
            }

            if (!string.IsNullOrWhiteSpace(resolvedUrl) && IsSafeImageUrl(resolvedUrl))
            {
                image.Url = resolvedUrl;
                changed = true;
            }
        }

        return changed ? clone : document;
    }

    private async Task<string?> ResolveImageUrlAsync(string documentId, string assetId)
    {
        // Phase C4 — LRU cache: avoid round-tripping the provider/resolver for repeatedly
        // requested assets. Cache covers both success (URL) and failure (null) cases for the TTL.
        if (_imageResolveCache.TryGet(documentId, assetId, out var cached))
        {
            return cached;
        }

        string? resolved = null;
        if (ImageProvider is not null)
        {
            var result = await ImageProvider.ResolveAsync(new DocumentImageResolveRequest
            {
                DocumentId = documentId,
                AssetId = assetId
            });

            if (result.Success && !string.IsNullOrWhiteSpace(result.Url))
            {
                resolved = result.Url;
            }
        }

        if (resolved is null && ImageUrlResolver is not null)
        {
            resolved = await ImageUrlResolver.ResolveUrlAsync(documentId, assetId);
        }

        _imageResolveCache.Set(documentId, assetId, resolved);
        return resolved;
    }

    private static IEnumerable<ImageBlockContent> EnumerateImages(DocumentEditorDocument document)
    {
        foreach (var block in EnumerateBlocks(document.Blocks))
        {
            if (block.Content is ImageBlockContent image)
            {
                yield return image;
            }
        }
    }

    private static IEnumerable<DocumentBlock> EnumerateBlocks(IEnumerable<DocumentBlock> blocks)
    {
        foreach (var block in blocks)
        {
            yield return block;
            if (block.Content is TableBlockContent table)
            {
                foreach (var nested in table.Rows.SelectMany(row => row.Cells).SelectMany(cell => EnumerateBlocks(cell.Blocks)))
                {
                    yield return nested;
                }
            }
        }
    }

    private static DocumentEditorDocument CloneDocument(DocumentEditorDocument document)
    {
        var json = JsonSerializer.Serialize(document, DocumentEditorJson.Options);
        return JsonSerializer.Deserialize<DocumentEditorDocument>(json, DocumentEditorJson.Options)!;
    }

    private void RememberSynchronizedSnapshot(DocumentEditorDocument synchronizedDocument)
    {
        var snapshot = new WysiwygDocumentSnapshot
        {
            ProtocolVersion = 1,
            Document = synchronizedDocument,
            Suggestions = Suggestions
        };
        RememberSentSnapshot(JsonSerializer.Serialize(snapshot, DocumentEditorJson.Options), synchronizedDocument);
    }

    private void RememberSentSnapshot(string? snapshotJson, DocumentEditorDocument? document)
    {
        // Phase C2 — `snapshotJson` may be null when we skipped serialization (Version fast path).
        _lastSentSnapshotJson = snapshotJson;
        // Phase C4 — invalidate image cache when the document reference changes OR Version moves
        // backwards (likely an undo/reload — assets may have been re-keyed). Forward Version
        // bumps within the same document instance preserve cache entries (assets unchanged).
        var previousDocument = _lastSnapshotDocument;
        var previousVersion = _lastSnapshotVersion;
        if (document is not null
            && (previousDocument is null
                || !ReferenceEquals(previousDocument, document)
                || (document.Version < previousVersion && previousVersion != long.MinValue)))
        {
            if (!string.IsNullOrWhiteSpace(document.DocumentId))
            {
                _imageResolveCache.InvalidateDocument(document.DocumentId);
            }
        }
        _lastSnapshotDocument = document;
        _lastSnapshotVersion = document?.Version ?? long.MinValue;
        _lastSnapshotSuggestions = Suggestions;
        _lastSnapshotReadOnly = ReadOnly;
        _lastTrackChangesEnabled = TrackChangesEnabled;
        _lastReviewDisplayMode = ReviewDisplayMode;
        _hasSentSnapshot = true;
    }

    private async Task ApplyRuntimeDraftStateIfNeededAsync(bool force = false)
    {
        if (_jsFailed || _disposed || !_jsReady || string.IsNullOrWhiteSpace(RuntimeDraftStateJson))
        {
            return;
        }

        if (!force && string.Equals(RuntimeDraftStateJson, _lastAppliedRuntimeDraftStateJson, StringComparison.Ordinal))
        {
            return;
        }

        try
        {
            var applied = await JSRuntime.InvokeAsync<bool>(
                "tmDocumentEditorRuntime.applyOfflineState",
                _instanceId,
                RuntimeDraftStateJson);
            if (applied)
            {
                _lastAppliedRuntimeDraftStateJson = RuntimeDraftStateJson;
            }
        }
        catch (JSException)
        {
            // Best-effort; the document snapshot has already restored the draft content.
        }
    }

