        }
    }

    private static string? NormalizeTokenType(string? typeLabel)
    {
        return string.IsNullOrWhiteSpace(typeLabel)
            ? null
            : typeLabel.Trim().ToLowerInvariant().Replace(' ', '-');
    }

    private async Task InsertImageUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_pendingImageUrl) || !IsSafeImageUrl(_pendingImageUrl))
        {
            _imageError = Loc["TmDocumentEditor_ImagePasteRejected"];
            await InvokeAsync(StateHasChanged);
            return;
        }

        var drawing = CreateImageDrawingRun(new ImageBlockContent
        {
            Source = DocumentImageSource.Url,
            Url = _pendingImageUrl,
            AltText = _pendingImageAltText
        });

        await InsertImageDrawingFromBlazorAsync(drawing, _lastSelectionSnapshot);
        _imageDialogOpen = false;
        _pendingImageUrl = null;
        _pendingImageAltText = null;
        _imageError = null;
    }

