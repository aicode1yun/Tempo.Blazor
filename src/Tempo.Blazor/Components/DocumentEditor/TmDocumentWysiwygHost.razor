                ? string.IsNullOrWhiteSpace(payload.Value) ? payload.Data : payload.Value
                : payload.Href,
            LinkTitle = payload.Title,
            Selection = payload.Selection ?? _lastSelectionSnapshot,
            ProtocolVersion = 1
        };

        return DocumentPatchGenerated.InvokeAsync(patch);
