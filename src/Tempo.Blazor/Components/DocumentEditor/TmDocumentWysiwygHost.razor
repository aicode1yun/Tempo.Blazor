    {
        DocumentAutocompleteKind.Token => Loc["TmRichEditor_TokenSearch"],
        DocumentAutocompleteKind.Mention => Loc["TmDocumentEditor_MentionSearch"],
        DocumentAutocompleteKind.Tag => Loc["TmDocumentEditor_TagSearch"],
        DocumentAutocompleteKind.SlashCommand => Loc["TmDocumentEditor_CommandSearch"],
        _ => Loc["TmDocumentEditor_AutocompleteSearch"]
    };

    private bool CanServeAutocomplete(DocumentAutocompleteTrigger trigger)
    {
        return trigger.Kind switch
        {
            DocumentAutocompleteKind.Token => TokenProvider is not null,
            DocumentAutocompleteKind.Mention => MentionProvider is not null,
            DocumentAutocompleteKind.SlashCommand => true,
            DocumentAutocompleteKind.Tag => false,
            _ => false
        };
    }

    private IDocumentAutocompleteProvider? CreateAutocompleteProvider(DocumentAutocompleteTrigger trigger)
    {
        return trigger.Kind switch
        {
            DocumentAutocompleteKind.Token when TokenProvider is not null => new TokenDocumentAutocompleteProvider(TokenProvider),
            DocumentAutocompleteKind.Mention when MentionProvider is not null => new MentionDocumentAutocompleteProvider(MentionProvider),
            DocumentAutocompleteKind.SlashCommand => new DocumentSlashCommandAutocompleteProvider(CreateSlashCommandItems()),
            _ => null
        };
    }

    private IReadOnlyList<DocumentAutocompleteItem> CreateSlashCommandItems()
    {
        return
        [
            new DocumentAutocompleteItem
            {
                Id = "insertTable",
                Label = Loc["TmDocumentEditor_InsertTable"],
                Description = Loc["TmDocumentEditor_SlashInsertTableDescription"],
                Kind = DocumentAutocompleteKind.SlashCommand,
                Icon = "table",
                RendererKey = "command",
                Metadata = { ["command"] = "insertTable" }
            },
            new DocumentAutocompleteItem
            {
                Id = "insertImage",
                Label = Loc["TmDocumentEditor_InsertImage"],
                Description = Loc["TmDocumentEditor_SlashInsertImageDescription"],
                Kind = DocumentAutocompleteKind.SlashCommand,
                Icon = "image",
                RendererKey = "command",
                Metadata = { ["command"] = "insertImage" }
            },
            new DocumentAutocompleteItem
            {
                Id = "insertPageBreak",
                Label = Loc["TmDocumentEditor_PageBreak"],
                Description = Loc["TmDocumentEditor_SlashInsertPageBreakDescription"],
                Kind = DocumentAutocompleteKind.SlashCommand,
                Icon = "separator-horizontal",
                RendererKey = "command",
                Metadata = { ["command"] = "insertPageBreak" }
            }
        ];
    }

    private static DocumentAutocompleteTrigger? ResolveAutocompleteTrigger(string? triggerId, string? marker)
    {
        var key = (triggerId ?? marker ?? string.Empty).Trim().ToLowerInvariant();
        return key switch
        {
            "token" or "{{" => DocumentAutocompleteTrigger.Token(),
            "mention" or "@" => DocumentAutocompleteTrigger.Mention(),
            "tag" or "#" => DocumentAutocompleteTrigger.Tag(),
            "slash" or "/" => DocumentAutocompleteTrigger.SlashCommand(),
            _ => null
        };
    }

