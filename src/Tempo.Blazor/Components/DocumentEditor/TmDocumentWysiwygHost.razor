    /// <summary>Called by the JS engine when selection changes.</summary>
    [JSInvokable]
    public async Task HandleSelectionChanged(WysiwygSelectionSnapshot? snapshot)
    {
        if (string.IsNullOrWhiteSpace(snapshot?.ActiveTableCellId)
            && (string.Equals(snapshot?.Region, "TableCell", StringComparison.OrdinalIgnoreCase)
                || _tablePropertiesPanelOpen
                || _cellPropertiesPanelOpen))
        {
            var runtimeSelection = await RequestRuntimeSelectionAsync();
            if (!string.IsNullOrWhiteSpace(runtimeSelection?.ActiveTableCellId))
            {
                snapshot = runtimeSelection;
            }
        }

        _lastSelectionSnapshot = snapshot;
        if (string.IsNullOrWhiteSpace(snapshot?.ActiveTableCellId))
        {
            _tablePropertiesPanelOpen = false;
            _cellPropertiesPanelOpen = false;
        }
        await DocumentSelectionChanged.InvokeAsync(snapshot);
        await InvokeAsync(StateHasChanged);
    }

