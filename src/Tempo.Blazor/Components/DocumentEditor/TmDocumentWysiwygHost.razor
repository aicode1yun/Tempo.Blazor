        return Task.FromResult<DocumentBlock?>(CreateImageDrawingBlock(asset));
    }

    private async Task<WysiwygImagePayload?> UploadImagePayloadAsync(WysiwygImagePayload payload)
    {
        if (Document is null)
        {
            return null;
        }

        var sizeBytes = payload.SizeBytes;
        var base64 = payload.Base64Data ?? string.Empty;
        byte[] bytes;
        try
        {
            bytes = Convert.FromBase64String(base64);
            if (sizeBytes <= 0)
            {
                sizeBytes = bytes.Length;
            }
        }
        catch
        {
            _imageError = Loc["TmDocumentEditor_ImagePasteRejected"];
            await InvokeAsync(StateHasChanged);
            return null;
        }

        if (!ImageValidation.IsAllowed(payload.ContentType, sizeBytes))
        {
            _imageError = Loc["TmDocumentEditor_ImagePasteRejected"];
            await InvokeAsync(StateHasChanged);
            return null;
        }

        var fileName = string.IsNullOrWhiteSpace(payload.FileName)
            ? "clipboard-image"
            : payload.FileName!;

        if (ImageProvider is null)
        {
            if (AllowOfflineClipboardImages)
            {
                var assetId = Guid.NewGuid().ToString("N");
                var dataUrl = $"data:{payload.ContentType};base64,{base64}";
                Document.Assets.Add(new DocumentImageAsset
                {
                    Id = assetId,
                    DocumentId = Document.DocumentId,
                    Source = DocumentImageSource.Clipboard,
                    Url = dataUrl,
                    ContentType = payload.ContentType,
                    FileName = fileName,
                    SizeBytes = sizeBytes,
                    AltText = payload.AltText ?? fileName,
                    IsLocalDraft = true
                });

                return new WysiwygImagePayload
                {
                    Source = DocumentImageSource.Clipboard,
                    AssetId = assetId,
                    Url = dataUrl,
                    AltText = payload.AltText ?? fileName,
                    Caption = payload.Caption,
                    FileName = fileName,
                    ContentType = payload.ContentType,
                    SizeBytes = sizeBytes,
                    Selection = payload.Selection
                };
            }

            _imageError = Loc["TmDocumentEditor_ImageProviderMissing"];
            _pasteReportWarnings =
            [
                new Clipboard.DocumentClipboardWarning
                {
                    Code = "image-provider-missing",
                    Message = _imageError
                }
            ];
            _ = AutoHidePasteReportAsync();
            await InvokeAsync(StateHasChanged);
            return null;
        }

        _pendingImageUpload = true;
        _imageError = null;
        await ImageUploadStateChanged.InvokeAsync(true);
        await using var stream = new MemoryStream(bytes);
        try
        {
            var result = await ImageProvider.UploadAsync(new DocumentImageUploadRequest
            {
                DocumentId = Document.DocumentId,
                FileName = fileName,
                ContentType = payload.ContentType,
                SizeBytes = sizeBytes
            }, stream);

            if (!result.Success || string.IsNullOrWhiteSpace(result.AssetId))
            {
                _imageError = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? Loc["TmDocumentEditor_ImageUploadFailed"]
                    : result.ErrorMessage;
                return null;
            }

            return new WysiwygImagePayload
            {
                Source = DocumentImageSource.Asset,
                AssetId = result.AssetId,
                Url = result.Url,
                AltText = payload.AltText ?? fileName,
                Caption = payload.Caption,
                FileName = fileName,
                ContentType = payload.ContentType,
                SizeBytes = sizeBytes,
                Selection = payload.Selection
            };
        }
        finally
        {
            _pendingImageUpload = false;
            await ImageUploadStateChanged.InvokeAsync(false);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task InsertImageDrawingFromBlazorAsync(DocumentDrawingRun drawing, WysiwygSelectionSnapshot? selection)
    {
        if (_jsReady && !_jsFailed && !_disposed)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "tmDocumentEditorRuntime.executeCommand",
                    _instanceId,
                    "insertImageObject",
                    new { Image = drawing, ObjectId = drawing.ObjectId, Selection = selection });
                return;
            }
            catch (JSException)
            {
                // Fall back to a Blazor patch when the runtime bridge is temporarily unavailable.
            }
        }

        ApplyDrawingSelectionAnchor(drawing, selection);
        var patch = new WysiwygPatch
        {
            Type = "InsertInline",
            Inline = drawing,
            Selection = selection,
            ProtocolVersion = 1
        };

        await DocumentPatchGenerated.InvokeAsync(patch);

        var imageSelection = new WysiwygSelectionSnapshot
        {
            Region = selection?.Region ?? "Body",
            SelectionMode = "Object",
            AnchorBlockId = selection?.AnchorBlockId,
            FocusBlockId = selection?.AnchorBlockId,
            ActiveObjectId = drawing.ObjectId,
            IsCollapsed = false,
            ObjectSelection = new WysiwygObjectSelectionSnapshot
            {
                Region = selection?.Region ?? "Body",
                Kind = "image",
                ObjectId = drawing.ObjectId,
                BlockId = selection?.AnchorBlockId,
                AnchorBlockId = selection?.AnchorBlockId
            }
        };
        _lastSelectionSnapshot = imageSelection;
        await DocumentSelectionChanged.InvokeAsync(imageSelection);
    }

