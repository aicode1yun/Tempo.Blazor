        };

    private void RememberImageAsset(DocumentImageAsset asset)
    {
        if (Document is null || string.IsNullOrWhiteSpace(asset.Id))
        {
            return;
        }

        var existing = Document.Assets.FirstOrDefault(item => string.Equals(item.Id, asset.Id, StringComparison.OrdinalIgnoreCase));
        if (existing is null)
        {
            Document.Assets.Add(asset);
            return;
        }

        existing.Source = asset.Source;
        existing.Url = asset.Url;
        existing.ContentType = asset.ContentType;
        existing.FileName = asset.FileName;
        existing.SizeBytes = asset.SizeBytes;
        existing.AltText = asset.AltText;
        existing.Caption = asset.Caption;
        existing.ImageSize = asset.ImageSize;
    }

    private static DocumentDrawingRun CreateImageDrawingRun(ImageBlockContent content)
    {
        SyncImageLayoutSize(content);
        return new DocumentDrawingRun
        {
            Id = Guid.NewGuid().ToString("N"),
            ObjectId = Guid.NewGuid().ToString("N"),
            Source = content.Source,
            Url = content.Url,
            AssetId = content.AssetId,
            AltText = content.AltText,
            IsDecorative = content.IsDecorative,
            Caption = content.Caption,
            Size = content.Size,
            NaturalSize = content.NaturalSize,
            Layout = content.Layout,
            LinkUrl = content.LinkUrl
        };
    }

    private static void ApplyDrawingSelectionAnchor(DocumentDrawingRun drawing, WysiwygSelectionSnapshot? selection)
    {
        drawing.Layout ??= DocumentObjectLayout.Inline();
        drawing.Layout.Anchor ??= new DocumentObjectAnchor();
        if (!string.IsNullOrWhiteSpace(selection?.AnchorBlockId))
        {
            drawing.Layout.Anchor.BlockId = selection.AnchorBlockId;
        }

        drawing.Layout.Anchor.Offset = selection?.AnchorOffset ?? 0;
    }

    private static void SyncImageLayoutSize(ImageBlockContent content)
    {
        content.Layout ??= DocumentObjectLayout.Inline();
        content.Layout.Transform.Width ??= content.Size.Width;
        content.Layout.Transform.Height ??= content.Size.Height;
        content.Layout.Transform.NaturalWidth ??= content.NaturalSize.Width;
        content.Layout.Transform.NaturalHeight ??= content.NaturalSize.Height;
    }

    private static bool IsSafeImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return false;
        }

        if (url.StartsWith("/", StringComparison.Ordinal))
        {
            return true;
        }

        if (url.StartsWith("data:image/png;base64,", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("data:image/jpeg;base64,", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("data:image/webp;base64,", StringComparison.OrdinalIgnoreCase)
            || url.StartsWith("data:image/gif;base64,", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return Uri.TryCreate(url, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp);
    }

