@namespace Tempo.Blazor.Components.DocumentEditor
@using Microsoft.AspNetCore.Components.Web
@using Tempo.Blazor.DocumentEditor.Models

@if (Block is not null)
{
    <div class="@RootClass"
         data-block-id="@Block.Id"
         @onclick="ActivateAsync"
         @onclick:stopPropagation="true">
        @if (IsActive && CanComment)
        {
            <button type="button"
                    class="tm-document-editable-block__comment"
                    data-testid="document-block-comment"
                    title="@Loc["TmDocumentEditor_AddComment"]"
                    @onclick="RequestCommentAsync">
                <TmIcon Name="message-square" Size="IconSize.Sm" />
            </button>
        }

        @switch (Block.Content)
        {
            case ParagraphBlockContent paragraph:
                <textarea class="tm-document-editable-text tm-document-editable-text--paragraph"
                          data-testid="document-paragraph-editor"
                          aria-label="@Loc["TmDocumentEditor_EditParagraph"]"
                          value="@GetInlineText(paragraph.Inlines)"
                          @oninput="args => ChangeInlineTextAsync(paragraph.Inlines, args)"
                          @onkeydown="HandleTextKeyDownAsync"></textarea>
                @if (HasTokens(paragraph.Inlines))
                {
                    <div class="tm-document-token-strip" data-testid="document-token-strip">
                        @foreach (var token in GetTokensWithIndexes(paragraph.Inlines))
                        {
                            <span class="tm-document-token-chip" data-testid="document-edit-token-chip" data-token-key="@token.Run.Key">
                                <span>@GetTokenLabel(token.Run)</span>
                                @if (!string.IsNullOrWhiteSpace(token.Run.TypeLabel))
                                {
                                    <small>@token.Run.TypeLabel</small>
                                }
                                <button type="button"
                                        title="@Loc["TmDocumentEditor_DeleteToken"]"
                                        data-testid="document-token-delete"
                                        @onclick="() => DeleteTokenAsync(paragraph.Inlines, token.Index)"
                                        @onclick:stopPropagation="true">
                                    <TmIcon Name="x" Size="IconSize.Xs" />
                                </button>
                            </span>
                        }
                    </div>
                }
                break;

            case HeadingBlockContent heading:
                <div class="tm-document-heading-editor">
                    <select class="tm-document-heading-editor__level"
                            aria-label="@Loc["TmDocumentEditor_HeadingLevel"]"
                            value="@heading.Level"
                            @onchange="args => ChangeHeadingLevelAsync(heading, args)">
                        @for (var level = 1; level <= 6; level++)
                        {
                            <option value="@level">@Loc[$"TmDocumentEditor_Heading{level}"]</option>
                        }
                    </select>
                    <textarea class="tm-document-editable-text tm-document-editable-text--heading"
                              data-testid="document-heading-editor"
                              aria-label="@Loc["TmDocumentEditor_EditHeading"]"
                              value="@GetInlineText(heading.Inlines)"
                              @oninput="args => ChangeInlineTextAsync(heading.Inlines, args)"
                              @onkeydown="HandleTextKeyDownAsync"></textarea>
                    @if (HasTokens(heading.Inlines))
                    {
                        <div class="tm-document-token-strip" data-testid="document-token-strip">
                            @foreach (var token in GetTokensWithIndexes(heading.Inlines))
                            {
                                <span class="tm-document-token-chip" data-testid="document-edit-token-chip" data-token-key="@token.Run.Key">
                                    <span>@GetTokenLabel(token.Run)</span>
                                    @if (!string.IsNullOrWhiteSpace(token.Run.TypeLabel))
                                    {
                                        <small>@token.Run.TypeLabel</small>
                                    }
                                    <button type="button"
                                            title="@Loc["TmDocumentEditor_DeleteToken"]"
                                            data-testid="document-token-delete"
                                            @onclick="() => DeleteTokenAsync(heading.Inlines, token.Index)"
                                            @onclick:stopPropagation="true">
                                        <TmIcon Name="x" Size="IconSize.Xs" />
                                    </button>
                                </span>
                            }
                        </div>
                    }
                </div>
                break;

            case ListBlockContent list:
                <div class="tm-document-list-editor">
                    <div class="tm-document-block-tools" role="toolbar" aria-label="@Loc["TmDocumentEditor_ListTools"]">
                        <button type="button" @onclick="() => CommandAsync(DocumentEditorBlockCommand.DecreaseIndent)" title="@Loc["TmDocumentEditor_DecreaseIndent"]">
                            <TmIcon Name="outdent" Size="IconSize.Sm" />
                        </button>
                        <button type="button" @onclick="() => CommandAsync(DocumentEditorBlockCommand.IncreaseIndent)" title="@Loc["TmDocumentEditor_IncreaseIndent"]">
                            <TmIcon Name="indent" Size="IconSize.Sm" />
                        </button>
                    </div>
                    <textarea class="tm-document-editable-text tm-document-editable-text--list"
                              data-testid="document-list-editor"
                              aria-label="@Loc["TmDocumentEditor_EditListItem"]"
                              value="@GetInlineText(list.Inlines)"
                              @oninput="args => ChangeInlineTextAsync(list.Inlines, args)"
                              @onkeydown="HandleListKeyDownAsync"></textarea>
                    @if (HasTokens(list.Inlines))
                    {
                        <div class="tm-document-token-strip" data-testid="document-token-strip">
                            @foreach (var token in GetTokensWithIndexes(list.Inlines))
                            {
                                <span class="tm-document-token-chip" data-testid="document-edit-token-chip" data-token-key="@token.Run.Key">
                                    <span>@GetTokenLabel(token.Run)</span>
                                    @if (!string.IsNullOrWhiteSpace(token.Run.TypeLabel))
                                    {
                                        <small>@token.Run.TypeLabel</small>
                                    }
                                    <button type="button"
                                            title="@Loc["TmDocumentEditor_DeleteToken"]"
                                            data-testid="document-token-delete"
                                            @onclick="() => DeleteTokenAsync(list.Inlines, token.Index)"
                                            @onclick:stopPropagation="true">
                                        <TmIcon Name="x" Size="IconSize.Xs" />
                                    </button>
                                </span>
                            }
                        </div>
                    }
                </div>
                break;

            case QuoteBlockContent quote:
                <textarea class="tm-document-editable-text tm-document-editable-text--quote"
                          aria-label="@Loc["TmDocumentEditor_EditQuote"]"
                          value="@GetInlineText(quote.Inlines)"
                          @oninput="args => ChangeInlineTextAsync(quote.Inlines, args)"
                          @onkeydown="HandleTextKeyDownAsync"></textarea>
                @if (HasTokens(quote.Inlines))
                {
                    <div class="tm-document-token-strip" data-testid="document-token-strip">
                        @foreach (var token in GetTokensWithIndexes(quote.Inlines))
                        {
                            <span class="tm-document-token-chip" data-testid="document-edit-token-chip" data-token-key="@token.Run.Key">
                                <span>@GetTokenLabel(token.Run)</span>
                                @if (!string.IsNullOrWhiteSpace(token.Run.TypeLabel))
                                {
                                    <small>@token.Run.TypeLabel</small>
                                }
                                <button type="button"
                                        title="@Loc["TmDocumentEditor_DeleteToken"]"
                                        data-testid="document-token-delete"
                                        @onclick="() => DeleteTokenAsync(quote.Inlines, token.Index)"
                                        @onclick:stopPropagation="true">
                                    <TmIcon Name="x" Size="IconSize.Xs" />
                                </button>
                            </span>
                        }
                    </div>
                }
                break;

            case TableBlockContent table:
                <div class="tm-document-table-editor">
                    <div class="tm-document-block-tools" role="toolbar" aria-label="@Loc["TmDocumentEditor_TableTools"]">
                        <button type="button" data-testid="document-table-add-row" @onclick="() => CommandAsync(DocumentEditorBlockCommand.AddTableRow)">
                            @Loc["TmDocumentEditor_AddRow"]
                        </button>
                        <button type="button" data-testid="document-table-add-column" @onclick="() => CommandAsync(DocumentEditorBlockCommand.AddTableColumn)">
                            @Loc["TmDocumentEditor_AddColumn"]
                        </button>
                        <button type="button" @onclick="() => CommandAsync(DocumentEditorBlockCommand.DeleteTableRow)">
                            @Loc["TmDocumentEditor_DeleteRow"]
                        </button>
                        <button type="button" @onclick="() => CommandAsync(DocumentEditorBlockCommand.DeleteTableColumn)">
                            @Loc["TmDocumentEditor_DeleteColumn"]
                        </button>
                        <button type="button" data-testid="document-table-merge-right" @onclick="() => CommandAsync(DocumentEditorBlockCommand.MergeCellRight)">
                            @Loc["TmDocumentEditor_MergeRight"]
                        </button>
                        <button type="button" @onclick="() => CommandAsync(DocumentEditorBlockCommand.SplitCell)">
                            @Loc["TmDocumentEditor_SplitCell"]
                        </button>
                    </div>
                    <table class="tm-document-block tm-document-table">
                        <tbody>
                            @for (var rowIndex = 0; rowIndex < table.Rows.Count; rowIndex++)
                            {
                                var row = table.Rows[rowIndex];
                                <tr>
                                    @for (var columnIndex = 0; columnIndex < row.Cells.Count; columnIndex++)
                                    {
                                        var cell = row.Cells[columnIndex];
                                        if (!cell.Merge.IsOrigin)
                                        {
                                            continue;
                                        }

                                        var currentRowIndex = rowIndex;
                                        var currentColumnIndex = columnIndex;
                                        <td colspan="@cell.ColumnSpan" rowspan="@cell.RowSpan" class="@(SelectedCellId == cell.Id ? "tm-document-table__cell--active" : null)">
                                            <input class="tm-document-table-editor__cell"
                                                   data-testid="document-table-cell"
                                                   value="@GetCellText(cell)"
                                                   @onclick="() => SelectCellAsync(cell.Id)"
                                                   @onkeydown="args => HandleTableCellKeyDownAsync(table, currentRowIndex, currentColumnIndex, args)"
                                                   @onchange="args => ChangeCellTextAsync(cell, args)" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case ImageBlockContent image:
                <div class="tm-document-image-editor">
                    <TmDocumentBlockRenderer DocumentId="@DocumentId"
                                             Block="@Block"
                                             ImageUrlResolver="@ImageUrlResolver" />
                    <div class="tm-document-image-editor__fields">
                        <label>
                            <span>@Loc["TmDocumentEditor_ImageUrl"]</span>
                            <input value="@image.Url" @onchange="args => ChangeImageUrlAsync(image, args)" disabled="@(image.Source != DocumentImageSource.Url)" />
                        </label>
                        <label>
                            <span>@Loc["TmDocumentEditor_ImageAltText"]</span>
                            <input value="@image.AltText" @onchange="args => ChangeImageAltAsync(image, args)" />
                        </label>
                        <label>
                            <span>@Loc["TmDocumentEditor_ImageCaption"]</span>
                            <input data-testid="document-image-caption" value="@image.Caption" @onchange="args => ChangeImageCaptionAsync(image, args)" />
                        </label>
                        <label>
                            <span>@Loc["TmDocumentEditor_ImageWidth"]</span>
                            <input type="number" value="@image.Size.Width" @onchange="args => ChangeImageWidthAsync(image, args)" />
                        </label>
                    </div>
                    <div class="tm-document-block-tools" role="toolbar" aria-label="@Loc["TmDocumentEditor_ImageTools"]">
                        <button type="button" @onclick="() => SetImageAlignmentAsync(image, DocumentImageAlignment.Start)">@Loc["TmDocumentEditor_AlignLeft"]</button>
                        <button type="button" @onclick="() => SetImageAlignmentAsync(image, DocumentImageAlignment.Center)">@Loc["TmDocumentEditor_AlignCenter"]</button>
                        <button type="button" @onclick="() => SetImageAlignmentAsync(image, DocumentImageAlignment.End)">@Loc["TmDocumentEditor_AlignRight"]</button>
                        <button type="button" data-testid="document-image-floating" @onclick="() => CommandAsync(DocumentEditorBlockCommand.ToggleFloatingImage)">
                            @Loc["TmDocumentEditor_FloatingImage"]
                        </button>
                        <button type="button" data-testid="document-image-delete" @onclick="() => CommandAsync(DocumentEditorBlockCommand.DeleteBlock)">
                            @Loc["TmDocumentEditor_DeleteImage"]
                        </button>
                    </div>
                </div>
                break;

            case PageBreakBlockContent:
                <TmDocumentBlockRenderer DocumentId="@DocumentId" Block="@Block" ImageUrlResolver="@ImageUrlResolver" />
                break;
        }

        <TmDocumentTokenMenu IsVisible="@_tokenMenuOpen"
                             Tokens="@_availableTokens"
                             Query="@_tokenQuery"
                             HighlightedIndex="@_tokenHighlightedIndex"
                             IsLoading="@_tokenLoading"
                             OnTokenSelected="InsertTokenAsync"
                             OnHighlightedIndexChanged="SetTokenHighlightAsync" />
    </div>
}
