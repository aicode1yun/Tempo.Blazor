</header>

@code {
    private const string RibbonPanelId = "tm-document-ribbon-panel";
    private DocumentRibbonTab _activeRibbonTab = DocumentRibbonTab.Home;
    private ElementReference _homeTab;
    private ElementReference _insertTab;
    private ElementReference _layoutTab;
    private ElementReference _referencesTab;
    private ElementReference _reviewTab;
    private ElementReference _viewTab;
    private ElementReference _headerFooterTab;
    private bool _linkDialogOpen;
    private bool _focusLinkUrlOnRender;
    private bool _docxImportOpen;
    private string? _pendingLinkUrl;
    private string? _pendingLinkTitle;
    private string? _linkError;
    private ElementReference _linkUrlInput;
    private ElementReference _headerFooterFieldMenu;
    private ElementReference _headerFooterPresetMenu;
    private ElementReference _pageLayoutInspector;
    private bool _wasHeaderFooterMode;
    private bool _keyboardMode;
    private ElementReference _ribbonGroupsRef;
    private DotNetObjectReference<TmDocumentEditorToolbar>? _dotNetRef;
    private DocumentTextAlignment? _optimisticParagraphAlignment;
    private DateTimeOffset _optimisticParagraphAlignmentExpiresAt;
    private double? _optimisticLineSpacing;
    private DateTimeOffset _optimisticLineSpacingExpiresAt;
    private bool? _optimisticBulletListActive;
    private bool? _optimisticNumberedListActive;
    private DateTimeOffset _optimisticListExpiresAt;
    private bool _isOverflowing;
    private bool _overflowMenuOpen;
    private string? _overflowSearchQuery;
    private bool _tableGridPickerOpen;
    private bool _imageInsertMenuOpen;
    private bool _headerFooterFieldMenuOpen;
    private bool _headerFooterPresetMenuOpen;
    private bool _pageLayoutInspectorOpen;
    private bool _focusHeaderFooterFieldMenuOnRender;
    private bool _focusHeaderFooterPresetMenuOnRender;
    private bool _focusPageLayoutInspectorOnRender;
    private string[] _overflowedCommandNames = [];
    private string? _lastFontFamilyChangeValue;
    private DateTimeOffset _lastFontFamilyChangeAt;
    private string? _lastFontSizeChangeValue;
    private DateTimeOffset _lastFontSizeChangeAt;
    private static readonly int[] FontSizes = [8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28, 32, 36, 48, 72];
    private static readonly string[] DocumentTextColors =
    [
        "#111827", "#374151", "#6b7280", "#000000", "#ffffff", "#dc2626",
        "#ea580c", "#d97706", "#059669", "#2563eb", "#4f46e5", "#7c3aed"
    ];
    private static readonly string[] DocumentHighlightColors =
    [
        "#ffffff", "#fef3c7", "#fde68a", "#fee2e2", "#ffedd5", "#dcfce7",
        "#dbeafe", "#e0e7ff", "#f3e8ff", "#f3f4f6", "#d1d5db", "#9ca3af"
    ];
    private static readonly double[] LineSpacingOptions = [1, 1.15, 1.5, 2];
    private static readonly int[] ParagraphSpacingOptions = [0, 6, 12, 18, 24];
    private static readonly DocumentRibbonTab[] BaseRibbonTabs =
    [
        DocumentRibbonTab.Home,
        DocumentRibbonTab.Insert,
        DocumentRibbonTab.Layout,
        DocumentRibbonTab.References,
        DocumentRibbonTab.Review,
        DocumentRibbonTab.View
    ];

    private IReadOnlyList<DocumentRibbonTab> RibbonTabs
        => IsHeaderFooterMode
            ? [.. BaseRibbonTabs, DocumentRibbonTab.HeaderFooter]
            : BaseRibbonTabs;

    private bool IsFeatureEnabled(string featureName) =>
        DisabledFeatures is null
        || !DisabledFeatures.Any(disabledFeature => string.Equals(disabledFeature, featureName, StringComparison.OrdinalIgnoreCase));

    private string ToolbarClass
    {
        get
        {
            var classes = new List<string> { "tm-document-editor__ribbon" };
            if (_keyboardMode)
            {
                classes.Add("tm-document-editor__ribbon--keyboard-mode");
            }

            if (ToolbarMode == DocumentToolbarMode.Compact)
            {
                classes.Add("tm-document-editor__ribbon--compact");
            }
            else if (ToolbarMode == DocumentToolbarMode.DistractionFree)
            {
                classes.Add("tm-document-editor__ribbon--distraction-free");
            }

            return string.Join(' ', classes);
        }
    }

    private string ActiveRibbonTabDataValue => GetRibbonTabDataValue(_activeRibbonTab);

    private string TrackChangesState => TrackChangesEnabled ? "on" : "off";

    /// <summary>Moves focus to the currently active ribbon tab.</summary>
    public async ValueTask FocusActiveTabAsync()
    {
        _keyboardMode = true;
        await GetActiveTabReference().FocusAsync();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync(
                    "tmDocumentEditorToolbar.createOverflowController",
                    _ribbonGroupsRef, _dotNetRef);
            }
            catch { /* JS not available in prerender/SSR */ }
        }

        if (_focusLinkUrlOnRender)
        {
            _focusLinkUrlOnRender = false;
            try
            {
                await _linkUrlInput.FocusAsync(preventScroll: true);
            }
            catch
            {
                // Element focus can fail during prerender or if the dialog closed before render.
            }
        }

        if (_focusHeaderFooterFieldMenuOnRender)
        {
            _focusHeaderFooterFieldMenuOnRender = false;
            await FocusToolbarFloatingElementAsync(_headerFooterFieldMenu);
        }

        if (_focusHeaderFooterPresetMenuOnRender)
        {
            _focusHeaderFooterPresetMenuOnRender = false;
            await FocusToolbarFloatingElementAsync(_headerFooterPresetMenu);
        }

        if (_focusPageLayoutInspectorOnRender)
        {
            _focusPageLayoutInspectorOnRender = false;
            await FocusToolbarFloatingElementAsync(_pageLayoutInspector);
        }
    }

    private static async Task FocusToolbarFloatingElementAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync(preventScroll: true);
        }
        catch
        {
            // The floating element may have been closed by a rapid user action before focus runs.
        }
    }

    /// <summary>Called by the JS overflow controller when overflow state changes.</summary>
    [JSInvokable]
    public Task SetOverflowingAsync(bool isOverflowing, string[] overflowedCommandNames)
    {
        _isOverflowing = isOverflowing;
        _overflowedCommandNames = overflowedCommandNames;
        if (!isOverflowing)
        {
            _overflowMenuOpen = false;
            _overflowSearchQuery = null;
        }
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Closes toolbar-owned floating UI in response to a document-level Escape key.</summary>
    [JSInvokable]
    public Task CloseToolbarFloatingUiFromJsAsync()
    {
        CloseToolbarFloatingUi();
        _overflowMenuOpen = false;
        _overflowSearchQuery = null;
        return InvokeAsync(StateHasChanged);
    }

    private void ToggleOverflowMenu()
    {
        _overflowMenuOpen = !_overflowMenuOpen;
        if (!_overflowMenuOpen)
        {
            _overflowSearchQuery = null;
        }
    }

    private void HandleMoreButtonKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && _overflowMenuOpen)
        {
            _overflowMenuOpen = false;
            _overflowSearchQuery = null;
        }
    }

    private void HandleOverflowMenuItemKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _overflowMenuOpen = false;
            _overflowSearchQuery = null;
        }
