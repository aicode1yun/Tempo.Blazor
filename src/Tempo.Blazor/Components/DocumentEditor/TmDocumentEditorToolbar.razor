    private bool CanExecuteSave =>
        CommandRegistry?.GetState("save")?.IsEnabled ?? (!ReadOnly && !IsSaving);

    private bool CanExecuteUndo =>
        CommandRegistry?.GetState("undo")?.IsEnabled ?? (!ReadOnly && CanUndo);

    private bool CanExecuteRedo =>
        CommandRegistry?.GetState("redo")?.IsEnabled ?? (!ReadOnly && CanRedo);

    private bool IsCommandEnabled(string commandName) =>
        CommandRegistry?.GetState(commandName)?.IsEnabled ?? !ReadOnly;

    private bool IsCommandEnabled(string commandName, bool fallback) =>
        CommandRegistry?.GetState(commandName)?.IsEnabled ?? fallback;

    private Task ExecuteToolbarCommandAsync(string commandName, EventCallback callback, bool fallback = true)
    {
        if (!IsCommandEnabled(commandName, fallback))
        {
            return Task.CompletedTask;
        }

        return callback.InvokeAsync();
    }

    private Task ExecuteToolbarCommandAsync(string commandName, Func<Task> callback, bool fallback = true)
    {
        if (!IsCommandEnabled(commandName, fallback))
        {
            return Task.CompletedTask;
        }

        return callback();
    }

    private string GetRegistryFormattingAriaPressed(string commandName, WysiwygFormattingValue fallback)
    {
        var value = CommandRegistry?.GetState(commandName)?.Value;
        return value switch
        {
            "active" => "true",
            "mixed"  => "mixed",
            _ when value is not null => "false",
            _ => GetFormattingAriaPressed(fallback)
        };
    }

