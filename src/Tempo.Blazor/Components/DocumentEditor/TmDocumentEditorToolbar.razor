</header>

@code {
    private DocumentRibbonTab _activeRibbonTab = DocumentRibbonTab.Home;
    private ElementReference _homeTab;
    private ElementReference _insertTab;
    private ElementReference _layoutTab;
    private ElementReference _referencesTab;
    private ElementReference _reviewTab;
    private ElementReference _viewTab;
    private ElementReference _headerFooterTab;
    private bool _linkDialogOpen;
    private bool _focusLinkUrlOnRender;
    private bool _docxImportOpen;
    private string? _pendingLinkUrl;
    private string? _pendingLinkTitle;
    private string? _linkError;
    private ElementReference _linkUrlInput;
    private bool _wasHeaderFooterMode;
    private bool _keyboardMode;
    private ElementReference _ribbonGroupsRef;
    private DotNetObjectReference<TmDocumentEditorToolbar>? _dotNetRef;
    private DocumentTextAlignment? _optimisticParagraphAlignment;
    private DateTimeOffset _optimisticParagraphAlignmentExpiresAt;
    private double? _optimisticLineSpacing;
    private DateTimeOffset _optimisticLineSpacingExpiresAt;
    private bool _isOverflowing;
    private bool _overflowMenuOpen;
    private string? _overflowSearchQuery;
    private bool _tableGridPickerOpen;
    private bool _imageInsertMenuOpen;
    private string[] _overflowedCommandNames = [];
    private static readonly int[] FontSizes = [8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28, 32, 36, 48, 72];
    private static readonly double[] LineSpacingOptions = [1, 1.15, 1.5, 2];
    private static readonly int[] ParagraphSpacingOptions = [0, 6, 12, 18, 24];
    private static readonly DocumentRibbonTab[] BaseRibbonTabs =
    [
        DocumentRibbonTab.Home,
        DocumentRibbonTab.Insert,
        DocumentRibbonTab.Layout,
        DocumentRibbonTab.References,
        DocumentRibbonTab.Review,
        DocumentRibbonTab.View
    ];

    private IReadOnlyList<DocumentRibbonTab> RibbonTabs
        => IsHeaderFooterMode
            ? [.. BaseRibbonTabs, DocumentRibbonTab.HeaderFooter]
            : BaseRibbonTabs;

    private bool IsFeatureEnabled(string featureName) =>
        DisabledFeatures is null
        || !DisabledFeatures.Any(disabledFeature => string.Equals(disabledFeature, featureName, StringComparison.OrdinalIgnoreCase));

    private string ToolbarClass
    {
        get
        {
            var classes = new List<string> { "tm-document-editor__ribbon" };
            if (_keyboardMode)
            {
                classes.Add("tm-document-editor__ribbon--keyboard-mode");
            }

            if (ToolbarMode == DocumentToolbarMode.Compact)
            {
                classes.Add("tm-document-editor__ribbon--compact");
            }
            else if (ToolbarMode == DocumentToolbarMode.DistractionFree)
            {
                classes.Add("tm-document-editor__ribbon--distraction-free");
            }

            return string.Join(' ', classes);
        }
    }

    /// <summary>Moves focus to the currently active ribbon tab.</summary>
    public async ValueTask FocusActiveTabAsync()
    {
        _keyboardMode = true;
        await GetActiveTabReference().FocusAsync();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync(
                    "tmDocumentEditorToolbar.createOverflowController",
                    _ribbonGroupsRef, _dotNetRef);
            }
            catch { /* JS not available in prerender/SSR */ }
        }

        if (_focusLinkUrlOnRender)
        {
            _focusLinkUrlOnRender = false;
            try
            {
                await _linkUrlInput.FocusAsync(preventScroll: true);
            }
            catch
            {
                // Element focus can fail during prerender or if the dialog closed before render.
            }
        }
    }

    /// <summary>Called by the JS overflow controller when overflow state changes.</summary>
    [JSInvokable]
    public Task SetOverflowingAsync(bool isOverflowing, string[] overflowedCommandNames)
    {
        _isOverflowing = isOverflowing;
        _overflowedCommandNames = overflowedCommandNames;
        if (!isOverflowing)
        {
            _overflowMenuOpen = false;
            _overflowSearchQuery = null;
        }
        return InvokeAsync(StateHasChanged);
    }

    private void ToggleOverflowMenu()
    {
        _overflowMenuOpen = !_overflowMenuOpen;
        if (!_overflowMenuOpen)
        {
            _overflowSearchQuery = null;
        }
    }

    private void HandleMoreButtonKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && _overflowMenuOpen)
        {
            _overflowMenuOpen = false;
            _overflowSearchQuery = null;
        }
    }

    private void HandleOverflowMenuItemKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _overflowMenuOpen = false;
            _overflowSearchQuery = null;
        }
    }

    private bool ShowOverflowSearch => _overflowedCommandNames.Length >= 8;

    private void HandleOverflowSearchInput(ChangeEventArgs args)
    {
        _overflowSearchQuery = args.Value?.ToString();
    }

    private Task ExecuteOverflowCommandAsync(string commandName) => commandName switch
    {
        "bold"           => OnBold.InvokeAsync(),
        "italic"         => OnItalic.InvokeAsync(),
        "underline"      => OnUnderline.InvokeAsync(),
        "save"           => OnSave.InvokeAsync(),
        "undo"           => OnUndo.InvokeAsync(),
        "redo"           => OnRedo.InvokeAsync(),
        "clearFormatting"=> OnClearFormatting.InvokeAsync(),
        "link"           => ToggleLinkDialogAsync(),
        "insertTable"    => OnInsertTable.InvokeAsync(),
        "insertImage"    => OnInsertImage.InvokeAsync(),
        "insertPageBreak" => OnInsertPageBreak.InvokeAsync(),
        "importDocx"     => ToggleDocxImportPanelAsync(),
        "insertMenu"     => OnToggleInsert.InvokeAsync(),
        "trackChanges"      => OnToggleTrackChanges.InvokeAsync(),
        "addComment"        => OnAddComment.InvokeAsync(),
        "openComments"      => OnOpenComments.InvokeAsync(),
        "openRevisions"     => OnOpenRevisions.InvokeAsync(),
        "compareDocuments"  => OnCompareDocuments.InvokeAsync(),
        "protectDocument"   => OnProtectDocument.InvokeAsync(),
        "markEditableRegion"=> OnMarkEditableRegion.InvokeAsync(),
        "showRuler"         => ShowRulerChanged.InvokeAsync(!ShowRuler),
        "showBlocks"        => OnShowBlocksToggle.InvokeAsync(),
        "toggleNonPrintingCharacters" => OnToggleNonPrintingCharacters.InvokeAsync(),
        "fullscreen"        => OnFullscreenToggle.InvokeAsync(),
        "viewDocumentJson"  => OnViewDocumentJson.InvokeAsync(),
        "viewClipboardHtml" => OnViewClipboardHtml.InvokeAsync(),
        "increaseIndent"    => OnIncreaseIndent.InvokeAsync(),
        "decreaseIndent" => OnDecreaseIndent.InvokeAsync(),
        "alignLeft"      => OnParagraphAlignmentChanged.InvokeAsync(DocumentTextAlignment.Left),
        "alignCenter"    => OnParagraphAlignmentChanged.InvokeAsync(DocumentTextAlignment.Center),
        "alignRight"     => OnParagraphAlignmentChanged.InvokeAsync(DocumentTextAlignment.Right),
        "alignJustify"   => OnParagraphAlignmentChanged.InvokeAsync(DocumentTextAlignment.Justify),
        "zoomPageWidth"  => OnZoomPageWidth.InvokeAsync(),
        "differentFirstPage" => DifferentFirstPageChanged.InvokeAsync(!DifferentFirstPage),
        "differentOddEven" => DifferentOddAndEvenPagesChanged.InvokeAsync(!DifferentOddAndEvenPages),
        "closeHeaderFooter" => OnCloseHeaderFooter.InvokeAsync(),
        "exportPdf"      => OnExportPdf.InvokeAsync(),
        "exportDocx"     => OnExportDocx.InvokeAsync(),
        "openVersions"   => OnOpenVersions.InvokeAsync(),
        _ => Task.CompletedTask
    };

    private async Task ExecuteGuardedOverflowCommandAsync(string commandName)
    {
        if (CommandRegistry?.GetState(commandName)?.IsEnabled == false)
        {
            return;
        }

        await ExecuteOverflowCommandAsync(commandName);
        _overflowMenuOpen = false;
        _overflowSearchQuery = null;
    }

    private IReadOnlyList<DocumentToolbarOverflowMenuGroup> GetOverflowMenuGroups()
    {
        var query = _overflowSearchQuery?.Trim();
        var items = _overflowedCommandNames
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(CreateOverflowMenuItem)
            .Where(IsOverflowItemVisible);

        if (!string.IsNullOrWhiteSpace(query))
        {
            items = items.Where(item =>
                item.Label.Contains(query, StringComparison.OrdinalIgnoreCase)
                || item.CommandName.Contains(query, StringComparison.OrdinalIgnoreCase));
        }

        var sortedItems = items
            .OrderBy(item => item.Metadata.Priority)
            .ThenBy(item => item.Metadata.Tab)
            .ThenBy(item => item.Metadata.EffectiveGroup ?? string.Empty, StringComparer.Ordinal)
            .ThenBy(item => item.Metadata.Order)
            .ToList();

        return sortedItems
            .GroupBy(item => item.Metadata.EffectiveGroup ?? "other", StringComparer.OrdinalIgnoreCase)
            .Select(group => new DocumentToolbarOverflowMenuGroup(group.Key, GetOverflowGroupLabel(group.Key), group.ToArray()))
            .ToArray();
    }

    private DocumentToolbarOverflowMenuItem CreateOverflowMenuItem(string commandName)
    {
        var metadata = DocumentEditorBuiltInToolbar.FindItemByCommandName(commandName)
            ?? new DocumentToolbarItem
            {
                Id = commandName,
                CommandName = commandName,
                Group = "other",
                GroupId = "other",
                Order = int.MaxValue,
                Priority = ToolbarItemPriority.Secondary
            };

        var state = CommandRegistry?.GetState(commandName);
        return new DocumentToolbarOverflowMenuItem(
            commandName,
            metadata,
            GetOverflowCommandLabel(commandName, metadata),
            state is null || state.IsEnabled);
    }

    private bool IsOverflowItemVisible(DocumentToolbarOverflowMenuItem item)
    {
        var context = new DocumentToolbarVisibilityContext
        {
            CommandRegistry = CommandRegistry,
            ToolbarMode = ToolbarMode,
            IsHeaderFooterMode = IsHeaderFooterMode,
            DisabledFeatures = DisabledFeatures
        };

        return item.Metadata.IsVisible(context)
            && (CommandRegistry?.GetState(item.CommandName)?.IsVisible ?? true);
    }

    private string GetOverflowGroupLabel(string groupId)
    {
        var group = DocumentEditorBuiltInToolbar.FindGroup(groupId);
        return group?.LabelKey is { Length: > 0 } labelKey
            ? Loc[labelKey]
            : groupId;
    }

    private string GetOverflowCommandLabel(string commandName, DocumentToolbarItem? metadata = null)
    {
        var key = metadata?.LabelKey;
        if (!string.IsNullOrWhiteSpace(key))
        {
            return Loc[key];
        }

        return commandName switch
    {
        "bold"           => Loc["TmDocumentEditor_Bold"],
        "italic"         => Loc["TmDocumentEditor_Italic"],
        "underline"      => Loc["TmDocumentEditor_Underline"],
        "save"           => Loc["TmDocumentEditor_Save"],
