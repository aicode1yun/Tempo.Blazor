        }

        return double.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var size)
            ? OnFontSizeChanged.InvokeAsync(size)
            : Task.CompletedTask;
    }

    private bool ShouldSkipDuplicateSelectChange(
        string? value,
        ref string? lastValue,
        ref DateTimeOffset lastChangedAt)
    {
        var now = DateTimeOffset.UtcNow;
        if (string.Equals(value, lastValue, StringComparison.Ordinal)
            && now - lastChangedAt < TimeSpan.FromMilliseconds(150))
        {
            return true;
        }

        lastValue = value;
        lastChangedAt = now;
        return false;
    }

