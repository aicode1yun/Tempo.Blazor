                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        title="@Loc["TmDocumentEditor_Zoom100"]"
                        aria-label="@Loc["TmDocumentEditor_Zoom100"]"
                        @onclick="ZoomTo100Async"
                        data-testid="document-zoom-100">
                    <TmIcon Name="scan-line" Size="IconSize.Sm" />
                    <span>@ZoomPercent%</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        title="@Loc["TmDocumentEditor_ZoomIn"]"
                        aria-label="@Loc["TmDocumentEditor_ZoomIn"]"
                        @onclick="ZoomInAsync"
                        data-testid="document-zoom-in">
                    <TmIcon Name="plus" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_ZoomIn"]</span>
                </button>
                <button class="@GetToggleButtonClass(ZoomPageWidth)"
                        type="button"
                        title="@Loc["TmDocumentEditor_ZoomPageWidth"]"
                        aria-pressed="@ZoomPageWidth.ToString().ToLowerInvariant()"
                        @onclick="ZoomToPageWidthAsync"
                        data-testid="document-zoom-page-width">
                    <TmIcon Name="maximize-2" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_ZoomPageWidth"]</span>
                </button>
            </section>

            <section class="tm-document-editor__ribbon-group" aria-label="@Loc["TmDocumentEditor_TabView"]">
                <button class="tm-document-editor__ribbon-button @(TemplatePreviewEnabled ? "tm-document-editor__ribbon-button--active" : null)"
                        type="button"
                        disabled="@(!CanPreviewTemplate)"
                        title="@(GetCommandTitle(Loc["TmDocumentEditor_TemplatePreview"], CanPreviewTemplate, Loc["TmDocumentEditor_CommandDisabledUnavailable"]))"
                        @onclick="OnToggleTemplatePreview"
                        data-testid="document-template-preview">
                    <TmIcon Name="eye" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_TemplatePreview"]</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        title="@Loc["TmDocumentEditor_OpenVersions"]"
                        @onclick="OnOpenVersions"
                        data-testid="document-open-versions">
                    <TmIcon Name="clock" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Versions"]</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(TemplatePreviewMessage))
                {
                    <span class="tm-document-editor__template-preview-message" data-testid="document-template-preview-message">
                        @TemplatePreviewMessage
                    </span>
                }
            </section>
        }
        else if (_activeRibbonTab == DocumentRibbonTab.HeaderFooter)
        {
            <section class="tm-document-editor__ribbon-group" aria-label="@Loc["TmDocumentEditor_TabHeaderFooter"]">
                <button class="@GetToggleButtonClass(DifferentFirstPage)"
                        type="button"
                        disabled="@ReadOnly"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_DifferentFirstPage"]))"
                        aria-pressed="@DifferentFirstPage.ToString().ToLowerInvariant()"
                        @onclick="ToggleDifferentFirstPageAsync"
                        data-testid="document-header-footer-different-first-page">
                    <TmIcon Name="panel-top" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_DifferentFirstPage"]</span>
                </button>
                <button class="@GetToggleButtonClass(DifferentOddAndEvenPages)"
                        type="button"
                        disabled="@ReadOnly"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_DifferentOddEven"]))"
                        aria-pressed="@DifferentOddAndEvenPages.ToString().ToLowerInvariant()"
                        @onclick="ToggleDifferentOddEvenAsync"
                        data-testid="document-header-footer-different-odd-even">
                    <TmIcon Name="layout" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_DifferentOddEven"]</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        title="@Loc["TmDocumentEditor_CloseHeaderFooter"]"
                        @onclick="OnCloseHeaderFooter"
                        data-testid="document-close-header-footer">
                    <TmIcon Name="x" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_CloseHeaderFooter"]</span>
                </button>
            </section>
        }
    </div>

    @if (_linkDialogOpen && !ReadOnly)
    {
        <section class="tm-document-editor__link-dialog" data-testid="document-link-dialog">
            <label>
                <span>@Loc["TmDocumentEditor_LinkUrl"]</span>
                <input value="@_pendingLinkUrl" @oninput="args => _pendingLinkUrl = args.Value?.ToString()" data-testid="document-link-url" />
            </label>
            <label>
                <span>@Loc["TmDocumentEditor_LinkTitle"]</span>
                <input value="@_pendingLinkTitle" @oninput="args => _pendingLinkTitle = args.Value?.ToString()" data-testid="document-link-title" />
            </label>
            @if (!string.IsNullOrWhiteSpace(_linkError))
            {
                <span class="tm-document-editor__link-error" role="alert" data-testid="document-link-error">@_linkError</span>
            }
            <button type="button" @onclick="ApplyLinkAsync" data-testid="document-apply-link">@Loc["TmDocumentEditor_ApplyLink"]</button>
            <button type="button" @onclick="CloseLinkDialog">@Loc["TmDocumentEditor_Cancel"]</button>
        </section>
    }
    @if (_docxImportOpen && CanImportDocx)
    {
        <section class="tm-document-editor__format-import-panel"
                 aria-label="@Loc["TmDocumentEditor_FormatImportPanelLabel"]"
                 data-testid="document-import-docx-panel">
            <TmFileDropZone Multiple="false"
                            MaxFileCount="1"
                            Accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                            Disabled="@IsImportingDocx"
                            Class="tm-document-editor__format-drop-zone"
                            InputTestId="document-import-docx"
                            InputAriaLabel="@Loc["TmDocumentEditor_ImportDocxDropZoneAria"]"
                            OnFilesSelected="HandleDocxImportSelectedAsync">
                <div class="tm-document-editor__format-drop-zone-content">
                    <TmIcon Name="upload" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_ImportDocxDropZone"]</span>
                </div>
            </TmFileDropZone>
        </section>
    }
</header>

@code {
    private DocumentRibbonTab _activeRibbonTab = DocumentRibbonTab.Home;
