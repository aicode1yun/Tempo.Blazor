            _pageLayoutInspectorOpen = false;
            _focusPageLayoutInspectorOnRender = false;
        }
    }

    private async Task InsertImageFromUrlAsync()
    {
        _imageInsertMenuOpen = false;
        if (OnInsertImageUrl.HasDelegate)
        {
            await ExecuteToolbarCommandAsync("insertImage", OnInsertImageUrl);
            return;
        }

        await ExecuteToolbarCommandAsync("insertImage", OnInsertImage);
    }

    private async Task InsertImageFromUploadAsync()
    {
        if (!CanUploadImages)
        {
            return;
        }

        _imageInsertMenuOpen = false;
        if (OnInsertImageUpload.HasDelegate)
        {
            await ExecuteToolbarCommandAsync("insertImage", OnInsertImageUpload);
            return;
        }

        await ExecuteToolbarCommandAsync("insertImage", OnInsertImage);
    }

    private async Task InsertImageFromAssetAsync()
    {
        if (!CanBrowseImageAssets)
        {
            return;
        }

        _imageInsertMenuOpen = false;
        if (OnInsertImageAsset.HasDelegate)
        {
            await ExecuteToolbarCommandAsync("insertImage", OnInsertImageAsset);
            return;
        }

        await ExecuteToolbarCommandAsync("insertImage", OnInsertImage);
    }

    private async Task ToggleLinkDialogAsync()
    {
        if (_linkDialogOpen)
        {
            CloseLinkDialog();
            return;
        }

        await OpenLinkDialogAsync();
    }

    /// <summary>Opens the link dialog and focuses its URL field on the next render.</summary>
    public async Task OpenLinkDialogAsync()
    {
        if (ReadOnly)
        {
            return;
        }

        _linkError = null;
        var info = LinkInfoProvider is null ? null : await LinkInfoProvider.Invoke();
        _pendingLinkUrl = info?.Href;
        _pendingLinkTitle = info?.Title;
        _linkDialogOpen = true;
        _focusLinkUrlOnRender = true;
    }

    private void ToggleDocxImportPanel()
    {
        if (!IsCommandEnabled("importDocx", CanImportDocx && !IsImportingDocx))
        {
            return;
        }

        _docxImportOpen = !_docxImportOpen;
    }

    private Task ToggleDocxImportPanelAsync()
    {
        ToggleDocxImportPanel();
        return Task.CompletedTask;
    }

    private void CloseLinkDialog()
    {
        _linkDialogOpen = false;
        _focusLinkUrlOnRender = false;
        _linkError = null;
    }

    private void HandleLinkDialogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseLinkDialog();
        }
    }

    private async Task ApplyLinkAsync()
    {
        var href = DocumentLinkUtility.NormalizeHref(_pendingLinkUrl);
        if (!DocumentLinkUtility.IsSafeHref(href))
        {
            _linkError = Loc["TmDocumentEditor_LinkInvalidUrl"];
            return;
        }

        var payload = new WysiwygLinkPayload
        {
            Href = href,
            Title = string.IsNullOrWhiteSpace(_pendingLinkTitle) ? null : _pendingLinkTitle.Trim()
        };

        if (OnLinkApplied.HasDelegate)
        {
            await OnLinkApplied.InvokeAsync(payload);
        }
        else
        {
            await OnLink.InvokeAsync(payload.Href);
        }

        _pendingLinkUrl = null;
        _pendingLinkTitle = null;
        _linkError = null;
        _linkDialogOpen = false;
    }

    private async Task RemoveLinkAsync()
    {
        if (!OnLinkRemoved.HasDelegate)
        {
            return;
        }

        await OnLinkRemoved.InvokeAsync();
        _pendingLinkUrl = null;
        _pendingLinkTitle = null;
        _linkError = null;
        _linkDialogOpen = false;
    }

    private async Task HandleDocxImportSelectedAsync(InputFileChangeEventArgs args)
    {
        if (!IsCommandEnabled("importDocx", CanImportDocx && !IsImportingDocx))
        {
            return;
        }

        await OnImportDocx.InvokeAsync(args);
        _docxImportOpen = false;
    }

    private enum DocumentRibbonTab
    {
        Home,
        Insert,
        Layout,
        References,
        Review,
        View,
        HeaderFooter
    }

