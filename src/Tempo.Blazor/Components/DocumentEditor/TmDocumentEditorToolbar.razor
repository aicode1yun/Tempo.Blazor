        "insertTable"    => Loc["TmDocumentEditor_InsertTable"],
        "insertImage"    => Loc["TmDocumentEditor_InsertImage"],
        "insertPageBreak"=> Loc["TmDocumentEditor_PageBreak"],
        "insertFootnote" => Loc["TmDocumentEditor_InsertFootnote"],
        "insertEndnote"  => Loc["TmDocumentEditor_InsertEndnote"],
        "importDocx"     => Loc["TmDocumentEditor_ImportDocx"],
        "insertMenu"     => Loc["TmDocumentEditor_Insert"],
        "trackChanges"   => Loc["TmDocumentEditor_TrackChanges"],
        "addComment"     => Loc["TmDocumentEditor_AddComment"],
        "openComments"   => Loc["TmDocumentEditor_Comments"],
        "openRevisions"  => Loc["TmDocumentEditor_Revisions"],
        "compareDocuments" => Loc["TmDocumentEditor_CompareDocuments"],
        "protectDocument" => Loc["TmDocumentEditor_ProtectDocument"],
        "markEditableRegion" => Loc["TmDocumentEditor_MarkEditableRegion"],
        "showRuler"      => Loc["TmDocumentEditor_ShowRuler"],
        "showBlocks"     => Loc["TmDocumentEditor_ShowBlocks"],
        "toggleNonPrintingCharacters" => Loc["TmDocumentEditor_NonPrintingCharacters"],
        "fullscreen"     => Loc["TmDocumentEditor_Fullscreen"],
