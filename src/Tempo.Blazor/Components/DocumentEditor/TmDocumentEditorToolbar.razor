    private void SelectRibbonTab(DocumentRibbonTab tab)
    {
        if (tab == DocumentRibbonTab.HeaderFooter && !IsHeaderFooterMode)
        {
            return;
        }

        _activeRibbonTab = tab;
    }

    private void HandleRibbonTabKeyDown(KeyboardEventArgs args, DocumentRibbonTab currentTab)
    {
        var tabs = RibbonTabs.ToArray();
        var currentIndex = Array.IndexOf(tabs, currentTab);
        if (currentIndex < 0)
        {
            currentIndex = Array.IndexOf(tabs, _activeRibbonTab);
        }

        var nextIndex = args.Key switch
        {
            "ArrowRight" => (currentIndex + 1) % tabs.Length,
            "ArrowLeft" => (currentIndex - 1 + tabs.Length) % tabs.Length,
            "Home" => 0,
            "End" => tabs.Length - 1,
            _ => -1
        };

        if (nextIndex >= 0)
        {
            SelectRibbonTab(tabs[nextIndex]);
        }
    }

