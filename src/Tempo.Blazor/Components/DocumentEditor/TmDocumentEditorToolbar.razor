    private string GetAlignmentButtonClass(DocumentTextAlignment alignment)
    {
        var effectiveAlignment = GetEffectiveParagraphAlignment();
        if (_optimisticParagraphAlignment is null && ParagraphAlignmentMixed)
        {
            return "tm-document-editor__ribbon-button tm-document-editor__ribbon-button--mixed";
        }

        return effectiveAlignment == alignment
            ? "tm-document-editor__ribbon-button tm-document-editor__ribbon-button--active"
            : "tm-document-editor__ribbon-button";
    }

    private string GetAlignmentAriaPressed(DocumentTextAlignment alignment)
    {
        var effectiveAlignment = GetEffectiveParagraphAlignment();
        if (_optimisticParagraphAlignment is null && ParagraphAlignmentMixed)
        {
            return "mixed";
        }

        return effectiveAlignment == alignment ? "true" : "false";
    }

    private DocumentTextAlignment GetEffectiveParagraphAlignment()
    {
        if (_optimisticParagraphAlignment is not null
            && DateTimeOffset.UtcNow <= _optimisticParagraphAlignmentExpiresAt)
        {
            return _optimisticParagraphAlignment.Value;
        }

        _optimisticParagraphAlignment = null;
        return ParagraphAlignment;
    }

    private double GetEffectiveLineSpacing()
    {
        if (_optimisticLineSpacing is not null
            && DateTimeOffset.UtcNow <= _optimisticLineSpacingExpiresAt)
        {
            return _optimisticLineSpacing.Value;
        }

        _optimisticLineSpacing = null;
        return CurrentLineSpacing;
    }

    private static string NormalizeFontSizeValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "11";
        }

        var normalized = value.Trim().Replace("pt", string.Empty, StringComparison.OrdinalIgnoreCase);
        return double.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out var size)
            ? size.ToString("0.##", CultureInfo.InvariantCulture)
            : "11";
    }

    private static string NormalizeLineSpacingValue(double value)
        => value <= 0
            ? "1"
            : value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string NormalizeColorValue(string? value, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        var trimmed = value.Trim();
        if (!trimmed.StartsWith('#'))
        {
            trimmed = $"#{trimmed}";
        }

        if (trimmed.Length == 4 && trimmed.Skip(1).All(Uri.IsHexDigit))
        {
            return $"#{trimmed[1]}{trimmed[1]}{trimmed[2]}{trimmed[2]}{trimmed[3]}{trimmed[3]}".ToLowerInvariant();
        }

        return trimmed.Length == 7 && trimmed.Skip(1).All(Uri.IsHexDigit)
            ? trimmed.ToLowerInvariant()
            : fallback;
    }

