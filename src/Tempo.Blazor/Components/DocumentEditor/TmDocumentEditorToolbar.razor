@namespace Tempo.Blazor.Components.DocumentEditor
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Files
@using Tempo.Blazor.Components.DocumentEditor.Features
@using Tempo.Blazor.Components.DocumentEditor.Registry
@using Tempo.Blazor.DocumentEditor.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

<header class="@ToolbarClass"
        role="toolbar"
        aria-label="@Loc["TmDocumentEditor_ToolbarLabel"]"
        hidden="@(ToolbarMode == DocumentToolbarMode.DistractionFree)"
        data-testid="document-toolbar"
        data-keyboard-mode="@_keyboardMode.ToString().ToLowerInvariant()"
        data-toolbar-mode="@ToolbarMode.ToString()">
    <div class="tm-document-editor__ribbon-tabs" role="tablist" aria-label="@Loc["TmDocumentEditor_ToolbarTabsLabel"]">
        <button type="button"
                @ref="_homeTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Home)"
                id="@GetRibbonTabId(DocumentRibbonTab.Home)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Home)"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Home)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Home)"
                @onkeydown="args => HandleRibbonTabKeyDown(args, DocumentRibbonTab.Home)"
                data-testid="document-ribbon-tab-home">@Loc["TmDocumentEditor_TabHome"]</button>
        <button type="button"
                @ref="_insertTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Insert)"
                id="@GetRibbonTabId(DocumentRibbonTab.Insert)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Insert)"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Insert)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Insert)"
                @onkeydown="args => HandleRibbonTabKeyDown(args, DocumentRibbonTab.Insert)"
                data-testid="document-ribbon-tab-insert">@Loc["TmDocumentEditor_TabInsert"]</button>
        <button type="button"
                @ref="_layoutTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Layout)"
                id="@GetRibbonTabId(DocumentRibbonTab.Layout)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Layout)"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Layout)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Layout)"
                @onkeydown="args => HandleRibbonTabKeyDown(args, DocumentRibbonTab.Layout)"
                data-testid="document-ribbon-tab-layout">@Loc["TmDocumentEditor_TabLayout"]</button>
        <button type="button"
                @ref="_referencesTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.References)"
                id="@GetRibbonTabId(DocumentRibbonTab.References)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.References)"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.References)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.References)"
                @onkeydown="args => HandleRibbonTabKeyDown(args, DocumentRibbonTab.References)"
                data-testid="document-ribbon-tab-references">@Loc["TmDocumentEditor_TabReferences"]</button>
        <button type="button"
                @ref="_reviewTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.Review)"
                id="@GetRibbonTabId(DocumentRibbonTab.Review)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.Review)"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.Review)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.Review)"
                @onkeydown="args => HandleRibbonTabKeyDown(args, DocumentRibbonTab.Review)"
                data-testid="document-ribbon-tab-review">@Loc["TmDocumentEditor_TabReview"]</button>
        <button type="button"
                @ref="_viewTab"
                class="@GetRibbonTabClass(DocumentRibbonTab.View)"
                id="@GetRibbonTabId(DocumentRibbonTab.View)"
                role="tab"
                aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.View)"
                tabindex="@GetRibbonTabIndex(DocumentRibbonTab.View)"
                @onclick="() => SelectRibbonTab(DocumentRibbonTab.View)"
                @onkeydown="args => HandleRibbonTabKeyDown(args, DocumentRibbonTab.View)"
                data-testid="document-ribbon-tab-view">@Loc["TmDocumentEditor_TabView"]</button>
        @if (IsHeaderFooterMode)
        {
            <button type="button"
                    @ref="_headerFooterTab"
                    class="@GetRibbonTabClass(DocumentRibbonTab.HeaderFooter)"
                    id="@GetRibbonTabId(DocumentRibbonTab.HeaderFooter)"
                    role="tab"
                    aria-selected="@GetRibbonTabSelected(DocumentRibbonTab.HeaderFooter)"
                    tabindex="@GetRibbonTabIndex(DocumentRibbonTab.HeaderFooter)"
                    @onclick="() => SelectRibbonTab(DocumentRibbonTab.HeaderFooter)"
                    @onkeydown="args => HandleRibbonTabKeyDown(args, DocumentRibbonTab.HeaderFooter)"
                    data-testid="document-ribbon-tab-header-footer">@Loc["TmDocumentEditor_TabHeaderFooter"]</button>
        }
    </div>

    <div class="tm-document-editor__ribbon-commands-wrapper">
    <div class="tm-document-editor__ribbon-groups" role="tabpanel" aria-labelledby="@GetRibbonTabId(_activeRibbonTab)" @ref="_ribbonGroupsRef">
        @if (_activeRibbonTab == DocumentRibbonTab.Home)
        {
            <section class="tm-document-editor__ribbon-group" aria-label="@Loc["TmDocumentEditor_GroupClipboard"]">
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@(!CanExecuteSave)"
                        title="@SaveTitle"
                        aria-label="@SaveTitle"
                        @onclick='() => ExecuteToolbarCommandAsync("save", OnSave, !ReadOnly && !IsSaving)'
                        data-command="save"
                        data-testid="document-save">
                    <TmIcon Name="save" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Save"]</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@(!CanExecuteUndo)"
                        title="@UndoTitle"
                        aria-label="@UndoTitle"
                        @onclick='() => ExecuteToolbarCommandAsync("undo", OnUndo, !ReadOnly && CanUndo)'
                        data-command="undo"
                        data-testid="document-undo">
                    <TmIcon Name="undo-2" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Undo"]</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@(!CanExecuteRedo)"
                        title="@RedoTitle"
                        aria-label="@RedoTitle"
                        @onclick='() => ExecuteToolbarCommandAsync("redo", OnRedo, !ReadOnly && CanRedo)'
                        data-command="redo"
                        data-testid="document-redo">
                    <TmIcon Name="redo-2" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Redo"]</span>
                </button>
            </section>

            <section class="tm-document-editor__ribbon-group" aria-label="@Loc["TmDocumentEditor_GroupFormatting"]">
                <label class="tm-document-editor__ribbon-select" title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontFamily"]))">
                    <TmIcon Name="type" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_FontFamily"]</span>
                    <select disabled="@(!IsCommandEnabled("fontFamily"))"
                            value="@CurrentFontFamily"
                            title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontFamily"]))"
                            aria-label="@Loc["TmDocumentEditor_FontFamily"]"
                            @onchange="HandleFontFamilyChangedAsync"
                            data-testid="document-font-family">
                        <option value="">@Loc["TmDocumentEditor_FontFamilyDefault"]</option>
                        @foreach (var font in FontFamilies)
                        {
                            <option value="@font.CssFamily">@font.DisplayName</option>
                        }
                    </select>
                </label>
                <label class="tm-document-editor__ribbon-select tm-document-editor__ribbon-select--compact" title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontSize"]))">
                    <span>@Loc["TmDocumentEditor_FontSize"]</span>
                    <select disabled="@(!IsCommandEnabled("fontSize"))"
                            value="@NormalizeFontSizeValue(CurrentFontSize)"
                            title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontSize"]))"
                            aria-label="@Loc["TmDocumentEditor_FontSize"]"
                            @onchange="HandleFontSizeChangedAsync"
                            data-testid="document-font-size">
                        @foreach (var size in FontSizes)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </label>
                <button class="@GetFormattingButtonClass(BoldState)"
                        type="button"
                        disabled="@(!IsCommandEnabled("bold"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Bold"]))"
                        aria-label="@Loc["TmDocumentEditor_Bold"]"
                        aria-pressed="@GetRegistryFormattingAriaPressed("bold", BoldState)"
                        @onclick='() => ExecuteToolbarCommandAsync("bold", OnBold)'
                        @onpointerdown:preventDefault="true"
                        @onmousedown:preventDefault="true"
                        data-command="bold"
                        data-testid="document-bold">
                    <TmIcon Name="bold" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Bold"]</span>
                </button>
                <button class="@GetFormattingButtonClass(ItalicState)"
                        type="button"
                        disabled="@(!IsCommandEnabled("italic"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Italic"]))"
                        aria-label="@Loc["TmDocumentEditor_Italic"]"
                        aria-pressed="@GetRegistryFormattingAriaPressed("italic", ItalicState)"
                        @onclick='() => ExecuteToolbarCommandAsync("italic", OnItalic)'
                        @onpointerdown:preventDefault="true"
                        @onmousedown:preventDefault="true"
                        data-command="italic"
                        data-testid="document-italic">
                    <TmIcon Name="italic" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Italic"]</span>
                </button>
                <button class="@GetFormattingButtonClass(UnderlineState)"
                        type="button"
                        disabled="@(!IsCommandEnabled("underline"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Underline"]))"
                        aria-label="@Loc["TmDocumentEditor_Underline"]"
                        aria-pressed="@GetRegistryFormattingAriaPressed("underline", UnderlineState)"
                        @onclick='() => ExecuteToolbarCommandAsync("underline", OnUnderline)'
                        @onpointerdown:preventDefault="true"
                        @onmousedown:preventDefault="true"
                        data-command="underline"
                        data-testid="document-underline">
                    <TmIcon Name="underline" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Underline"]</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@(!IsCommandEnabled("link"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Link"]))"
                        @onclick='() => ExecuteToolbarCommandAsync("link", ToggleLinkDialogAsync)'
                        @onpointerdown:preventDefault="true"
                        @onmousedown:preventDefault="true"
                        data-command="link"
                        data-testid="document-link">
                    <TmIcon Name="link" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Link"]</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@(!IsCommandEnabled("clearFormatting"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_ClearFormatting"]))"
                        @onclick='() => ExecuteToolbarCommandAsync("clearFormatting", OnClearFormatting)'
                        @onpointerdown:preventDefault="true"
                        @onmousedown:preventDefault="true"
                        data-command="clearFormatting"
                        data-testid="document-clear-formatting">
                    <TmIcon Name="eraser" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_ClearFormatting"]</span>
                </button>
                <div class="tm-document-editor__ribbon-color-picker"
                     title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_FontColor"]))">
                    <TmColorPicker Value="@NormalizeColorValue(CurrentTextColor, "#111827")"
                                   ValueChanged="HandleTextColorAppliedAsync"
                                   Format="ColorFormat.Hex"
                                   ShowAlpha="false"
                                   ShowPalette="true"
                                   ShowClearButton="false"
                                   ShowApplyButton="true"
                                   ShowCancelButton="true"
                                   Disabled="@(!IsCommandEnabled("textColor"))"
                                   Placeholder="@Loc["TmDocumentEditor_FontColor"]"
                                   ApplyText="@Loc["TmDocumentEditor_ApplyColor"]"
                                   CancelText="@Loc["TmDocumentEditor_CancelColor"]"
                                   Class="@GetTempoColorPickerClass(TextColorMixed)"
                                   data-testid="document-font-color-trigger" />
                </div>
                <div class="tm-document-editor__ribbon-color-picker"
                     title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_HighlightColor"]))">
                    <TmColorPicker Value="@NormalizeColorValue(CurrentHighlightColor, "#ffffff")"
                                   ValueChanged="HandleHighlightColorAppliedAsync"
                                   Format="ColorFormat.Hex"
                                   ShowAlpha="false"
                                   ShowPalette="true"
                                   ShowClearButton="false"
                                   ShowApplyButton="true"
                                   ShowCancelButton="true"
                                   Disabled="@(!IsCommandEnabled("highlightColor"))"
                                   Placeholder="@Loc["TmDocumentEditor_HighlightColor"]"
                                   ApplyText="@Loc["TmDocumentEditor_ApplyColor"]"
                                   CancelText="@Loc["TmDocumentEditor_CancelColor"]"
                                   Class="@GetTempoColorPickerClass(HighlightColorMixed)"
                                   data-testid="document-highlight-color-trigger" />
                </div>
            </section>

            <section class="tm-document-editor__ribbon-group" aria-label="@Loc["TmDocumentEditor_GroupParagraph"]">
                <button class="@GetAlignmentButtonClass(DocumentTextAlignment.Left)"
                        type="button"
                        disabled="@(!IsCommandEnabled("paragraphAlignment"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_AlignLeft"]))"
                        aria-pressed="@GetAlignmentAriaPressed(DocumentTextAlignment.Left)"
                        @onclick="() => HandleParagraphAlignmentClickedAsync(DocumentTextAlignment.Left)"
                        data-command="alignLeft"
                        data-testid="document-align-left">
                    <TmIcon Name="align-left" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_AlignLeft"]</span>
                </button>
                <button class="@GetAlignmentButtonClass(DocumentTextAlignment.Center)"
                        type="button"
                        disabled="@(!IsCommandEnabled("paragraphAlignment"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_AlignCenter"]))"
                        aria-pressed="@GetAlignmentAriaPressed(DocumentTextAlignment.Center)"
                        @onclick="() => HandleParagraphAlignmentClickedAsync(DocumentTextAlignment.Center)"
                        data-command="alignCenter"
                        data-testid="document-align-center">
                    <TmIcon Name="align-center" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_AlignCenter"]</span>
                </button>
                <button class="@GetAlignmentButtonClass(DocumentTextAlignment.Right)"
                        type="button"
                        disabled="@(!IsCommandEnabled("paragraphAlignment"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_AlignRight"]))"
                        aria-pressed="@GetAlignmentAriaPressed(DocumentTextAlignment.Right)"
                        @onclick="() => HandleParagraphAlignmentClickedAsync(DocumentTextAlignment.Right)"
                        data-command="alignRight"
                        data-testid="document-align-right">
                    <TmIcon Name="align-right" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_AlignRight"]</span>
                </button>
                <button class="@GetAlignmentButtonClass(DocumentTextAlignment.Justify)"
                        type="button"
                        disabled="@(!IsCommandEnabled("paragraphAlignment"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_AlignJustify"]))"
                        aria-pressed="@GetAlignmentAriaPressed(DocumentTextAlignment.Justify)"
                        @onclick="() => HandleParagraphAlignmentClickedAsync(DocumentTextAlignment.Justify)"
                        data-command="alignJustify"
                        data-testid="document-align-justify">
                    <TmIcon Name="align-justify" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_AlignJustify"]</span>
                </button>
                <label class="tm-document-editor__ribbon-select tm-document-editor__ribbon-select--compact" title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_LineSpacing"]))">
                    <TmIcon Name="pilcrow" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_LineSpacing"]</span>
                    <select disabled="@(!IsCommandEnabled("lineSpacing"))"
                            value="@NormalizeLineSpacingValue(GetEffectiveLineSpacing())"
                            title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_LineSpacing"]))"
                            aria-label="@Loc["TmDocumentEditor_LineSpacing"]"
                            @onchange="HandleLineSpacingChangedAsync"
                            data-testid="document-line-spacing">
                        @foreach (var spacing in LineSpacingOptions)
                        {
                            <option value="@spacing.ToString("0.##", CultureInfo.InvariantCulture)">@spacing.ToString("0.##", CultureInfo.InvariantCulture)</option>
                        }
                    </select>
                </label>
                <label class="tm-document-editor__ribbon-select tm-document-editor__ribbon-select--compact" title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_SpacingBefore"]))">
                    <span>@Loc["TmDocumentEditor_SpacingBefore"]</span>
                    <select disabled="@(!IsCommandEnabled("lineSpacing"))"
                            title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_SpacingBefore"]))"
                            aria-label="@Loc["TmDocumentEditor_SpacingBefore"]"
                            @onchange="HandleSpacingBeforeChangedAsync"
                            data-testid="document-spacing-before">
                        @foreach (var spacing in ParagraphSpacingOptions)
                        {
                            <option value="@spacing">@spacing</option>
                        }
                    </select>
                </label>
                <label class="tm-document-editor__ribbon-select tm-document-editor__ribbon-select--compact" title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_SpacingAfter"]))">
                    <span>@Loc["TmDocumentEditor_SpacingAfter"]</span>
                    <select disabled="@(!IsCommandEnabled("lineSpacing"))"
                            title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_SpacingAfter"]))"
                            aria-label="@Loc["TmDocumentEditor_SpacingAfter"]"
                            @onchange="HandleSpacingAfterChangedAsync"
                            data-testid="document-spacing-after">
                        @foreach (var spacing in ParagraphSpacingOptions)
                        {
                            <option value="@spacing">@spacing</option>
                        }
                    </select>
                </label>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@(!IsCommandEnabled("decreaseIndent"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_DecreaseIndent"]))"
                        @onclick="OnDecreaseIndent"
                        data-command="decreaseIndent"
                        data-testid="document-decrease-indent">
                    <TmIcon Name="indent-decrease" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_DecreaseIndent"]</span>
                </button>
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@(!IsCommandEnabled("increaseIndent"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_IncreaseIndent"]))"
                        @onclick="OnIncreaseIndent"
                        data-command="increaseIndent"
                        data-testid="document-increase-indent">
                    <TmIcon Name="indent-increase" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_IncreaseIndent"]</span>
                </button>
            </section>
        }
        else if (_activeRibbonTab == DocumentRibbonTab.Insert)
        {
            <section class="tm-document-editor__ribbon-group" aria-label="@Loc["TmDocumentEditor_GroupInsert"]">
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@(!IsCommandEnabled("insertMenu"))"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_Insert"]))"
                        @onclick='() => ExecuteToolbarCommandAsync("insertMenu", OnToggleInsert)'
                        data-testid="document-insert-menu">
                    <TmIcon Name="plus" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_Insert"]</span>
                </button>
                @if (IsFeatureEnabled(DocumentEditorFeatureNames.Table))
                {
                    <div class="tm-document-table-grid-picker-wrapper">
                        <button class="@($"tm-document-editor__ribbon-button{(_tableGridPickerOpen ? " tm-document-editor__ribbon-button--active" : "")}")"
                                type="button"
                                disabled="@(!IsCommandEnabled("insertTable"))"
                                title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_InsertTable"]))"
                                aria-haspopup="grid"
                                aria-expanded="@_tableGridPickerOpen.ToString().ToLowerInvariant()"
                                @onclick="ToggleTableGridPicker"
                                @onpointerdown:preventDefault="true"
                                @onmousedown:preventDefault="true"
                                data-command="insertTable"
                                data-testid="document-toolbar-table">
                            <TmIcon Name="table" Size="IconSize.Sm" />
                            <span>@Loc["TmDocumentEditor_InsertTable"]</span>
                        </button>
                        @if (_tableGridPickerOpen)
                        {
                            <TmDocumentTableGridPicker OnInsert="HandleGridPickerInsertAsync"
                                                       OnClose="CloseTableGridPicker" />
                        }
                    </div>
                }
                @if (IsFeatureEnabled(DocumentEditorFeatureNames.Image))
                {
                    <div class="tm-document-image-insert-menu-wrapper">
                        <button class="@($"tm-document-editor__ribbon-button{(_imageInsertMenuOpen ? " tm-document-editor__ribbon-button--active" : "")}")"
                                type="button"
                                disabled="@(!IsCommandEnabled("insertImage"))"
                                title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_InsertImage"]))"
                                aria-haspopup="menu"
                                aria-expanded="@_imageInsertMenuOpen.ToString().ToLowerInvariant()"
                                @onclick="ToggleImageInsertMenu"
                                data-command="insertImage"
                                data-testid="document-toolbar-image">
                            <TmIcon Name="image" Size="IconSize.Sm" />
                            <span>@Loc["TmDocumentEditor_InsertImage"]</span>
                        </button>
                        @if (_imageInsertMenuOpen)
                        {
                            <div class="tm-document-image-insert-menu"
                                 role="menu"
                                 aria-label="@Loc["TmDocumentEditor_ImageInsertMenu"]"
                                 data-testid="document-image-insert-menu">
                                <button type="button"
                                        role="menuitem"
                                        data-testid="document-image-insert-url"
                                        @onclick="InsertImageFromUrlAsync">
                                    <TmIcon Name="link" Size="IconSize.Sm" />
                                    <span>@Loc["TmDocumentEditor_ImageInsertUrl"]</span>
                                </button>
                                <button type="button"
                                        role="menuitem"
                                        disabled="@(!CanUploadImages)"
                                        title="@(CanUploadImages ? Loc["TmDocumentEditor_UploadImage"] : Loc["TmDocumentEditor_ImageProviderMissing"])"
                                        data-testid="document-image-insert-upload"
                                        @onclick="InsertImageFromUploadAsync">
                                    <TmIcon Name="upload" Size="IconSize.Sm" />
                                    <span>@Loc["TmDocumentEditor_UploadImage"]</span>
                                </button>
                                @if (CanBrowseImageAssets)
                                {
                                    <button type="button"
                                            role="menuitem"
                                            title="@Loc["TmDocumentEditor_ImageInsertAsset"]"
                                            data-testid="document-image-insert-asset"
                                            @onclick="InsertImageFromAssetAsync">
                                        <TmIcon Name="images" Size="IconSize.Sm" />
                                        <span>@Loc["TmDocumentEditor_ImageInsertAsset"]</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                @if (CommandRegistry?.GetState("insertPageBreak")?.IsVisible ?? true)
                {
                    <button class="tm-document-editor__ribbon-button"
                            type="button"
                            disabled="@(!IsCommandEnabled("insertPageBreak"))"
                            title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_PageBreak"]))"
                            @onclick='() => ExecuteToolbarCommandAsync("insertPageBreak", OnInsertPageBreak)'
                            data-command="insertPageBreak"
                            data-testid="document-insert-page-break">
                        <TmIcon Name="between-horizontal-start" Size="IconSize.Sm" />
                        <span>@Loc["TmDocumentEditor_PageBreak"]</span>
                    </button>
                }
            </section>
        }
        else if (_activeRibbonTab == DocumentRibbonTab.Layout)
        {
            <section class="tm-document-editor__ribbon-group" aria-label="@Loc["TmDocumentEditor_GroupLayout"]">
                <button class="tm-document-editor__ribbon-button"
                        type="button"
                        disabled="@ReadOnly"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_PageLayout"]))"
                        data-testid="document-page-layout">
                    <TmIcon Name="panel-top" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_PageLayout"]</span>
                </button>
                <button class="@GetToggleButtonClass(DifferentFirstPage)"
                        type="button"
                        disabled="@ReadOnly"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_DifferentFirstPage"]))"
                        aria-pressed="@DifferentFirstPage.ToString().ToLowerInvariant()"
                        @onclick="ToggleDifferentFirstPageAsync"
                        data-testid="document-different-first-page">
                    <TmIcon Name="panel-top" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_DifferentFirstPage"]</span>
                </button>
                <button class="@GetToggleButtonClass(DifferentOddAndEvenPages)"
                        type="button"
                        disabled="@ReadOnly"
                        title="@(GetEditingCommandTitle(Loc["TmDocumentEditor_DifferentOddEven"]))"
                        aria-pressed="@DifferentOddAndEvenPages.ToString().ToLowerInvariant()"
                        @onclick="ToggleDifferentOddEvenAsync"
                        data-testid="document-different-odd-even">
                    <TmIcon Name="layout" Size="IconSize.Sm" />
                    <span>@Loc["TmDocumentEditor_DifferentOddEven"]</span>
                </button>
            </section>
        }
        else if (_activeRibbonTab == DocumentRibbonTab.References)
        {
            <section class="tm-document-editor__ribbon-group" aria-label="@Loc["TmDocumentEditor_GroupReferences"]">
                <button class="tm-document-editor__ribbon-button"
                        type="button"
