    /// <summary>Raised when paragraph alignment changes.</summary>
    [Parameter] public EventCallback<DocumentTextAlignment> OnParagraphAlignmentChanged { get; set; }

    /// <summary>Raised when line spacing changes.</summary>
    [Parameter] public EventCallback<double> OnLineSpacingChanged { get; set; }

