    private bool CanExecuteSave => !ReadOnly && !IsSaving;

    private bool CanExecuteUndo => !ReadOnly && CanUndo;

    private bool CanExecuteRedo => !ReadOnly && CanRedo;

    private string SaveTitle => ReadOnly
        ? GetCommandTitle(Loc["TmDocumentEditor_Save"], canExecute: false, Loc["TmDocumentEditor_CommandDisabledReadOnly"])
        : GetCommandTitle(Loc["TmDocumentEditor_Save"], !IsSaving, Loc["TmDocumentEditor_CommandDisabledBusy"]);

    private string UndoTitle => GetUndoRedoTitle(
        Loc["TmDocumentEditor_Undo"],
        CanUndo,
        NextUndoDescription);

    private string RedoTitle => GetUndoRedoTitle(
        Loc["TmDocumentEditor_Redo"],
        CanRedo,
        NextRedoDescription);

    private bool IsHeaderFooterMode
        => string.Equals(ActiveRegion, "Header", StringComparison.OrdinalIgnoreCase)
            || string.Equals(ActiveRegion, "Footer", StringComparison.OrdinalIgnoreCase);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (IsHeaderFooterMode && !_wasHeaderFooterMode)
        {
            _activeRibbonTab = DocumentRibbonTab.HeaderFooter;
        }
        else if (!IsHeaderFooterMode && _activeRibbonTab == DocumentRibbonTab.HeaderFooter)
        {
            _activeRibbonTab = DocumentRibbonTab.Home;
        }

        _wasHeaderFooterMode = IsHeaderFooterMode;
    }

    private bool IsActiveRibbonTab(DocumentRibbonTab tab) => _activeRibbonTab == tab;

    private string GetRibbonTabSelected(DocumentRibbonTab tab) => IsActiveRibbonTab(tab) ? "true" : "false";

    private string GetRibbonTabIndex(DocumentRibbonTab tab) => IsActiveRibbonTab(tab) ? "0" : "-1";

    private static string GetRibbonTabId(DocumentRibbonTab tab)
        => $"tm-document-ribbon-tab-{tab.ToString().ToLowerInvariant()}";

    private ElementReference GetActiveTabReference()
    {
        return _activeRibbonTab switch
        {
            DocumentRibbonTab.Insert => _insertTab,
            DocumentRibbonTab.Layout => _layoutTab,
            DocumentRibbonTab.References => _referencesTab,
            DocumentRibbonTab.Review => _reviewTab,
            DocumentRibbonTab.View => _viewTab,
            DocumentRibbonTab.HeaderFooter when IsHeaderFooterMode => _headerFooterTab,
            _ => _homeTab
        };
    }

    private string GetRibbonTabClass(DocumentRibbonTab tab)
        => IsActiveRibbonTab(tab)
            ? "tm-document-editor__ribbon-tab tm-document-editor__ribbon-tab--active"
            : "tm-document-editor__ribbon-tab";

    private string GetCommandTitle(string label, bool canExecute, string? reason)
    {
        if (canExecute)
        {
            return label;
        }

        return string.IsNullOrWhiteSpace(reason)
            ? $"{label}: {Loc["TmDocumentEditor_CommandDisabledUnavailable"]}"
            : $"{label}: {reason}";
    }

    private string GetEditingCommandTitle(string label, bool canExecute = true, string? reason = null)
    {
        if (ReadOnly)
        {
            return GetCommandTitle(label, canExecute: false, Loc["TmDocumentEditor_CommandDisabledReadOnly"]);
        }

        return GetCommandTitle(label, canExecute, reason);
    }

    private string GetUndoRedoTitle(string label, bool canExecute, string? description)
    {
        if (ReadOnly)
        {
            return GetCommandTitle(label, canExecute: false, Loc["TmDocumentEditor_CommandDisabledReadOnly"]);
        }

        if (!canExecute)
        {
            return GetCommandTitle(label, canExecute: false, Loc["TmDocumentEditor_CommandDisabledUnavailable"]);
        }

        return string.IsNullOrWhiteSpace(description)
            ? label
            : $"{label}: {description}";
    }

    private static string GetFormattingButtonClass(WysiwygFormattingValue state)
    {
        return state switch
        {
            WysiwygFormattingValue.Active => "tm-document-editor__ribbon-button tm-document-editor__ribbon-button--active",
            WysiwygFormattingValue.Mixed => "tm-document-editor__ribbon-button tm-document-editor__ribbon-button--mixed",
            _ => "tm-document-editor__ribbon-button"
        };
    }

    private static string GetToggleButtonClass(bool active)
        => active
            ? "tm-document-editor__ribbon-button tm-document-editor__ribbon-button--active"
            : "tm-document-editor__ribbon-button";

    private static string GetFormattingAriaPressed(WysiwygFormattingValue state)
    {
        return state switch
        {
            WysiwygFormattingValue.Active => "true",
            WysiwygFormattingValue.Mixed => "mixed",
            _ => "false"
        };
    }

    private string GetAlignmentButtonClass(DocumentTextAlignment alignment)
    {
        if (ParagraphAlignmentMixed)
        {
            return "tm-document-editor__ribbon-button tm-document-editor__ribbon-button--mixed";
        }

        return ParagraphAlignment == alignment
            ? "tm-document-editor__ribbon-button tm-document-editor__ribbon-button--active"
            : "tm-document-editor__ribbon-button";
    }

    private string GetAlignmentAriaPressed(DocumentTextAlignment alignment)
    {
        if (ParagraphAlignmentMixed)
        {
            return "mixed";
        }

        return ParagraphAlignment == alignment ? "true" : "false";
    }

    private Task HandleReviewDisplayModeChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (!Enum.TryParse<DocumentReviewDisplayMode>(value, out var mode))
        {
            mode = DocumentReviewDisplayMode.AllMarkup;
        }

        return ReviewDisplayModeChanged.InvokeAsync(mode);
    }

    private Task HandleFontFamilyChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        return string.IsNullOrWhiteSpace(value)
            ? Task.CompletedTask
            : OnFontFamilyChanged.InvokeAsync(value);
    }

    private Task HandleFontSizeChangedAsync(ChangeEventArgs args)
    {
        return double.TryParse(args.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var size)
            ? OnFontSizeChanged.InvokeAsync(size)
            : Task.CompletedTask;
    }

    private Task HandleTextColorChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        return string.IsNullOrWhiteSpace(value)
            ? Task.CompletedTask
            : OnTextColorChanged.InvokeAsync(value);
    }

    private Task HandleHighlightColorChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        return string.IsNullOrWhiteSpace(value)
            ? Task.CompletedTask
            : OnHighlightColorChanged.InvokeAsync(value);
    }

    private Task HandleLineSpacingChangedAsync(ChangeEventArgs args)
    {
        return double.TryParse(args.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var spacing)
            ? OnLineSpacingChanged.InvokeAsync(spacing)
            : Task.CompletedTask;
    }

    private Task HandleSpacingBeforeChangedAsync(ChangeEventArgs args)
    {
        return double.TryParse(args.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var spacing)
            ? OnSpacingBeforeChanged.InvokeAsync(spacing)
            : Task.CompletedTask;
    }

    private Task HandleSpacingAfterChangedAsync(ChangeEventArgs args)
    {
        return double.TryParse(args.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var spacing)
            ? OnSpacingAfterChanged.InvokeAsync(spacing)
            : Task.CompletedTask;
    }

    private void SelectRibbonTab(DocumentRibbonTab tab)
    {
        if (tab == DocumentRibbonTab.HeaderFooter && !IsHeaderFooterMode)
        {
            return;
        }

        _activeRibbonTab = tab;
    }

    private void HandleRibbonTabKeyDown(KeyboardEventArgs args, DocumentRibbonTab currentTab)
    {
        var tabs = RibbonTabs.ToArray();
        var currentIndex = Array.IndexOf(tabs, currentTab);
        if (currentIndex < 0)
        {
            currentIndex = Array.IndexOf(tabs, _activeRibbonTab);
        }

        var nextIndex = args.Key switch
        {
            "ArrowRight" => (currentIndex + 1) % tabs.Length,
            "ArrowLeft" => (currentIndex - 1 + tabs.Length) % tabs.Length,
            "Home" => 0,
            "End" => tabs.Length - 1,
            _ => -1
        };

        if (nextIndex >= 0)
        {
            SelectRibbonTab(tabs[nextIndex]);
        }
    }

    private Task ToggleDifferentFirstPageAsync()
        => DifferentFirstPageChanged.InvokeAsync(!DifferentFirstPage);

    private Task ToggleDifferentOddEvenAsync()
        => DifferentOddAndEvenPagesChanged.InvokeAsync(!DifferentOddAndEvenPages);

    private Task ToggleRulerAsync()
        => ShowRulerChanged.InvokeAsync(!ShowRuler);

    private Task ZoomOutAsync()
        => ZoomPercentChanged.InvokeAsync(Math.Max(50, ZoomPercent - 10));

    private Task ZoomInAsync()
        => ZoomPercentChanged.InvokeAsync(Math.Min(200, ZoomPercent + 10));

    private Task ZoomTo100Async()
        => ZoomPercentChanged.InvokeAsync(100);

    private Task ZoomToPageWidthAsync()
        => OnZoomPageWidth.InvokeAsync();

    private async Task ToggleLinkDialogAsync()
    {
        if (_linkDialogOpen)
        {
            CloseLinkDialog();
            return;
        }

        _linkError = null;
        var info = LinkInfoProvider is null ? null : await LinkInfoProvider.Invoke();
        _pendingLinkUrl = info?.Href;
        _pendingLinkTitle = info?.Title;
        _linkDialogOpen = true;
    }

    private void ToggleDocxImportPanel()
    {
        _docxImportOpen = !_docxImportOpen;
    }

    private void CloseLinkDialog()
    {
        _linkDialogOpen = false;
        _linkError = null;
    }

    private async Task ApplyLinkAsync()
    {
        var href = DocumentLinkUtility.NormalizeHref(_pendingLinkUrl);
        if (!DocumentLinkUtility.IsSafeHref(href))
        {
            _linkError = Loc["TmDocumentEditor_LinkInvalidUrl"];
            return;
        }

        var payload = new WysiwygLinkPayload
        {
            Href = href,
            Title = string.IsNullOrWhiteSpace(_pendingLinkTitle) ? null : _pendingLinkTitle.Trim()
        };

        if (OnLinkApplied.HasDelegate)
        {
            await OnLinkApplied.InvokeAsync(payload);
        }
        else
        {
            await OnLink.InvokeAsync(payload.Href);
        }

        _pendingLinkUrl = null;
        _pendingLinkTitle = null;
        _linkError = null;
        _linkDialogOpen = false;
    }

    private async Task HandleDocxImportSelectedAsync(InputFileChangeEventArgs args)
    {
        await OnImportDocx.InvokeAsync(args);
        _docxImportOpen = false;
    }

    private enum DocumentRibbonTab
    {
        Home,
        Insert,
        Layout,
        References,
        Review,
        View,
        HeaderFooter
    }
}
