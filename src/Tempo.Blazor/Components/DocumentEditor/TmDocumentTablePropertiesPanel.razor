@namespace Tempo.Blazor.Components.DocumentEditor
@using System.Globalization
@using Tempo.Blazor.DocumentEditor.Models

<section class="tm-document-table-properties"
         role="region"
         aria-label="@Loc["TmDocumentEditor_TableProperties"]"
         data-testid="@($"{TestIdPrefix}-panel")">
    <header>
        <TmIcon Name="table-properties" Size="IconSize.Sm" />
        <span>@Loc["TmDocumentEditor_TableProperties"]</span>
    </header>

    <label>
        <span>@Loc["TmDocumentEditor_TableWidth"]</span>
        <input type="number"
               min="80"
               step="10"
               value="@WidthValue"
               data-testid="@($"{TestIdPrefix}-width")"
               @onchange="HandleWidthChangedAsync" />
    </label>

    <div class="tm-document-table-properties__segmented" role="group" aria-label="@Loc["TmDocumentEditor_TableAlignment"]">
        @foreach (var alignment in Alignments)
        {
            <button type="button"
                    class="@SegmentClass(alignment)"
                    aria-pressed="@(CurrentAlignment == alignment)"
                    data-testid="@($"{TestIdPrefix}-align-{alignment.ToString().ToLowerInvariant()}")"
                    @onclick="() => HandleAlignmentChangedAsync(alignment)">
                @Loc[$"TmDocumentEditor_TableAlign{alignment}"]
            </button>
        }
    </div>

    <label>
        <span>@Loc["TmDocumentEditor_TableCellPadding"]</span>
        <input type="number"
               min="0"
               step="1"
               value="@PaddingValue"
               data-testid="@($"{TestIdPrefix}-padding")"
               @onchange="HandlePaddingChangedAsync" />
    </label>

    <label>
        <span>@Loc["TmDocumentEditor_TableBackground"]</span>
        <input type="color"
               value="@BackgroundValue"
               data-testid="@($"{TestIdPrefix}-background")"
               @onchange="HandleBackgroundChangedAsync" />
    </label>

    <label>
        <span>@Loc["TmDocumentEditor_TableBorder"]</span>
        <select value="@BorderValue"
                data-testid="@($"{TestIdPrefix}-border")"
                @onchange="HandleBorderChangedAsync">
            <option value="">@Loc["TmDocumentEditor_None"]</option>
            <option value="1px solid var(--tm-color-border)">@Loc["TmDocumentEditor_TableBorderDefault"]</option>
            <option value="2px solid var(--tm-color-primary)">@Loc["TmDocumentEditor_TableBorderStrong"]</option>
        </select>
    </label>
</section>

@code {
    private static readonly TableHorizontalAlignment[] Alignments =
    [
        TableHorizontalAlignment.Left,
        TableHorizontalAlignment.Center,
        TableHorizontalAlignment.Right
    ];

    /// <summary>Current table layout.</summary>
    [Parameter] public TableLayoutContent? Layout { get; set; }

    /// <summary>Raised when table properties change.</summary>
    [Parameter] public EventCallback<TableLayoutContent> LayoutChanged { get; set; }

    /// <summary>Prefix used for test id attributes. Defaults to document-table-properties.</summary>
    [Parameter] public string TestIdPrefix { get; set; } = "document-table-properties";

    private TableHorizontalAlignment CurrentAlignment => Layout?.Alignment ?? TableHorizontalAlignment.Left;

    private string WidthValue => Layout?.Width?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

    private string PaddingValue => Layout?.CellPadding?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

    private string BackgroundValue => string.IsNullOrWhiteSpace(Layout?.BackgroundColor) ? "#ffffff" : Layout!.BackgroundColor!;

    private string BorderValue => Layout?.Borders.Top ?? string.Empty;

    private string SegmentClass(TableHorizontalAlignment alignment) =>
        "tm-document-table-properties__segment" + (CurrentAlignment == alignment ? " tm-document-table-properties__segment--active" : string.Empty);

    private Task HandleWidthChangedAsync(ChangeEventArgs args)
    {
        var next = CloneLayout();
        next.Width = ParseNonNegative(args.Value);
        return LayoutChanged.InvokeAsync(next);
    }

    private Task HandleAlignmentChangedAsync(TableHorizontalAlignment alignment)
    {
        var next = CloneLayout();
        next.Alignment = alignment;
        return LayoutChanged.InvokeAsync(next);
    }

    private Task HandlePaddingChangedAsync(ChangeEventArgs args)
    {
        var next = CloneLayout();
        next.CellPadding = ParseNonNegative(args.Value);
        return LayoutChanged.InvokeAsync(next);
    }

    private Task HandleBackgroundChangedAsync(ChangeEventArgs args)
    {
        var next = CloneLayout();
        next.BackgroundColor = args.Value?.ToString();
        return LayoutChanged.InvokeAsync(next);
    }

    private Task HandleBorderChangedAsync(ChangeEventArgs args)
    {
        var next = CloneLayout();
        var border = args.Value?.ToString();
        next.Borders = new TableCellBorders { Top = border, Right = border, Bottom = border, Left = border };
        return LayoutChanged.InvokeAsync(next);
    }

    private TableLayoutContent CloneLayout() =>
        new()
        {
            Width = Layout?.Width,
            Alignment = CurrentAlignment,
            CellPadding = Layout?.CellPadding,
            BackgroundColor = Layout?.BackgroundColor,
            Borders = new TableCellBorders
            {
                Top = Layout?.Borders.Top,
                Right = Layout?.Borders.Right,
                Bottom = Layout?.Borders.Bottom,
                Left = Layout?.Borders.Left
            }
        };

    private static double? ParseNonNegative(object? value) =>
        double.TryParse(value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed) && parsed >= 0
            ? parsed
            : null;
}
