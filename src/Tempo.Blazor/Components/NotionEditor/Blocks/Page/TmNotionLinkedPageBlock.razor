@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Page
@using Tempo.Blazor.NotionEditor.Models

<div class="tm-linked-page"
     role="link"
     tabindex="0"
     @onclick="HandleClickAsync"
     @onkeydown="HandleKeyDownAsync"
     aria-label="@Loc["TmNotionLinkedPageBlock_Label", _title]">

    <svg class="tm-linked-page__arrow" width="14" height="14" viewBox="0 0 14 14"
         fill="none" aria-hidden="true">
        <path d="M5.5 2H2.5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V9"
              stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        <path d="M8 1.5h4.5m0 0V6m0-4.5L6.5 7"
              stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

    @if (!string.IsNullOrEmpty(_icon))
    {
        <span class="tm-linked-page__icon" aria-hidden="true">@_icon</span>
    }
    else
    {
        <svg class="tm-linked-page__default-icon" width="16" height="16" viewBox="0 0 16 16"
             fill="none" aria-hidden="true">
            <path d="M3.5 1.5h6L13 5v9.5H3.5v-13z"
                  stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
            <path d="M9.5 1.5V5H13" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
        </svg>
    }

    <span class="tm-linked-page__title">@_title</span>
</div>
