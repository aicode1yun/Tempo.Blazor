@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Embed
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.NotionEditor.Enums

<div class="tm-notion-embed-block" @onfocus="HandleFocusAsync">

    @if (string.IsNullOrEmpty(Content?.Url))
    {
        @if (!ReadOnly)
        {
            <div class="tm-notion-embed-block__input-zone @(_loading ? "tm-notion-embed-block__input-zone--loading" : "")">
                <svg class="tm-notion-embed-block__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <input type="url"
                       class="tm-notion-embed-block__url-input"
                       placeholder="@Loc["TmNotionEmbedBlock_UrlPlaceholder"]"
                       value="@_urlInput"
                       @oninput="HandleUrlInput"
                       @onkeydown="HandleUrlKeyDownAsync"
                       disabled="@_loading"
                       aria-label="@Loc["TmNotionEmbedBlock_UrlPlaceholder"]" />
                @if (!string.IsNullOrWhiteSpace(_urlInput) && _detectedProvider != EmbedProvider.Generic)
                {
                    <span class="tm-notion-embed-block__provider-badge" title="@_detectedProvider.ToString()">
                        @_detectedProvider.ToString()
                    </span>
                }
                <button class="tm-notion-embed-block__confirm-btn"
                        type="button"
                        disabled="@(_loading || string.IsNullOrWhiteSpace(_urlInput))"
                        @onclick="ConfirmEmbedAsync">
                    @Loc["TmNotionEmbedBlock_Confirm"]
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="tm-notion-embed-block__error" role="alert">@_error</div>
            }
        }
        else
        {
            <div class="tm-notion-media-empty-placeholder" aria-label="@Loc["TmNotionEmbedBlock_UrlPlaceholder"]">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </div>
        }
    }
    else
    {
        <figure class="tm-notion-embed-block__figure">

            <div class="tm-notion-embed-block__frame-wrap"
                 style="@_sizeStyle"
                 @ref="_wrapRef">

                <iframe src="@_embedUrl"
                        class="tm-notion-embed-block__frame"
                        title="@(Content.Provider == EmbedProvider.Generic ? Content.Url : Content.Provider.ToString())"
                        allowfullscreen
                        sandbox="allow-scripts allow-same-origin allow-forms allow-presentation allow-popups">
                </iframe>

                @if (!ReadOnly)
                {
                    <div class="tm-notion-embed-block__overlay">
                        <button class="tm-notion-embed-block__action-btn"
                                type="button"
                                title="@Loc["TmNotionEmbedBlock_Replace"]"
                                @onclick="StartReplaceAsync"
                                @onclick:stopPropagation="true">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <polyline points="17 8 12 3 7 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <line x1="12" y1="3" x2="12" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            @Loc["TmNotionEmbedBlock_Replace"]
                        </button>
                        <a class="tm-notion-embed-block__action-btn"
                           href="@Content.Url"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="@Loc["TmNotionEmbedBlock_OpenSource"]"
                           @onclick:stopPropagation="true">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <polyline points="15 3 21 3 21 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <line x1="10" y1="14" x2="21" y2="3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            @Loc["TmNotionEmbedBlock_OpenSource"]
                        </a>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Content?.Caption) || !ReadOnly)
            {
                <figcaption class="tm-notion-image-block__caption tm-notion-editable"
                             contenteditable="@(!ReadOnly ? "true" : "false")"
                             data-placeholder="@Loc["TmNotionEmbedBlock_CaptionPlaceholder"]"
                             @ref="_captionRef"
                             @oninput="() => _captionDirty = true"
                             @onblur="OnCaptionBlurAsync">
                </figcaption>
            }

        </figure>
    }

</div>
