@namespace Tempo.Blazor.Components.NotionEditor.Blocks
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.Components.NotionEditor.Services
@using Tempo.Blazor.Components.NotionEditor.Blocks.Text
@using Tempo.Blazor.Components.NotionEditor.Blocks.Lists
@using Tempo.Blazor.Components.NotionEditor.Blocks.Media
@using Tempo.Blazor.Components.NotionEditor.Blocks.Embed
@using Tempo.Blazor.Components.NotionEditor.Blocks.Layout
@using Tempo.Blazor.Components.NotionEditor.Blocks.Special
@using Tempo.Blazor.Components.NotionEditor.Blocks.TempoBlocks
@using Tempo.Blazor.Components.NotionEditor.Blocks.Table
@using Tempo.Blazor.Components.NotionEditor.Blocks.Page
@using Tempo.Blazor.Components.NotionEditor.Blocks.Synced
@using Tempo.Blazor.Components.NotionEditor.Blocks.Database

<div class="tm-notion-block @_blockMods"
     data-notion-block
     data-block-id="@Block.Id"
     data-block-type="@Block.Type"
     @ref="_blockRef">

    @* ── Block handle (add + drag + options menu) ──────────────────────────── *@
    @if (!ReadOnly)
    {
        <TmNotionBlockHandle Block="Block"
                             OnAddClicked="HandleAddClickedAsync"
                             OnDelete="OnDeleted"
                             OnDuplicate="HandleDuplicateAsync"
                             OnTurnInto="OnConvertTo"
                             OnMoveTo="HandleMoveToAsync"
                             OnCopyLink="HandleCopyLinkAsync"
                             OnComment="HandleCommentAsync"
                             OnTextColorChange="HandleTextColorChangeAsync"
                             OnBackgroundChange="HandleBackgroundColorChangeAsync" />
    }

    @* ── Block content dispatcher ──────────────────────────────────────────── *@
    <div class="tm-notion-block__content">
        @switch (Block.Type)
        {
            // ── Paragraph ───────────────────────────────────────────────────
            case BlockType.Paragraph:
            {
                var c = Block.Content as ITextBlockContent;
                <TmNotionTextBlock Content="c"
                                   ReadOnly="ReadOnly"
                                   IsFocused="IsFocused"
                                   Placeholder="@Loc["TmNotionBlock_ParagraphPlaceholder"]"
                                   OnContentSaved="HandleParagraphContentSavedAsync"
                                   OnEnterSplit="HandleParagraphEnterPressedAsync"
                                   OnDeleteRequested="OnDeleted"
                                   OnIndentChange="HandleParagraphTabAsync"
                                   OnTypeConvert="HandleParagraphMarkdownShortcutAsync"
                                   OnFocused="OnFocusedAsync"
                                   OnSlashMenu="HandleParagraphSlashAsync"
                                   OnMentionMenu="HandleParagraphMentionAsync"
                                   OnPageLinkMenu="HandleParagraphPageLinkAsync" />
                break;
            }

            // ── Heading 1 / 2 / 3 ───────────────────────────────────────────
            case BlockType.Heading1:
            case BlockType.Heading2:
            case BlockType.Heading3:
            {
                var c = Block.Content as IHeadingBlockContent;
                <TmNotionHeadingBlock Content="c"
                                      ReadOnly="ReadOnly"
                                      IsFocused="IsFocused"
                                      OnContentSaved="HandleHeadingContentSavedAsync"
                                      OnEnterSplit="HandleHeadingEnterPressedAsync"
                                      OnDeleteRequested="OnDeleted"
                                      OnIndentChange="HandleHeadingTabAsync"
                                      OnTypeConvert="HandleHeadingMarkdownShortcutAsync"
                                      OnFocused="OnFocusedAsync"
                                      OnSlashMenu="HandleHeadingSlashAsync"
                                      OnMentionMenu="HandleHeadingMentionAsync"
                                      OnPageLinkMenu="HandleHeadingPageLinkAsync"
                                      OnToggleChanged="HandleHeadingToggleAsync" />
                break;
            }

            // ── Quote ────────────────────────────────────────────────────────
            case BlockType.Quote:
            {
                var c = Block.Content as ITextBlockContent;
                <TmNotionQuoteBlock Content="c"
                                    ReadOnly="ReadOnly"
                                    IsFocused="IsFocused"
                                    Placeholder="@Loc["TmNotionBlock_QuotePlaceholder"]"
                                    OnContentSaved="HandleQuoteContentSavedAsync"
                                    OnEnterSplit="HandleQuoteEnterPressedAsync"
                                    OnDeleteRequested="OnDeleted"
                                    OnIndentChange="HandleQuoteTabAsync"
                                    OnTypeConvert="HandleQuoteMarkdownShortcutAsync"
                                    OnFocused="OnFocusedAsync"
                                    OnSlashMenu="HandleQuoteSlashAsync"
                                    OnMentionMenu="HandleQuoteMentionAsync"
                                    OnPageLinkMenu="HandleQuotePageLinkAsync" />
                break;
            }

            // ── Callout ──────────────────────────────────────────────────────
            case BlockType.Callout:
            {
                var c = Block.Content as ICalloutBlockContent;
                <TmNotionCalloutBlock Content="c"
                                      ReadOnly="ReadOnly"
                                      IsFocused="IsFocused"
                                      Placeholder="@Loc["TmNotionBlock_CalloutPlaceholder"]"
                                      OnContentSaved="HandleCalloutContentSavedAsync"
                                      OnEnterSplit="HandleCalloutEnterPressedAsync"
                                      OnDeleteRequested="OnDeleted"
                                      OnIndentChange="HandleCalloutTabAsync"
                                      OnTypeConvert="HandleCalloutMarkdownShortcutAsync"
                                      OnFocused="OnFocusedAsync"
                                      OnSlashMenu="HandleCalloutSlashAsync"
                                      OnMentionMenu="HandleCalloutMentionAsync"
                                      OnPageLinkMenu="HandleCalloutPageLinkAsync"
                                      OnEmojiChanged="HandleCalloutEmojiChangedAsync" />
                break;
            }

            // ── Bullet list ──────────────────────────────────────────────────
            case BlockType.BulletList:
            {
                var c = Block.Content as IListBlockContent;
                <TmNotionBulletListBlock Content="c"
                                         ReadOnly="ReadOnly"
                                         IsFocused="IsFocused"
                                         Placeholder="@Loc["TmNotionBlock_ListPlaceholder"]"
                                         OnContentSaved="HandleBulletContentSavedAsync"
                                         OnEnterSplit="HandleBulletEnterSplitAsync"
                                         OnDeleteRequested="OnDeleted"
                                         OnIndentChange="HandleBulletTabAsync"
                                         OnTypeConvert="HandleBulletMarkdownShortcutAsync"
                                         OnFocused="OnFocusedAsync"
                                         OnSlashMenu="HandleBulletSlashAsync"
                                         OnMentionMenu="HandleBulletMentionAsync"
                                         OnPageLinkMenu="HandleBulletPageLinkAsync" />
                break;
            }

            // ── Numbered list ────────────────────────────────────────────────
            case BlockType.NumberedList:
            {
                var c = Block.Content as IListBlockContent;
                <TmNotionNumberedListBlock Content="c"
                                           Number="NumberedListNumber"
                                           ReadOnly="ReadOnly"
                                           IsFocused="IsFocused"
                                           Placeholder="@Loc["TmNotionBlock_ListPlaceholder"]"
                                           OnContentSaved="HandleNumberedContentSavedAsync"
                                           OnEnterSplit="HandleNumberedEnterSplitAsync"
                                           OnDeleteRequested="OnDeleted"
                                           OnIndentChange="HandleNumberedTabAsync"
                                           OnTypeConvert="HandleNumberedMarkdownShortcutAsync"
                                           OnFocused="OnFocusedAsync"
                                           OnSlashMenu="HandleNumberedSlashAsync"
                                           OnMentionMenu="HandleNumberedMentionAsync"
                                           OnPageLinkMenu="HandleNumberedPageLinkAsync" />
                break;
            }

            // ── Todo item ────────────────────────────────────────────────────
            case BlockType.TodoItem:
            {
                var c = Block.Content as ITodoBlockContent;
                <TmNotionTodoBlock Content="c"
                                   ReadOnly="ReadOnly"
                                   IsFocused="IsFocused"
                                   Placeholder="@Loc["TmNotionBlock_ListPlaceholder"]"
                                   OnCheckedChanged="HandleTodoCheckedChangedAsync"
                                   OnContentSaved="HandleTodoContentSavedAsync"
                                   OnEnterSplit="HandleTodoEnterSplitAsync"
                                   OnDeleteRequested="OnDeleted"
                                   OnTypeConvert="HandleTodoMarkdownShortcutAsync"
                                   OnFocused="OnFocusedAsync"
                                   OnSlashMenu="HandleTodoSlashAsync"
                                   OnMentionMenu="HandleTodoMentionAsync"
                                   OnPageLinkMenu="HandleTodoPageLinkAsync" />
                break;
            }

            // ── Toggle ───────────────────────────────────────────────────────
            case BlockType.Toggle:
            {
                var c = Block.Content as IToggleBlockContent;
                <TmNotionToggleBlock Block="Block"
                                     Content="c"
                                     ReadOnly="ReadOnly"
                                     IsFocused="IsFocused"
                                     Placeholder="@Loc["TmNotionBlock_TogglePlaceholder"]"
                                     OnContentSaved="HandleToggleContentSavedAsync"
                                     OnEnterSplit="HandleToggleEnterSplitAsync"
                                     OnDeleteRequested="OnDeleted"
                                     OnTypeConvert="HandleToggleMarkdownShortcutAsync"
                                     OnFocused="OnFocusedAsync"
                                     OnOpenChanged="HandleToggleOpenChangedAsync"
                                     OnSlashMenu="HandleToggleSlashAsync"
                                     OnMentionMenu="HandleToggleMentionAsync"
                                     OnPageLinkMenu="HandleTogglePageLinkAsync" />
                break;
            }

            // ── Divider ──────────────────────────────────────────────────────
            case BlockType.Divider:
                <TmNotionDividerBlock ReadOnly="ReadOnly"
                                      IsFocused="IsFocused"
                                      OnFocused="OnFocusedAsync"
                                      OnDeleteRequested="OnDeleted"
                                      OnAddAfter="HandleDividerAddAfterAsync" />
                break;

            // ── Code ─────────────────────────────────────────────────────────
            case BlockType.Code:
            {
                var c = Block.Content as ICodeBlockContent;
                <TmNotionCodeBlock Content="c"
                                   ReadOnly="ReadOnly"
                                   IsFocused="IsFocused"
                                   OnCodeSaved="HandleCodeSavedAsync"
                                   OnLanguageChanged="HandleCodeLanguageChangedAsync"
                                   OnCaptionSaved="HandleCodeCaptionSavedAsync"
                                   OnDeleteRequested="OnDeleted"
                                   OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Equation ─────────────────────────────────────────────────────
            case BlockType.Equation:
            {
                var c = Block.Content as IEquationBlockContent;
                <TmNotionEquationBlock Content="c"
                                       ReadOnly="ReadOnly"
                                       IsFocused="IsFocused"
                                       OnExpressionSaved="HandleEquationExpressionSavedAsync"
                                       OnDeleteRequested="OnDeleted"
                                       OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Image ────────────────────────────────────────────────────────
            case BlockType.Image:
            {
                var c = Block.Content as IImageBlockContent;
                <TmNotionImageBlock Content="c"
                                    ReadOnly="ReadOnly"
                                    OnMediaSet="HandleImageMediaSetAsync"
                                    OnWidthChanged="HandleImageWidthChangedAsync"
                                    OnCaptionSaved="HandleImageCaptionSavedAsync"
                                    OnAlignmentChanged="HandleImageAlignmentChangedAsync"
                                    OnDeleteRequested="OnDeleted"
                                    OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Video ────────────────────────────────────────────────────────
            case BlockType.Video:
            {
                var c = Block.Content as IVideoBlockContent;
                <TmNotionVideoBlock Content="c"
                                    ReadOnly="ReadOnly"
                                    OnMediaSet="HandleVideoMediaSetAsync"
                                    OnWidthChanged="HandleVideoWidthChangedAsync"
                                    OnCaptionSaved="HandleVideoCaptionSavedAsync"
                                    OnDeleteRequested="OnDeleted"
                                    OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Audio ────────────────────────────────────────────────────────
            case BlockType.Audio:
            {
                var c = Block.Content as IAudioBlockContent;
                <TmNotionAudioBlock Content="c"
                                    ReadOnly="ReadOnly"
                                    OnMediaSet="HandleAudioMediaSetAsync"
                                    OnCaptionSaved="HandleAudioCaptionSavedAsync"
                                    OnDeleteRequested="OnDeleted"
                                    OnFocused="OnFocusedAsync" />
                break;
            }

            // ── File ─────────────────────────────────────────────────────────
            case BlockType.File:
            {
                var c = Block.Content as IFileBlockContent;
                <TmNotionFileBlock Content="c"
                                   ReadOnly="ReadOnly"
                                   OnMediaSet="HandleFileMediaSetAsync"
                                   OnCaptionSaved="HandleFileCaptionSavedAsync"
                                   OnDeleteRequested="OnDeleted"
                                   OnFocused="OnFocusedAsync" />
                break;
            }

            // ── PDF ──────────────────────────────────────────────────────────
            case BlockType.Pdf:
            {
                var c = Block.Content as IPdfBlockContent;
                <TmNotionPdfBlock Content="c"
                                  ReadOnly="ReadOnly"
                                  OnMediaSet="HandlePdfMediaSetAsync"
                                  OnCaptionSaved="HandlePdfCaptionSavedAsync"
                                  OnDeleteRequested="OnDeleted"
                                  OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Bookmark ─────────────────────────────────────────────────────
            case BlockType.Bookmark:
            {
                var c = Block.Content as IBookmarkBlockContent;
                <TmNotionBookmarkBlock Content="c"
                                       ReadOnly="ReadOnly"
                                       BookmarkProvider="Context.BookmarkProvider"
                                       OnResolved="HandleBookmarkResolvedAsync"
                                       OnCaptionSaved="HandleBookmarkCaptionSavedAsync"
                                       OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Embed ────────────────────────────────────────────────────────
            case BlockType.Embed:
            {
                var c = Block.Content as IEmbedBlockContent;
                <TmNotionEmbedBlock Content="c"
                                    ReadOnly="ReadOnly"
                                    OnUrlSet="HandleEmbedUrlSetAsync"
                                    OnResized="HandleEmbedResizedAsync"
                                    OnCaptionSaved="HandleEmbedCaptionSavedAsync"
                                    OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Child page ───────────────────────────────────────────────────
            case BlockType.ChildPage:
            {
                var c = Block.Content as IChildPageBlockContent;
                <TmNotionChildPageBlock Content="c"
                                        ReadOnly="ReadOnly"
                                        IsFocused="IsFocused"
                                        OnNavigate="HandleChildPageNavigateAsync"
                                        OnRenameCommitted="HandleChildPageRenameCommittedAsync"
                                        OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Linked page ──────────────────────────────────────────────────
            case BlockType.LinkedPage:
            {
                var c = Block.Content as ILinkedPageBlockContent;
                <TmNotionLinkedPageBlock Content="c"
                                         ReadOnly="ReadOnly"
                                         OnNavigate="HandleLinkedPageNavigateAsync"
                                         OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Table of contents ─────────────────────────────────────────────
            case BlockType.TableOfContents:
            {
                var c = Block.Content as ITableOfContentsBlockContent;
                <TmNotionTableOfContentsBlock Content="c"
                                              ReadOnly="ReadOnly"
                                              OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Breadcrumb ───────────────────────────────────────────────────
            case BlockType.Breadcrumb:
            {
                var c = Block.Content as IBreadcrumbBlockContent;
                <TmNotionBreadcrumbBlock Block="Block"
                                         Content="c"
                                         ReadOnly="ReadOnly"
                                         OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Synced block origin ───────────────────────────────────────────
            case BlockType.SyncedBlockOrigin:
            {
                var c = Block.Content as ISyncedBlockOriginContent;
                <TmNotionSyncedBlockOrigin Block="Block"
                                           Content="c"
                                           ReadOnly="ReadOnly"
                                           IsFocused="IsFocused"
                                           OnFocused="OnFocusedAsync"
                                           OnCopySyncId="HandleSyncedOriginCopySyncIdAsync" />
                break;
            }

            // ── Synced block ref ──────────────────────────────────────────────
            case BlockType.SyncedBlockRef:
            {
                var c = Block.Content as ISyncedBlockRefContent;
                <TmNotionSyncedBlockRef Block="Block"
                                        Content="c"
                                        ReadOnly="ReadOnly"
                                        IsFocused="IsFocused"
                                        OnFocused="OnFocusedAsync"
                                        OnUnsync="HandleSyncedRefUnsyncAsync" />
                break;
            }

            // ── Template button ───────────────────────────────────────────────
            case BlockType.TemplateButton:
            {
                var c = Block.Content as ITemplateButtonBlockContent;
                <TmNotionTemplateButtonBlock Content="c"
                                             ReadOnly="ReadOnly"
                                             IsFocused="IsFocused"
                                             OnInsertTemplateBlocks="HandleInsertTemplateBlocksAsync"
                                             OnUpdated="HandleTemplateButtonUpdatedAsync"
                                             OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Inline database ───────────────────────────────────────────────
            case BlockType.InlineDatabase:
            // ── Linked database ───────────────────────────────────────────────
            case BlockType.LinkedDatabase:
            {
                <TmNotionDatabaseBlock Block="Block"
                                       ReadOnly="ReadOnly"
                                       IsFocused="IsFocused"
                                       OnFocused="OnFocusedAsync"
                                       OnUpdated="OnUpdated" />
                break;
            }

            // ── Column list ───────────────────────────────────────────────────
            case BlockType.ColumnList:
            {
                var c = Block.Content as IColumnListBlockContent;
                <TmNotionColumnListBlock Block="Block"
                                        Content="c"
                                        ReadOnly="ReadOnly"
                                        OnUpdated="OnUpdated"
                                        OnFocused="OnFocusedAsync"
                                        OnSlashMenu="OnSlashMenu"
                                        OnMentionMenu="OnMentionMenu"
                                        OnPageLinkMenu="OnPageLinkMenu" />
                break;
            }

            // ── Column (standalone fallback — normally inside ColumnList) ─────
            case BlockType.Column:
            {
                var c = Block.Content as IColumnBlockContent;
                <TmNotionColumnBlock Block="Block"
                                     ColumnIndex="c?.ColumnIndex ?? 0"
                                     WidthPercent="100"
                                     ReadOnly="ReadOnly"
                                     OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Diagram ───────────────────────────────────────────────────────
            case BlockType.Diagram:
            {
                var c = Block.Content as IDiagramBlockContent;
                <TmNotionDiagramBlock Content="c"
                                      ReadOnly="ReadOnly"
                                      OnContentSaved="HandleDiagramContentSavedAsync"
                                      OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Wireframe ─────────────────────────────────────────────────────
            case BlockType.Wireframe:
            {
                var c = Block.Content as IWireframeBlockContent;
                <TmNotionWireframeBlock Content="c"
                                        ReadOnly="ReadOnly"
                                        OnContentSaved="HandleWireframeContentSavedAsync"
                                        OnFocused="OnFocusedAsync" />
                break;
            }

            // ── Table ────────────────────────────────────────────────────────
            case BlockType.Table:
            {
                var c = Block.Content as ITableBlockContent;
                <TmNotionTableBlock Block="Block"
                                    Content="c"
                                    ReadOnly="ReadOnly"
                                    OnUpdated="OnUpdated"
                                    OnFocused="OnFocusedAsync" />
                break;
            }

            // ── TableRow (managed by TmNotionTableBlock — standalone fallback) ─
            case BlockType.TableRow:
                <div class="tm-notion-block-unsupported" aria-hidden="true">
                    <span class="tm-notion-block-unsupported__label">@Block.Type</span>
                </div>
                break;

            // ── Default / unsupported ────────────────────────────────────────
            default:
                <div class="tm-notion-block-unsupported">
                    <span class="tm-notion-block-unsupported__label">
                        @Block.Type.ToString()
                    </span>
                </div>
                break;
        }
    </div>

</div>
