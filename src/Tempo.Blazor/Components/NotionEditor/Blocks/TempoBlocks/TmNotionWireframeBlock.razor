@namespace Tempo.Blazor.Components.NotionEditor.Blocks.TempoBlocks
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.Components.Wireframe.Models

<div class="tm-notion-wireframe-block" @onfocus="HandleFocusAsync">

    @if (Content is null || Content.WireframeDocumentId == Guid.Empty)
    {
        @if (!ReadOnly)
        {
            <button class="tm-notion-media-upload-zone tm-notion-media-upload-zone--wireframe"
                    type="button"
                    aria-label="@Loc["TmNotionWireframeBlock_CreateWireframe"]"
                    @onclick="CreateWireframeAsync"
                    disabled="@_creating">
                @if (_creating)
                {
                    <span class="tm-notion-wireframe-block__spinner" aria-hidden="true"></span>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        <rect x="5" y="6" width="5" height="4" rx="1" stroke="currentColor" stroke-width="1.2"/>
                        <rect x="14" y="6" width="5" height="4" rx="1" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M5 13h14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                }
                <span>@Loc["TmNotionWireframeBlock_CreateWireframe"]</span>
            </button>
        }
        else
        {
            <div class="tm-notion-media-empty-placeholder"
                 aria-label="@Loc["TmNotionWireframeBlock_CreateWireframe"]">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <rect x="5" y="6" width="5" height="4" rx="1" stroke="currentColor" stroke-width="1.2"/>
                    <rect x="14" y="6" width="5" height="4" rx="1" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M5 13h14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
            </div>
        }
    }
    else
    {
        <figure class="tm-notion-wireframe-block__figure">

            <div class="tm-notion-wireframe-block__preview-wrap"
                 style="@_sizeStyle"
                 @ref="_previewWrapRef">

                @if (!string.IsNullOrEmpty(Content.SvgPreviewCache))
                {
                    <div class="tm-notion-wireframe-block__svg-container">
                        @((MarkupString)Content.SvgPreviewCache)
                    </div>
                }
                else
                {
                    <div class="tm-notion-wireframe-block__placeholder-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            <rect x="5" y="6" width="5" height="4" rx="1" stroke="currentColor" stroke-width="1.2"/>
                            <rect x="14" y="6" width="5" height="4" rx="1" stroke="currentColor" stroke-width="1.2"/>
                            <path d="M5 13h14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                        </svg>
                    </div>
                }

                @if (!ReadOnly)
                {
                    <div class="tm-notion-wireframe-block__overlay">
                        <button class="tm-notion-wireframe-block__edit-btn"
                                type="button"
                                @onclick="OpenEditorAsync"
                                @onclick:stopPropagation="true">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"
                                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"
                                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            @Loc["TmNotionWireframeBlock_Edit"]
                        </button>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Content.Caption) || !ReadOnly)
            {
                <figcaption class="tm-notion-wireframe-block__caption tm-notion-editable"
                             contenteditable="@(!ReadOnly ? "true" : "false")"
                             data-placeholder="@Loc["TmNotionWireframeBlock_CaptionPlaceholder"]"
                             @ref="_captionRef"
                             @oninput="() => _captionDirty = true"
                             @onblur="OnCaptionBlurAsync">
                </figcaption>
            }

        </figure>
    }

    @if (_editorOpen && Content is not null && Content.WireframeDocumentId != Guid.Empty)
    {
        <TmNotionWireframeEditModal WireframeDocumentId="Content.WireframeDocumentId"
                                    Provider="Context.WireframeDocumentProvider"
                                    OnSaved="HandleEditorSavedAsync"
                                    OnDiscarded="HandleEditorDiscardedAsync" />
    }

</div>
