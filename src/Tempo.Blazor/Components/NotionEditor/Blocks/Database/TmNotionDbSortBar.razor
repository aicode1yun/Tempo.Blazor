@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Database
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.NotionEditor.Models

<div class="tm-dbsb">

    @* ── Header ──────────────────────────────────────────────────────────── *@
    <div class="tm-dbsb__header">
        <span class="tm-dbsb__title">@Loc["TmNotionDbSortBar_Title"]</span>
        <button class="tm-dbsb__close" type="button"
                aria-label="@Loc["TmNotionDbSortBar_Close"]"
                @onclick="() => OnClose.InvokeAsync()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </button>
    </div>

    @* ── Sort rows ────────────────────────────────────────────────────────── *@
    @if (IsEmpty)
    {
        <p class="tm-dbsb__empty">@Loc["TmNotionDbSortBar_Empty"]</p>
    }
    else
    {
        <div class="tm-dbsb__list">
            @foreach (var sort in _sorts)
            {
                var s          = sort;
                var isDragOver = _dragOver == s;
                var isDragging = _dragging == s;
                <div class="tm-dbsb__row @(isDragOver ? "tm-dbsb__row--drag-over" : "") @(isDragging ? "tm-dbsb__row--dragging" : "")"
                     draggable="@(ReadOnly ? "false" : "true")"
                     @ondragstart="() => StartDrag(s)"
                     @ondragend="_ => EndDrag()"
                     @ondragover:preventDefault="true"
                     @ondragover="_ => SetDragOver(s)"
                     @ondrop="_ => DropOnAsync(s)">

                    @if (!ReadOnly)
                    {
                        <span class="tm-dbsb__drag-handle" title="@Loc["TmNotionDbSortBar_DragHandle"]" aria-hidden="true">
                            <svg width="10" height="14" viewBox="0 0 10 14" fill="none">
                                <circle cx="3"   cy="2.5"  r="1.2" fill="currentColor"/>
                                <circle cx="7"   cy="2.5"  r="1.2" fill="currentColor"/>
                                <circle cx="3"   cy="7"    r="1.2" fill="currentColor"/>
                                <circle cx="7"   cy="7"    r="1.2" fill="currentColor"/>
                                <circle cx="3"   cy="11.5" r="1.2" fill="currentColor"/>
                                <circle cx="7"   cy="11.5" r="1.2" fill="currentColor"/>
                            </svg>
                        </span>
                    }

                    <select class="tm-dbsb__select"
                            disabled="@ReadOnly"
                            @onchange="e => SetFieldAsync(s, e.Value?.ToString())">
                        <option value="">@Loc["TmNotionDbSortBar_SelectField"]</option>
                        @foreach (var f in Fields)
                        {
                            <option value="@f.Id.ToString()" selected="@(s.FieldId == f.Id)">@f.Name</option>
                        }
                    </select>

                    <div class="tm-dbsb__dir-toggle" role="group">
                        <button class="tm-dbsb__dir-btn @(s.Direction == SortDirection.Ascending ? "tm-dbsb__dir-btn--active" : "")"
                                type="button"
                                disabled="@ReadOnly"
                                title="@Loc["TmNotionDbSortBar_Ascending"]"
                                @onclick="() => SetDirectionAsync(s, SortDirection.Ascending)">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            @Loc["TmNotionDbSortBar_Ascending"]
                        </button>
                        <button class="tm-dbsb__dir-btn @(s.Direction == SortDirection.Descending ? "tm-dbsb__dir-btn--active" : "")"
                                type="button"
                                disabled="@ReadOnly"
                                title="@Loc["TmNotionDbSortBar_Descending"]"
                                @onclick="() => SetDirectionAsync(s, SortDirection.Descending)">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            @Loc["TmNotionDbSortBar_Descending"]
                        </button>
                    </div>

                    @if (!ReadOnly)
                    {
                        <button class="tm-dbsb__remove" type="button"
                                title="@Loc["TmNotionDbSortBar_Remove"]"
                                aria-label="@Loc["TmNotionDbSortBar_Remove"]"
                                @onclick="() => RemoveSortAsync(s)">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                        </button>
                    }
                </div>
            }
        </div>
    }

    @* ── Footer ──────────────────────────────────────────────────────────── *@
    @if (!ReadOnly)
    {
        <div class="tm-dbsb__footer">
            <button class="tm-dbsb__add-btn" type="button" @onclick="AddSortAsync">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                @Loc["TmNotionDbSortBar_AddSort"]
            </button>
            @if (!IsEmpty)
            {
                <button class="tm-dbsb__clear-btn" type="button" @onclick="ClearAllAsync">
                    @Loc["TmNotionDbSortBar_ClearAll"]
                </button>
            }
        </div>
    }

</div>
