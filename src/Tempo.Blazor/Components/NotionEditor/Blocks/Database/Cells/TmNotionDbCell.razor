    case DatabaseFieldType.Url:
        <TmNotionDbCellUrl Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                            OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
        break;

    case DatabaseFieldType.Email:
        <TmNotionDbCellEmail Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                              OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
        break;

    case DatabaseFieldType.Phone:
        <TmNotionDbCellPhone Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                              OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
        break;

    case DatabaseFieldType.Files:
        <TmNotionDbCellFiles Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
