    case DatabaseFieldType.Formula:
        <TmNotionDbCellFormula Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                                OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
        break;

    case DatabaseFieldType.Relation:
        <TmNotionDbCellRelation Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                                 OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
        break;

    case DatabaseFieldType.Rollup:
        <TmNotionDbCellRollup Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                               OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
