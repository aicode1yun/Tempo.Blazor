        <TmNotionDbCellLastEditedTime Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                                       OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
