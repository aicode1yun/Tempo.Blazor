@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Database.Cells
@inherits TmNotionDbCellBase
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.NotionEditor.Models

@switch (Field.Type)
{
    case DatabaseFieldType.Number:
        <TmNotionDbCellNumber Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                               OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
        break;

    case DatabaseFieldType.Select:
        <TmNotionDbCellSelect Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                               OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
        break;

    case DatabaseFieldType.MultiSelect:
        <TmNotionDbCellMultiSelect Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                                    OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
        break;

    case DatabaseFieldType.Status:
        <TmNotionDbCellStatus Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                               OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
        break;

    case DatabaseFieldType.Date:
    case DatabaseFieldType.DateRange:
        <TmNotionDbCellDate Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                             OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
