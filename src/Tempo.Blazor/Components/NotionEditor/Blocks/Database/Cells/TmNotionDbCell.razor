    case DatabaseFieldType.LastEditedBy:
        <TmNotionDbCellLastEditedBy Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                                     OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
        break;

    default:
        <TmNotionDbCellText Field="Field" Value="Value" ReadOnly="ReadOnly" IsEditing="IsEditing"
                             OnCommit="OnCommit" OnCancel="OnCancel" OnEditRequested="OnEditRequested" />
