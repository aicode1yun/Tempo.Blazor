@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Text
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Enums

@if (ReadOnly)
{
    <div @key="ReadOnly"
         class="tm-notion-quote tm-notion-editable tm-notion-editable--readonly @_alignClass @_bgClass"
         data-bg="@Content?.BackgroundColor"
         data-color="@Content?.TextColor">
        @((MarkupString)(Content?.Html ?? string.Empty))
    </div>
}
else
{
    <div @key="ReadOnly"
         class="tm-notion-quote tm-notion-editable @_alignClass @_bgClass"
         contenteditable="true"
         data-placeholder="@Placeholder"
         data-bg="@Content?.BackgroundColor"
         data-color="@Content?.TextColor"
         spellcheck="true"
         @ref="_editableRef"
         @oninput="() => _dirty = true"
         @onblur="OnBlurAsync"
         @onfocus="HandleFocusAsync">
    </div>
}
