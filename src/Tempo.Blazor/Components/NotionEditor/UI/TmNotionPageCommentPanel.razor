@namespace Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.Components.NotionEditor.Services

@* ── Inline panel — rendered inside page header area ─────────────────────── *@
<div class="tm-npcp @(Expanded ? "tm-npcp--expanded" : "")"
     role="region"
     aria-label="@Loc["TmNotionPageComment_PanelLabel"]">

    @* ── Toggle header ─────────────────────────────────────────────────────── *@
    <button class="tm-npcp__toggle"
            type="button"
            aria-expanded="@Expanded"
            @onclick="ToggleExpandedAsync">
        <svg class="tm-npcp__toggle-icon @(Expanded ? "tm-npcp__toggle-icon--open" : "")"
             width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
            <path d="M4 5.5l2.5 2.5 2.5-2.5"
                  stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="tm-npcp__toggle-label">@Loc["TmNotionPageComment_Toggle"]</span>
        @if (_unresolvedCount > 0)
        {
            <span class="tm-npcp__badge" aria-label="@string.Format(Loc["TmNotionPageComment_BadgeLabel"], _unresolvedCount)">
                @_unresolvedCount
            </span>
        }
    </button>

    @* ── Expandable body ───────────────────────────────────────────────────── *@
    @if (Expanded)
    {
        <div class="tm-npcp__body">

            @* ── Thread list ──────────────────────────────────────────────── *@
            @if (_loading)
            {
                <div class="tm-npcp__status" aria-live="polite" aria-busy="true">
                    <span class="tm-npcp__spinner" aria-hidden="true"></span>
                    @Loc["TmNotionPageComment_Loading"]
                </div>
            }
            else if (_comments.Count == 0)
            {
                <div class="tm-npcp__status">@Loc["TmNotionPageComment_NoComments"]</div>
            }
            else
            {
                <div class="tm-npcp__threads" role="list" aria-label="@Loc["TmNotionPageComment_Thread"]">
                    @foreach (var comment in _comments)
                    {
                        <div class="tm-npcp__thread @(comment.IsResolved ? "tm-npcp__thread--resolved" : "")"
                             role="listitem">

                            @* ── Thread header ────────────────────────────── *@
                            <div class="tm-npcp__thread-header">
                                @if (comment.IsResolved)
                                {
                                    <span class="tm-npcp__thread-resolved-badge">
                                        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                                            <circle cx="5.5" cy="5.5" r="4" stroke="currentColor" stroke-width="1.3"/>
                                            <path d="M3 5.5l2 2 2.5-2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        @Loc["TmNotionPageComment_Resolved"]
                                    </span>
                                }
                                <div class="tm-npcp__thread-actions" role="group">
                                    @if (!comment.IsResolved)
                                    {
                                        <button class="tm-npcp__thread-action"
                                                type="button"
                                                title="@Loc["TmNotionPageComment_Resolve"]"
                                                @onclick="() => ResolveAsync(comment)">
                                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                                <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/>
                                                <path d="M3.5 6l2 2 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                            @Loc["TmNotionPageComment_Resolve"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="tm-npcp__thread-action"
                                                type="button"
                                                title="@Loc["TmNotionPageComment_Unresolve"]"
                                                @onclick="() => UnresolveAsync(comment)">
                                            @Loc["TmNotionPageComment_Unresolve"]
                                        </button>
                                    }
                                </div>
                            </div>

                            @* ── Entries ───────────────────────────────────── *@
                            @foreach (var entry in comment.Thread)
                            {
                                <div class="tm-npcp__entry">
                                    <div class="tm-npcp__avatar" aria-hidden="true">
                                        @if (!string.IsNullOrEmpty(entry.AuthorAvatarUrl))
                                        {
                                            <img class="tm-npcp__avatar-img" src="@entry.AuthorAvatarUrl" alt="" />
                                        }
                                        else
                                        {
                                            <span class="tm-npcp__avatar-fallback">@AvatarInitial(entry.AuthorDisplayName)</span>
                                        }
                                    </div>
                                    <div class="tm-npcp__entry-body">
                                        <div class="tm-npcp__entry-meta">
                                            <span class="tm-npcp__entry-author">@entry.AuthorDisplayName</span>
                                            <time class="tm-npcp__entry-time" datetime="@entry.CreatedAt.ToString("O")">
                                                @FormatTime(entry.CreatedAt)
                                            </time>
                                        </div>

                                        @if (_editingEntryId == entry.Id)
                                        {
                                            <div class="tm-npcp__edit-wrap">
                                                <textarea class="tm-npcp__edit-input"
                                                          rows="3"
                                                          @bind="_editText"
                                                          @bind:event="oninput"
                                                          aria-label="@Loc["TmNotionPageComment_EditLabel"]"></textarea>
                                                <div class="tm-npcp__edit-actions">
                                                    <button class="tm-npcp__edit-save" type="button"
                                                            disabled="@string.IsNullOrWhiteSpace(_editText)"
                                                            @onclick="SaveEditAsync">@Loc["TmNotionPageComment_Save"]</button>
                                                    <button class="tm-npcp__edit-cancel" type="button"
                                                            @onclick="CancelEdit">@Loc["TmNotionPageComment_Cancel"]</button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="tm-npcp__entry-text" @((MarkupString)entry.HtmlContent)></div>
                                            @if (entry.CreatedAt != entry.UpdatedAt)
                                            {
                                                <span class="tm-npcp__entry-edited">@Loc["TmNotionPageComment_Edited"]</span>
                                            }
                                        }

                                        @if (_editingEntryId != entry.Id && (entry.CanEdit || entry.CanDelete))
                                        {
                                            <div class="tm-npcp__entry-actions" role="group">
                                                @if (entry.CanEdit)
                                                {
                                                    <button class="tm-npcp__entry-action" type="button"
                                                            title="@Loc["TmNotionPageComment_Edit"]"
                                                            @onclick="() => StartEdit(entry)">
                                                        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                                                            <path d="M2 8.5l1.5.5 5-5-2-2L2 8.5zm7-7l1 1-1.5 1.5-1-1L9 1.5z"
                                                                  stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none"/>
                                                        </svg>
                                                        @Loc["TmNotionPageComment_Edit"]
                                                    </button>
                                                }
                                                @if (entry.CanDelete)
                                                {
                                                    <button class="tm-npcp__entry-action tm-npcp__entry-action--danger" type="button"
                                                            title="@Loc["TmNotionPageComment_Delete"]"
                                                            @onclick="() => DeleteEntryAsync(comment, entry)">
                                                        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                                                            <path d="M2 3h7M4 3V1.5h3V3M4.5 5v3.5M6.5 5v3.5M2.5 3l.5 6.5h5L9 3"
                                                                  stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                                                        </svg>
                                                        @Loc["TmNotionPageComment_Delete"]
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @* ── Thread reply ────────────────────────────── *@
                            @if (!comment.IsResolved)
                            {
                                @if (_replyingToCommentId == comment.Id)
                                {
                                    <div class="tm-npcp__thread-reply">
                                        <textarea class="tm-npcp__reply-input"
                                                  rows="2"
                                                  placeholder="@Loc["TmNotionPageComment_ReplyPlaceholder"]"
                                                  @bind="_replyText"
                                                  @bind:event="oninput"
                                                  @onkeydown="HandleReplyKeyDownAsync"
                                                  aria-label="@Loc["TmNotionPageComment_ReplyLabel"]"></textarea>
                                        <div class="tm-npcp__reply-actions">
                                            <span class="tm-npcp__reply-hint">@Loc["TmNotionPageComment_ReplyHint"]</span>
                                            <div class="tm-npcp__reply-btns">
                                                <button class="tm-npcp__reply-cancel" type="button"
                                                        @onclick="CancelReply">@Loc["TmNotionPageComment_Cancel"]</button>
                                                <button class="tm-npcp__reply-send" type="button"
                                                        disabled="@(string.IsNullOrWhiteSpace(_replyText) || _submitting)"
                                                        @onclick="SendReplyAsync">
                                                    @if (_submitting)
                                                    {
                                                        <span class="tm-npcp__spinner tm-npcp__spinner--sm" aria-hidden="true"></span>
                                                    }
                                                    @Loc["TmNotionPageComment_Reply"]
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <button class="tm-npcp__reply-trigger" type="button"
                                            @onclick="() => StartReply(comment)">
                                        @Loc["TmNotionPageComment_ReplyTrigger"]
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            }

            @* ── New comment input ─────────────────────────────────────────── *@
            @if (_replyingToCommentId is null)
            {
                <div class="tm-npcp__new-comment">
                    <textarea class="tm-npcp__reply-input"
                              rows="2"
                              placeholder="@Loc["TmNotionPageComment_NewPlaceholder"]"
                              @bind="_newCommentText"
                              @bind:event="oninput"
                              @onkeydown="HandleNewKeyDownAsync"
                              aria-label="@Loc["TmNotionPageComment_NewLabel"]"></textarea>
                    <div class="tm-npcp__reply-actions">
                        <span class="tm-npcp__reply-hint">@Loc["TmNotionPageComment_ReplyHint"]</span>
                        <button class="tm-npcp__reply-send" type="button"
                                disabled="@(string.IsNullOrWhiteSpace(_newCommentText) || _submitting)"
                                @onclick="SendNewCommentAsync">
                            @if (_submitting)
                            {
                                <span class="tm-npcp__spinner tm-npcp__spinner--sm" aria-hidden="true"></span>
                            }
                            @Loc["TmNotionPageComment_Comment"]
                        </button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="tm-npcp__error" role="alert">@_error</div>
            }

        </div>
    }

</div>
