@namespace Tempo.Blazor.Components.NotionEditor.UI
@using Tempo.Blazor.NotionEditor.Enums

@if (Visible)
{
    @* ── Transparent backdrop — click outside to close ────────────────────── *@
    <div class="tm-notion-slash-backdrop" @onclick="HandleBackdropClickAsync" aria-hidden="true"></div>

    @* ── Menu card ─────────────────────────────────────────────────────────── *@
    <div class="tm-notion-slash"
         role="dialog"
         aria-label="@Loc["TmNotionSlashMenu_SearchPlaceholder"]"
         style="top:@(_top)px;left:@(_left)px"
         @ref="_menuRef"
         @onkeydown:stopPropagation="true">

        @* ── Search input ──────────────────────────────────────────────────── *@
        <div class="tm-notion-slash__search">
            <svg class="tm-notion-slash__search-icon" width="14" height="14" viewBox="0 0 14 14"
                 fill="none" aria-hidden="true">
                <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/>
                <path d="M9.5 9.5l3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            <input class="tm-notion-slash__input"
                   type="text"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="@Loc["TmNotionSlashMenu_SearchPlaceholder"]"
                   value="@_query"
                   @ref="_inputRef"
                   @oninput="HandleQueryInputAsync"
                   @onkeydown="HandleKeyDownAsync" />
        </div>

        @* ── Item list ─────────────────────────────────────────────────────── *@
        <div class="tm-notion-slash__list" role="listbox" @ref="_listRef">
            @if (_groups.Count == 0)
            {
                <div class="tm-notion-slash__empty">@Loc["TmNotionSlashMenu_NoResults"]</div>
            }
            else
            {
                var flatIdx = 0;
                @foreach (var (category, items) in _groups)
                {
                    <div class="tm-notion-slash__group" role="group">
                        <div class="tm-notion-slash__group-label" role="presentation">
                            @CategoryLabel(category)
                        </div>
                        @foreach (var item in items)
                        {
                            var capturedIdx = flatIdx++;
                            var isSelected = capturedIdx == _selectedIndex;
                            <div class="tm-notion-slash__item @(isSelected ? "tm-notion-slash__item--selected" : "")"
                                 role="option"
                                 aria-selected="@isSelected"
                                 data-slash-idx="@capturedIdx"
                                 @onclick="() => SelectItemAsync(item)"
                                 @onmouseenter="() => _selectedIndex = capturedIdx">
                                <span class="tm-notion-slash__item-icon" aria-hidden="true">
                                    @((MarkupString)item.SvgIcon)
                                </span>
                                <span class="tm-notion-slash__item-body">
                                    <span class="tm-notion-slash__item-name">@Loc[item.Name]</span>
                                    <span class="tm-notion-slash__item-desc">@Loc[item.Description]</span>
                                </span>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}
