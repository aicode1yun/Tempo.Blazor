@namespace Tempo.Blazor.Components.Compliance
@inherits Tempo.Blazor.Components.TmComponentBase
@using System.Globalization
@using Tempo.Blazor.Abstractions.Models
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Components.Workflow

<div class="tm-kyc @Class" data-testid="@TestId("kyc-wizard")">

    <TmStepper Steps="StepItems"
               ActiveStep="_activeIndex"
               ShowDescriptions="false"
               OnStepClick="HandleStepClickAsync" />

    @if (_errors.Count > 0)
    {
        <div class="tm-kyc__errors" role="alert" data-testid="@TestId("kyc-errors")">
            <strong class="tm-kyc__errors-title">@Loc["TmKycWizard_ErrorsTitle"]</strong>
            <ul class="tm-kyc__errors-list">
                @foreach (var error in _errors)
                {
                    <li>@Loc[error.MessageKey]</li>
                }
            </ul>
        </div>
    }

    <div class="tm-kyc__body">
        @switch (CurrentStep)
        {
            case KycWizardStep.Subject:
                <section class="tm-kyc__step" data-testid="@TestId("kyc-step-subject")" aria-label="@Loc["TmKycWizard_Step_Subject"]">
                    <fieldset class="tm-kyc__kind" role="radiogroup" aria-label="@Loc["TmKycWizard_KindLabel"]">
                        <legend class="tm-kyc__field-label">@Loc["TmKycWizard_KindLabel"]</legend>
                        <label class="tm-kyc__kind-option">
                            <input type="radio"
                                   name="@KindRadioName"
                                   checked="@(_draft.SubjectKind == KycSubjectKind.Person)"
                                   data-testid="@TestId("kyc-kind-person")"
                                   @onchange="() => SetSubjectKind(KycSubjectKind.Person)" />
                            @Loc["TmKycWizard_KindPerson"]
                        </label>
                        <label class="tm-kyc__kind-option">
                            <input type="radio"
                                   name="@KindRadioName"
                                   checked="@(_draft.SubjectKind == KycSubjectKind.Company)"
                                   data-testid="@TestId("kyc-kind-company")"
                                   @onchange="() => SetSubjectKind(KycSubjectKind.Company)" />
                            @Loc["TmKycWizard_KindCompany"]
                        </label>
                    </fieldset>

                    @if (_draft.SubjectKind == KycSubjectKind.Person)
                    {
                        <div class="tm-kyc__grid">
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_FirstName"]</span>
                                <input type="text"
                                       value="@_draft.Person.FirstName"
                                       data-testid="@TestId("kyc-first-name")"
                                       @onchange="e => _draft.Person.FirstName = Text(e)" />
                                @FieldError("Person.FirstName")
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_LastName"]</span>
                                <input type="text"
                                       value="@_draft.Person.LastName"
                                       data-testid="@TestId("kyc-last-name")"
                                       @onchange="e => _draft.Person.LastName = Text(e)" />
                                @FieldError("Person.LastName")
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_DateOfBirth"]</span>
                                <input type="date"
                                       value="@DateValue(_draft.Person.DateOfBirth)"
                                       data-testid="@TestId("kyc-birth-date")"
                                       @onchange="e => _draft.Person.DateOfBirth = ParseDate(e)" />
                                @FieldError("Person.DateOfBirth")
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_Nationality"]</span>
                                <input type="text"
                                       value="@_draft.Person.Nationality"
                                       data-testid="@TestId("kyc-nationality")"
                                       @onchange="e => _draft.Person.Nationality = Text(e)" />
                                @FieldError("Person.Nationality")
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_PersonalIdNumber"]</span>
                                <input type="text"
                                       value="@_draft.Person.PersonalIdNumber"
                                       data-testid="@TestId("kyc-personal-id")"
                                       @onchange="e => _draft.Person.PersonalIdNumber = NullableText(e)" />
                            </label>
                        </div>
                    }
                    else
                    {
                        <div class="tm-kyc__grid">
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_CompanyName"]</span>
                                <input type="text"
                                       value="@_draft.Company.Name"
                                       data-testid="@TestId("kyc-company-name")"
                                       @onchange="e => _draft.Company.Name = Text(e)" />
                                @FieldError("Company.Name")
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_RegistrationNumber"]</span>
                                <input type="text"
                                       value="@_draft.Company.RegistrationNumber"
                                       data-testid="@TestId("kyc-company-regno")"
                                       @onchange="e => _draft.Company.RegistrationNumber = Text(e)" />
                                @FieldError("Company.RegistrationNumber")
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_LegalForm"]</span>
                                <input type="text"
                                       value="@_draft.Company.LegalForm"
                                       data-testid="@TestId("kyc-company-legal-form")"
                                       @onchange="e => _draft.Company.LegalForm = NullableText(e)" />
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_CompanyCountry"]</span>
                                <input type="text"
                                       value="@_draft.Company.Country"
                                       data-testid="@TestId("kyc-company-country")"
                                       @onchange="e => _draft.Company.Country = Text(e)" />
                                @FieldError("Company.Country")
                            </label>
                        </div>
                    }
                </section>
                break;

            case KycWizardStep.Documents:
                <section class="tm-kyc__step" data-testid="@TestId("kyc-step-documents")" aria-label="@Loc["TmKycWizard_Step_Documents"]">
                    @FieldError("Documents")
                    @if (_draft.Documents.Count == 0)
                    {
                        <p class="tm-kyc__hint">@Loc["TmKycWizard_NoDocuments"]</p>
                    }
                    @for (var i = 0; i < _draft.Documents.Count; i++)
                    {
                        var index = i;
                        var document = _draft.Documents[index];
                        <div class="tm-kyc__row" data-testid="@TestId("kyc-doc-row")">
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_DocKind"]</span>
                                <select data-testid="@TestId("kyc-doc-kind")"
                                        @onchange="e => document.Kind = ParseEnum(e, document.Kind)">
                                    @foreach (var kind in Enum.GetValues<KycDocumentKind>())
                                    {
                                        <option value="@kind" selected="@(kind == document.Kind)">@DocumentKindLabel(kind)</option>
                                    }
                                </select>
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_DocNumber"]</span>
                                <input type="text"
                                       value="@document.Number"
                                       data-testid="@TestId("kyc-doc-number")"
                                       @onchange="e => document.Number = Text(e)" />
                                @FieldError($"Documents[{index}].Number")
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_DocIssuedBy"]</span>
                                <input type="text"
                                       value="@document.IssuedBy"
                                       data-testid="@TestId("kyc-doc-issuer")"
                                       @onchange="e => document.IssuedBy = Text(e)" />
                                @FieldError($"Documents[{index}].IssuedBy")
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_DocValidUntil"]</span>
                                <input type="date"
                                       value="@DateValue(document.ValidUntil)"
                                       data-testid="@TestId("kyc-doc-valid-until")"
                                       @onchange="e => document.ValidUntil = ParseDate(e)" />
                                @FieldError($"Documents[{index}].ValidUntil")
                            </label>
                            <button type="button"
                                    class="tm-kyc__icon-btn"
                                    title="@Loc["TmKycWizard_RemoveDocument"]"
                                    aria-label="@Loc["TmKycWizard_RemoveDocument"]"
                                    data-testid="@TestId("kyc-doc-remove")"
                                    @onclick="() => _draft.Documents.Remove(document)">
                                <TmIcon Name="x" Size="IconSize.Xs" />
                            </button>
                        </div>
                    }
                    <button type="button"
                            class="tm-kyc__btn"
                            data-testid="@TestId("kyc-add-document")"
                            @onclick="() => _draft.Documents.Add(new KycDocument())">
                        <TmIcon Name="plus" Size="IconSize.Xs" />
                        @Loc["TmKycWizard_AddDocument"]
                    </button>
                </section>
                break;

            case KycWizardStep.Addresses:
                <section class="tm-kyc__step" data-testid="@TestId("kyc-step-addresses")" aria-label="@Loc["TmKycWizard_Step_Addresses"]">
                    @FieldError("Addresses")
                    @if (_draft.Addresses.Count == 0)
                    {
                        <p class="tm-kyc__hint">@Loc["TmKycWizard_NoAddresses"]</p>
                    }
                    @for (var i = 0; i < _draft.Addresses.Count; i++)
                    {
                        var index = i;
                        var address = _draft.Addresses[index];
                        <div class="tm-kyc__row" data-testid="@TestId("kyc-address-row")">
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_AddrKind"]</span>
                                <select data-testid="@TestId("kyc-addr-kind")"
                                        @onchange="e => address.Kind = ParseEnum(e, address.Kind)">
                                    @foreach (var kind in Enum.GetValues<KycAddressKind>())
                                    {
                                        <option value="@kind" selected="@(kind == address.Kind)">@AddressKindLabel(kind)</option>
                                    }
                                </select>
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_Street"]</span>
                                <input type="text"
                                       value="@address.Street"
                                       data-testid="@TestId("kyc-addr-street")"
                                       @onchange="e => address.Street = Text(e)" />
                                @FieldError($"Addresses[{index}].Street")
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_City"]</span>
                                <input type="text"
                                       value="@address.City"
                                       data-testid="@TestId("kyc-addr-city")"
                                       @onchange="e => address.City = Text(e)" />
                                @FieldError($"Addresses[{index}].City")
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_PostalCode"]</span>
                                <input type="text"
                                       value="@address.PostalCode"
                                       data-testid="@TestId("kyc-addr-postal")"
                                       @onchange="e => address.PostalCode = Text(e)" />
                                @FieldError($"Addresses[{index}].PostalCode")
                            </label>
                            <label class="tm-kyc__field">
                                <span class="tm-kyc__field-label">@Loc["TmKycWizard_Country"]</span>
                                <input type="text"
                                       value="@address.Country"
                                       data-testid="@TestId("kyc-addr-country")"
                                       @onchange="e => address.Country = Text(e)" />
                                @FieldError($"Addresses[{index}].Country")
                            </label>
                            <button type="button"
                                    class="tm-kyc__icon-btn"
                                    title="@Loc["TmKycWizard_RemoveAddress"]"
                                    aria-label="@Loc["TmKycWizard_RemoveAddress"]"
                                    data-testid="@TestId("kyc-addr-remove")"
                                    @onclick="() => _draft.Addresses.Remove(address)">
                                <TmIcon Name="x" Size="IconSize.Xs" />
                            </button>
                        </div>
                    }
                    <button type="button"
                            class="tm-kyc__btn"
                            data-testid="@TestId("kyc-add-address")"
                            @onclick="() => _draft.Addresses.Add(new KycAddress())">
                        <TmIcon Name="plus" Size="IconSize.Xs" />
                        @Loc["TmKycWizard_AddAddress"]
                    </button>
                </section>
                break;

            case KycWizardStep.Ownership:
                <section class="tm-kyc__step" data-testid="@TestId("kyc-step-ownership")" aria-label="@Loc["TmKycWizard_Step_Ownership"]">
                    <p class="tm-kyc__ownership-subject">
                        @(string.IsNullOrWhiteSpace(_draft.Company.Name) ? Loc["TmKycWizard_OwnershipSubject"] : _draft.Company.Name)
                    </p>
                    @FieldError("OwnershipRoot.Children")
                    @if (_draft.OwnershipRoot.Children.Count == 0)
                    {
                        <p class="tm-kyc__hint">@Loc["TmKycWizard_NoOwners"]</p>
                    }
                    @OwnerEditor(_draft.OwnershipRoot, "OwnershipRoot")
                    <button type="button"
                            class="tm-kyc__btn"
                            data-testid="@TestId("kyc-add-owner")"
                            @onclick="() => AddOwner(_draft.OwnershipRoot)">
                        <TmIcon Name="plus" Size="IconSize.Xs" />
                        @Loc["TmKycWizard_AddOwner"]
                    </button>
                </section>
                break;

            case KycWizardStep.Declarations:
                <section class="tm-kyc__step" data-testid="@TestId("kyc-step-declarations")" aria-label="@Loc["TmKycWizard_Step_Declarations"]">
                    <fieldset class="tm-kyc__kind" role="radiogroup" aria-label="@Loc["TmKycWizard_PepQuestion"]">
                        <legend class="tm-kyc__field-label">@Loc["TmKycWizard_PepQuestion"]</legend>
                        <label class="tm-kyc__kind-option">
                            <input type="radio"
                                   name="@PepRadioName"
                                   checked="@(_draft.Declarations.IsPoliticallyExposed == true)"
                                   data-testid="@TestId("kyc-pep-yes")"
                                   @onchange="() => _draft.Declarations.IsPoliticallyExposed = true" />
                            @Loc["TmKycWizard_PepYes"]
                        </label>
                        <label class="tm-kyc__kind-option">
                            <input type="radio"
                                   name="@PepRadioName"
                                   checked="@(_draft.Declarations.IsPoliticallyExposed == false)"
                                   data-testid="@TestId("kyc-pep-no")"
                                   @onchange="() => _draft.Declarations.IsPoliticallyExposed = false" />
                            @Loc["TmKycWizard_PepNo"]
                        </label>
                        @FieldError("Declarations.IsPoliticallyExposed")
                    </fieldset>

                    <label class="tm-kyc__field">
                        <span class="tm-kyc__field-label">@Loc["TmKycWizard_SourceOfFunds"]</span>
                        <input type="text"
                               value="@_draft.Declarations.SourceOfFunds"
                               data-testid="@TestId("kyc-source-of-funds")"
                               @onchange="e => _draft.Declarations.SourceOfFunds = Text(e)" />
                        @FieldError("Declarations.SourceOfFunds")
                    </label>

                    <label class="tm-kyc__field">
                        <span class="tm-kyc__field-label">@Loc["TmKycWizard_DeclarationNote"]</span>
                        <textarea value="@_draft.Declarations.Note"
                                  data-testid="@TestId("kyc-declaration-note")"
                                  @onchange="e => _draft.Declarations.Note = NullableText(e)"></textarea>
                    </label>

                    <label class="tm-kyc__consent">
                        <input type="checkbox"
                               checked="@_draft.Declarations.ConsentGiven"
                               data-testid="@TestId("kyc-consent")"
                               @onchange="e => _draft.Declarations.ConsentGiven = e.Value is bool b && b" />
                        @Loc["TmKycWizard_Consent"]
                        @FieldError("Declarations.ConsentGiven")
                    </label>
                </section>
                break;

            case KycWizardStep.Review:
                <section class="tm-kyc__step tm-kyc__review" data-testid="@TestId("kyc-step-review")" aria-label="@Loc["TmKycWizard_Step_Review"]">
                    <dl class="tm-kyc__review-section" data-testid="@TestId("kyc-review-section")">
                        <dt>@Loc["TmKycWizard_Step_Subject"]</dt>
                        @if (_draft.SubjectKind == KycSubjectKind.Person)
                        {
                            <dd>@_draft.Person.FirstName @_draft.Person.LastName@(_draft.Person.DateOfBirth is { } dob ? $" · {FormatDate(dob)}" : string.Empty) · @_draft.Person.Nationality</dd>
                        }
                        else
                        {
                            <dd>@_draft.Company.Name (@_draft.Company.RegistrationNumber) · @_draft.Company.Country</dd>
                        }
                    </dl>
                    <dl class="tm-kyc__review-section" data-testid="@TestId("kyc-review-section")">
                        <dt>@Loc["TmKycWizard_Step_Documents"]</dt>
                        @foreach (var document in _draft.Documents)
                        {
                            <dd>@DocumentKindLabel(document.Kind) · @document.Number</dd>
                        }
                    </dl>
                    <dl class="tm-kyc__review-section" data-testid="@TestId("kyc-review-section")">
                        <dt>@Loc["TmKycWizard_Step_Addresses"]</dt>
                        @foreach (var address in _draft.Addresses)
                        {
                            <dd>@AddressKindLabel(address.Kind) · @address.Street, @address.City</dd>
                        }
                    </dl>
                    @if (_draft.SubjectKind == KycSubjectKind.Company)
                    {
                        <dl class="tm-kyc__review-section" data-testid="@TestId("kyc-review-section")">
                            <dt>@Loc["TmKycWizard_Step_Ownership"]</dt>
                            @foreach (var owner in FlattenOwners(_draft.OwnershipRoot))
                            {
                                <dd>@owner.Name · @owner.SharePercent.ToString("0.##", CultureInfo.CurrentCulture) %</dd>
                            }
                        </dl>
                    }
                    <dl class="tm-kyc__review-section" data-testid="@TestId("kyc-review-section")">
                        <dt>@Loc["TmKycWizard_Step_Declarations"]</dt>
                        <dd>@Loc["TmKycWizard_PepQuestion"]: @(_draft.Declarations.IsPoliticallyExposed == true ? Loc["TmKycWizard_PepYes"] : Loc["TmKycWizard_PepNo"])</dd>
                        <dd>@Loc["TmKycWizard_SourceOfFunds"]: @_draft.Declarations.SourceOfFunds</dd>
                    </dl>
                </section>
                break;
        }
    </div>

    @if (_submissionResult is { Success: true })
    {
        <div class="tm-kyc__submitted" role="status" data-testid="@TestId("kyc-submitted")">
            @string.Format(Loc["TmKycWizard_Submitted"], _submissionResult.SubmissionId)
        </div>
    }
    @if (_draftSavedAt is not null && _submissionResult is null)
    {
        <div class="tm-kyc__saved" role="status" data-testid="@TestId("kyc-draft-saved")">
            @Loc["TmKycWizard_DraftSaved"]
        </div>
    }

    <div class="tm-kyc__actions">
        <button type="button"
                class="tm-kyc__btn"
                disabled="@(_activeIndex == 0 || _busy)"
                data-testid="@TestId("kyc-back")"
                @onclick="BackAsync">
            @Loc["TmKycWizard_Back"]
        </button>
        <button type="button"
                class="tm-kyc__btn"
                disabled="@_busy"
                data-testid="@TestId("kyc-save-draft")"
                @onclick="SaveDraftAsync">
            @Loc["TmKycWizard_SaveDraft"]
        </button>
        @if (CurrentStep != KycWizardStep.Review)
        {
            <button type="button"
                    class="tm-kyc__btn tm-kyc__btn--primary"
                    disabled="@_busy"
                    data-testid="@TestId("kyc-next")"
                    @onclick="NextAsync">
                @Loc["TmKycWizard_Next"]
            </button>
        }
        else
        {
            <button type="button"
                    class="tm-kyc__btn tm-kyc__btn--primary"
                    disabled="@(_busy || _submissionResult is { Success: true })"
                    data-testid="@TestId("kyc-submit")"
                    @onclick="SubmitAsync">
                @Loc["TmKycWizard_Submit"]
            </button>
        }
    </div>
</div>

@code {
    private RenderFragment OwnerEditor(KycOwnershipNode parent, string parentPath) => __builder =>
    {
        @for (var i = 0; i < parent.Children.Count; i++)
        {
            var index = i;
            var child = parent.Children[index];
            var childPath = $"{parentPath}.Children[{index}]";
            <div class="tm-kyc__owner">
                <div class="tm-kyc__row" data-testid="@TestId("kyc-owner-row")">
                    <label class="tm-kyc__field">
                        <span class="tm-kyc__field-label">@Loc["TmKycWizard_OwnerName"]</span>
                        <input type="text"
                               value="@child.Name"
                               data-testid="@TestId("kyc-owner-name")"
                               @onchange="e => child.Name = Text(e)" />
                        @FieldError($"{childPath}.Name")
                    </label>
                    <label class="tm-kyc__field tm-kyc__field--narrow">
                        <span class="tm-kyc__field-label">@Loc["TmKycWizard_SharePercent"]</span>
                        <input type="number"
                               min="0"
                               max="100"
                               step="0.01"
                               value="@child.SharePercent.ToString("0.##", CultureInfo.InvariantCulture)"
                               data-testid="@TestId("kyc-owner-share")"
                               @onchange="e => child.SharePercent = ParseDecimal(e)" />
                        @FieldError($"{childPath}.SharePercent")
                    </label>
                    <label class="tm-kyc__consent">
                        <input type="checkbox"
                               checked="@child.IsBeneficialOwner"
                               data-testid="@TestId("kyc-owner-bo")"
                               @onchange="e => child.IsBeneficialOwner = e.Value is bool b && b" />
                        @Loc["TmKycWizard_BeneficialOwner"]
                    </label>
                    <button type="button"
                            class="tm-kyc__icon-btn"
                            title="@Loc["TmKycWizard_AddChildOwner"]"
                            aria-label="@Loc["TmKycWizard_AddChildOwner"]"
                            data-testid="@TestId("kyc-owner-add-child")"
                            @onclick="() => AddOwner(child)">
                        <TmIcon Name="plus" Size="IconSize.Xs" />
                    </button>
                    <button type="button"
                            class="tm-kyc__icon-btn"
                            title="@Loc["TmKycWizard_RemoveOwner"]"
                            aria-label="@Loc["TmKycWizard_RemoveOwner"]"
                            data-testid="@TestId("kyc-owner-remove")"
                            @onclick="() => parent.Children.Remove(child)">
                        <TmIcon Name="x" Size="IconSize.Xs" />
                    </button>
                </div>
                @FieldError($"{childPath}.Children")
                @if (child.Children.Count > 0)
                {
                    <div class="tm-kyc__owner-children">
                        @OwnerEditor(child, childPath)
                    </div>
                }
            </div>
        }
    };

    private RenderFragment? FieldError(string fieldPath)
    {
        var key = FieldErrorKey(fieldPath);
        if (key is null)
        {
            return null;
        }

        return @<span class="tm-kyc__field-error" data-testid="@TestId("kyc-field-error")">@Loc[key]</span>;
    }
}
