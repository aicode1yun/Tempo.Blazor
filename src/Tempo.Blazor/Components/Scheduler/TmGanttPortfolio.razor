@namespace Tempo.Blazor.Components.Scheduler
@using Tempo.Blazor.Abstractions.Models

<div class="tm-gantt-portfolio">
    @foreach (var project in Projects)
    {
        <div class="tm-gantt-portfolio__project" data-testid="@($"portfolio-project-{project.Id}")">
            <div class="tm-gantt-portfolio__project-header">
                <span class="tm-gantt-portfolio__project-name">@project.Name</span>
            </div>
            <div class="tm-gantt-portfolio__project-summary">
                <TmGantt Data="project.Tasks.ToList()"
                         Dependencies="project.Dependencies" />
            </div>
        </div>
    }
</div>
