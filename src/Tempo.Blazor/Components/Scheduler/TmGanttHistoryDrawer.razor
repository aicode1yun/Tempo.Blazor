@namespace Tempo.Blazor.Components.Scheduler
@using Tempo.Blazor.Abstractions.Models

@if (IsOpen)
{
    <div class="tm-gantt__history-drawer" data-testid="gantt-history-drawer">
        <div class="tm-gantt__history-drawer-header">
            <span class="tm-gantt__history-drawer-title">@Loc["TmGantt_History"]</span>
            <button type="button" class="tm-gantt__dialog-close" @onclick="OnClose">
                <TmIcon Name="x" />
            </button>
        </div>
        <div class="tm-gantt__history-drawer-body">
            @if (History is null || !History.Any())
            {
                <div class="tm-gantt__history-empty">
                    <TmIcon Name="clock" Size="IconSize.Lg" />
                    <span>@Loc["TmGantt_History"]</span>
                </div>
            }
            else
            {
                <ul class="tm-gantt__history-list">
                    @foreach (var entry in History.OrderByDescending(e => e.Timestamp))
                    {
                        <li class="tm-gantt__history-entry" data-testid="history-entry-@entry.Id">
                            <div class="tm-gantt__history-entry-header">
                                <span class="tm-gantt__history-entry-type">@GetChangeTypeLabel(entry.ChangeType)</span>
                                <span class="tm-gantt__history-entry-author">@entry.Author</span>
                                <span class="tm-gantt__history-entry-time">@entry.Timestamp.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            @if (entry.OldValue is not null || entry.NewValue is not null)
                            {
                                <div class="tm-gantt__history-entry-values">
                                    @if (entry.OldValue is not null)
                                    {
                                        <span class="tm-gantt__history-old">@entry.OldValue</span>
                                        <TmIcon Name="arrow-right" Size="IconSize.Xs" />
                                    }
                                    @if (entry.NewValue is not null)
                                    {
                                        <span class="tm-gantt__history-new">@entry.NewValue</span>
                                    }
                                </div>
                            }
                            <div class="tm-gantt__history-entry-actions">
                                <TmButton Size="ButtonSize.Xs" Variant="ButtonVariant.Ghost"
                                          OnClick="() => TimeTravelAsync(entry.Timestamp)"
                                          data-testid="@($"history-timetravel-{entry.Id}")">
                                    <TmIcon Name="clock" Size="IconSize.Xs" />
                                    @Loc["TmGantt_TimeTravel"]
                                </TmButton>
                                <TmButton Size="ButtonSize.Xs" Variant="ButtonVariant.Ghost"
                                          OnClick="() => RollbackAsync(entry)"
                                          data-testid="@($"history-rollback-{entry.Id}")">
                                    <TmIcon Name="rotate-ccw" Size="IconSize.Xs" />
                                    @Loc["TmGantt_Rollback"]
                                </TmButton>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}
