@namespace Tempo.Blazor.Components.Spreadsheet
@using Tempo.Blazor.Components.Spreadsheet.Enums
@using Tempo.Blazor.Components.Spreadsheet.Models

<div class="tm-spreadsheet-toolbar">
    <!-- Tab Headers -->
    <div class="tm-spreadsheet-toolbar__tabs">
        @foreach (var tab in _tabs)
        {
            <button class="tm-spreadsheet-toolbar__tab @(ActiveTab == tab ? "tm-spreadsheet-toolbar__tab--active" : "")"
                    @onclick="() => ActiveTab = tab">
                @Loc[$"TmSpreadsheet_Tab{tab}"]
            </button>
        }
    </div>

    <!-- Home Tab -->
    @if (ActiveTab == "Home")
    {
        <div class="tm-spreadsheet-toolbar__tab-content">
            <!-- Clipboard Group -->
            <div class="tm-spreadsheet-toolbar__group">
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_Undo"]"
                        @onclick="OnUndo"
                        disabled="@(!CanUndo)">
                    <TmIcon Name="undo" />
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_Redo"]"
                        @onclick="OnRedo"
                        disabled="@(!CanRedo)">
                    <TmIcon Name="redo" />
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_Copy"]"
                        @onclick="OnCopy">
                    <TmIcon Name="copy" />
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_Cut"]"
                        @onclick="OnCut">
                    <TmIcon Name="cut" />
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_Paste"]"
                        @onclick="OnPaste">
                    <TmIcon Name="paste" />
                </button>
                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(IsFormatPainterActive)"
                        title="@Loc["TmSpreadsheet_FormatPainter"]"
                        @onclick="OnFormatPainterClick"
                        @ondblclick="OnFormatPainterDoubleClick">
                    <TmIcon Name="format-painter" />
                </button>
            </div>

            <div class="tm-spreadsheet-toolbar__divider"></div>

            <!-- Insert / Delete Group -->
            <div class="tm-spreadsheet-toolbar__group">
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_InsertRow"]"
                        @onclick="OnInsertRow">
                    <TmIcon Name="insert-row" />
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_DeleteRow"]"
                        @onclick="OnDeleteRow">
                    <TmIcon Name="delete-row" />
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_InsertColumn"]"
                        @onclick="OnInsertColumn">
                    <TmIcon Name="insert-column" />
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_DeleteColumn"]"
                        @onclick="OnDeleteColumn">
                    <TmIcon Name="delete-column" />
                </button>
            </div>

            <div class="tm-spreadsheet-toolbar__divider"></div>

            <!-- Font Group -->
            <div class="tm-spreadsheet-toolbar__group">
                <TmSelect Value="SelectedFontFamily"
                          ValueChanged="OnFontFamilyChanged"
                          Options="_fontOptions"
                          Class="tm-spreadsheet-toolbar__select" />

                <TmSelect Value="SelectedFontSize"
                          ValueChanged="OnFontSizeChanged"
                          Options="_fontSizeOptions"
                          Class="tm-spreadsheet-toolbar__select tm-spreadsheet-toolbar__select--narrow" />

                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(IsBold)"
                        title="@Loc["TmSpreadsheet_Bold"]"
                        @onclick="OnBoldToggle">
                    <strong>B</strong>
                </button>
                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(IsItalic)"
                        title="@Loc["TmSpreadsheet_Italic"]"
                        @onclick="OnItalicToggle">
                    <em>I</em>
                </button>
                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(IsUnderline)"
                        title="@Loc["TmSpreadsheet_Underline"]"
                        @onclick="OnUnderlineToggle">
                    <u>U</u>
                </button>
                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(IsStrikeThrough)"
                        title="@Loc["TmSpreadsheet_Strikethrough"]"
                        @onclick="OnStrikeThroughToggle">
                    <s>S</s>
                </button>
            </div>

            <div class="tm-spreadsheet-toolbar__divider"></div>

            <!-- Indent Group -->
            <div class="tm-spreadsheet-toolbar__group">
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_IndentDecrease"]"
                        @onclick="OnIndentDecrease">
                    ←|
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_IndentIncrease"]"
                        @onclick="OnIndentIncrease">
                    |→
                </button>
            </div>

            <div class="tm-spreadsheet-toolbar__divider"></div>

            <!-- Text Color Picker -->
            <div class="tm-spreadsheet-toolbar__group">
                <div class="tm-color-picker-inline">
                    <button class="tm-spreadsheet-toolbar__button @GetActiveClass(HasTextColor)"
                            title="@Loc["TmSpreadsheet_TextColor"]"
                            @onclick="() => OnTextColorChanged.InvokeAsync(TextColor)">
                        <span class="tm-spreadsheet-toolbar__color-preview"
                              style="border-bottom-color: @(TextColor ?? "currentColor")">A</span>
                    </button>
                    <button class="tm-spreadsheet-toolbar__button tm-color-picker-inline__chevron"
                            title="@Loc["TmSpreadsheet_TextColorPicker"]"
                            @onclick="() => _isTextColorOpen = !_isTextColorOpen">
                        ▾
                    </button>
                    @if (_isTextColorOpen)
                    {
                        <div class="tm-color-picker-inline__dropdown" @onclick:stopPropagation>
                            <TmFlatColorPicker Value="@(TextColor ?? "#000000")"
                                               ValueChanged="OnTextColorSelected"
                                               ShowAlpha="false"
                                               ShowPreview="false"
                                               ShowClearButton="true" />
                        </div>
                    }
                </div>

                <!-- Background Color Picker -->
                <div class="tm-color-picker-inline">
                    <button class="tm-spreadsheet-toolbar__button @GetActiveClass(HasBackgroundColor)"
                            title="@Loc["TmSpreadsheet_BackgroundColor"]"
                            @onclick="() => OnBackgroundColorChanged.InvokeAsync(BackgroundColor)">
                        <span class="tm-spreadsheet-toolbar__color-preview tm-spreadsheet-toolbar__color-preview--bg"
                              style="background: @(BackgroundColor ?? "transparent")">
                            <TmIcon Name="fill" />
                        </span>
                    </button>
                    <button class="tm-spreadsheet-toolbar__button tm-color-picker-inline__chevron"
                            title="@Loc["TmSpreadsheet_BackgroundColorPicker"]"
                            @onclick="() => _isBackgroundColorOpen = !_isBackgroundColorOpen">
                        ▾
                    </button>
                    @if (_isBackgroundColorOpen)
                    {
                        <div class="tm-color-picker-inline__dropdown" @onclick:stopPropagation>
                            <TmFlatColorPicker Value="@(BackgroundColor ?? "transparent")"
                                               ValueChanged="OnBackgroundColorSelected"
                                               ShowAlpha="false"
                                               ShowPreview="false"
                                               ShowClearButton="true" />
                        </div>
                    }
                </div>
            </div>

            <div class="tm-spreadsheet-toolbar__divider"></div>

            <!-- Alignment Group -->
            <div class="tm-spreadsheet-toolbar__group">
                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(SelectedHorizontalAlign == "left")"
                        title="@Loc["TmSpreadsheet_AlignLeft"]"
                        @onclick="AlignLeft">
                    <TmIcon Name="align-left" />
                </button>
                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(SelectedHorizontalAlign == "center")"
                        title="@Loc["TmSpreadsheet_AlignCenter"]"
                        @onclick="AlignCenter">
                    <TmIcon Name="align-center" />
                </button>
                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(SelectedHorizontalAlign == "right")"
                        title="@Loc["TmSpreadsheet_AlignRight"]"
                        @onclick="AlignRight">
                    <TmIcon Name="align-right" />
                </button>
            </div>

            <div class="tm-spreadsheet-toolbar__divider"></div>

            <!-- Border Picker -->
            @if (_isBorderDropdownOpen)
            {
                <div class="tm-border-picker-overlay" @onclick="() => _isBorderDropdownOpen = false"></div>
            }
            <div class="tm-border-picker">
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc[$"TmSpreadsheet_Border_{_lastBorderPreset}"]"
                        @onclick="ApplyLastBorderPreset">
                    @GetBorderPresetIcon(_lastBorderPreset)
                </button>
                <button class="tm-spreadsheet-toolbar__button tm-border-picker__chevron"
                        title="@Loc["TmSpreadsheet_BorderPicker"]"
                        @onclick="() => _isBorderDropdownOpen = !_isBorderDropdownOpen">
                    ▾
                </button>
                @if (_isBorderDropdownOpen)
                {
                    <div class="tm-border-picker__dropdown" @onclick:stopPropagation>
                        <div class="tm-border-picker__section-label">@Loc["TmSpreadsheet_BorderSection_Borders"]</div>
                        <button class="tm-border-picker__item" @onclick="() => ApplyBorderPreset(BorderPreset.None)">
                            <span class="tm-border-picker__icon">☐</span> @Loc["TmSpreadsheet_BorderNone"]
                        </button>
                        <button class="tm-border-picker__item" @onclick="() => ApplyBorderPreset(BorderPreset.AllBorders)">
                            <span class="tm-border-picker__icon">⊞</span> @Loc["TmSpreadsheet_BorderAllBorders"]
                        </button>
                        <button class="tm-border-picker__item" @onclick="() => ApplyBorderPreset(BorderPreset.OutsideBorders)">
                            <span class="tm-border-picker__icon">▣</span> @Loc["TmSpreadsheet_BorderOutside"]
                        </button>
                        <button class="tm-border-picker__item" @onclick="() => ApplyBorderPreset(BorderPreset.ThickBox)">
                            <span class="tm-border-picker__icon">◼</span> @Loc["TmSpreadsheet_BorderThickBox"]
                        </button>
                        <div class="tm-border-picker__section-label">@Loc["TmSpreadsheet_BorderSection_Bottom"]</div>
                        <button class="tm-border-picker__item" @onclick="() => ApplyBorderPreset(BorderPreset.BottomBorder)">
                            <span class="tm-border-picker__icon">▬</span> @Loc["TmSpreadsheet_BorderBottom"]
                        </button>
                        <button class="tm-border-picker__item" @onclick="() => ApplyBorderPreset(BorderPreset.ThickBottom)">
                            <span class="tm-border-picker__icon">▰</span> @Loc["TmSpreadsheet_BorderThickBottom"]
                        </button>
                        <button class="tm-border-picker__item" @onclick="() => ApplyBorderPreset(BorderPreset.DoubleBottom)">
                            <span class="tm-border-picker__icon">═</span> @Loc["TmSpreadsheet_BorderDoubleBottom"]
                        </button>
                        <button class="tm-border-picker__item" @onclick="() => ApplyBorderPreset(BorderPreset.TopAndThickBottom)">
                            <span class="tm-border-picker__icon">⊟</span> @Loc["TmSpreadsheet_BorderTopAndThickBottom"]
                        </button>
                        <div class="tm-border-picker__section-label">@Loc["TmSpreadsheet_BorderSection_Other"]</div>
                        <button class="tm-border-picker__item" @onclick="() => ApplyBorderPreset(BorderPreset.TopBorder)">
                            <span class="tm-border-picker__icon">▭</span> @Loc["TmSpreadsheet_BorderTop"]
                        </button>
                        <button class="tm-border-picker__item" @onclick="() => ApplyBorderPreset(BorderPreset.LeftBorder)">
                            <span class="tm-border-picker__icon">▏</span> @Loc["TmSpreadsheet_BorderLeft"]
                        </button>
                        <button class="tm-border-picker__item" @onclick="() => ApplyBorderPreset(BorderPreset.RightBorder)">
                            <span class="tm-border-picker__icon">▕</span> @Loc["TmSpreadsheet_BorderRight"]
                        </button>
                        <div class="tm-border-picker__divider"></div>
                        <button class="tm-border-picker__item" @onclick="OpenBorderDialog">
                            <span class="tm-border-picker__icon">⚙</span> @Loc["TmSpreadsheet_MoreBorders"]
                        </button>
                    </div>
                }
            </div>

            <div class="tm-spreadsheet-toolbar__divider"></div>

            <!-- Number Format Group -->
            <div class="tm-spreadsheet-toolbar__group">
                <TmSelect Value="SelectedNumberFormat"
                          ValueChanged="OnNumberFormatChanged"
                          Options="_numberFormatOptions"
                          Class="tm-spreadsheet-toolbar__select tm-spreadsheet-toolbar__select--wide" />

                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(IsPercentageFormat)"
                        title="@Loc["TmSpreadsheet_PercentageFormat"]"
                        @onclick="OnPercentageFormat">
                    %
                </button>
                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(IsThousandsFormat)"
                        title="@Loc["TmSpreadsheet_ThousandsFormat"]"
                        @onclick="OnThousandsFormat">
                    ,
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_IncreaseDecimals"]"
                        @onclick="OnIncreaseDecimals">
                    .0→
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_DecreaseDecimals"]"
                        @onclick="OnDecreaseDecimals">
                    .00→
                </button>
            </div>

            <!-- Custom Home Tools -->
            @RenderCustomTools("Home")
        </div>
    }

    <!-- Insert Tab -->
    @if (ActiveTab == "Insert")
    {
        <div class="tm-spreadsheet-toolbar__tab-content">
            <div class="tm-spreadsheet-toolbar__group">
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_InsertLink"]"
                        @onclick="OnInsertLink">
                    <TmIcon Name="link" />
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_InsertImage"]"
                        @onclick="OnInsertImage">
                    <TmIcon Name="image" />
                </button>
            </div>

            @RenderCustomTools("Insert")
        </div>
    }

    <!-- View Tab -->
    @if (ActiveTab == "View")
    {
        <div class="tm-spreadsheet-toolbar__tab-content">
            <div class="tm-spreadsheet-toolbar__group">
                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(IsMergeCellsActive)"
                        title="@Loc["TmSpreadsheet_MergeCells"]"
                        @onclick="OnMergeCells">
                    <TmIcon Name="merge-cells" />
                </button>
                <button class="tm-spreadsheet-toolbar__button @GetActiveClass(ShowGridLines)"
                        title="@Loc["TmSpreadsheet_GridLines"]"
                        @onclick="OnToggleGridLines">
                    <TmIcon Name="grid" />
                </button>
            </div>

            @RenderCustomTools("View")
        </div>
    }

    <!-- File Tab -->
    @if (ActiveTab == "File")
    {
        <div class="tm-spreadsheet-toolbar__tab-content">
            <div class="tm-spreadsheet-toolbar__group">
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_Open"]"
                        @onclick="OnOpen">
                    <TmIcon Name="folder-open" />
                </button>
                <button class="tm-spreadsheet-toolbar__button"
                        title="@Loc["TmSpreadsheet_Download"]"
                        @onclick="OnDownload">
                    <TmIcon Name="download" />
                </button>
            </div>

            @RenderCustomTools("File")
        </div>
    }
</div>

@code {
    private readonly string[] _tabs = ["Home", "Insert", "View", "File"];

    private RenderFragment RenderCustomTools(string tab)
    {
        if (CustomTools is null) return builder => { };
        var tools = CustomTools.Where(t => t.Tab == tab).OrderBy(t => t.Order).ToList();
        if (tools.Count == 0) return builder => { };

        return builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "tm-spreadsheet-toolbar__group");
            builder.AddAttribute(2, "style", "margin-left:auto;");
            foreach (var tool in tools)
            {
                builder.OpenElement(3, "button");
                builder.AddAttribute(4, "class", $"tm-spreadsheet-toolbar__button {tool.CssClass}");
                builder.AddAttribute(5, "title", tool.Title);
                builder.AddAttribute(6, "onclick", EventCallback.Factory.Create(this, () => OnCustomToolClick.InvokeAsync(tool)));
                if (!string.IsNullOrEmpty(tool.IconName))
                {
                    // For simplicity, render icon name as text if component rendering is complex in code
                    builder.AddContent(7, tool.IconName);
                }
                else
                {
                    builder.AddContent(7, tool.Title);
                }
                builder.CloseElement();
            }
            builder.CloseElement();
        };
    }
}
