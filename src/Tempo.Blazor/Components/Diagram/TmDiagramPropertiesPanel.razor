@namespace Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Components.Diagram.Commands
@using Tempo.Blazor.Components.Diagram.Models

<div class="tm-diagram-properties @Class" data-collapsed="@_collapsed">
    <button type="button" class="tm-diagram-properties__toggle" @onclick="ToggleCollapse"
            aria-label="@Loc["TmDiagramProperties_Toggle"]" title="@Loc["TmDiagramProperties_Toggle"]">
        <TmIcon Name="@(_collapsed ? IconNames.ChevronLeft : IconNames.ChevronRight)" />
    </button>

    <div class="tm-diagram-properties__inner">
        <h3 class="tm-diagram-properties__title">@Loc["TmDiagramProperties_Title"]</h3>

        @if (IsMixedSelection)
        {
            <p class="tm-diagram-properties__empty">
                @SelectedNodes.Count @Loc["TmDiagramProperties_NodeTitle"] + @SelectedEdges.Count @Loc["TmDiagramProperties_EdgeTitle"]
            </p>
        }
        else if (SelectedNodes.Count > 0 && !ReadOnly)
        {
            @* ── Single Node Data Fields ───────────────────────────────────── *@
            @if (IsSingleNode && SelectedStencil?.Layout.Sections.Any(s => s.DataKey is not null && (s.Type == "text" || s.Type == "list")) == true)
            {
                <div class="tm-diagram-properties__section">
                    @foreach (var section in SelectedStencil.Layout.Sections.Where(s => s.DataKey is not null && (s.Type == "text" || s.Type == "list")))
                    {
                        <div class="tm-diagram-properties__field">
                            <label>@Capitalize(section.DataKey!)</label>
                            @if (section.Type == "list")
                            {
                                <textarea class="tm-text-input"
                                          style="min-height: 80px; font-family: inherit;"
                                          value="@GetNodeDataListText(section.DataKey!)"
                                          @onchange="e => OnNodeDataListChanged(section.DataKey!, e.Value?.ToString())"></textarea>
                            }
                            else
                            {
                                <TmTextInput Value="@GetNodeDataText(section.DataKey!)"
                                             ValueChanged="v => OnNodeDataTextChanged(section.DataKey!, v)" />
                            }
                        </div>
                    }
                </div>
            }

            @* ── Link Section ─────────────────────────────────────────────── *@
            <div class="tm-diagram-properties__section">
                <div class="tm-diagram-properties__field">
                    <label>@Loc["TmDiagramProperties_Link"]</label>
                    <div class="tm-diagram-properties__row">
                        <TmTextInput Value="@GetNodeLink()" ValueChanged="OnNodeLinkChanged" Placeholder="@Loc["TmDiagramProperties_LinkPlaceholder"]" />
                        <TmSelect TValue="string" Value="@GetNodeLinkPageId()" ValueChanged="OnNodeLinkPageChanged" Options="@_pageLinkOptions" />
                    </div>
                </div>
            </div>

            @* ── Style Section ─────────────────────────────────────────────── *@
            <div class="tm-diagram-properties__section tm-diagram-properties__section--collapsible">
                <button type="button" class="tm-diagram-properties__section-header" @onclick='() => ToggleSection("style")'>
                    <span>@Loc["TmDiagramProperties_Style"]</span>
                    <TmIcon Name="@(IsSectionExpanded("style") ? IconNames.ChevronDown : IconNames.ChevronRight)" />
                </button>
                @if (IsSectionExpanded("style"))
                {
                    <div class="tm-diagram-properties__section-body">
                        <div class="tm-diagram-properties__row">
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_Fill"]</label>
                                <div class="tm-diagram-properties__color-wrap">
                                    <input class="tm-text-input tm-diagram-properties__color" type="color" value="@GetNodeFill()" @onchange="OnNodeFillChanged" />
                                </div>
                            </div>
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_Stroke"]</label>
                                <div class="tm-diagram-properties__color-wrap">
                                    <input class="tm-text-input tm-diagram-properties__color" type="color" value="@GetNodeStroke()" @onchange="OnNodeStrokeChanged" />
                                </div>
                            </div>
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_StrokeWidth"]</label>
                            <input class="tm-text-input" type="number" step="0.5" min="0" value="@GetNodeStrokeWidth()" @onchange="OnNodeStrokeWidthChanged" />
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_Opacity"] (@(GetNodeOpacity())%)</label>
                            <input class="tm-diagram-properties__slider" type="range" min="0" max="100" step="5" value="@GetNodeOpacity()" @onchange="OnNodeOpacityChanged" />
                        </div>

                        @if (SelectedStencil?.Layout.SupportsCornerRadius != false)
                        {
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_Radius"]</label>
                                <input class="tm-text-input" type="number" step="1" min="0" value="@GetNodeRadius()" @onchange="OnNodeRadiusChanged" />
                            </div>
                        }

                        <div class="tm-diagram-properties__field tm-diagram-properties__field--inline">
                            <TmCheckbox Value="@GetNodeShadow()" ValueChanged="OnNodeShadowChanged" Label="@Loc["TmDiagramProperties_Shadow"]" />
                        </div>
                    </div>
                }
            </div>

            @* ── Replace Shape Section (single node only) ─────────────────── *@
            @if (IsSingleNode && !ReadOnly)
            {
                <div class="tm-diagram-properties__section tm-diagram-properties__section--collapsible">
                    <button type="button" class="tm-diagram-properties__section-header" @onclick='() => ToggleSection("replaceShape")'>
                        <span>@Loc["TmDiagramProperties_ReplaceShape"]</span>
                        <TmIcon Name="@(IsSectionExpanded("replaceShape") ? IconNames.ChevronDown : IconNames.ChevronRight)" />
                    </button>
                    @if (IsSectionExpanded("replaceShape"))
                    {
                        <div class="tm-diagram-properties__section-body">
                            <div class="tm-diagram-properties__field">
                                <TmSearchInput Value="_replaceShapeSearch"
                                               ValueChanged="OnReplaceShapeSearchChanged"
                                               Placeholder="@Loc["TmDiagramProperties_ReplaceShapeSearch"]"
                                               Clearable="true" />
                            </div>
                            <div class="tm-diagram-replace-shape__list">
                                @foreach (var cat in ReplaceShapeCategories)
                                {
                                    var stencils = GetReplaceShapeStencils(cat);
                                    if (stencils.Count == 0) continue;

                                    <div class="tm-diagram-replace-shape__category">
                                        <span class="tm-diagram-replace-shape__category-name">@cat</span>
                                        <div class="tm-diagram-replace-shape__items">
                                            @foreach (var stencil in stencils)
                                            {
                                                <button type="button"
                                                        class="tm-diagram-replace-shape__item"
                                                        title="@stencil.Name"
                                                        @onclick="() => OnReplaceShape(stencil.Id)">
                                                    @if (!string.IsNullOrEmpty(stencil.IconSvg))
                                                    {
                                                        <svg viewBox="0 0 32 32" aria-hidden="true">
                                                            @((MarkupString)stencil.IconSvg)
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <svg viewBox="0 0 32 32" aria-hidden="true">
                                                            <rect x="2" y="8" width="28" height="16" rx="2"
                                                                  fill="var(--tm-color-surface-elevated)"
                                                                  stroke="var(--tm-color-text)" stroke-width="2" />
                                                        </svg>
                                                    }
                                                    <span>@stencil.Name</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @* ── Text Section ──────────────────────────────────────────────── *@
            <div class="tm-diagram-properties__section tm-diagram-properties__section--collapsible">
                <button type="button" class="tm-diagram-properties__section-header" @onclick='() => ToggleSection("text")'>
                    <span>@Loc["TmDiagramProperties_Text"]</span>
                    <TmIcon Name="@(IsSectionExpanded("text") ? IconNames.ChevronDown : IconNames.ChevronRight)" />
                </button>
                @if (IsSectionExpanded("text"))
                {
                    <div class="tm-diagram-properties__section-body">
                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_FontFamily"]</label>
                            <TmSelect TValue="string" Value="@GetNodeFontFamily()" ValueChanged="OnNodeFontFamilyChanged" Options="@_fontFamilyOptions" />
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_FontSize"]</label>
                            <input class="tm-text-input" type="number" step="1" min="6" value="@GetNodeFontSize()" @onchange="OnNodeFontSizeChanged" />
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_Color"]</label>
                            <div class="tm-diagram-properties__color-wrap">
                                <input class="tm-text-input tm-diagram-properties__color" type="color" value="@GetNodeColor()" @onchange="OnNodeColorChanged" />
                            </div>
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_TextAlign"]</label>
                            <TmSelect TValue="string" Value="@GetNodeTextAlign()" ValueChanged="OnNodeTextAlignChanged" Options="@_textAlignOptions" />
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_VerticalAlign"]</label>
                            <TmSelect TValue="string" Value="@GetNodeVerticalAlign()" ValueChanged="OnNodeVerticalAlignChanged" Options="@_verticalAlignOptions" />
                        </div>

                        <div class="tm-diagram-properties__field tm-diagram-properties__field--inline">
                            <label>@Loc["TmDiagram_EnableMathJax"]</label>
                            <TmToggle Value="GetNodeMathJax()" ValueChanged="OnNodeMathJaxChanged" />
                        </div>

                        <div class="tm-diagram-properties__row tm-diagram-properties__toggles">
                            <button type="button" class="tm-diagram-properties__toggle-btn @(GetNodeBold() ? "tm-diagram-properties__toggle-btn--active" : "")" @onclick="() => OnNodeBoldChanged(!GetNodeBold())">
                                <strong>B</strong>
                            </button>
                            <button type="button" class="tm-diagram-properties__toggle-btn @(GetNodeItalic() ? "tm-diagram-properties__toggle-btn--active" : "")" @onclick="() => OnNodeItalicChanged(!GetNodeItalic())">
                                <em>I</em>
                            </button>
                            <button type="button" class="tm-diagram-properties__toggle-btn @(GetNodeUnderline() ? "tm-diagram-properties__toggle-btn--active" : "")" @onclick="() => OnNodeUnderlineChanged(!GetNodeUnderline())">
                                <u>U</u>
                            </button>
                        </div>
                    </div>
                }
            </div>

            @* ── Arrange Section ───────────────────────────────────────────── *@
            <div class="tm-diagram-properties__section tm-diagram-properties__section--collapsible">
                <button type="button" class="tm-diagram-properties__section-header" @onclick='() => ToggleSection("arrange")'>
                    <span>@Loc["TmDiagramProperties_Arrange"]</span>
                    <TmIcon Name="@(IsSectionExpanded("arrange") ? IconNames.ChevronDown : IconNames.ChevronRight)" />
                </button>
                @if (IsSectionExpanded("arrange"))
                {
                    <div class="tm-diagram-properties__section-body">
                        <div class="tm-diagram-properties__row">
                            <div class="tm-diagram-properties__field">
                                <label>X</label>
                                <input class="tm-text-input" type="number" step="1" value="@(FirstSelectedNode?.X ?? 0)" @onchange="e => OnNodeXChanged(e.Value?.ToString())" />
                            </div>
                            <div class="tm-diagram-properties__field">
                                <label>Y</label>
                                <input class="tm-text-input" type="number" step="1" value="@(FirstSelectedNode?.Y ?? 0)" @onchange="e => OnNodeYChanged(e.Value?.ToString())" />
                            </div>
                        </div>

                        <div class="tm-diagram-properties__row">
                            <div class="tm-diagram-properties__field">
                                <label>W</label>
                                <input class="tm-text-input" type="number" step="1" min="20" value="@(FirstSelectedNode?.W ?? 0)" @onchange="e => OnNodeWChanged(e.Value?.ToString())" />
                            </div>
                            <div class="tm-diagram-properties__field">
                                <label>H</label>
                                <input class="tm-text-input" type="number" step="1" min="20" value="@(FirstSelectedNode?.H ?? 0)" @onchange="e => OnNodeHChanged(e.Value?.ToString())" />
                            </div>
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_ZIndex"]</label>
                            <input class="tm-text-input" type="number" step="1" value="@(FirstSelectedNode?.ZIndex ?? 0)" @onchange="e => OnNodeZChanged(e.Value?.ToString())" />
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_Layer"]</label>
                            <select class="tm-text-input" value="@(FirstSelectedNode?.LayerId ?? "")" @onchange="OnNodeLayerChanged">
                                <option value="">@Loc["TmDiagramLayers_DefaultLayer"]</option>
                                @foreach (var layer in SortedLayers)
                                {
                                    <option value="@layer.Id">@layer.Name</option>
                                }
                            </select>
                        </div>

                        <div class="tm-diagram-properties__row tm-diagram-properties__actions">
                            <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnBringToFront">@Loc["TmDiagramProperties_BringToFront"]</button>
                            <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnSendToBack">@Loc["TmDiagramProperties_SendToBack"]</button>
                        </div>

                        @if (CanGroup || CanUngroup)
                        {
                            <div class="tm-diagram-properties__row tm-diagram-properties__actions">
                                @if (CanGroup)
                                {
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnGroup">@Loc["TmDiagramProperties_Group"]</button>
                                }
                                @if (CanUngroup)
                                {
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnUngroup">@Loc["TmDiagramProperties_Ungroup"]</button>
                                }
                            </div>
                        }

                        @if (CanAlign)
                        {
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_TextAlign"]</label>
                                <div class="tm-diagram-properties__align-grid">
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnAlign("left")'>@Loc["TmDiagramProperties_AlignLeft"]</button>
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnAlign("center")'>@Loc["TmDiagramProperties_AlignCenter"]</button>
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnAlign("right")'>@Loc["TmDiagramProperties_AlignRight"]</button>
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnAlign("top")'>@Loc["TmDiagramProperties_AlignTop"]</button>
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnAlign("middle")'>@Loc["TmDiagramProperties_AlignMiddle"]</button>
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnAlign("bottom")'>@Loc["TmDiagramProperties_AlignBottom"]</button>
                                </div>
                            </div>
                        }

                        @if (CanDistribute)
                        {
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_Distribute"]</label>
                                <div class="tm-diagram-properties__align-grid">
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnDistribute("horizontal")'>@Loc["TmDiagramProperties_DistributeHorizontal"]</button>
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnDistribute("vertical")'>@Loc["TmDiagramProperties_DistributeVertical"]</button>
                                </div>
                            </div>
                        }

                        @if (CanLayout)
                        {
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagram_Layout"]</label>
                                <div class="tm-diagram-properties__align-grid">
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnApplyLayout.InvokeAsync(("dagre", "TB"))' title="@Loc["TmDiagram_LayoutHierarchicalTopDown_Tooltip"]">@Loc["TmDiagram_LayoutHierarchicalTopDown"]</button>
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnApplyLayout.InvokeAsync(("dagre", "LR"))' title="@Loc["TmDiagram_LayoutHierarchicalLeftRight_Tooltip"]">@Loc["TmDiagram_LayoutHierarchicalLeftRight"]</button>
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnApplyLayout.InvokeAsync(("tree", "TB"))' title="@Loc["TmDiagram_LayoutTree_Tooltip"]">@Loc["TmDiagram_LayoutTree"]</button>
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnApplyLayout.InvokeAsync(("force", ""))' title="@Loc["TmDiagram_LayoutForce_Tooltip"]">@Loc["TmDiagram_LayoutForce"]</button>
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnApplyLayout.InvokeAsync(("circle", ""))' title="@Loc["TmDiagram_LayoutCircle_Tooltip"]">@Loc["TmDiagram_LayoutCircle"]</button>
                                    <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick='() => OnApplyLayout.InvokeAsync(("grid", ""))' title="@Loc["TmDiagram_LayoutGrid_Tooltip"]">@Loc["TmDiagram_LayoutGrid"]</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* ── Swimlane Section ───────────────────────────────────────────── *@
            @if (IsSingleNode && FirstSelectedNode?.SwimlaneData is { } swimlane)
            {
                <div class="tm-diagram-properties__section tm-diagram-properties__section--collapsible">
                    <button type="button" class="tm-diagram-properties__section-header" @onclick='() => ToggleSection("swimlane")'>
                        <span>@Loc["TmDiagramProperties_Swimlane"]</span>
                        <TmIcon Name="@(IsSectionExpanded("swimlane") ? IconNames.ChevronDown : IconNames.ChevronRight)" />
                    </button>
                    @if (IsSectionExpanded("swimlane"))
                    {
                        <div class="tm-diagram-properties__section-body">
                            <div class="tm-diagram-properties__row tm-diagram-properties__actions">
                                <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnAddSwimlaneRow">@Loc["TmDiagramProperties_AddRow"]</button>
                                <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnRemoveSwimlaneRow">@Loc["TmDiagramProperties_RemoveRow"]</button>
                            </div>
                            <div class="tm-diagram-properties__row tm-diagram-properties__actions">
                                <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnAddSwimlaneColumn">@Loc["TmDiagramProperties_AddColumn"]</button>
                                <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnRemoveSwimlaneColumn">@Loc["TmDiagramProperties_RemoveColumn"]</button>
                            </div>

                            @if (swimlane.IsHorizontal)
                            {
                                <div class="tm-diagram-properties__field">
                                    <label>@Loc["TmDiagramProperties_RowHeights"]</label>
                                    @for (int i = 0; i < swimlane.RowCount; i++)
                                    {
                                        var idx = i;
                                        <div class="tm-diagram-properties__row">
                                            <span>Row @(idx + 1)</span>
                                            <input class="tm-text-input" type="number" step="1" min="20"
                                                   value="@GetSwimlaneRowSize(idx)"
                                                   @onchange="e => OnSwimlaneRowSizeChanged(idx, e.Value?.ToString())" />
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="tm-diagram-properties__field">
                                    <label>@Loc["TmDiagramProperties_ColumnWidths"]</label>
                                    @for (int i = 0; i < swimlane.ColumnCount; i++)
                                    {
                                        var idx = i;
                                        <div class="tm-diagram-properties__row">
                                            <span>Col @(idx + 1)</span>
                                            <input class="tm-text-input" type="number" step="1" min="20"
                                                   value="@GetSwimlaneColumnSize(idx)"
                                                   @onchange="e => OnSwimlaneColumnSizeChanged(idx, e.Value?.ToString())" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @* ── Table Section ──────────────────────────────────────────────── *@
            @if (IsSingleNode && FirstSelectedNode is { } tableNode && SelectedStencil?.IsTable == true)
            {
                <div class="tm-diagram-properties__section tm-diagram-properties__section--collapsible">
                    <button type="button" class="tm-diagram-properties__section-header" @onclick='() => ToggleSection("table")'>
                        <span>@Loc["TmDiagramProperties_Table"]</span>
                        <TmIcon Name="@(IsSectionExpanded("table") ? IconNames.ChevronDown : IconNames.ChevronRight)" />
                    </button>
                    @if (IsSectionExpanded("table"))
                    {
                        <div class="tm-diagram-properties__section-body">
                            <div class="tm-diagram-properties__row tm-diagram-properties__actions">
                                <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnAddTableRow">@Loc["TmDiagramProperties_AddRow"]</button>
                                <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnRemoveTableRow">@Loc["TmDiagramProperties_RemoveRow"]</button>
                            </div>
                            <div class="tm-diagram-properties__row tm-diagram-properties__actions">
                                <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnAddTableColumn">@Loc["TmDiagramProperties_AddColumn"]</button>
                                <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" @onclick="OnRemoveTableColumn">@Loc["TmDiagramProperties_RemoveColumn"]</button>
                            </div>

                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_TableCellSelection"]</label>
                                <div class="tm-diagram-properties__table-grid">
                                    @for (int r = 0; r < GetTableRowCount(); r++)
                                    {
                                        <div class="tm-diagram-properties__table-grid-row">
                                            @for (int c = 0; c < GetTableColumnCount(); c++)
                                            {
                                                var row = r;
                                                var col = c;
                                                bool isSelected = IsTableCellSelected(row, col);
                                                <button type="button"
                                                        class="tm-diagram-properties__table-grid-cell @(isSelected ? "tm-diagram-properties__table-grid-cell--selected" : "")"
                                                        @onclick="() => ToggleTableCellSelection(row, col)"
                                                        title="@GetTableCellText(row, col)">
                                                    @GetTableCellText(row, col)
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="tm-diagram-properties__row tm-diagram-properties__actions">
                                <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" disabled="@(!CanMergeTableCells())" @onclick="OnMergeTableCells">@Loc["TmDiagramProperties_MergeCells"]</button>
                                <button type="button" class="tm-btn tm-btn--secondary tm-btn--small" disabled="@(!CanSplitTableCells())" @onclick="OnSplitTableCell">@Loc["TmDiagramProperties_SplitCell"]</button>
                            </div>

                            @if (SelectedTableCells.Count == 1)
                            {
                                var cell = GetSelectedTableCell();
                                if (cell is not null)
                                {
                                    <div class="tm-diagram-properties__field">
                                        <label>@Loc["TmDiagramProperties_CellText"]</label>
                                        <TmTextInput Value="@cell.Text" ValueChanged="OnTableCellTextChanged" />
                                    </div>
                                    <div class="tm-diagram-properties__row">
                                        <div class="tm-diagram-properties__field">
                                            <label>@Loc["TmDiagramProperties_CellBackground"]</label>
                                            <div class="tm-diagram-properties__color-wrap">
                                                <input class="tm-text-input tm-diagram-properties__color" type="color" value="@(cell.Style?.BackgroundColor ?? "#ffffff")" @onchange="OnTableCellBackgroundChanged" />
                                            </div>
                                        </div>
                                        <div class="tm-diagram-properties__field">
                                            <label>@Loc["TmDiagramProperties_CellBorder"]</label>
                                            <div class="tm-diagram-properties__color-wrap">
                                                <input class="tm-text-input tm-diagram-properties__color" type="color" value="@(cell.Style?.BorderColor ?? "#e5e7eb")" @onchange="OnTableCellBorderChanged" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        }
        else if (SelectedEdges.Count > 0 && !ReadOnly)
        {
            @* ── Edge Style Section ────────────────────────────────────────── *@
            <div class="tm-diagram-properties__section tm-diagram-properties__section--collapsible">
                <button type="button" class="tm-diagram-properties__section-header" @onclick='() => ToggleSection("style")'>
                    <span>@Loc["TmDiagramProperties_Style"]</span>
                    <TmIcon Name="@(IsSectionExpanded("style") ? IconNames.ChevronDown : IconNames.ChevronRight)" />
                </button>
                @if (IsSectionExpanded("style"))
                {
                    <div class="tm-diagram-properties__section-body">
                        @if (IsSingleEdge)
                        {
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_Label"]</label>
                                <TmTextInput Value="@GetEdgeLabel()" ValueChanged="OnEdgeLabelChanged" />
                            </div>
                        }

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_Routing"]</label>
                            <TmSelect TValue="string" Value="@GetEdgeRouting()" ValueChanged="HandleEdgeRoutingChanged" Options="@_routingOptions" />
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_ConnectorType"]</label>
                            <TmSelect TValue="string" Value="@GetEdgeConnectorType()" ValueChanged="HandleConnectorTypeChanged" Options="@_connectorTypeOptions" />
                        </div>

                        <div class="tm-diagram-properties__row">
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_StartArrow"]</label>
                                <TmSelect TValue="string" Value="@GetEdgeStartArrow()" ValueChanged="OnEdgeStartArrowChanged" Options="@_arrowheadOptions" />
                            </div>
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_EndArrow"]</label>
                                <TmSelect TValue="string" Value="@GetEdgeEndArrow()" ValueChanged="OnEdgeEndArrowChanged" Options="@_arrowheadOptions" />
                            </div>
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_StrokeColor"]</label>
                            <div class="tm-diagram-properties__color-wrap">
                                <input class="tm-text-input tm-diagram-properties__color" type="color" value="@GetEdgeStrokeColor()" @onchange="OnEdgeStrokeColorChanged" />
                            </div>
                        </div>

                        <div class="tm-diagram-properties__row">
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_StrokeWidth"]</label>
                                <input class="tm-text-input" type="number" step="0.5" min="0.5" value="@GetEdgeStrokeWidth()" @onchange="OnEdgeStrokeWidthChanged" />
                            </div>
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_JumpSize"]</label>
                                <input class="tm-text-input" type="number" step="1" min="0" value="@GetEdgeJumpSize()" @onchange="OnEdgeJumpSizeChanged" />
                            </div>
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_StrokeDashPattern"]</label>
                            <TmSelect TValue="string" Value="@GetEdgeStrokeDashPattern()" ValueChanged="OnEdgeStrokeDashPatternChanged" Options="@_dashPatternOptions" />
                        </div>

                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_JumpStyle"]</label>
                            <TmSelect TValue="string" Value="@GetEdgeJumpStyle()" ValueChanged="OnEdgeJumpStyleChanged" Options="@_jumpStyleOptions" />
                        </div>

                        <div class="tm-diagram-properties__row">
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_SourceSpacing"]</label>
                                <input class="tm-text-input" type="number" step="1" min="0" value="@GetEdgeSourceSpacing()" @onchange="OnEdgeSourceSpacingChanged" />
                            </div>
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_TargetSpacing"]</label>
                                <input class="tm-text-input" type="number" step="1" min="0" value="@GetEdgeTargetSpacing()" @onchange="OnEdgeTargetSpacingChanged" />
                            </div>
                        </div>

                        <div class="tm-diagram-properties__field tm-diagram-properties__field--inline">
                            <TmCheckbox Value="@GetEdgeRounded()" ValueChanged="OnEdgeRoundedChanged" Label="@Loc["TmDiagramProperties_Rounded"]" />
                        </div>

                        <div class="tm-diagram-properties__row">
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_SourceCardinality"]</label>
                                <TmSelect TValue="string" Value="@GetEdgeSourceCardinality()" ValueChanged="OnEdgeSourceCardinalityChanged" Options="@_cardinalityOptions" />
                            </div>
                            <div class="tm-diagram-properties__field">
                                <label>@Loc["TmDiagramProperties_TargetCardinality"]</label>
                                <TmSelect TValue="string" Value="@GetEdgeTargetCardinality()" ValueChanged="OnEdgeTargetCardinalityChanged" Options="@_cardinalityOptions" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (SelectedIds.Length == 0)
        {
            @* ── Page Properties Section ───────────────────────────────────── *@
            <div class="tm-diagram-properties__section tm-diagram-properties__section--collapsible">
                <button type="button" class="tm-diagram-properties__section-header" @onclick='() => ToggleSection("page")'>
                    <span>@Loc["TmDiagramProperties_Page"]</span>
                    <TmIcon Name="@(IsSectionExpanded("page") ? IconNames.ChevronDown : IconNames.ChevronRight)" />
                </button>
                @if (IsSectionExpanded("page"))
                {
                    <div class="tm-diagram-properties__section-body">
                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_PageSize"]</label>
                            <TmSelect TValue="string" Value="@GetCurrentPageSizeKey()" ValueChanged="OnPageSizeChangedHandler" Options="@_pageSizeOptions" />
                        </div>
                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_PageOrientation"]</label>
                            <div class="tm-diagram-properties__row tm-diagram-properties__toggles">
                                <button type="button"
                                        class="tm-diagram-properties__toggle-btn @(GetPageOrientation() == "portrait" ? "tm-diagram-properties__toggle-btn--active" : "")"
                                        @onclick='() => OnOrientationChanged("portrait")'
                                        title="@Loc["TmDiagramProperties_Portrait"]">
                                    ⬍
                                </button>
                                <button type="button"
                                        class="tm-diagram-properties__toggle-btn @(GetPageOrientation() == "landscape" ? "tm-diagram-properties__toggle-btn--active" : "")"
                                        @onclick='() => OnOrientationChanged("landscape")'
                                        title="@Loc["TmDiagramProperties_Landscape"]">
                                    ⬌
                                </button>
                            </div>
                        </div>
                        <div class="tm-diagram-properties__row">
                            <div class="tm-diagram-properties__field">
                                <label>W</label>
                                <input class="tm-text-input" type="number" step="1" min="100" value="@((int)(Document?.Width ?? 3000))" @onchange="OnPageWidthChanged" />
                            </div>
                            <div class="tm-diagram-properties__field">
                                <label>H</label>
                                <input class="tm-text-input" type="number" step="1" min="100" value="@((int)(Document?.Height ?? 2000))" @onchange="OnPageHeightChanged" />
                            </div>
                        </div>
                        <div class="tm-diagram-properties__field">
                            <label>@Loc["TmDiagramProperties_Scale"]</label>
                            <input class="tm-text-input" type="number" step="0.1" min="0.1" value="@GetCurrentPageScale()" @onchange="OnPageScaleChanged" />
                        </div>
                        <div class="tm-diagram-properties__hint">
                            <span>@Loc["TmDiagramProperties_PlaceholdersHint"]</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="tm-diagram-properties__empty">@Loc["TmDiagramProperties_ReadOnly"]</p>
        }
    </div>
</div>
