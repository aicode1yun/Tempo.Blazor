@namespace Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Models

<div class="tm-diagram-arrow-select @Class" style="position:relative;width:100%;display:block;" @onkeydown="HandleKeyDown">
    <button type="button"
            class="tm-diagram-arrow-select__trigger"
            style="display:flex;align-items:center;gap:6px;width:100%;min-height:34px;padding:5px 10px;background:#ffffff;border:1px solid #d1d5db;border-radius:6px;font-size:13px;color:#111827;cursor:pointer;text-align:left;box-sizing:border-box;"
            aria-haspopup="listbox"
            aria-expanded="@_isOpen.ToString().ToLowerInvariant()"
            @onclick="Toggle"
            @onclick:stopPropagation="true">
        <span class="tm-diagram-arrow-select__preview"
              style="flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:24px;height:16px;overflow:hidden;">
            @((MarkupString)GetPreviewSvg(Value))
        </span>
        <span class="tm-diagram-arrow-select__label" style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">
            @GetLabel(Value)
        </span>
        <svg style="flex-shrink:0;width:14px;height:14px;color:#6b7280;@(_isOpen ? "transform:rotate(180deg);" : "")transition:transform 150ms ease;"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9" />
        </svg>
    </button>
    @if (_isOpen)
    {
        <div class="tm-diagram-arrow-select__menu"
             style="position:absolute;top:calc(100% + 3px);left:0;right:0;z-index:9999;background:#ffffff;border:1px solid #d1d5db;border-radius:6px;box-shadow:0 10px 28px rgba(0,0,0,0.15);max-height:280px;overflow-y:auto;padding:4px 0;min-width:180px;"
             role="listbox">
            @foreach (var opt in Options ?? [])
            {
                <button type="button"
                        class="tm-diagram-arrow-select__option"
                        style="display:flex;align-items:center;gap:6px;width:100%;min-height:34px;padding:5px 10px;background:none;border:none;font-size:13px;color:#111827;cursor:pointer;text-align:left;box-sizing:border-box;@(opt.Value == Value ? "background:#eff6ff;color:#2563eb;" : "")"
                        role="option"
                        aria-selected="@((opt.Value == Value).ToString().ToLowerInvariant())"
                        @onclick="() => SelectAsync(opt.Value)"
                        @onclick:stopPropagation="true">
                    <span style="flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;width:24px;height:16px;overflow:hidden;">
                        @((MarkupString)GetPreviewSvg(opt.Value))
                    </span>
                    <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;">
                        @opt.Label
                    </span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<SelectOption<string>>? Options { get; set; }
    [Parameter] public Func<string?, string>? PreviewRenderer { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool _isOpen;

    private void Toggle() => _isOpen = !_isOpen;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _isOpen = false;
    }

    private async Task SelectAsync(string? value)
    {
        Value = value;
        _isOpen = false;
        await ValueChanged.InvokeAsync(value);
    }

    private string GetLabel(string? value)
    {
        var opt = Options?.FirstOrDefault(o => o.Value == value);
        return opt?.Label ?? value ?? "";
    }

    private string GetPreviewSvg(string? value)
    {
        if (PreviewRenderer is not null)
            return PreviewRenderer(value);

        if (string.IsNullOrEmpty(value))
            return GetEmptyPreview();

        var def = DiagramArrowheadRegistry.Get(value);
        if (def is null || def.FillMode == "none")
            return GetEmptyPreview();

        var isFilled = def.FillMode == "filled";
        var fill = isFilled ? "#374151" : "none";
        var stroke = "#374151";
        var strokeWidth = isFilled ? "0" : "1.5";

        var w = def.Width;
        var h = def.Height;
        // Scale to fit 22x14 preview area while preserving aspect ratio
        var scale = Math.Min(22.0 / w, 14.0 / h);
        var sw = w * scale;
        var sh = h * scale;
        var ox = (22 - sw) / 2;
        var oy = (14 - sh) / 2;

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {w} {h}\" width=\"{(int)sw}\" height=\"{(int)sh}\" style=\"display:block;\">");
        sb.Append($"<g transform=\"translate({ox.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{oy.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)})\">");
        sb.Append($"<path d=\"{def.PathData}\" fill=\"{fill}\" stroke=\"{stroke}\" stroke-width=\"{strokeWidth}\" stroke-linejoin=\"round\" />");
        if (!string.IsNullOrEmpty(def.ExtraPath))
        {
            sb.Append($"<path d=\"{def.ExtraPath}\" fill=\"{fill}\" stroke=\"{stroke}\" stroke-width=\"{strokeWidth}\" stroke-linejoin=\"round\" />");
        }
        sb.Append("</g></svg>");
        return sb.ToString();
    }

    private static string GetEmptyPreview()
        => """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 4" width="22" height="6" style="display:block;"><line x1="0" y1="2" x2="24" y2="2" stroke="#9ca3af" stroke-width="1.5" /></svg>""";
}
