@namespace Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Components.Diagram.Templates

<div class="tm-diagram-template-card @(_selected ? "tm-diagram-template-card--selected" : "")"
     @onclick="OnClick"
     role="button"
     tabindex="0"
     aria-label="@Template.Name"
     aria-pressed="@_selected">
    <div class="tm-diagram-template-card__thumb">
        @if (!string.IsNullOrEmpty(Template.ThumbnailUrl))
        {
            <img src="@_thumbUrl" alt="" loading="lazy" />
        }
        else
        {
            <div class="tm-diagram-template-card__placeholder">
                <span>@Template.Name[0]</span>
            </div>
        }
    </div>
    <div class="tm-diagram-template-card__info">
        <span class="tm-diagram-template-card__name">@Template.Name</span>
        @if (Template.Tags.Length > 0)
        {
            <div class="tm-diagram-template-card__tags">
                @foreach (var tag in Template.Tags.Take(3))
                {
                    <span class="tm-diagram-template-card__tag">@tag</span>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public DiagramTemplate Template { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string BaseUri { get; set; } = "";

    private bool _selected => Selected;
    private string _thumbUrl => string.IsNullOrWhiteSpace(Template.ThumbnailUrl)
        ? ""
        : Template.ThumbnailUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
            || Template.ThumbnailUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Template.ThumbnailUrl
            : string.IsNullOrWhiteSpace(BaseUri)
                ? Template.ThumbnailUrl
                : $"{BaseUri.TrimEnd('/')}/{Template.ThumbnailUrl.TrimStart('/')}";
}
