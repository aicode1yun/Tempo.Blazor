@namespace Tempo.Blazor.Components.Diagram
@using System.Globalization
@using Tempo.Blazor.Components.Diagram.Models
@using Tempo.Blazor.Components.Diagram.Commands

<div class="tm-diagram-canvas @Class"
     tabindex="0"
     @ref="_containerRef"
     @onmousemove="OnCanvasMouseMove"
     @onmouseup="OnCanvasMouseUp"
     @onmouseleave="OnCanvasMouseUp">
    @* SVG layer: grid + background + edges *@
    <svg @ref="_svgRef"
         id="@_svgId"
         class="tm-diagram-canvas__svg"
         viewBox="@_viewBox"
         xmlns="http://www.w3.org/2000/svg"
         aria-label="@Loc["TmDiagramCanvas_AriaLabel"]"
         style="width:100%;height:100%;display:block;overflow:hidden;transform:scale(@(F(Document?.ActivePage?.Scale ?? 1.0)));transform-origin:0 0;">

        <defs>
            @if (ShowGrid)
            {
                <pattern id="@_gridSmallId" width="@_gs" height="@_gs" patternUnits="userSpaceOnUse">
                    <path d="M @_gs 0 L 0 0 0 @_gs" fill="none" stroke="#e5e7eb" stroke-width="0.5" />
                </pattern>
                <pattern id="@_gridLargeId" width="@_gl" height="@_gl" patternUnits="userSpaceOnUse">
                    <rect width="@_gl" height="@_gl" fill="url(#@_gridSmallId)" />
                    <path d="M @_gl 0 L 0 0 0 @_gl" fill="none" stroke="#d1d5db" stroke-width="1" />
                </pattern>
            }

            @if (ShowPageView)
            {
                <filter id="@_pageShadowFilterId" x="-50%" y="-50%" width="200%" height="200%">
                    <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="rgba(0,0,0,0.15)" />
                </filter>
            }

            @foreach (var marker in GetRequiredMarkers())
            {
                var def = DiagramArrowheadRegistry.Get(marker.Arrowhead);
                if (def is null || def.FillMode == "none") continue;
                <marker id="@marker.Id" markerWidth="@F(def.Width)" markerHeight="@F(def.Height)" refX="@F(def.RefX)" refY="@F(def.RefY)" orient="auto" markerUnits="strokeWidth">
                    @if (def.FillMode == "filled")
                    {
                        <path d="@def.PathData" fill="@marker.Color" />
                    }
                    else if (def.FillMode == "empty")
                    {
                        <path d="@def.PathData" fill="white" stroke="@marker.Color" stroke-width="1" />
                    }
                    else if (def.FillMode == "line")
                    {
                        <path d="@def.PathData" fill="none" stroke="@marker.Color" stroke-width="1.5" />
                    }
                </marker>
            }
            <marker id="arrow-emerald" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
                <path d="M0,0 L0,6 L9,3 z" fill="#10b981" />
            </marker>
        </defs>

        @* Canvas background + page view + grid *@
        @if (ShowPageView)
        {
            <rect x="-100000" y="-100000" width="200000" height="200000" fill="#f3f4f6" />
        }
        <rect x="0" y="0"
              width="@(Document?.Width ?? 3000)" height="@(Document?.Height ?? 2000)"
              fill="white" stroke="#d1d5db" stroke-width="1"
              rx="@(ShowPageView ? 0 : 4)"
              filter="@(ShowPageView ? $"url(#{_pageShadowFilterId})" : null)" />
        @if (ShowGrid)
        {
            <rect x="0" y="0"
                  width="@(Document?.Width ?? 3000)" height="@(Document?.Height ?? 2000)"
                  fill="url(#@_gridLargeId)"
                  pointer-events="none" />
        }

        @* Group bounds *@
        @if (Document is not null)
        {
            var groups = Document.Nodes
                .Where(n => !string.IsNullOrEmpty(n.GroupId))
                .GroupBy(n => n.GroupId!)
                .ToList();
            @foreach (var g in groups)
            {
                // Only show bounds for groups whose container is at the current level
                var container = Document.Nodes.FirstOrDefault(n => n.Id == g.Key && n.StencilId == "general.group");
                var isAtCurrentLevel = container?.ParentGroupId == ActiveGroupId;
                var hasOldStyleGroup = container is null && string.IsNullOrEmpty(ActiveGroupId);
                if (!isAtCurrentLevel && !hasOldStyleGroup) continue;
                var minX = g.Min(n => n.X);
                var minY = g.Min(n => n.Y);
                var maxX = g.Max(n => n.X + n.W);
                var maxY = g.Max(n => n.Y + n.H);
                const double pad = 8;
                <rect x="@F(minX - pad)" y="@F(minY - pad)"
                      width="@F(maxX - minX + pad * 2)" height="@F(maxY - minY + pad * 2)"
                      fill="none"
                      stroke="var(--tm-color-primary)"
                      stroke-width="1"
                      stroke-dasharray="4,4"
                      opacity="0.4"
                      pointer-events="none" />
            }
        }

        @* Edges *@
        @if (Document is not null)
        {
            @foreach (var edge in Document.Edges)
            {
                var pathD = ComputeEdgePath(edge);
                var isSelected = _currentSelectionIds.Contains(edge.Id);
                <g>
                    @* Invisible hit path *@
                    <path class="tm-diagram-edge-hit-path"
                          d="@pathD"
                          data-edge-id="@edge.Id"
                          @onclick="e => OnEdgeClicked(edge.Id, e)"
                          @ondblclick="e => OnEdgeDoubleClicked(edge.Id, e)" />
                    @* Visible path *@
                    <path class="tm-diagram-edge-path @(isSelected ? "tm-diagram-edge-path--selected" : "") @(_activeSearchResultId == edge.Id ? "tm-diagram-search-match" : "")"
                          d="@pathD"
                          stroke="@GetEdgeColor(edge)"
                          stroke-width="@F(GetEdgeStrokeWidth(edge))"
                          stroke-dasharray="@GetEdgeStrokeDasharray(edge)"
                          marker-start="@GetEdgeMarkerStart(edge)"
                          marker-end="@GetEdgeMarkerEnd(edge)" />
                    @* Edge label *@
                    @{
                        var labelPos = ComputeEdgePointAtT(edge, edge.LabelPositionT);
                    }
                    <g class="tm-diagram-edge-label-group"
                       @onclick:stopPropagation="true" @onclick="() => OnEdgeLabelSelect(edge.Id)"
                       @ondblclick:stopPropagation="true" @ondblclick="() => OnEdgeLabelEdit(edge.Id)">
                        <rect class="tm-diagram-edge-label-hit"
                              x="@F(labelPos.X - 24)"
                              y="@F(labelPos.Y - 12)"
                              width="48"
                              height="24"
                              fill="transparent"
                              data-edge-id="@edge.Id"
                              data-label-handle="true" />
                        @if (!string.IsNullOrEmpty(edge.Label))
                        {
                            <foreignObject x="@F(labelPos.X - 80)" y="@F(labelPos.Y - 14)" width="160" height="28">
                                <div xmlns="http://www.w3.org/1999/xhtml"
                                     class="tm-diagram-edge-label"
                                     style="display:flex;align-items:center;justify-content:center;height:100%;font-size:12px;line-height:1;">
                                    @if (edge.Style?.EnableMathJax == true && ContainsMath(edge.Label))
                                    {
                                        <span class="tm-diagram-math">@edge.Label</span>
                                    }
                                    else
                                    {
                                        @edge.Label
                                    }
                                </div>
                            </foreignObject>
                        }
                    </g>
                    @if (_editingEdgeLabelId == edge.Id)
                    {
                        <foreignObject x="@F(labelPos.X - 60)" y="@F(labelPos.Y - 14)" width="120" height="28">
                            <input @ref="_labelInputRef"
                                   class="tm-diagram-edge-label-input"
                                   value="@_editingLabelValue"
                                   @oninput="OnLabelInputChanged"
                                   @onkeydown="OnLabelInputKeyDown"
                                   @onblur="OnLabelInputBlur"
                                   @onmousedown:stopPropagation="true"
                                   @onmousemove:stopPropagation="true"
                                   @onmouseup:stopPropagation="true"
                                   @onwheel:stopPropagation="true"
                                   placeholder="@Loc["TmDiagramProperties_Label"]" />
                        </foreignObject>
                    }
                    @* Selection handles (control points) *@
                    @if (isSelected)
                    {
                        var pts = DiagramGeometryHelper.GetEdgePoints(Document, edge);
                        for (int i = 0; i < pts.Length; i++)
                        {
                            var pt = pts[i];
                            var isWaypoint = i > 0 && i < pts.Length - 1;
                            <circle class="tm-diagram-edge-handle"
                                    cx="@F(pt.X)"
                                    cy="@F(pt.Y)"
                                    r="5"
                                    data-edge-id="@edge.Id"
                                    data-handle-index="@i"
                                    data-waypoint="@(isWaypoint.ToString().ToLowerInvariant())"
                                    @ondblclick:stopPropagation="true"
                                    @ondblclick="() => OnEdgeWaypointDelete(edge.Id, i)" />
                        }
                        @if (edge.Routing == "orthogonal")
                        {
                            var srcNode = Document.Nodes.FirstOrDefault(n => n.Id == edge.SourceNodeId);
                            var tgtNode = Document.Nodes.FirstOrDefault(n => n.Id == edge.TargetNodeId);
                            if (srcNode is not null && string.IsNullOrEmpty(edge.SourceEdgeId))
                            {
                                var srcPort = edge.SourcePortId is not null
                                    ? srcNode.Ports.FirstOrDefault(p => p.Id == edge.SourcePortId)
                                    : srcNode.Ports.FirstOrDefault();
                                var sPort = srcPort ?? new DiagramPort { Side = PortSide.Right, Offset = 0.5 };
                                <circle class="tm-diagram-edge-handle tm-diagram-edge-handle--jetty"
                                        cx="@F(pts[0].X)" cy="@F(pts[0].Y)" r="4"
                                        data-edge-id="@edge.Id" data-jetty="source" data-jetty-side="@sPort.Side.ToString().ToLowerInvariant()" data-node-id="@edge.SourceNodeId" />
                            }
                            if (tgtNode is not null && string.IsNullOrEmpty(edge.TargetEdgeId))
                            {
                                var tgtPort = edge.TargetPortId is not null
                                    ? tgtNode.Ports.FirstOrDefault(p => p.Id == edge.TargetPortId)
                                    : tgtNode.Ports.FirstOrDefault();
                                var tPort = tgtPort ?? new DiagramPort { Side = PortSide.Left, Offset = 0.5 };
                                <circle class="tm-diagram-edge-handle tm-diagram-edge-handle--jetty"
                                        cx="@F(pts[^1].X)" cy="@F(pts[^1].Y)" r="4"
                                        data-edge-id="@edge.Id" data-jetty="target" data-jetty-side="@tPort.Side.ToString().ToLowerInvariant()" data-node-id="@edge.TargetNodeId" />
                            }
                        }
                    }
                </g>
            }
        }

    </svg>

    @* HTML overlay layer: nodes *@
    <div class="tm-diagram-canvas__overlay">
        <div class="tm-diagram-transform-layer" style="transform:scale(@(F(Document?.ActivePage?.Scale ?? 1.0)));transform-origin:0 0;">
            @if (Document is not null)
            {
                @foreach (var node in Document.Nodes.Where(IsNodeVisible).Where(IsLayerVisible).OrderBy(n => n.ZIndex))
                {
                    <div class="tm-diagram-node @(_activeSearchResultId == node.Id ? "tm-diagram-search-match" : "")"
                         data-node-id="@node.Id"
                         data-stencil-id="@node.StencilId"
                         data-w="@node.W"
                         data-h="@node.H"
                         data-group-id="@node.GroupId"
                         data-parent-id="@node.ParentNodeId"
                         data-parent-group-id="@node.ParentGroupId"
                         data-locked="@(IsNodeLocked(node) ? "true" : "false")"
                         data-link="@node.Link"
                         style="transform: translate(@(F(node.X))px, @(F(node.Y))px) rotate(@(F(node.Rotation))deg); width: @(F(node.W))px; height: @(F(node.H))px; z-index: @node.ZIndex;">
                        <TmDiagramStencilShape Node="node"
                                               IsSelected="_currentSelectionIds.Contains(node.Id)"
                                               OnPortMouseDownEvent="(portId) => HandlePortMouseDown(node.Id, portId)"
                                               OnSectionEdit="(args) => HandleSectionEdit(node.Id, args.DataKey, args.Value)"
                                               SelectedTableCells="SelectedTableCells"
                                               OnTableCellSelect="(args) => HandleTableCellSelect(node.Id, args.Row, args.Column, args.IsCtrlHeld)"
                                               Page="Document?.ActivePage"
                                               Document="Document" />

                        @if (node.IsCollapsible && !ReadOnly)
                        {
                            <button type="button"
                                    class="tm-diagram-node__collapse-btn"
                                    aria-label="@(node.Collapsed ? Loc["TmDiagramNode_Expand"] : Loc["TmDiagramNode_Collapse"])"
                                    title="@(node.Collapsed ? Loc["TmDiagramNode_Expand"] : Loc["TmDiagramNode_Collapse"])"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ToggleCollapse(node.Id)">
                                <span>@(node.Collapsed ? "+" : "−")</span>
                            </button>
                        }

                        @if (!ReadOnly)
                        {
                            @foreach (var port in node.Ports)
                            {
                                if (node is { IsCollapsible: true, Collapsed: true } && port.Side is not (PortSide.Top or PortSide.Bottom))
                                    continue;
                                var (absX, absY) = DiagramGeometryHelper.ComputePortPosition(node, port);
                                var px = absX - node.X;
                                var py = absY - node.Y;
                                <div class="tm-diagram-port"
                                     data-port-id="@port.Id"
                                     style="left: @(F(px))px; top: @(F(py))px;"
                                     title="@port.Name"
                                     @onmousedown:stopPropagation="true"
                                     @onmousedown="() => HandlePortMouseDown(node.Id, port.Id)"
                                     @onmouseenter="() => HandlePortMouseEnter(node.Id, port.Id)"
                                     @onmouseleave="() => HandlePortMouseLeave(node.Id, port.Id)">
                                </div>
                            }
                        }

                        @if (_currentSelectionIds.Contains(node.Id) && !ReadOnly)
                        {
                            @foreach (var h in _resizeHandles)
                            {
                                <div class="tm-diagram-resize-handle tm-diagram-resize-handle--@h"
                                     @onmousedown:stopPropagation="true"
                                     @onmousedown="e => OnResizeStart(e, node.Id, h)">
                                </div>
                            }

                            @* Rotate handle *@
                            <div class="tm-diagram-rotate-handle"
                                 title="@Loc["TmDiagramEditor_RotateHandleLabel"]"
                                 @onmousedown:stopPropagation="true"
                                 @onmousedown="e => OnRotateStartJs(e, node.Id)">
                            </div>

                            @* Quick-connect arrows *@
                            @foreach (var dir in _connectDirections)
                            {
                                <button type="button"
                                        class="tm-diagram-connect-arrow tm-diagram-connect-arrow--@dir.Css"
                                        aria-label="@Loc[$"TmDiagramEditor_ConnectArrow{dir.Label}"]"
                                        title="@Loc[$"TmDiagramEditor_ConnectArrow{dir.Label}"]"
                                        @onmousedown:stopPropagation="true"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => HandleConnectArrowClicked(node.Id, dir.Css)">
                                    <span class="tm-diagram-connect-arrow__icon">→</span>
                                </button>
                            }
                        }
                    </div>
                }
            }
        </div>
    </div>

    @* Interaction layer: injected by JS for selection outlines *@
    <div class="tm-diagram-canvas__interaction"></div>

</div>
