@namespace Tempo.Blazor.Components.Diagram
@using Tempo.Blazor.Components.Diagram.Models
@using Tempo.Blazor.Components.Diagram.Commands
@using Microsoft.AspNetCore.Components.Forms

<CascadingValue Value="ActiveCommandStack" IsFixed="false">

<div class="tm-diagram-editor @Class @(ReadOnly ? "tm-diagram-editor--readonly" : "")">

    @* ── Page tabs ────────────────────────────────────────────────────────── *@
    <div class="tm-diagram-editor__page-tabs"
         @ondragover:preventDefault
         @ondrop:preventDefault>
        @if (_document?.Pages is not null)
        {
            @foreach (var pg in _document.Pages)
            {
                var isActive = pg.Id == _document.ActivePage.Id;
                var isDragOver = _pageDragOverId == pg.Id;
                <div class="tm-diagram-editor__page-tab @(isActive ? "tm-diagram-editor__page-tab--active" : "") @(_pageRenamingId == pg.Id ? "tm-diagram-editor__page-tab--renaming" : "") @(isDragOver ? "tm-diagram-editor__page-tab--drag-over" : "")"
                     @onclick="() => SelectPage(pg.Id)"
                     @ondblclick="() => StartRenamePage(pg.Id)"
                     @ondragstart="() => OnPageTabDragStart(pg.Id)"
                     @ondragenter="() => OnPageTabDragEnter(pg.Id)"
                     @ondragleave="OnPageTabDragLeave"
                     @ondrop="() => OnPageTabDrop(pg.Id)"
                     draggable="true"
                     title="@pg.Name"
                     role="tab"
                     aria-selected="@isActive">
                    @if (_pageRenamingId == pg.Id)
                    {
                        <input type="text"
                               class="tm-diagram-editor__page-tab-input"
                               value="@_pageRenameInput"
                               @oninput="e => _pageRenameInput = e.Value?.ToString() ?? _pageRenameInput"
                               @onkeydown="e => OnRenamePageKeyDown(e, pg.Id)"
                               @onblur="() => CommitRenamePage(pg.Id)"
                               @ref="_pageRenameInputRef" />
                    }
                    else
                    {
                        <span class="tm-diagram-editor__page-tab-name">@pg.Name</span>
                        @if (ActiveCommandStack.CanUndo)
                        {
                            <span class="tm-diagram-editor__page-tab-dot" aria-hidden="true"></span>
                        }
                        <button class="tm-diagram-editor__page-tab-close"
                                aria-label="@Loc["TmDiagramEditor_DuplicatePage"]"
                                title="@Loc["TmDiagramEditor_DuplicatePage"]"
                                @onclick:stopPropagation
                                @onclick="() => DuplicatePage(pg.Id)">
                            ⧉
                        </button>
                        @if (_document.Pages.Count > 1)
                        {
                            <button class="tm-diagram-editor__page-tab-close"
                                    aria-label="@Loc["TmDiagramEditor_ClosePage", pg.Name]"
                                    title="@Loc["TmDiagramEditor_ClosePage", pg.Name]"
                                    @onclick:stopPropagation
                                    @onclick="() => RemovePage(pg.Id)">
                                ✕
                            </button>
                        }
                    }
                </div>
            }
            <button class="tm-diagram-editor__page-tab-add"
                    aria-label="@Loc["TmDiagramEditor_AddPage"]"
                    title="@Loc["TmDiagramEditor_AddPage"]"
                    @onclick="AddPage">
                +
            </button>
        }
    </div>

    @* ── Toolbar ─────────────────────────────────────────────────────────── *@
    @if (ShowToolbar)
    {
        <div class="tm-diagram-editor__toolbar" role="toolbar" aria-label="@Loc["TmDiagramEditor_ToolbarAriaLabel"]">

            @* Title *@
            <input class="tm-diagram-editor__title"
                   type="text"
                   value="@_document?.Title"
                   placeholder="@Loc["TmDiagramEditor_UntitledPlaceholder"]"
                   aria-label="@Loc["TmDiagramEditor_DocumentTitleLabel"]"
                   @onchange="OnTitleChanged"
                   disabled="@ReadOnly"
                   title="@Loc["TmDiagramEditor_DocumentTitleLabel"]" />

            @* Tool mode: Select / Pan / Edge *@
            <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon @(_toolMode == "select" ? "tm-diagram-editor__btn--active" : "")"
                    aria-label="@Loc["TmDiagramEditor_SelectTool"]"
                    aria-pressed="@(_toolMode == "select")"
                    title="@Loc["TmDiagramEditor_SelectTool"]"
                    disabled="@ReadOnly"
                    @onclick='() => SetToolMode("select")'>
                ↖
            </button>
            <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon @(_toolMode == "pan" ? "tm-diagram-editor__btn--active" : "")"
                    aria-label="@Loc["TmDiagramEditor_PanTool"]"
                    aria-pressed="@(_toolMode == "pan")"
                    title="@Loc["TmDiagramEditor_PanToolHint"]"
                    @onclick='() => SetToolMode("pan")'>
                ✋
            </button>
            <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon @(_toolMode == "edge" ? "tm-diagram-editor__btn--active" : "")"
                    aria-label="@Loc["TmDiagramEditor_EdgeTool"]"
                    aria-pressed="@(_toolMode == "edge")"
                    title="@Loc["TmDiagramEditor_EdgeToolHint"]"
                    disabled="@ReadOnly"
                    @onclick='() => SetToolMode("edge")'>
                ➡
            </button>

            <div class="tm-diagram-editor__toolbar-sep" role="separator"></div>

            @* Undo / Redo *@
            <button class="tm-diagram-editor__btn"
                    aria-label="@Loc["TmDiagramEditor_Undo"] @ActiveCommandStack.NextUndoName"
                    title="@Loc["TmDiagramEditor_Undo"] (@ActiveCommandStack.NextUndoName)"
                    disabled="@(!ActiveCommandStack.CanUndo || ReadOnly)"
                    @onclick="OnUndoClicked">
                ↩
            </button>
            <button class="tm-diagram-editor__btn"
                    aria-label="@Loc["TmDiagramEditor_Redo"] @ActiveCommandStack.NextRedoName"
                    title="@Loc["TmDiagramEditor_Redo"] (@ActiveCommandStack.NextRedoName)"
                    disabled="@(!ActiveCommandStack.CanRedo || ReadOnly)"
                    @onclick="OnRedoClicked">
                ↪
            </button>

            <div class="tm-diagram-editor__toolbar-sep" role="separator"></div>

            @* Format Painter *@
            <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon"
                    aria-label="@Loc["TmDiagramEditor_CopyStyle"]"
                    title="@Loc["TmDiagramEditor_CopyStyle"]"
                    disabled="@ReadOnly"
                    @onclick="OnCopyStyle">
                <TmIcon Name="@IconNames.Brush" />
            </button>
            <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon"
                    aria-label="@Loc["TmDiagramEditor_PasteStyle"]"
                    title="@Loc["TmDiagramEditor_PasteStyle"]"
                    disabled="@ReadOnly"
                    @onclick="OnPasteStyle">
                <TmIcon Name="@IconNames.Brush" Color="IconColor.Primary" />
            </button>
            <button class="tm-diagram-editor__btn"
                    aria-label="@Loc["TmDiagramEditor_PasteSize"]"
                    title="@Loc["TmDiagramEditor_PasteSize"]"
                    disabled="@ReadOnly"
                    @onclick="OnPasteSize">
                @Loc["TmDiagramEditor_PasteSize"]
            </button>

            <div class="tm-diagram-editor__toolbar-sep" role="separator"></div>

            @* Zoom *@
            <button class="tm-diagram-editor__btn" aria-label="@Loc["TmDiagramEditor_ZoomOut"]" title="@Loc["TmDiagramEditor_ZoomOut"]" @onclick="ZoomOut">−</button>
            <span class="tm-diagram-editor__zoom-label" role="status" aria-live="polite" aria-label="Zoom @_zoomLabel">@_zoomLabel</span>
            <button class="tm-diagram-editor__btn" aria-label="@Loc["TmDiagramEditor_ZoomIn"]" title="@Loc["TmDiagramEditor_ZoomIn"]" @onclick="ZoomIn">+</button>
            <button class="tm-diagram-editor__btn" aria-label="@Loc["TmDiagramEditor_FitToView"]" title="@Loc["TmDiagramEditor_FitToView"]" @onclick="FitToView">@Loc["TmDiagramEditor_FitToView"]</button>

            @* Rulers toggle *@
            <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon @(_showRulers ? "tm-diagram-editor__btn--active" : "")"
                    aria-label="@Loc["TmDiagramEditor_ToggleRulers"]"
                    title="@Loc["TmDiagramEditor_ToggleRulers"]"
                    @onclick="ToggleRulers">
                📏
            </button>

            @* Ruler unit *@
            <select class="tm-diagram-editor__unit-select"
                    aria-label="@Loc["TmDiagramEditor_RulerUnitLabel"]"
                    title="@Loc["TmDiagramEditor_RulerUnitLabel"]"
                    value="@(_document?.ActivePage?.RulerUnit ?? MeasurementUnit.Px)"
                    @onchange='e => OnRulerUnitChanged(Enum.Parse<MeasurementUnit>(e.Value?.ToString() ?? "Px"))'>
                @foreach (var opt in _rulerUnitOptions)
                {
                    <option value="@opt.Value">@opt.Label</option>
                }
            </select>

            @* Canvas size *@
            @if (_canvasSizeEditing)
            {
                <input class="tm-diagram-editor__props-input"
                       type="number" min="100" max="9999" step="1"
                       aria-label="@Loc["TmDiagramEditor_CanvasWidth"]"
                       value="@_canvasWInput"
                       @oninput="e => _canvasWInput = e.Value?.ToString() ?? _canvasWInput"
                       style="width:70px;" />
                <span>×</span>
                <input class="tm-diagram-editor__props-input"
                       type="number" min="100" max="9999" step="1"
                       aria-label="@Loc["TmDiagramEditor_CanvasHeight"]"
                       value="@_canvasHInput"
                       @oninput="e => _canvasHInput = e.Value?.ToString() ?? _canvasHInput"
                       style="width:70px;" />
                <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon"
                        aria-label="@Loc["TmDiagramEditor_Apply"]"
                        title="@Loc["TmDiagramEditor_Apply"]"
                        @onclick="ApplyCanvasSize">✓</button>
                <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon"
                        aria-label="@Loc["TmDiagramEditor_Cancel"]"
                        title="@Loc["TmDiagramEditor_Cancel"]"
                        @onclick="() => _canvasSizeEditing = false">✕</button>
            }
            else
            {
                <button class="tm-diagram-editor__btn"
                        aria-label="@Loc["TmDiagramEditor_ChangeCanvasSize"], current @((int)(_document?.Width ?? 3000))×@((int)(_document?.Height ?? 2000))"
                        title="@Loc["TmDiagramEditor_ChangeCanvasSize"]"
                        @onclick="OpenCanvasSize">
                    @((int)(_document?.Width ?? 3000))×@((int)(_document?.Height ?? 2000))
                </button>
            }

            <div class="tm-diagram-editor__toolbar-sep" role="separator"></div>

            @* Layout *@
            <div style="position:relative;">
                <button class="tm-diagram-editor__btn"
                        aria-label="@Loc["TmDiagram_Layout"]"
                        aria-haspopup="true"
                        aria-expanded="@_layoutMenuOpen"
                        @onclick="ToggleLayoutMenu"
                        title="@Loc["TmDiagram_Layout"]">
                    <span>@Loc["TmDiagram_Layout"] ▾</span>
                </button>
                @if (_layoutMenuOpen)
                {
                    <div class="tm-dropdown__menu" role="menu" aria-label="@Loc["TmDiagram_Layout"]" style="position:absolute;top:100%;left:0;z-index:100;min-width:220px;">
                        <button class="tm-dropdown__item" role="menuitem" @onclick='() => RunLayout("dagre", "TB")' title="@Loc["TmDiagram_LayoutHierarchicalTopDown_Tooltip"]">@Loc["TmDiagram_LayoutHierarchicalTopDown"]</button>
                        <button class="tm-dropdown__item" role="menuitem" @onclick='() => RunLayout("dagre", "LR")' title="@Loc["TmDiagram_LayoutHierarchicalLeftRight_Tooltip"]">@Loc["TmDiagram_LayoutHierarchicalLeftRight"]</button>
                        <div class="tm-dropdown__divider" role="separator"></div>
                        <button class="tm-dropdown__item" role="menuitem" @onclick='() => RunLayout("tree", "TB")' title="@Loc["TmDiagram_LayoutTree_Tooltip"]">@Loc["TmDiagram_LayoutTree"]</button>
                        <button class="tm-dropdown__item" role="menuitem" @onclick='() => RunLayout("tree", "LR")' title="@Loc["TmDiagram_LayoutTreeLR_Tooltip"]">@Loc["TmDiagram_LayoutTreeLR"]</button>
                        <div class="tm-dropdown__divider" role="separator"></div>
                        <button class="tm-dropdown__item" role="menuitem" @onclick='() => RunLayout("force")' title="@Loc["TmDiagram_LayoutForce_Tooltip"]">@Loc["TmDiagram_LayoutForce"]</button>
                        <button class="tm-dropdown__item" role="menuitem" @onclick='() => RunLayout("circle")' title="@Loc["TmDiagram_LayoutCircle_Tooltip"]">@Loc["TmDiagram_LayoutCircle"]</button>
                        <button class="tm-dropdown__item" role="menuitem" @onclick='() => RunLayout("grid")' title="@Loc["TmDiagram_LayoutGrid_Tooltip"]">@Loc["TmDiagram_LayoutGrid"]</button>
                    </div>
                }
            </div>

            <div class="tm-diagram-editor__toolbar-sep" role="separator"></div>

            @* Export *@
            <div style="position:relative;">
                <button class="tm-diagram-editor__btn"
                        aria-label="@Loc["TmDiagramEditor_Export"]"
                        aria-haspopup="true"
                        aria-expanded="@_exportMenuOpen"
                        @onclick="ToggleExportMenu"
                        title="@Loc["TmDiagramEditor_Export"]"
                        disabled="@_exporting">
                    @if (_exporting)
                    {
                        <TmSpinner Size="SpinnerSize.Xs" Class="tm-diagram-editor__btn-spinner" />
                    }
                    else
                    {
                        <span>@Loc["TmDiagramEditor_Export"] ▾</span>
                    }
                </button>
                @if (_exportMenuOpen && !_exporting)
                {
                    <div class="tm-dropdown__menu" role="menu" aria-label="@Loc["TmDiagramEditor_Export"]" style="position:absolute;top:100%;left:0;z-index:100;min-width:140px;">
                        <button class="tm-dropdown__item" role="menuitem" @onclick="ExportJson">@Loc["TmDiagramEditor_ExportJson"]</button>
                        <button class="tm-dropdown__item" role="menuitem" @onclick="ExportSvg">@Loc["TmDiagramEditor_ExportSvg"]</button>
                        <button class="tm-dropdown__item" role="menuitem" @onclick="ExportPng">@Loc["TmDiagramEditor_ExportPng"]</button>
                        <button class="tm-dropdown__item" role="menuitem" @onclick="ExportPdf">@Loc["TmDiagramEditor_ExportPdf"]</button>
                    </div>
                }
            </div>

            @* Templates *@
            <button class="tm-diagram-editor__btn"
                    title="@Loc["TmDiagramEditor_Templates"]"
                    aria-label="@Loc["TmDiagramEditor_Templates"]"
                    @onclick="OpenTemplateGallery">
                @Loc["TmDiagramEditor_Templates"]
            </button>

            <div class="tm-diagram-editor__toolbar-sep" role="separator"></div>

            @* Import *@
            <label class="tm-diagram-editor__btn" title="@Loc["TmDiagramEditor_ImportJson"]" aria-label="@Loc["TmDiagramEditor_ImportJson"]">
                @Loc["TmDiagramEditor_ImportJson"]
                <InputFile style="display:none;" OnChange="OnImportFile" accept=".json,.diagram.json" />
            </label>
            <button class="tm-diagram-editor__btn"
                    title="@Loc["TmDiagramEditor_ImportSql"]"
                    aria-label="@Loc["TmDiagramEditor_ImportSql"]"
                    @onclick="OpenSqlImportDialog">
                @Loc["TmDiagramEditor_ImportSql"]
            </button>
            <button class="tm-diagram-editor__btn"
                    title="@Loc["TmDiagramEditor_ImportCsv"]"
                    aria-label="@Loc["TmDiagramEditor_ImportCsv"]"
                    @onclick="OpenCsvImportDialog">
                @Loc["TmDiagramEditor_ImportCsv"]
            </button>

            <div class="tm-diagram-editor__toolbar-spacer"></div>

            @* Read-only toggle *@
            <button class="tm-diagram-editor__btn @(ReadOnly ? "tm-diagram-editor__btn--active" : "")"
                    aria-label="@(ReadOnly ? Loc["TmDiagramEditor_SwitchToEditMode"] : Loc["TmDiagramEditor_SwitchToReadOnlyMode"])"
                    aria-pressed="@ReadOnly"
                    title="@(ReadOnly ? Loc["TmDiagramEditor_SwitchToEditMode"] : Loc["TmDiagramEditor_SwitchToReadOnlyMode"])"
                    @onclick="ToggleReadOnly">
                @(ReadOnly ? "🔒 " + Loc["TmDiagramEditor_ReadOnly"] : "✏ " + Loc["TmDiagramEditor_Edit"])
            </button>

            @* Panel toggles *@
            @if (ShowToolbox)
            {
                <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon @(_toolboxCollapsed ? "" : "tm-diagram-editor__btn--active")"
                        aria-label="@(_toolboxCollapsed ? Loc["TmDiagramEditor_ShowToolbox"] : Loc["TmDiagramEditor_HideToolbox"])"
                        aria-pressed="@(!_toolboxCollapsed)"
                        title="@Loc["TmDiagramEditor_ToggleToolbox"]"
                        @onclick="() => _toolboxCollapsed = !_toolboxCollapsed">
                    ◧
                </button>
            }
            @if (ShowPropertiesPanel)
            {
                <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon @(_propsCollapsed ? "" : "tm-diagram-editor__btn--active")"
                        aria-label="@(_propsCollapsed ? Loc["TmDiagramEditor_ShowProperties"] : Loc["TmDiagramEditor_HideProperties"])"
                        aria-pressed="@(!_propsCollapsed)"
                        title="@Loc["TmDiagramEditor_ToggleProperties"]"
                        @onclick="() => _propsCollapsed = !_propsCollapsed">
                    ◨
                </button>
            }
            @if (ShowLayersPanel)
            {
                <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon @(_layersCollapsed ? "" : "tm-diagram-editor__btn--active")"
                        aria-label="@(_layersCollapsed ? Loc["TmDiagramEditor_ShowLayers"] : Loc["TmDiagramEditor_HideLayers"])"
                        aria-pressed="@(!_layersCollapsed)"
                        title="@Loc["TmDiagramEditor_ToggleLayers"]"
                        @onclick="() => _layersCollapsed = !_layersCollapsed">
                    ☰
                </button>
            }
            @if (ShowMinimap)
            {
                <button class="tm-diagram-editor__btn tm-diagram-editor__btn--icon @(_minimapCollapsed ? "" : "tm-diagram-editor__btn--active")"
                        aria-label="@(_minimapCollapsed ? Loc["TmDiagramEditor_ShowMinimap"] : Loc["TmDiagramEditor_HideMinimap"])"
                        aria-pressed="@(!_minimapCollapsed)"
                        title="@Loc["TmDiagramEditor_ToggleMinimap"]"
                        @onclick="() => _minimapCollapsed = !_minimapCollapsed">
                    ⊡
                </button>
            }
        </div>
    }

    @* ── Search panel ───────────────────────────────────────────────────── *@
    @if (_showSearchPanel)
    {
        <TmDiagramSearchPanel Query="@_searchQuery"
                              QueryChanged="OnSearchQueryChanged"
                              ResultsCount="_searchResults.Count"
                              CurrentIndex="_searchCurrentIndex"
                              CurrentIndexChanged="OnSearchIndexChanged"
                              SearchAllPages="_searchAllPages"
                              SearchAllPagesChanged="OnSearchAllPagesChanged"
                              ReplaceQuery="@_replaceQuery"
                              ReplaceQueryChanged="OnReplaceQueryChanged"
                              UseRegex="_searchUseRegex"
                              UseRegexChanged="OnSearchUseRegexChanged"
                              RegexError="_regexError"
                              OnReplace="OnReplace"
                              OnReplaceAll="OnReplaceAll"
                              OnClose="CloseSearchPanel" />
    }

    @* ── Import error banner ─────────────────────────────────────────────── *@
    @if (_importError is not null)
    {
        <div class="tm-alert tm-alert--danger" role="alert" aria-live="assertive" style="margin:0;border-radius:0;">
            <div class="tm-alert__content" style="display:flex;align-items:center;gap:8px;">
                <span>@_importError</span>
                <button class="tm-btn tm-btn--ghost tm-btn--sm" aria-label="@Loc["TmDiagramEditor_DismissError"]" @onclick="() => _importError = null">✕</button>
            </div>
        </div>
    }

    @* ── Export error banner ──────────────────────────────────────────────── *@
    @if (_exportError is not null)
    {
        <div class="tm-alert tm-alert--danger" role="alert" aria-live="assertive" style="margin:0;border-radius:0;">
            <div class="tm-alert__content" style="display:flex;align-items:center;gap:8px;">
                <span>@_exportError</span>
                <button class="tm-btn tm-btn--ghost tm-btn--sm" aria-label="@Loc["TmDiagramEditor_DismissError"]" @onclick="() => _exportError = null">✕</button>
            </div>
        </div>
    }

    @* ── Body (toolbox + canvas + props) ─────────────────────────────────── *@
    <div class="tm-diagram-editor__body">

        @* Left: Toolbox *@
        @if (ShowToolbox && !_toolboxCollapsed)
        {
            <div class="tm-diagram-editor__toolbox-wrap">
                <TmDiagramToolbox StencilDragStart="OnToolboxDragStart"
                                  Class="tm-diagram-editor__toolbox" />
            </div>
        }

        @* Centre: Canvas with optional rulers *@
        <div class="tm-diagram-editor__canvas-wrap" style="@(_showRulers ? "padding-top:24px;padding-left:24px;" : "")">
            @if (_showRulers)
            {
                <div class="tm-diagram-editor__ruler-corner"></div>
                <div class="tm-diagram-editor__ruler-h">
                    <TmDiagramRuler Orientation="horizontal"
                                    ViewportX="_rulerViewportX"
                                    ViewportY="_rulerViewportY"
                                    ViewportW="_rulerViewportW"
                                    ViewportH="_rulerViewportH"
                                    Zoom="_zoomLevel"
                                    Unit="_document?.ActivePage?.RulerUnit ?? MeasurementUnit.Px"
                                    Scale="_document?.ActivePage?.PageScale ?? 1.0"
                                    CursorX="_rulerCursorX"
                                    CursorY="_rulerCursorY" />
                </div>
                <div class="tm-diagram-editor__ruler-v">
                    <TmDiagramRuler Orientation="vertical"
                                    ViewportX="_rulerViewportX"
                                    ViewportY="_rulerViewportY"
                                    ViewportW="_rulerViewportW"
                                    ViewportH="_rulerViewportH"
                                    Zoom="_zoomLevel"
                                    Unit="_document?.ActivePage?.RulerUnit ?? MeasurementUnit.Px"
                                    Scale="_document?.ActivePage?.PageScale ?? 1.0"
                                    CursorX="_rulerCursorX"
                                    CursorY="_rulerCursorY" />
                </div>
            }
            <TmDiagramCanvas @ref="_canvas"
                             Document="@_document"
                             DocumentChanged="OnDocumentChanged"
                             ShowGrid="@ShowGrid"
                             GridSize="@GridSize"
                             ReadOnly="@ReadOnly"
                             Zoom="@_zoomLevel"
                             ShowPageView="@ShowPageView"
                             OnSelectionChanged="OnSelectionChanged"
                             OnToolModeChanged="OnCanvasToolModeChanged"
                             ZoomChanged="OnCanvasZoomChanged"
                             ViewportChanged="OnCanvasViewportChanged"
                             OnToolboxDrop="OnToolboxDrop"
                             OnPortMouseDownEvent="OnPortMouseDownEvent"
                             OnEdgeCreated="OnEdgeCreated"
                             OnNodeContextMenu="OnNodeContextMenu"
                             OnEdgeContextMenu="OnEdgeContextMenu"
                             OnTableCellContextMenu="OnTableCellContextMenu"
                             OnCanvasContextMenu="OnCanvasContextMenu"
                             OnConnectArrowClicked="OnConnectArrowClicked"
                             OnShowSearch="OpenSearchPanel"
                             OnShowReplace="OpenReplacePanel"
                             OnQuickInsert="HandleQuickInsert"
                             OnNavigateToCorner="HandleNavigateToCorner"
                             OnSwitchPage="HandleSwitchPage"
                             OnGroupSelected="HandleGroupSelected"
                             OnLockSelected="HandleLockSelected"
                             OnEnterGroup="HandleEnterGroup"
                             OnExitGroup="HandleExitGroup"
                             OnToggleBold="HandleToggleBold"
                             OnToggleItalic="HandleToggleItalic"
                             OnToggleUnderline="HandleToggleUnderline"
                             OnNodeLinkClicked="HandleNodeLinkClicked"
                             ActiveGroupId="@ActiveGroupId"
                             SelectedTableCells="_selectedTableCells"
                             OnTableCellSelect="HandleTableCellSelect"
                             Class="tm-diagram-editor__canvas" />
            @* Context menu (long-press / right-click) *@
            @if (_contextMenuOpen)
            {
                <div class="tm-diagram-editor__context-menu" role="menu" style="position:fixed;left:@($"{_contextMenuScreenX}px");top:@($"{_contextMenuScreenY}px");z-index:1000;"
                     @onclick:stopPropagation>
                    @switch (_contextMenuType)
                    {
                        case ContextMenuType.Canvas:
                            <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(!DiagramClipboard.HasNodes)" @onclick="ContextMenuPaste">@Loc["TmDiagramEditor_Paste"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(!DiagramClipboard.HasNodes)" @onclick="ContextMenuPasteHere">@Loc["TmDiagramEditor_PasteHere"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuSelectAll">@Loc["TmDiagramEditor_SelectAll"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(!ActiveCommandStack.CanUndo)" @onclick="ContextMenuUndo">@Loc["TmDiagramEditor_Undo"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(!ActiveCommandStack.CanRedo)" @onclick="ContextMenuRedo">@Loc["TmDiagramEditor_Redo"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_Insert"]</span>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuInsertText">@Loc["TmDiagramEditor_Text"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuInsertRectangle">@Loc["TmDiagramEditor_Rectangle"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuInsertEllipse">@Loc["TmDiagramEditor_Ellipse"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_Layout"]</span>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuRunLayout("dagre", "TB")'>@Loc["TmDiagramEditor_LayoutDagreTb"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuRunLayout("dagre", "LR")'>@Loc["TmDiagramEditor_LayoutDagreLr"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuRunLayout("tree", "TB")'>@Loc["TmDiagramEditor_LayoutTree"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuRunLayout("force", "")'>@Loc["TmDiagramEditor_LayoutForce"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuRunLayout("circle", "")'>@Loc["TmDiagramEditor_LayoutCircle"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuToggleGrid">@Loc[ShowGrid ? "TmDiagramEditor_HideGrid" : "TmDiagramEditor_ShowGrid"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuTogglePageView">@Loc[ShowPageView ? "TmDiagramEditor_HidePageView" : "TmDiagramEditor_ShowPageView"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuToggleSnapToGrid">@Loc[GridSize == 0 ? "TmDiagramEditor_EnableSnap" : "TmDiagramEditor_DisableSnap"]</button>
                            break;

                        case ContextMenuType.Node:
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuCut">@Loc["TmDiagramEditor_Cut"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuCopy">@Loc["TmDiagramEditor_Copy"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuDuplicate">@Loc["TmDiagramEditor_Duplicate"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(DiagramClipboard.Style is null)" @onclick="ContextMenuPasteStyle">@Loc["TmDiagramEditor_PasteStyle"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(DiagramClipboard.Width is null)" @onclick="ContextMenuPasteSize">@Loc["TmDiagramEditor_PasteSize"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuBringToFront">@Loc["TmDiagramEditor_BringToFront"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuSendToBack">@Loc["TmDiagramEditor_SendToBack"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            @if (GetContextMenuNodeLocked())
                            {
                                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuUnlock">@Loc["TmDiagramEditor_Unlock"]</button>
                            }
                            else
                            {
                                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuLock">@Loc["TmDiagramEditor_Lock"]</button>
                            }
                            @if (CanContextMenuGroup())
                            {
                                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuGroup">@Loc["TmDiagramEditor_Group"]</button>
                            }
                            @if (CanContextMenuUngroup())
                            {
                                <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuUngroup">@Loc["TmDiagramEditor_Ungroup"]</button>
                            }
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_ChangeShape"]</span>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuReplaceShape("general.rectangle")'>@Loc["TmDiagramEditor_Rectangle"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuReplaceShape("general.ellipse")'>@Loc["TmDiagramEditor_Ellipse"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuReplaceShape("general.text")'>@Loc["TmDiagramEditor_Text"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuReplaceShape("general.diamond")'>@Loc["TmDiagramEditor_Diamond"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <button class="tm-diagram-editor__context-item tm-diagram-editor__context-item--danger" role="menuitem" @onclick="ContextMenuDelete">@Loc["TmDiagramEditor_Delete"]</button>
                            break;

                        case ContextMenuType.Edge:
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuEditEdgeLabel">@Loc["TmDiagramEditor_EditLabel"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_Connector"]</span>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeConnector("straight")'>@Loc["TmDiagramEditor_Straight"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeConnector("orthogonal")'>@Loc["TmDiagramEditor_Orthogonal"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeConnector("curved")'>@Loc["TmDiagramEditor_Curved"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_StartArrow"]</span>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadStart("none")'>@Loc["TmDiagramEditor_ArrowNone"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadStart("classic")'>@Loc["TmDiagramEditor_ArrowClassic"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadStart("block")'>@Loc["TmDiagramEditor_ArrowBlock"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadStart("crow")'>@Loc["TmDiagramEditor_ArrowCrow"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_EndArrow"]</span>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadEnd("none")'>@Loc["TmDiagramEditor_ArrowNone"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadEnd("classic")'>@Loc["TmDiagramEditor_ArrowClassic"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadEnd("block")'>@Loc["TmDiagramEditor_ArrowBlock"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeArrowheadEnd("crow")'>@Loc["TmDiagramEditor_ArrowCrow"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_LineStyle"]</span>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="() => ContextMenuChangeEdgeLineStyle(null)">@Loc["TmDiagramEditor_LineSolid"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeLineStyle("5,5")'>@Loc["TmDiagramEditor_LineDashed"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuChangeEdgeLineStyle("2,2")'>@Loc["TmDiagramEditor_LineDotted"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <button class="tm-diagram-editor__context-item tm-diagram-editor__context-item--danger" role="menuitem" @onclick="ContextMenuDeleteEdge">@Loc["TmDiagramEditor_Delete"]</button>
                            break;

                        case ContextMenuType.TableCell:
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuInsertRowAbove">@Loc["TmDiagramEditor_InsertRowAbove"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuInsertRowBelow">@Loc["TmDiagramEditor_InsertRowBelow"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuInsertColumnLeft">@Loc["TmDiagramEditor_InsertColumnLeft"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick="ContextMenuInsertColumnRight">@Loc["TmDiagramEditor_InsertColumnRight"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(!CanContextMenuMergeCells())" @onclick="ContextMenuMergeCells">@Loc["TmDiagramEditor_MergeCells"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" disabled="@(!CanContextMenuSplitCell())" @onclick="ContextMenuSplitCell">@Loc["TmDiagramEditor_SplitCell"]</button>
                            <div class="tm-diagram-editor__context-sep" role="separator"></div>
                            <span class="tm-diagram-editor__context-heading">@Loc["TmDiagramEditor_FormatCell"]</span>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuFormatTableCell("#ffffff", "#e5e7eb")'>@Loc["TmDiagramEditor_CellWhite"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuFormatTableCell("#f3f4f6", "#d1d5db")'>@Loc["TmDiagramEditor_CellLightGray"]</button>
                            <button class="tm-diagram-editor__context-item" role="menuitem" @onclick='() => ContextMenuFormatTableCell("#d1d5db", "#9ca3af")'>@Loc["TmDiagramEditor_CellGray"]</button>
                            break;
                    }
                </div>
                <div class="tm-diagram-editor__context-backdrop" style="position:fixed;inset:0;z-index:999;" @onclick="CloseContextMenu"></div>
            }

        </div>

        @* Right: Properties + Layers + Minimap *@
        @if ((ShowPropertiesPanel && !_propsCollapsed) || (ShowLayersPanel && !_layersCollapsed) || (ShowMinimap && !_minimapCollapsed))
        {
            <div class="tm-diagram-editor__right-stack">
                @if ((ShowPropertiesPanel && !_propsCollapsed) || (ShowLayersPanel && !_layersCollapsed))
                {
                    <div class="tm-diagram-editor__right-wrap">
                        @if (ShowPropertiesPanel && !_propsCollapsed)
                        {
                            <div class="tm-diagram-editor__props-wrap">
                                <TmDiagramPropertiesPanel Document="_document"
                                                          DocumentChanged="OnDocumentChanged"
                                                          SelectedIds="_selectedIds"
                                                          OnEdgeRoutingChanged="HandleEdgeRoutingChanged"
                                                          OnApplyLayout="args => RunLayout(args.Algorithm, args.Direction)"
                                                          OnPageSizeChanged="HandlePageSizeChanged"
                                                          SelectedTableCells="_selectedTableCells"
                                                          SelectedTableCellsChanged="OnSelectedTableCellsChanged"
                                                          Class="tm-diagram-editor__props" />
                            </div>
                        }
                        @if (ShowLayersPanel && !_layersCollapsed)
                        {
                            <div class="tm-diagram-editor__layers-wrap">
                                <TmDiagramLayersPanel Document="_document"
                                                      DocumentChanged="OnDocumentChanged"
                                                      SelectedIds="_selectedIds"
                                                      ActiveLayerId="_activeLayerId"
                                                      ActiveLayerIdChanged="id => _activeLayerId = id"
                                                      Class="tm-diagram-editor__layers" />
                            </div>
                        }
                    </div>
                }
                @if (ShowMinimap && !_minimapCollapsed)
                {
                    <div class="tm-diagram-editor__minimap-wrap">
                        <TmDiagramMinimap Document="_document"
                                          SelectedIds="_selectedIds"
                                          Viewport="_minimapViewport"
                                          NavigateRequested="OnMinimapNavigate"
                                          Class="tm-diagram-editor__minimap" />
                    </div>
                }
            </div>
        }

    </div>

</div>

@* Connect stencil selection modal *@
<TmModal Show="@_connectModalOpen"
         OnClose="CloseConnectModal"
         Title="@Loc["TmDiagramEditor_SelectStencilTitle"]"
         ShowDefaultFooterButtons="false"
         Size="ModalSize.Medium"
         CloseOnOverlayClick="true"
         CloseOnEscape="true">
    <ChildContent>
        <div class="tm-diagram-connect-modal__grid">
            @foreach (var stencil in StencilRegistry.GetAll())
            {
                <button type="button"
                        class="tm-diagram-connect-modal__item"
                        title="@stencil.Name"
                        @onclick="() => OnStencilSelectedForConnect(stencil.Id)">
                    <div class="tm-diagram-connect-modal__icon">
                        @if (!string.IsNullOrEmpty(stencil.IconSvg))
                        {
                            <svg viewBox="0 0 32 32" aria-hidden="true" style="width:32px;height:32px;">
                                @((MarkupString)stencil.IconSvg)
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 32 32" aria-hidden="true" style="width:32px;height:32px;">
                                <rect x="2" y="8" width="28" height="16" rx="2"
                                      fill="var(--tm-color-surface-elevated)"
                                      stroke="var(--tm-color-text)" stroke-width="2" />
                            </svg>
                        }
                    </div>
                    <span class="tm-diagram-connect-modal__label">@stencil.Name</span>
                </button>
            }
        </div>
    </ChildContent>
</TmModal>

@* SQL Import dialog *@
<TmDiagramSqlImportDialog Show="@_sqlImportDialogOpen"
                          OnClose="CloseSqlImportDialog"
                          OnImport="OnSqlImport" />

@* CSV Import dialog *@
<TmDiagramCsvImportDialog Show="@_csvImportDialogOpen"
                          OnClose="CloseCsvImportDialog"
                          OnImport="OnCsvImport" />

@* Template gallery *@
<TmDiagramTemplateGallery Show="@_showTemplateGallery"
                            OnClose="CloseTemplateGallery"
                            OnSelect="OnTemplateSelected" />

</CascadingValue>

@* Hidden download anchor for export *@
<a @ref="_downloadAnchor" style="display:none"></a>
