@namespace Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Components.Icons
@using Tempo.Blazor.Helpers
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (IsOpen)
{
    @if (ShowOverlay)
    {
        <div class="tm-drawer__overlay" @onclick="HandleOverlayClick"></div>
    }

    <div class="tm-drawer @PositionClass @Class"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@(!string.IsNullOrEmpty(Title) ? "tm-drawer-title" : null)"
         @ref="_drawerElement"
         @attributes="AdditionalAttributes">

        <div class="tm-drawer__panel" style="width: @Width;">
            <!-- Header -->
            <div class="tm-drawer__header">
                @if (HeaderContent is not null)
                {
                    @HeaderContent
                }
                else if (!string.IsNullOrEmpty(Title))
                {
                    <h2 id="tm-drawer-title" class="tm-drawer__title">@Title</h2>
                }

                @if (ShowCloseButton)
                {
                    <button type="button"
                            class="tm-drawer__close"
                            aria-label="@Loc["TmDrawer_Close"]"
                            @onclick="Close">
                        <TmIcon Name="x" Size="IconSize.Sm" />
                    </button>
                }
            </div>

            <!-- Body -->
            <div class="tm-drawer__body">
                @ChildContent
            </div>

            <!-- Footer -->
            @if (FooterContent is not null)
            {
                <div class="tm-drawer__footer">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>Whether the drawer is open.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Fires when the drawer should open or close.</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Side from which the drawer slides in.</summary>
    [Parameter] public DrawerPosition Position { get; set; } = DrawerPosition.Right;

    /// <summary>Width of the drawer panel.</summary>
    [Parameter] public string Width { get; set; } = "400px";

    /// <summary>Title shown in the header.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Show a semi-transparent backdrop behind the drawer.</summary>
    [Parameter] public bool ShowOverlay { get; set; } = true;

    /// <summary>Close the drawer when clicking the overlay.</summary>
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;

    /// <summary>Close the drawer when pressing Escape.</summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;

    /// <summary>Show the X close button in the header.</summary>
    [Parameter] public bool ShowCloseButton { get; set; } = true;

    /// <summary>Custom header content (replaces Title).</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>Main body content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional footer with action buttons.</summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>Additional CSS class for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Additional HTML attributes for the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _drawerElement;
    private bool _wasOpen;
    private bool _shouldActivateTrap;
    private FocusTrap? _focusTrap;
    private DotNetObjectReference<TmDrawer>? _dotNetRef;

    private string PositionClass => Position switch
    {
        DrawerPosition.Left => "tm-drawer--left",
        _ => "tm-drawer--right"
    };

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _shouldActivateTrap = true;
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            await DeactivateTrapAsync();
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldActivateTrap && IsOpen)
        {
            _shouldActivateTrap = false;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            _focusTrap ??= new FocusTrap(JS);
            // Escape is handled at the document level so it closes the drawer regardless of
            // where focus currently sits (the panel is not always the focused element).
            await _focusTrap.ActivateAsync(_drawerElement, _dotNetRef, CloseOnEscape);
        }
    }

    /// <summary>Invoked by the shared focus-trap module when Escape is pressed at the document level.</summary>
    [JSInvokable]
    public async Task HandleFocusTrapEscapeAsync()
    {
        if (CloseOnEscape)
        {
            await Close();
        }
    }

    private async Task Close()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleOverlayClick()
    {
        if (CloseOnOverlayClick)
            await Close();
    }

    private async Task DeactivateTrapAsync()
    {
        if (_focusTrap is not null)
        {
            await _focusTrap.DeactivateAsync();
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_focusTrap is not null)
        {
            await _focusTrap.DisposeAsync();
        }
        _dotNetRef?.Dispose();
    }
}
