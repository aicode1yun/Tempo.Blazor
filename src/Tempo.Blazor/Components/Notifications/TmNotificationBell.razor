@namespace Tempo.Blazor.Components.Notifications
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.Components.Icons
@implements IDisposable

<div class="tm-notification-bell @Class @(_hasNew ? "tm-notification-bell--pulse" : "")"
     @attributes="AdditionalAttributes"
     @ref="_rootRef">
    <button type="button"
            class="tm-notification-bell__button"
            aria-label="@AriaLabelText"
            title="@AriaLabelText"
            @onclick="ToggleAsync">
        <TmIcon Name="@IconNames.Bell" Size="IconSize.Sm" />
        @if (UnreadCount > 0)
        {
            <span class="tm-notification-bell__badge">@UnreadCount</span>
        }
    </button>

    @if (_isOpen)
    {
        <div class="tm-notification-bell__dropdown">
            <div class="tm-notification-bell__header">
                <span class="tm-notification-bell__title">@Loc["TmNotificationBell_AriaLabel"]</span>
                <div class="tm-notification-bell__actions">
                    <button type="button"
                            class="tm-notification-bell__filter"
                            @onclick="() => _showOnlyUnread = !_showOnlyUnread">
                        @(_showOnlyUnread ? Loc["TmNotificationBell_ShowAll"] : Loc["TmNotificationBell_ShowOnlyUnread"])
                    </button>
                    @if (UnreadCount > 0)
                    {
                        <button type="button"
                                class="tm-notification-bell__mark-all"
                                @onclick="MarkAllReadAsync">
                            @Loc["TmNotificationBell_MarkAllRead"]
                        </button>
                    }
                </div>
            </div>

            <div class="tm-notification-bell__list">
                @if (VisibleNotifications.Any())
                {
                    @foreach (var n in VisibleNotifications)
                    {
                        <div class="tm-notification-bell__item @(n.IsRead ? "" : "tm-notification-bell__item--unread")"
                             @onclick="() => OnItemClickAsync(n)">
                            <div class="tm-notification-bell__avatar">
                                @if (!string.IsNullOrEmpty(n.Event.SenderAvatarUrl))
                                {
                                    <img src="@n.Event.SenderAvatarUrl" alt="" />
                                }
                                else
                                {
                                    <TmIcon Name="@TypeIcon(n.Event.Type)" Size="IconSize.Sm" />
                                }
                            </div>
                            <div class="tm-notification-bell__content">
                                <span class="tm-notification-bell__message">@n.Event.Message</span>
                                <span class="tm-notification-bell__time">@FormatTime(n.Event.CreatedAt)</span>
                            </div>
                            @if (!n.IsRead)
                            {
                                <span class="tm-notification-bell__dot" aria-hidden="true"></span>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="tm-notification-bell__empty">@Loc["TmNotificationBell_NoNotifications"]</div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Inject] private INotificationService NotificationService { get; set; } = default!;
    [Inject] private INotificationBadgeState BadgeState { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    [Parameter] public string? Class { get; set; }
    [Parameter] public string CurrentUserId { get; set; } = "demo";
    [Parameter] public EventCallback<bool> OnDropdownOpenChanged { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _isOpen;
    private bool _hasNew;
    private bool _showOnlyUnread;
    private List<INotification> _notifications = new();
    private ElementReference _rootRef;

    private int UnreadCount => BadgeState.UnreadCount;

    private string AriaLabelText => UnreadCount > 0
        ? Loc["TmNotificationBell_NewCount", UnreadCount]
        : Loc["TmNotificationBell_AriaLabel"];

    private IEnumerable<INotification> VisibleNotifications =>
        _showOnlyUnread ? _notifications.Where(n => !n.IsRead) : _notifications;

    protected override void OnInitialized()
    {
        BadgeState.OnChanged += OnBadgeChanged;
    }

    private async void OnBadgeChanged()
    {
        await InvokeAsync(async () =>
        {
            _hasNew = true;
            if (_isOpen)
                await LoadNotificationsAsync();
            StateHasChanged();
        });
    }

    private async Task ToggleAsync()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            _hasNew = false;
            await LoadNotificationsAsync();
        }
        else
        {
            _showOnlyUnread = false;
        }
        await OnDropdownOpenChanged.InvokeAsync(_isOpen);
    }

    private async Task LoadNotificationsAsync()
    {
        _notifications = (await NotificationService.GetNotificationsAsync(CurrentUserId, limit: 50)).ToList();
    }

    private async Task MarkAllReadAsync()
    {
        await NotificationService.MarkAllAsReadAsync(CurrentUserId);
        await LoadNotificationsAsync();
    }

    private async Task OnItemClickAsync(INotification notification)
    {
        if (!notification.IsRead)
            await NotificationService.MarkAsReadAsync(notification.Id, CurrentUserId);

        if (!string.IsNullOrEmpty(notification.Event.DeepLink))
            Navigation.NavigateTo(notification.Event.DeepLink);

        await LoadNotificationsAsync();
    }

    private static string FormatTime(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt.ToUniversalTime();
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("MMM d");
    }

    private static string TypeIcon(NotificationType type) => type switch
    {
        NotificationType.Mention => IconNames.AtSign,
        NotificationType.Reply => IconNames.MessageSquare,
        NotificationType.Reaction => IconNames.ThumbsUp,
        NotificationType.ThreadResolved => IconNames.CheckCircle,
        NotificationType.NewThread => IconNames.PlusCircle,
        _ => IconNames.Bell
    };

    public void Dispose()
    {
        BadgeState.OnChanged -= OnBadgeChanged;
    }
}
