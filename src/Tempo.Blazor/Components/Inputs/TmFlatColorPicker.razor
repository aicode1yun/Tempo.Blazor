@namespace Tempo.Blazor.Components.Inputs
@using Tempo.Blazor.Abstractions.Models
@inject ITmLocalizer Loc

<div class="tm-flat-color-picker @Class" @attributes="AdditionalAttributes">
    @if (ShowPreview)
    {
        <div class="tm-flat-color-picker-preview-row">
            <div class="tm-flat-color-picker-preview-bg">
                <div class="tm-flat-color-picker-preview" style="background: @(_currentValue);"></div>
            </div>
            <span class="tm-flat-color-picker-value-text">@_currentValue</span>
        </div>
    }

    <TmColorGradient Value="@_currentValue"
                     ValueChanged="OnGradientValueChanged"
                     Format="Format"
                     ShowAlpha="ShowAlpha" />

    @if (ShowPalette)
    {
        <div class="tm-flat-color-picker-divider"></div>
        <TmColorPalette Value="@_currentValue"
                        ValueChanged="OnPaletteValueChanged"
                        ShowClearButton="ShowClearButton" />
    }
</div>
