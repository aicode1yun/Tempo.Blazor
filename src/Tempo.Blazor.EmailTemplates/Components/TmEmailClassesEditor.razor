@namespace Tempo.Blazor.EmailTemplates.Components

<div class="tm-email-classes" data-tm-classes-editor>
    @foreach (var entry in Attributes.Classes.ToList())
    {
        var name = entry.Key;
        <div class="tm-email-classes__class" data-tm-class="@name">
            <div class="tm-email-classes__class-head">
                <code>.@name</code>
                <button type="button" data-tm-class-remove aria-label="@Loc["EmailEditor_Action_Delete"]"
                        @onclick="() => RemoveAsync(name)">
                    <TmIcon Name="trash-2" Size="IconSize.Xs" />
                </button>
            </div>
            <TmEmailKeyValueEditor Items="Attributes.Classes[name]" OnChanged="OnChanged" />
        </div>
    }
    <div class="tm-email-classes__add">
        <TmTextInput Placeholder="@Loc["EmailEditor_Classes_NewName"]" Value="_newName"
                     ValueChanged="v => _newName = v" />
        <TmButton Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary" Icon="plus"
                  data-tm-class-add="true" OnClick="AddAsync">@Loc["EmailEditor_Classes_Add"]</TmButton>
    </div>
</div>

@code {
    /// <summary>The head attributes containing the named-class definitions (<c>mj-class</c>).</summary>
    [Parameter, EditorRequired] public MjAttributes Attributes { get; set; } = default!;

    /// <summary>Raised after the class definitions change.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private string _newName = string.Empty;

    private async Task AddAsync()
    {
        var name = _newName.Trim();
        if (string.IsNullOrEmpty(name) || Attributes.Classes.ContainsKey(name)) return;
        Attributes.Classes[name] = new Dictionary<string, string>();
        _newName = string.Empty;
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveAsync(string name)
    {
        Attributes.Classes.Remove(name);
        await OnChanged.InvokeAsync();
    }
}
