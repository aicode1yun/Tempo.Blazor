<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Tempo.Blazor.DocumentFormats</PackageId>
    <Version>2.3.9</Version>
    <Title>Tempo.Blazor.DocumentFormats</Title>
    <Description>Optional server-side DOCX and ODT import/export support for TmDocumentEditor.</Description>
    <Authors>Tempo</Authors>
    <PackageTags>blazor;documents;docx;odt;openxml;document-editor</PackageTags>
    <RepositoryUrl>https://github.com/tempo/tempo-blazor</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tempo.Blazor.Abstractions\Tempo.Blazor.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
