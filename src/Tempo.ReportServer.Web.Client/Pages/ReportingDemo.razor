@namespace Tempo.ReportServer.Web.Pages
@page "/reporting"
@using Tempo.Reporting.Abstractions.Definitions
@inject DemoReportSourceFactory SourceFactory
@inject NavigationManager Navigation

<main class="report-demo-shell" data-testid="reporting-demo-page">
    <div class="report-demo-title">
        <h1>Sales Register</h1>
    </div>

<TmReportViewer ReportSource="@_source"
                Height="760px"
                ShowParameterPanel="false"
                TenantId="demo"
                UserId="playwright"
                CultureName="en-US"
                OnDrillThrough="HandleDrillThrough" />
</main>

@code {
    private IReportSource? _source;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _source = SourceFactory.CreateSalesRegister();
    }

    // Demonstrates drill-through: the viewer resolves the target report + mapped parameters from the
    // clicked context and the host navigates to the target's deep link (/reports/{path}?param=value).
    private void HandleDrillThrough(ReportDrillThroughResolution resolution)
    {
        var url = ReportDeepLink.Build(resolution);
        if (url is not null)
        {
            Navigation.NavigateTo(url);
        }
    }
}
