@namespace Tempo.ReportServer.Web.Pages
@page "/designer/{ReportId?}"
@using Tempo.Reporting.Abstractions.Definitions
@inject IPortalIdentity Session
@inject ITempoReportServerClient Client
@inject DemoReportSourceFactory SourceFactory

<ReportServerShell Title="Report designer" ActiveSection="designer">
    <div class="rs-page rs-designer-page" data-testid="f13-designer-page">
        <div class="rs-page__heading">
            <div>
                <p class="rs-kicker">@(_resolved?.FolderId ?? "/finance")</p>
                <h2>@(_definition?.Name ?? "Report designer")</h2>
            </div>
            <div class="rs-page__stats">
                <span>@(_definition?.DataSets.Count ?? 0) datasets</span>
                <span>@(_resolved is null ? "Draft report" : $"Revision {_resolved.RevisionNumber}")</span>
            </div>
        </div>

        @if (_definition is null)
        {
            <div class="rs-empty" data-testid="designer-not-found">
                <TmIcon Name="@IconNames.AlertTriangle" Size="IconSize.Md" />
                <strong>Report not found</strong>
                <span>The requested report does not exist in this tenant.</span>
            </div>
        }
        else
        {
            <TmReportDesigner Definition="@_definition"
                              DefinitionChanged="HandleDefinitionChanged"
                              Saved="HandleSaved" />
        }

        @if (_lastSave is not null)
        {
            <div class="rs-status" data-testid="designer-save-status">
                <TmIcon Name="@IconNames.Check" Size="IconSize.Sm" />
                <span>@_lastSave.Kind saved as revision @_lastSave.Revision</span>
            </div>
        }
    </div>
</ReportServerShell>

@code {
    /// <summary>Catalog report id to open in the designer.</summary>
    [Parameter] public string? ReportId { get; set; }

    private ReportResolveResultDto? _resolved;
    private ReportDefinition? _definition;
    private ReportDesignerSaveEventArgs? _lastSave;
    private string? _loadedReportId;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        var reportId = string.IsNullOrWhiteSpace(ReportId) ? "sales-register" : ReportId;
        if (string.Equals(_loadedReportId, reportId, StringComparison.Ordinal))
        {
            return;
        }

        _loadedReportId = reportId;
        _lastSave = null;
        try
        {
            // Resolution goes through the typed client (/resolve); the editable definition is still
            // materialized in-process by the demo source factory for the self-contained demo.
            _resolved = await Client.ResolveReportAsync(Session.CurrentTenantId, reportId: reportId);
            _definition = SourceFactory.CreateReportDefinition(_resolved.ReportId);
        }
        catch (KeyNotFoundException)
        {
            _resolved = null;
            _definition = null;
        }
    }

    private void HandleDefinitionChanged(ReportDefinition definition)
        => _definition = definition;

    private void HandleSaved(ReportDesignerSaveEventArgs args)
    {
        _definition = args.Definition;
        _lastSave = args;
    }
}
