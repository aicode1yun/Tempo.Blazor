@namespace Tempo.ReportServer.Web.Pages
@page "/admin/datasources"
@inject ReportServerSessionState Session
@inject ReportServerCatalogStore Catalog

<ReportServerShell Title="Data sources" ActiveSection="datasources">
    <div class="rs-page" data-testid="f12-datasources-page">
        <div class="rs-page__heading">
            <div>
                <p class="rs-kicker">Administration</p>
                <h2>Data sources</h2>
            </div>
        </div>

        <section class="rs-admin-grid">
            <form class="rs-panel" @onsubmit="AddSource" @onsubmit:preventDefault>
                <h3>Add source</h3>
                <label class="rs-field">
                    <span>Name</span>
                    <input data-testid="datasource-name" value="@_name" @oninput="HandleNameInput" />
                </label>
                <label class="rs-field">
                    <span>Provider</span>
                    <select data-testid="datasource-provider" value="@_provider" @onchange="HandleProviderChange">
                        <option>SQL</option>
                        <option>REST JSON</option>
                    </select>
                </label>
                <label class="rs-field">
                    <span>Endpoint</span>
                    <input data-testid="datasource-endpoint" value="@_endpoint" @oninput="HandleEndpointInput" />
                </label>
                <TmButton Variant="ButtonVariant.Primary" Icon="@IconNames.Plus" data-testid="datasource-add" OnClick="AddSource">
                    Add source
                </TmButton>
            </form>

            <section class="rs-panel rs-table-panel">
                <h3>Connections</h3>
                <div class="rs-table" data-testid="datasources-table">
                    @foreach (var source in TenantCatalog.DataSources)
                    {
                        <article class="rs-table__row">
                            <div>
                                <strong>@source.Name</strong>
                                <span>@source.Provider</span>
                            </div>
                            <code>@source.Endpoint</code>
                            <span class="@(source.LastTestSucceeded ? "rs-status rs-status--ok" : "rs-status")">@source.LastTestMessage</span>
                            <button type="button" class="rs-text-button" data-testid="@($"test-datasource-{source.Id}")" @onclick="() => TestSource(source.Id)">
                                Test connection
                            </button>
                        </article>
                    }
                </div>
            </section>
        </section>
    </div>
</ReportServerShell>

@code {
    private string _name = "Analytics API";
    private string _provider = "REST JSON";
    private string _endpoint = "https://api.example.test/analytics";

    private ReportServerTenantCatalog TenantCatalog => Catalog.GetCatalog(Session.CurrentTenantId);

    private void HandleNameInput(ChangeEventArgs args)
        => _name = args.Value?.ToString() ?? string.Empty;

    private void HandleProviderChange(ChangeEventArgs args)
        => _provider = args.Value?.ToString() ?? "SQL";

    private void HandleEndpointInput(ChangeEventArgs args)
        => _endpoint = args.Value?.ToString() ?? string.Empty;

    private void AddSource()
        => Catalog.AddDataSource(Session.CurrentTenantId, _name, _provider, _endpoint);

    private void TestSource(string id)
        => Catalog.TestDataSource(Session.CurrentTenantId, id);
}
