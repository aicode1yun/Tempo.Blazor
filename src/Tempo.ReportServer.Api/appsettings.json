{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer",
    "Seed": {
      "Enabled": false,
      "TenantId": "default",
      "RootFolderName": "Root",
      "OwnerSubject": "",
      "OwnerRole": "Admin"
    }
  },
  "ConnectionStrings": {
    "ReportServer": "Server=localhost\\SQLEXPRESS;Database=TempoReportServer;Integrated Security=true;TrustServerCertificate=true;"
  },
  "Rendering": {
    "MaxSynchronousPages": 20,
    "MaxQueuedPages": 200,
    "Timeout": "00:00:30",
    "MaxConcurrentRenders": 4,
    "MaxRenderQueueLength": 50,
    "MaxOutputBytes": 52428800
  },
  "Scheduling": {
    "Webhook": {
      "AllowedSchemes": [ "https" ],
      "AllowPrivateNetworks": false,
      "Timeout": "00:00:30"
    }
  },
  "Authentication": {
    "Jwt": {
      "Authority": "",
      "Audience": "tempo-report-api",
      "RequireHttpsMetadata": true
    }
  },
  "Cors": {
    "FrontendOrigin": ""
  }
}
