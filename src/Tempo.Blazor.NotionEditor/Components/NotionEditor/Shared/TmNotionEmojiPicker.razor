@namespace Tempo.Blazor.Components.NotionEditor.Shared

<div class="tm-notion-emoji-picker"
     role="dialog"
     aria-label="@Loc["TmNotionEmojiPicker_Title"]"
     aria-modal="true">

    <div class="tm-notion-emoji-picker__header">
        <input class="tm-notion-emoji-picker__search"
               type="search"
               placeholder="@Loc["TmNotionEmojiPicker_Search"]"
               @bind="_search"
               @bind:event="oninput"
               autofocus />
        @if (ShowRemoveButton)
        {
            <button class="tm-notion-emoji-picker__remove"
                    type="button"
                    @onclick="() => OnRemoved.InvokeAsync()"
                    @onclick:stopPropagation="true">
                @Loc["TmNotionEmojiPicker_Remove"]
            </button>
        }
    </div>

    <div class="tm-notion-emoji-picker__body">
        @foreach (var cat in FilteredCategories)
        {
            <div class="tm-notion-emoji-picker__category">
                <div class="tm-notion-emoji-picker__category-label">@cat.Name</div>
                <div class="tm-notion-emoji-picker__grid">
                    @foreach (var item in cat.Emojis)
                    {
                        var captured = item;
                        <button class="tm-notion-emoji-picker__btn"
                                type="button"
                                title="@captured.Name"
                                aria-label="@captured.Name"
                                @onclick="() => OnSelected.InvokeAsync(captured.Char)"
                                @onclick:stopPropagation="true">
                            @captured.Char
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="tm-notion-emoji-picker-backdrop"
     aria-hidden="true"
     @onclick="() => OnClosed.InvokeAsync()">
</div>
