@namespace Tempo.Blazor.Components.NotionEditor.Page
@using Tempo.Blazor.NotionEditor.Interfaces

@if (Visible)
{
    <div class="tm-page-info-backdrop" aria-hidden="true" @onclick="CloseAsync"></div>
    <aside class="tm-page-info"
           role="dialog"
           aria-modal="true"
           aria-label="@Loc["Notion_PageInfo_Title"]"
           data-page-info-panel>
        <header class="tm-page-info__header">
            <div>
                <h2 class="tm-page-info__title">@Loc["Notion_PageInfo_Title"]</h2>
                <p class="tm-page-info__subtitle">@Page.Title</p>
            </div>
            <button class="tm-page-info__close"
                    type="button"
                    aria-label="@Loc["Tm_Close"]"
                    title="@Loc["Tm_Close"]"
                    @onclick="CloseAsync">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </button>
        </header>

        <section class="tm-page-info__section" aria-label="@Loc["Notion_PageInfo_Title"]">
            <dl class="tm-page-info__facts">
                <div class="tm-page-info__fact tm-page-info__created">
                    <dt>@Loc["Notion_PageInfo_Created"]</dt>
                    <dd>
                        <span class="tm-page-info__user">@FormatUser(Page.CreatedByUserId)</span>
                        <time datetime="@Page.CreatedAt.ToString("O")">@FormatDate(Page.CreatedAt)</time>
                    </dd>
                </div>
                <div class="tm-page-info__fact tm-page-info__last-edited">
                    <dt>@Loc["Notion_PageInfo_LastEdited"]</dt>
                    <dd>
                        <span class="tm-page-info__user">@FormatUser(Page.LastEditedByUserId)</span>
                        <time datetime="@Page.LastEditedAt.ToString("O")">@FormatDate(Page.LastEditedAt)</time>
                    </dd>
                </div>
            </dl>
        </section>

        <section class="tm-page-info__metrics" aria-label="@Loc["Notion_PageInfo_Words"]">
            <div class="tm-page-info__metric tm-page-info__words">
                <span class="tm-page-info__metric-label">@Loc["Notion_PageInfo_Words"]</span>
                <strong class="tm-page-info__metric-value">@_stats.WordCount.ToString("N0")</strong>
            </div>
            <div class="tm-page-info__metric tm-page-info__reading-time">
                <span class="tm-page-info__metric-label">@Loc["Notion_PageInfo_ReadingTime"]</span>
                <strong class="tm-page-info__metric-value">@string.Format(Loc["Notion_PageInfo_Minutes"], _stats.ReadingTimeMinutes)</strong>
            </div>
            @if (_analytics is not null)
            {
                <div class="tm-page-info__metric tm-page-info__views">
                    <span class="tm-page-info__metric-label">@Loc["Notion_PageInfo_Views"]</span>
                    <strong class="tm-page-info__metric-value">@_analytics.Views.ToString("N0")</strong>
                </div>
            }
        </section>
    </aside>
}
