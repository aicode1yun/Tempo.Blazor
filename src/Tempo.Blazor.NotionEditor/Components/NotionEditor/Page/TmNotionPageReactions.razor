@namespace Tempo.Blazor.Components.NotionEditor.Page

@if (Context.ReactionProvider is not null)
{
    <div class="tm-page-reactions" data-page-reactions>
        <button type="button"
                class="@LikeClass"
                aria-pressed="@IsActive(LikeReaction).ToString().ToLowerInvariant()"
                aria-label="@Loc["Notion_Reactions_Like"]"
                title="@Loc["Notion_Reactions_Like"]"
                disabled="@_busy"
                @onclick="ToggleLikeAsync">
            <span class="tm-page-reactions__like-icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
                    <path d="M4.7 6.3l2.5-4.2c.2-.3.6-.5 1-.4.5.1.8.5.8 1v3h3.1c.8 0 1.3.7 1.1 1.4l-1.2 4.5c-.2.7-.8 1.2-1.6 1.2H5.5c-.5 0-.8-.4-.8-.8V6.3z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                    <path d="M2 6.5h2.7v6H2z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                </svg>
            </span>
            <span class="tm-page-reactions__like-label">@Loc["Notion_Reactions_Like"]</span>
            <span class="tm-page-reactions__like-count">@LikeCount</span>
        </button>

        @foreach (var reaction in VisibleEmojiReactions)
        {
            <button type="button"
                    class="@ReactionClass(reaction)"
                    data-reaction="@reaction.Reaction"
                    aria-pressed="@IsActive(reaction.Reaction).ToString().ToLowerInvariant()"
                    aria-label="@string.Format(Loc["Notion_Reactions_Count"], reaction.Count)"
                    disabled="@_busy"
                    @onclick="() => ToggleReactionAsync(reaction.Reaction)">
                <span aria-hidden="true">@reaction.Reaction</span>
                <span class="tm-page-reactions__pill-count">@reaction.Count</span>
            </button>
        }

        <div class="tm-page-reactions__picker-wrap">
            <button type="button"
                    class="tm-page-reactions__add"
                    aria-label="@Loc["Notion_Reactions_AddReaction"]"
                    title="@Loc["Notion_Reactions_AddReaction"]"
                    aria-haspopup="listbox"
                    aria-expanded="@_pickerOpen.ToString().ToLowerInvariant()"
                    disabled="@_busy"
                    @onclick="TogglePicker">
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                    <path d="M7.5 3v9M3 7.5h9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
            </button>

            @if (_pickerOpen)
            {
                <div class="tm-page-reactions__picker"
                     role="listbox"
                     aria-label="@Loc["Notion_Reactions_PickerLabel"]">
                    @foreach (var reaction in AvailableReactions)
                    {
                        <button type="button"
                                class="tm-page-reactions__choice"
                                role="option"
                                disabled="@_busy"
                                @onclick="() => ToggleReactionAsync(reaction)">
                            @reaction
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}
