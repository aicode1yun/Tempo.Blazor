@namespace Tempo.Blazor.Components.NotionEditor.Blocks.TempoBlocks
@using Tempo.Blazor.NotionEditor.Interfaces
@using Tempo.Blazor.Components.Diagram.Models
@using Tempo.Blazor.Components.Diagram.Services

<div class="tm-notion-diagram-edit-modal"
     role="dialog"
     aria-modal="true"
     aria-label="@Loc["TmNotionDiagramEditModal_Title"]">

    @if (_loading)
    {
        <div class="tm-notion-diagram-edit-modal__loading">
            <span class="tm-notion-diagram-edit-modal__spinner" aria-hidden="true"></span>
        </div>
    }
    else if (_document is not null)
    {
        @if (DiagramEditorComponentType is not null)
        {
            <DynamicComponent Type="DiagramEditorComponentType"
                              Parameters="DiagramEditorParameters" />
        }
        else
        {
            <div class="tm-notion-diagram-edit-modal__missing" role="status">
                @Loc["TmNotionDiagramEditModal_MissingPackage"]
            </div>
        }

        <div class="tm-notion-diagram-edit-modal__footer">
            <button class="tm-notion-diagram-edit-modal__btn tm-notion-diagram-edit-modal__btn--primary"
                    type="button"
                    disabled="@(_saving || DiagramEditorComponentType is null)"
                    @onclick="SaveAsync">
                @if (_saving)
                {
                    <span class="tm-notion-diagram-edit-modal__spinner tm-notion-diagram-edit-modal__spinner--sm"
                          aria-hidden="true"></span>
                }
                @Loc["TmNotionDiagramEditModal_Save"]
            </button>
            <button class="tm-notion-diagram-edit-modal__btn"
                    type="button"
                    disabled="@_saving"
                    @onclick="DiscardAsync">
                @Loc["TmNotionDiagramEditModal_Discard"]
            </button>
        </div>
    }

</div>
