@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Database.Cells
@inherits TmNotionDbCellBase
@using Tempo.Blazor.NotionEditor.Models

@if (IsEditing)
{
    <input class="tm-dbc__input tm-dbc__input--tel"
           type="tel"
           @ref="_inputRef"
           value="@_buffer"
           @oninput="e => _buffer = e.Value?.ToString() ?? string.Empty"
           @onblur="() => CommitAsync(_buffer.Length > 0 ? _buffer : null)"
           @onkeydown="e => HandleKeyAsync(e, () => CommitAsync(_buffer.Length > 0 ? _buffer : null))"
           @onclick:stopPropagation="true" />
}
else
{
    <div class="tm-dbc @(ReadOnly ? "tm-dbc--readonly" : "")"
         @onclick="() => !ReadOnly ? RequestEditAsync() : Task.CompletedTask">
        @if (StringValue.Length > 0)
        {
            <a class="tm-dbc__link"
               href="tel:@StringValue"
               title="@Loc["TmNotionDbCell_CallPhone"]"
               @onclick:stopPropagation="true">
                <svg class="tm-dbc__link-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 4 4L14 12l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"
                          stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                </svg>
                @StringValue
            </a>
        }
        else
        {
            <span class="tm-dbc__text tm-dbc__text--empty">&nbsp;</span>
        }
    </div>
}
