@namespace Tempo.Blazor.Components.NotionEditor.Blocks.Media
@using Tempo.Blazor.NotionEditor.Models
@using Tempo.Blazor.NotionEditor.Enums
@using Tempo.Blazor.Components.NotionEditor.UI

<div class="tm-notion-video-block" @onfocus="HandleFocusAsync">

    @if (string.IsNullOrEmpty(Content?.Url))
    {
        @if (!ReadOnly)
        {
            <button class="tm-notion-media-upload-zone tm-notion-media-upload-zone--video"
                    type="button"
                    aria-label="@Loc["TmNotionVideoBlock_AddVideo"]"
                    @onclick="OpenDialogAsync">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M10 8l6 4-6 4V8z" fill="currentColor"/>
                </svg>
                <span>@Loc["TmNotionVideoBlock_AddVideo"]</span>
            </button>

            <TmNotionMediaUploadDialog IsOpen="_dialogOpen"
                                       MediaType="video"
                                       OnConfirmed="HandleMediaSetAsync"
                                       OnCancelled="CloseDialogAsync" />
        }
        else
        {
            <div class="tm-notion-media-empty-placeholder">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M10 8l6 4-6 4V8z" fill="currentColor"/>
                </svg>
            </div>
        }
    }
    else
    {
        <figure class="tm-notion-video-block__figure">

            <div class="tm-notion-video-block__media-wrap"
                 style="@_widthStyle"
                 @ref="_wrapRef">

                @if (_isEmbedProvider)
                {
                    <div class="tm-notion-video-block__embed-wrap">
                        <iframe src="@_embedUrl"
                                class="tm-notion-video-block__embed"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen
                                title="@Loc["TmNotionVideoBlock_AddVideo"]">
                        </iframe>
                    </div>
                }
                else
                {
                    <video src="@Content.Url"
                           class="tm-notion-video-block__video"
                           controls
                           preload="metadata">
                    </video>
                }

                @if (!ReadOnly)
                {
                    <div class="tm-notion-video-block__overlay">
                        <button class="tm-notion-image-block__action-btn"
                                type="button"
                                title="@Loc["TmNotionVideoBlock_Replace"]"
                                @onclick="OpenDialogAsync"
                                @onclick:stopPropagation="true">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <polyline points="17 8 12 3 7 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <line x1="12" y1="3" x2="12" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            @Loc["TmNotionVideoBlock_Replace"]
                        </button>
                    </div>

                    <TmNotionMediaUploadDialog IsOpen="_dialogOpen"
                                               MediaType="video"
                                               OnConfirmed="HandleMediaSetAsync"
                                               OnCancelled="CloseDialogAsync" />
                }
            </div>

            @if (!string.IsNullOrEmpty(Content?.Caption) || !ReadOnly)
            {
                <figcaption class="tm-notion-image-block__caption tm-notion-editable"
                             contenteditable="@(!ReadOnly ? "true" : "false")"
                             data-placeholder="@Loc["TmNotionVideoBlock_CaptionPlaceholder"]"
                             @ref="_captionRef"
                             @oninput="() => _captionDirty = true"
                             @onblur="OnCaptionBlurAsync">
                </figcaption>
            }

        </figure>
    }

</div>
