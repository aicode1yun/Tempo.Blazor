    private string? GetRunnerValue(string fieldUuid)
    {
        if (fieldUuid == "runner-total"
            && _runnerValues.TryGetValue("runner-amount", out var amountValue)
            && decimal.TryParse(amountValue?.ToString(), out var amount))
        {
            return (amount * 1.21m).ToString("0.##");
        }

        return _runnerValues.TryGetValue(fieldUuid, out var value)
            ? value?.ToString()
            : null;
    }

    private static SigningField CreateField(
        SigningFieldType type,
        string name,
        string? title = null,
        bool required = false)
    {
        return new SigningField
        {
            Uuid = $"{type}-{name}".Replace(' ', '-').ToLowerInvariant(),
            Name = name,
            Title = title,
            Type = type,
            Required = required
        };
    }

    private static SigningField CreateChoiceField(SigningFieldType type, string name)
    {
        var field = CreateField(type, name);
        field.Options =
        [
            new SigningFieldOption { Uuid = "option-1", Value = "One" },
            new SigningFieldOption { Uuid = "option-2", Value = "Two" },
            new SigningFieldOption { Uuid = "option-3", Value = "Three" }
        ];

        return field;
    }

    private static SigningFieldArea CreateSampleArea(string? optionUuid = null)
    {
        return new SigningFieldArea
        {
            Uuid = Guid.NewGuid().ToString("N"),
            X = 0.08,
            Y = 0.25,
            Width = 0.84,
            Height = 0.48,
            OptionUuid = optionUuid
        };
    }

