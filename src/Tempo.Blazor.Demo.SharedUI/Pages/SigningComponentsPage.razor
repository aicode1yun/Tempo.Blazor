    }

    private void HandleTemplateRolesChanged(IReadOnlyList<SigningSubmitterRole> roles)
    {
        _templateRoles = roles;
        _templateRoleStatus = roles.Count == 0
            ? "No roles"
            : $"{roles.Count} role{(roles.Count == 1 ? string.Empty : "s")}: {string.Join(", ", roles.Select(role => $"{role.Order + 1}. {role.Name}"))}";
    }

    private void HandleSubmissionRecipientsChanged(IReadOnlyList<SigningSubmitterRole> roles)
    {
        _submissionRecipients = roles;
        var missingEmailCount = roles.Count(role => !role.IsOptional && string.IsNullOrWhiteSpace(role.Email));
        _submissionRecipientStatus = missingEmailCount == 0
            ? $"{roles.Count} recipients ready"
            : $"{missingEmailCount} recipient email missing";
    }

