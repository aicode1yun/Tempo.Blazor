@page "/chat"
@using Tempo.Blazor.Components.Chat
@using Tempo.Blazor.Models
<PageTitle>Chat – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Chat</h1>
    <p class="text-slate-600 dark:text-slate-400">
        A conversation component with message bubbles, typing indicators, attachments, and send input.
    </p>
</div>

<!-- Basic Conversation -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Basic Conversation</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Core</span>
    </div>

    <div class="showcase-card" style="height: 500px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Standard chat with incoming and outgoing messages, timestamps, and avatars.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_basicMessages"
                OnSendMessage="HandleBasicSend"
                TypingUsers="_basicTyping" />
    </div>
</section>

<!-- Typing Indicator -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Typing Indicator</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">UX</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Animated dots and user names when someone is typing.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_typingMessages"
                TypingUsers="_typingUsers" />
    </div>
</section>

<!-- With Attachments -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">With Attachments</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Files</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Messages can include file attachments. Click an attachment to trigger the callback.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_attachmentMessages"
                OnAttachmentClick="HandleAttachmentClick" />
    </div>

    @if (!string.IsNullOrEmpty(_lastAttachment))
    {
        <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <p class="text-sm text-slate-600 dark:text-slate-400">Clicked: <strong>@_lastAttachment</strong></p>
        </div>
    }
</section>

<!-- System Messages -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">System Messages</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">Info</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            System messages for events like user joins, leaves, or channel updates.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_systemMessages" />
    </div>
</section>

<!-- Interactive Demo -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Interactive Demo</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">Live</span>
    </div>

    <div class="showcase-card" style="height: 500px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Type a message and hit send. Simulate an AI or bot response with typing delay.
        </p>
        <TmChat CurrentUser="_currentUser"
                Messages="_liveMessages"
                OnSendMessage="HandleLiveSend"
                TypingUsers="_liveTyping" />
    </div>
</section>

@code {
    private ChatUser _currentUser = default!;
    private ChatUser _bob = default!;
    private ChatUser _carol = default!;

    private string? _lastAttachment;

    // ── Basic demo ────────────────────────────────────────────────────────
    private List<ChatMessage> _basicMessages = default!;
    private List<ChatUser> _basicTyping = default!;

    // ── Typing demo ───────────────────────────────────────────────────────
    private List<ChatMessage> _typingMessages = default!;
    private List<ChatUser> _typingUsers = default!;

    // ── Attachment demo ───────────────────────────────────────────────────
    private List<ChatMessage> _attachmentMessages = default!;

    // ── System messages demo ──────────────────────────────────────────────
    private List<ChatMessage> _systemMessages = default!;

    // ── Live interactive demo ─────────────────────────────────────────────
    private List<ChatMessage> _liveMessages = default!;
    private List<ChatUser> _liveTyping = default!;

    protected override void OnInitialized()
    {
        _currentUser = new("u1", "Alice", avatar: "A", isOnline: true);
        _bob = new("u2", "Bob", avatar: "B", isOnline: true);
        _carol = new("u3", "Carol", avatar: "C", isOnline: true);

        _basicMessages = new()
        {
            new("m1", "Hey Alice, how is the new component coming along?", new ChatUser("u2", "Bob", "B"), ChatMessageType.Incoming, new DateTimeOffset(2026, 5, 2, 9, 15, 0, TimeSpan.Zero)),
            new("m2", "Pretty good! Just finished the message rendering and styling.", new ChatUser("u1", "Alice", "A"), ChatMessageType.Outgoing, new DateTimeOffset(2026, 5, 2, 9, 16, 0, TimeSpan.Zero)),
            new("m3", "Nice! Does it support attachments too?", new ChatUser("u2", "Bob", "B"), ChatMessageType.Incoming, new DateTimeOffset(2026, 5, 2, 9, 17, 0, TimeSpan.Zero)),
            new("m4", "Yes — file cards with name, size, and click handler.", new ChatUser("u1", "Alice", "A"), ChatMessageType.Outgoing, new DateTimeOffset(2026, 5, 2, 9, 18, 0, TimeSpan.Zero)),
        };
        _basicTyping = new() { new ChatUser("u2", "Bob", "B") };

        _typingMessages = new()
        {
            new("t1", "Can you review my PR?", _bob, ChatMessageType.Incoming),
            new("t2", "Sure, give me 5 minutes.", _currentUser, ChatMessageType.Outgoing),
        };
        _typingUsers = new() { _bob, _carol };

        _attachmentMessages = new()
        {
            new("a1", "Here is the design mockup", _bob, ChatMessageType.Incoming)
            {
                Attachments = new[]
                {
                    new ChatAttachment("f1", "dashboard-mockup.figma", "/files/dashboard.fig", "application/figma", 2_450_000),
                    new ChatAttachment("f2", "requirements.docx", "/files/req.docx", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", 45_000),
                }
            },
            new("a2", "Thanks, I'll take a look", _currentUser, ChatMessageType.Outgoing),
        };

        _systemMessages = new()
        {
            new("s1", "Bob joined the conversation", type: ChatMessageType.System),
            new("s2", "Hi everyone!", _bob, ChatMessageType.Incoming),
            new("s3", "Hey Bob 👋", _currentUser, ChatMessageType.Outgoing),
            new("s4", "Carol joined the conversation", type: ChatMessageType.System),
            new("s5", "Hello!", _carol, ChatMessageType.Incoming),
        };

        _liveMessages = new()
        {
            new("l1", "Welcome! Type a message and I will echo it back with a delay.", _bob, ChatMessageType.Incoming),
        };
        _liveTyping = new();
    }

    private void HandleBasicSend(string text)
    {
        _basicMessages.Add(new ChatMessage(Guid.NewGuid().ToString(), text, _currentUser, ChatMessageType.Outgoing));
    }

    private void HandleAttachmentClick(ChatAttachment attachment)
    {
        _lastAttachment = attachment.Name;
    }

    private async Task HandleLiveSend(string text)
    {
        _liveMessages.Add(new ChatMessage(Guid.NewGuid().ToString(), text, _currentUser, ChatMessageType.Outgoing));

        _liveTyping = new List<ChatUser> { _bob };
        StateHasChanged();
        await Task.Delay(1200);

        _liveTyping = new List<ChatUser>();
        _liveMessages.Add(new ChatMessage(Guid.NewGuid().ToString(), $"Echo: {text}", _bob, ChatMessageType.Incoming));
        StateHasChanged();
    }
}
