@page "/core-engine-editor"
@using Tempo.Blazor.Components.DocumentEditor
@using Tempo.Blazor.DocumentEditor.Interfaces
@using Tempo.Blazor.DocumentEditor.Models
@using Tempo.Blazor.DocumentEditor.Services

<h1>TmDocumentEditor — canvas engine</h1>
<p>The full editor shell is now canvas-only; legacy render-engine switches are ignored.</p>

<div data-testid="saved-output">@_savedText</div>

<TmDocumentEditor DocumentId="@_documentId"
                  Provider="@_provider"
                  AutoSaveInterval="@TimeSpan.FromMilliseconds(400)"
                  ImageAssetOptions="@_imageAssets"
                  CanDeleteOwnComments="true"
                  OnSaveRequested="HandleSaveRequested" />

@code {
    private readonly PreviewDocumentProvider _provider = new();
    private readonly string _documentId = "core-engine-preview-demo";
    private string _savedText = string.Empty;

    // R.4.8 — a preset asset so the toolbar's "insert from asset" path is exercised.
    private readonly List<DocumentImageAsset> _imageAssets =
    [
        new DocumentImageAsset { Id = "asset-cat", FileName = "Cat", Url = "https://example.com/asset-cat.png" },
    ];

    protected override void OnInitialized() => _provider.SeedPreview(_documentId);

    // Surfaces what the save flow persisted (proves SaveAsync pulled the live model from the
    // core engine via RequestDocumentAsync → documentToSave).
    private void HandleSaveRequested(DocumentEditorSaveRequest request)
    {
        var p1 = request.Document?.Blocks.FirstOrDefault(b => b.Id == "p1");
        _savedText = p1?.Content is ParagraphBlockContent p
            ? "saved:" + string.Concat(p.Inlines.OfType<TextRun>().Select(r => r.Text))
            : "saved:(none)";
        StateHasChanged();
    }

    // Exposes a public seed for a small, converter-friendly document (heading + paragraph),
    // since the base provider's StoreDocument is protected.
    private sealed class PreviewDocumentProvider : InMemoryDocumentEditorProvider
    {
        public void SeedPreview(string documentId)
        {
            var doc = DocumentEditorDocument.Empty(documentId);
            doc.Metadata.Title = "Core engine preview";
            doc.Blocks =
            [
                new DocumentBlock
                {
                    Id = "h1",
                    Type = DocumentBlockType.Heading,
                    Content = new HeadingBlockContent { Level = 1, Inlines = [new TextRun { Id = "h1-r", Text = "Preview Heading" }] },
                },
                new DocumentBlock
                {
                    Id = "p1",
                    Type = DocumentBlockType.Paragraph,
                    Content = new ParagraphBlockContent { Inlines = [new TextRun { Id = "p1-r", Text = "Edited by the core engine." }] },
                },
            ];
            StoreDocument(doc);
        }
    }
}
