@page "/gantt"
@using Tempo.Blazor.Components.Scheduler
@using Tempo.Blazor.Abstractions.Models

<PageTitle>Gantt Chart – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Gantt Chart</h1>
    <p class="text-slate-600 dark:text-slate-400">Visualize project timelines, task hierarchies, and dependencies with an interactive Gantt chart.</p>
</div>

<!-- Gantt Chart -->
<section class="showcase-card p-0 overflow-hidden" style="height: 600px;">
    <TmGantt Data="_tasks"
             Dependencies="_dependencies"
             @bind-View="_view"
             OnTaskSelected="HandleTaskSelected" />
</section>

<!-- Selected Task Info -->
@if (_selectedTask is not null)
{
    <section class="mt-6 showcase-card">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Selected Task</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
            <div>
                <span class="text-slate-500 dark:text-slate-400">Title:</span>
                <span class="font-medium text-slate-900 dark:text-white ml-1">@_selectedTask.Title</span>
            </div>
            <div>
                <span class="text-slate-500 dark:text-slate-400">Start:</span>
                <span class="font-medium text-slate-900 dark:text-white ml-1">@_selectedTask.Start.ToString("dd.MM.yyyy")</span>
            </div>
            <div>
                <span class="text-slate-500 dark:text-slate-400">End:</span>
                <span class="font-medium text-slate-900 dark:text-white ml-1">@_selectedTask.End.ToString("dd.MM.yyyy")</span>
            </div>
            <div>
                <span class="text-slate-500 dark:text-slate-400">Progress:</span>
                <span class="font-medium text-slate-900 dark:text-white ml-1">@_selectedTask.PercentComplete%</span>
            </div>
        </div>
    </section>
}

