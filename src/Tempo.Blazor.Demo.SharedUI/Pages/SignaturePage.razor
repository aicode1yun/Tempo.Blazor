@page "/signature"
@using Tempo.Blazor.Components.Inputs

<PageTitle>Signature Pad – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Signature Pad</h1>
    <p class="text-slate-600 dark:text-slate-400">Capture freehand signatures with pointer events and export as SVG.</p>
</div>

<!-- Basic Signature -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Basic Signature Pad</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Draw with your mouse or touch device</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">Input</span>
    </div>

    <div class="showcase-card">
        <TmSignature @bind-Value="_signature1"
                     Width="600"
                     Height="200"
                     StrokeColor="#1e293b"
                     StrokeWidth="2"
                     BackgroundColor="#f8fafc"
                     ShowClearButton="true" />

        @if (!string.IsNullOrEmpty(_signature1))
        {
            <div class="mt-4 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg">
                <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">SVG Output</p>
                <code class="text-xs text-slate-600 dark:text-slate-400 break-all">@_signature1</code>
            </div>
        }
    </div>
</section>

<!-- Custom Styled Signature -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Custom Styled Signature</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Thick red stroke on dark background</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-full">Styled</span>
    </div>

    <div class="showcase-card">
        <TmSignature @bind-Value="_signature2"
                     Width="600"
                     Height="200"
                     StrokeColor="#ef4444"
                     StrokeWidth="4"
                     BackgroundColor="#0f172a"
                     ShowClearButton="true" />
    </div>
</section>

<!-- Read-only Signature -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Read-Only Signature</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Previously captured signature displayed without editing</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-full">Read-only</span>
    </div>

    <div class="showcase-card">
        <TmSignature Value="_savedSignature"
                     Width="600"
                     Height="200"
                     StrokeColor="#1e293b"
                     StrokeWidth="2"
                     BackgroundColor="#f8fafc"
                     Disabled="true" />
    </div>
</section>

@code {
    private string? _signature1;
    private string? _signature2;

    private string _savedSignature = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"600\" height=\"200\">"
        + "<rect width=\"100%\" height=\"100%\" fill=\"#f8fafc\"/>"
        + "<polyline points=\"50,100 100,80 150,120 200,60 250,110 300,70 350,130 400,90 450,100\" fill=\"none\" stroke=\"#1e293b\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>"
        + "</svg>";
}
