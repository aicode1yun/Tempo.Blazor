@page "/charts"
@using Tempo.Blazor.Components.Charts
@using Tempo.Blazor.Models

<PageTitle>Charts – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Charts</h1>
    <p class="text-slate-600 dark:text-slate-400">Pure SVG charts with no JavaScript dependencies. Bar, Line, Pie, Donut and Horizontal Bar types.</p>
</div>

<!-- Per-value color charts -->
<section class="demo-section mb-8">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200">Per-value Colors</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">BackgroundColors</span>
    </div>
    <div class="demo-grid demo-grid-2">
        <div class="showcase-card" data-testid="chart-donut-custom">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Donut - custom colors</h3>
            <TmChart Type="ChartType.Donut"
                     Data="_donutCustomColorsData"
                     Height="260px"
                     ShowValues="true"
                     Animated="false" />
        </div>
        <div class="showcase-card" data-testid="chart-horizontal-bar-custom">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">HorizontalBar - custom colors</h3>
            <TmChart Type="ChartType.HorizontalBar"
                     Data="_horizontalBarCustomColorsData"
                     Height="260px"
                     ShowValues="true"
                     Animated="false" />
        </div>
        <div class="showcase-card" data-testid="chart-bar-custom">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Bar - custom colors</h3>
            <TmChart Type="ChartType.Bar"
                     Data="_barCustomColorsData"
                     Height="260px"
                     ShowValues="true"
                     Animated="false" />
        </div>
        <div class="showcase-card" data-testid="chart-donut-default">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-4">Donut - default palette</h3>
            <TmChart Type="ChartType.Donut"
                     Data="_donutDefaultPaletteData"
                     Height="260px"
                     ShowValues="true"
                     Animated="false" />
        </div>
    </div>
</section>

<!-- Bar Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Bar Chart</h2>
    <TmChart Type="ChartType.Bar"
             Data="_barData"
             Height="350px"
             OnSegmentClick="HandleSegmentClick" />
    @if (_clickedSegment is not null)
    {
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            Clicked: <strong>@_clickedSegment.Label</strong> = @_clickedSegment.Value (Dataset @_clickedSegment.DatasetIndex)
        </p>
    }
</section>

<!-- Grouped Bar Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Grouped Bar Chart</h2>
    <TmChart Type="ChartType.Bar"
             Data="_groupedBarData"
             Height="350px"
             ShowValues="true" />
</section>

<!-- Interactive legend & tooltips (K10) -->
<section class="demo-section mb-8" data-testid="charts-interactive-section">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Interactive Legend &amp; Tooltips</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        Click a legend entry to toggle its series (multi-dataset) or single slice (per-value); hover any
        bar, point or slice for a rich tooltip. The component owns the hidden state and reports each
        change through <code>OnSeriesToggle</code>.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            <TmChart Type="ChartType.Bar"
                     Data="_groupedBarData"
                     Height="320px"
                     InteractiveLegend="true"
                     TestIdPrefix="k10-bar"
                     OnSeriesToggle="HandleSeriesToggle" />
        </div>
        <div>
            <TmChart Type="ChartType.Donut"
                     Data="_donutCustomColorsData"
                     Height="320px"
                     InteractiveLegend="true"
                     TestIdPrefix="k10-donut"
                     OnSeriesToggle="HandleSeriesToggle" />
        </div>
    </div>
    @if (_lastToggle is not null)
    {
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="charts-toggle-status">
            Toggled <strong>@_lastToggle.Label</strong> → @(_lastToggle.Hidden ? "hidden" : "shown")
        </p>
    }
</section>

<!-- Line Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Line Chart</h2>
    <TmChart Type="ChartType.Line"
             Data="_lineData"
             Height="350px" />
</section>

<!-- Pie Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Pie Chart</h2>
    <div style="max-width: 500px;">
        <TmChart Type="ChartType.Pie"
                 Data="_pieData"
                 Height="400px" />
    </div>
</section>

<!-- Donut Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Donut Chart</h2>
    <div style="max-width: 500px;">
        <TmChart Type="ChartType.Donut"
                 Data="_donutData"
                 Height="400px" />
    </div>
</section>

<!-- Horizontal Bar Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Horizontal Bar Chart</h2>
    <TmChart Type="ChartType.HorizontalBar"
             Data="_horizontalData"
             Height="300px"
             ShowValues="true" />
</section>

<!-- No Animation / No Legend -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Minimal (No Animation, No Legend, No Grid)</h2>
    <TmChart Type="ChartType.Bar"
             Data="_barData"
             Height="250px"
             Animated="false"
             ShowLegend="false"
             ShowGrid="false" />
</section>

<!-- Stock Chart -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Stock Chart (Candlestick)</h2>
    <TmStockChart Data="_stockData"
                  Type="StockChartType.Candlestick"
                  ShowVolume="true"
                  Animated="true"
                  Height="400px" />
</section>

<!-- Stock Chart OHLC -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Stock Chart (OHLC)</h2>
    <TmStockChart Data="_stockData"
                  Type="StockChartType.OHLC"
                  ShowVolume="false"
                  Height="350px" />
</section>

<!-- Stock Chart Line -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Stock Chart (Line — Closing Prices)</h2>
    <TmStockChart Data="_stockData"
                  Type="StockChartType.Line"
                  ShowVolume="false"
                  Height="350px" />
</section>

<!-- Sparklines -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Sparklines</h2>
    <div class="flex flex-wrap items-center gap-6">
        <div class="flex items-center gap-3">
            <span class="text-sm text-slate-600 dark:text-slate-400">Line</span>
            <TmSparkline Data="_sparkData" Type="SparklineType.Line" Height="40px" Width="120px" />
        </div>
        <div class="flex items-center gap-3">
            <span class="text-sm text-slate-600 dark:text-slate-400">Bar</span>
            <TmSparkline Data="_sparkData" Type="SparklineType.Bar" Height="40px" Width="120px" />
        </div>
        <div class="flex items-center gap-3">
            <span class="text-sm text-slate-600 dark:text-slate-400">Area</span>
            <TmSparkline Data="_sparkData" Type="SparklineType.Area" Height="40px" Width="120px" />
        </div>
        <div class="flex items-center gap-3">
            <span class="text-sm text-slate-600 dark:text-slate-400">Pie</span>
            <TmSparkline Data="_sparkData" Type="SparklineType.Pie" Height="40px" Width="40px" />
        </div>
    </div>
</section>

<!-- Gauges -->
<section class="demo-section mb-8">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Gauges</h2>
    <div class="flex flex-wrap items-center gap-8">
        <div class="text-center">
            <TmGauge Type="GaugeType.Arc" Value="65" Min="0" Max="100" ShowValue="true" LabelFormat="{0}%" Animated="true" />
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Arc</p>
        </div>
        <div class="text-center">
            <TmGauge Type="GaugeType.Circular" Value="78" Min="0" Max="100" ShowValue="true" LabelFormat="{0}%" Animated="true" />
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Circular</p>
        </div>
        <div class="text-center">
            <TmGauge Type="GaugeType.Linear" Value="45" Min="0" Max="100" ShowValue="true" LabelFormat="{0}%" Width="250px" Height="80px" />
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Linear</p>
        </div>
        <div class="text-center">
            <TmGauge Type="GaugeType.Arc" Value="82" Min="0" Max="100"
                     Ranges="_gaugeRanges" ShowValue="true" LabelFormat="{0}%" Animated="true" />
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Arc with Ranges</p>
        </div>
    </div>
</section>

<!-- Funnel / Heatmap / Treemap -->
<section class="demo-section mb-8" data-testid="charts-demo-funnel">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Funnel — Case Intake Conversion</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        A conversion funnel over the client-intake pipeline. Hover a stage for the tooltip,
        click it to select, and read the per-stage conversion against the first stage.
    </p>
    <div class="max-w-2xl">
        <TmChart Type="ChartType.Funnel" Data="_funnelData" Height="320px"
                 ShowValues="true" InteractiveLegend="true" OnSegmentClick="HandleSegmentClick" />
    </div>
</section>

<section class="demo-section mb-8" data-testid="charts-demo-heatmap">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Heatmap — Filings by Day × Hour</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        Court filings received per weekday and daypart — the intensity scales with the count.
        Toggle a day in the legend to exclude it from the scale.
    </p>
    <div class="max-w-3xl">
        <TmChart Type="ChartType.Heatmap" Data="_heatmapData" Height="320px"
                 ShowValues="true" InteractiveLegend="true" OnSegmentClick="HandleSegmentClick" />
    </div>
</section>

<section class="demo-section mb-8" data-testid="charts-demo-treemap">
    <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200 mb-4">Treemap — Billing by Practice Area and Client</h2>
    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        Hierarchical shares: practice areas as groups, clients as tiles sized by billed amount.
        Toggle an area in the legend to drop its whole subtree.
    </p>
    <div class="max-w-3xl">
        <TmChart Type="ChartType.Treemap" TreeNodes="_treemapNodes" Height="360px"
                 ShowValues="true" InteractiveLegend="true" OnSegmentClick="HandleSegmentClick" />
    </div>
    @if (_clickedSegment is not null)
    {
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400" data-testid="charts-demo-clicked">
            Clicked: <strong>@_clickedSegment.Label</strong> = @_clickedSegment.Value
        </p>
    }
</section>

