@page "/dock-manager"
@using Tempo.Blazor.Components.Layout
@using Tempo.Blazor.Abstractions.Models
<PageTitle>Dock Manager – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Dock Manager</h1>
    <p class="text-slate-600 dark:text-slate-400">
        A VS Code–like dockable layout manager with draggable panes, tab grouping, floating windows, and close actions.
    </p>
</div>

<!-- Basic Docking -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Basic Docking</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Core</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Classic three-pane layout: Explorer on the left, editor in the center, and properties on the right.
            Drag any pane header to move it to a different docking zone.
        </p>
        <TmDockManager>
            <TmDockPane Id="explorer"
                        Title="Explorer"
                        Icon="folder"
                        Position="DockPosition.Left"
                        Width="200">
                <div class="space-y-2">
                    <div class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                        <TmIcon Name="folder" Size="IconSize.Sm" />
                        <span>src</span>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300 pl-4">
                        <TmIcon Name="file-code" Size="IconSize.Sm" />
                        <span>Components</span>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300 pl-4">
                        <TmIcon Name="file-text" Size="IconSize.Sm" />
                        <span>Program.cs</span>
                    </div>
                </div>
            </TmDockPane>

            <TmDockPane Id="editor"
                        Title="Editor"
                        Icon="file-edit"
                        Position="DockPosition.Center"
                        IsActive="true">
                <div class="font-mono text-sm text-slate-800 dark:text-slate-200 whitespace-pre-wrap">&lt;TmDockManager&gt;
  &lt;TmDockPane Position="DockPosition.Left"&gt;
    Explorer content
  &lt;/TmDockPane&gt;
  &lt;TmDockPane Position="DockPosition.Center"&gt;
    Editor content
  &lt;/TmDockPane&gt;
&lt;/TmDockManager&gt;</div>
            </TmDockPane>

            <TmDockPane Id="properties"
                        Title="Properties"
                        Icon="settings"
                        Position="DockPosition.Right"
                        Width="220">
                <div class="space-y-3">
                    <div>
                        <label class="text-xs font-medium text-slate-500 dark:text-slate-400">Id</label>
                        <div class="text-sm text-slate-800 dark:text-slate-200">editor</div>
                    </div>
                    <div>
                        <label class="text-xs font-medium text-slate-500 dark:text-slate-400">Position</label>
                        <div class="text-sm text-slate-800 dark:text-slate-200">Center</div>
                    </div>
                    <div>
                        <label class="text-xs font-medium text-slate-500 dark:text-slate-400">Can Float</label>
                        <div class="text-sm text-slate-800 dark:text-slate-200">True</div>
                    </div>
                </div>
            </TmDockPane>
        </TmDockManager>
    </div>
</section>

<!-- Tab Grouping -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Tab Grouping</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">Tabs</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Multiple panes in the same position automatically group into tabs. Click a tab to switch the active pane.
        </p>
        <TmDockManager>
            <TmDockPane Id="tab1"
                        Title="Index.razor"
                        Icon="file-code"
                        Position="DockPosition.Center"
                        IsActive="true">
                <div class="font-mono text-sm text-slate-600 dark:text-slate-400">@@page "/"

&lt;h1&gt;Hello World&lt;/h1&gt;</div>
            </TmDockPane>

            <TmDockPane Id="tab2"
                        Title="Counter.razor"
                        Icon="file-code"
                        Position="DockPosition.Center">
                <div class="font-mono text-sm text-slate-600 dark:text-slate-400">@@page "/counter"

&lt;p&gt;Current count: @@currentCount&lt;/p&gt;
&lt;button @@onclick="IncrementCount"&gt;Click me&lt;/button&gt;</div>
            </TmDockPane>

            <TmDockPane Id="tab3"
                        Title="FetchData.razor"
                        Icon="file-code"
                        Position="DockPosition.Center">
                <div class="font-mono text-sm text-slate-600 dark:text-slate-400">@@page "/fetchdata"
@@inject HttpClient Http

&lt;table class="table"&gt;
  &lt;thead&gt;
    &lt;tr&gt;&lt;th&gt;Date&lt;/th&gt;&lt;th&gt;Temp&lt;/th&gt;&lt;/tr&gt;
  &lt;/thead&gt;
&lt;/table&gt;</div>
            </TmDockPane>
        </TmDockManager>
    </div>
</section>

<!-- Float & Close Actions -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Float &amp; Close</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">Actions</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Panes can be floated into overlay windows or closed entirely. Use the <strong>Float</strong> and <strong>Close</strong> buttons on each tab.
            Floating panes show a <strong>Dock</strong> button to return them to the layout.
        </p>
        <TmDockManager OnPaneClose="HandlePaneClose"
                       OnPaneFloat="HandlePaneFloat"
                       OnPaneDock="HandlePaneDock">
            <TmDockPane Id="terminal"
                        Title="Terminal"
                        Icon="terminal"
                        Position="DockPosition.Bottom"
                        Height="120"
                        CanFloat="true"
                        CanClose="true">
                <div class="font-mono text-xs text-emerald-600 dark:text-emerald-400">
                    > dotnet build<br />
                    Build succeeded. 0 Warning(s), 0 Error(s)<br />
                    > dotnet test<br />
                    Passed!  - Failed: 0, Passed: 3363
                </div>
            </TmDockPane>

            <TmDockPane Id="output"
                        Title="Output"
                        Icon="list"
                        Position="DockPosition.Center"
                        IsActive="true">
                <div class="text-sm text-slate-700 dark:text-slate-300">
                    This pane cannot be floated or closed — it is pinned to the center area.
                </div>
            </TmDockPane>

            <TmDockPane Id="problems"
                        Title="Problems"
                        Icon="alert-circle"
                        Position="DockPosition.Bottom"
                        CanFloat="true"
                        CanClose="true">
                <div class="text-sm text-slate-500 dark:text-slate-400">
                    No problems have been detected in the current file.
                </div>
            </TmDockPane>
        </TmDockManager>
    </div>

    @if (!string.IsNullOrEmpty(_lastAction))
    {
        <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <p class="text-sm text-slate-600 dark:text-slate-400">@_lastAction</p>
        </div>
    }
</section>

<!-- Data-Bound Panes -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Data-Bound Panes</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">MVVM</span>
    </div>

    <div class="showcase-card" style="height: 400px;">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Instead of declarative child content, you can bind a list of <code>DockPane</code> models and provide a <code>PaneTemplate</code>. This enables full MVVM and dynamic pane creation.
        </p>
        <TmDockManager Items="_boundPanes"
                       PaneTemplate="PaneTemplate"
                       OnPaneClose="HandleBoundPaneClose" />
    </div>

    <div class="mt-4 flex gap-2">
        <TmButton Variant="ButtonVariant.Primary" OnClick="AddBoundPane">
            <TmIcon Name="plus" Size="IconSize.Sm" />
            <span>Add Pane</span>
        </TmButton>
        <TmButton Variant="ButtonVariant.Secondary" OnClick="ResetBoundPanes">
            <TmIcon Name="rotate-ccw" Size="IconSize.Sm" />
            <span>Reset</span>
        </TmButton>
    </div>
</section>

@code {
    private string? _lastAction;

    // ── Action handlers ───────────────────────────────────────────────────

    private void HandlePaneClose(DockPane pane)
    {
        _lastAction = $"Closed pane: {pane.Title}";
    }

    private void HandlePaneFloat(DockPane pane)
    {
        _lastAction = $"Floated pane: {pane.Title}";
    }

    private void HandlePaneDock(DockPane pane)
    {
        _lastAction = $"Docked pane back: {pane.Title} → {pane.Position}";
    }

    // ── Data-bound panes ──────────────────────────────────────────────────

    private List<DockPane> _boundPanes = new()
    {
        new()
        {
            Id = "bound-left",
            Title = "Navigation",
            Icon = "compass",
            Position = DockPosition.Left,
            Width = 180,
            IsActive = true
        },
        new()
        {
            Id = "bound-center",
            Title = "Main View",
            Icon = "layout",
            Position = DockPosition.Center,
            IsActive = true
        },
        new()
        {
            Id = "bound-right",
            Title = "Details",
            Icon = "info",
            Position = DockPosition.Right,
            Width = 200,
            IsActive = true
        }
    };

    private int _boundCounter = 0;

    private RenderFragment<DockPane> PaneTemplate => pane =>
    @<div class="flex flex-col h-full">
        <div class="flex items-center gap-2 p-2 bg-slate-100 dark:bg-slate-800 rounded mb-2">
            @if (!string.IsNullOrEmpty(pane.Icon))
            {
                <TmIcon Name="@pane.Icon" Size="IconSize.Sm" />
            }
            <span class="text-sm font-medium text-slate-800 dark:text-slate-200">@pane.Title</span>
            <span class="text-xs text-slate-400 ml-auto">@pane.Position</span>
        </div>
        <div class="flex-1 p-2 text-sm text-slate-600 dark:text-slate-400">
            This is the content for <strong>@pane.Title</strong> rendered via PaneTemplate.
        </div>
    </div>;

    private void AddBoundPane()
    {
        _boundCounter++;
        _boundPanes.Add(new DockPane
        {
            Id = $"bound-extra-{_boundCounter}",
            Title = $"Extra {_boundCounter}",
            Icon = "file-plus",
            Position = DockPosition.Center,
            IsActive = true
        });
    }

    private void ResetBoundPanes()
    {
        _boundCounter = 0;
        _boundPanes = new()
        {
            new()
            {
                Id = "bound-left",
                Title = "Navigation",
                Icon = "compass",
                Position = DockPosition.Left,
                Width = 180,
                IsActive = true
            },
            new()
            {
                Id = "bound-center",
                Title = "Main View",
                Icon = "layout",
                Position = DockPosition.Center,
                IsActive = true
            },
            new()
            {
                Id = "bound-right",
                Title = "Details",
                Icon = "info",
                Position = DockPosition.Right,
                Width = 200,
                IsActive = true
            }
        };
    }

    private void HandleBoundPaneClose(DockPane pane)
    {
        _boundPanes.RemoveAll(p => p.Id == pane.Id);
        _lastAction = $"Removed bound pane: {pane.Title}";
    }
}
