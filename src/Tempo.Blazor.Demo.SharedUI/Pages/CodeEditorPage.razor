@page "/code-editor"
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Inputs

<PageTitle>Code Editor – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Code Editor</h1>
    <p class="text-slate-600 dark:text-slate-400">
        Monospace source editor with an optional Prism syntax-highlight overlay, Tab indentation,
        copy button and built-in JSON validation. Without Prism it degrades to a plain monospace textarea.
    </p>
</div>

<!-- JSON editor with validation + format -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">JSON with validation</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Invalid JSON shows a localized error; the Format button pretty-prints</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">JSON</span>
    </div>

    <div class="showcase-card">
        <TmCodeEditor
            @bind-Value="_jsonValue"
            Language="json"
            Label="Attributes"
            ValidateJson="true"
            ShowFormatButton="true"
            Placeholder="{ }"
            Rows="10" />

        <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <code class="text-xs text-slate-600 dark:text-slate-400">Language="json" ValidateJson="true" ShowFormatButton="true"</code>
        </div>
    </div>

    <!-- Live value output -->
    <div class="mt-4">
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-2 uppercase tracking-wide">Live Value</p>
        <pre class="p-4 bg-slate-900 dark:bg-slate-950 text-green-400 rounded-xl text-xs overflow-x-auto min-h-[3rem] whitespace-pre-wrap">@(string.IsNullOrEmpty(_jsonValue) ? "// empty" : _jsonValue)</pre>
    </div>
</section>

<!-- C# / generic language -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Other languages</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Any Prism grammar id works — highlighting activates when the host loads Prism</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Language</span>
    </div>

    <div class="showcase-card">
        <TmCodeEditor
            @bind-Value="_csharpValue"
            Language="csharp"
            Label="C# snippet"
            Rows="8" />
    </div>
</section>

<!-- Read-only + disabled -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Read-only &amp; disabled</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Read-only keeps selection and the copy button; disabled turns everything off</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">States</span>
    </div>

    <div class="showcase-card space-y-4">
        <TmCodeEditor Value="@_readOnlyValue" Language="json" Label="Read-only" ReadOnly="true" Rows="5" />
        <TmCodeEditor Value="@_readOnlyValue" Language="json" Label="Disabled" Disabled="true" Rows="5" />
    </div>
</section>

@code {
    private string _jsonValue = "{\n  \"name\": \"nightly-cleanup\",\n  \"schedule\": \"0 2 * * *\",\n  \"retries\": 3,\n  \"enabled\": true\n}";

    private string _csharpValue = "public sealed record JobInfo(string Name, string Schedule)\n{\n    public bool IsNightly => Schedule.StartsWith(\"0 2\");\n}";

    private string _readOnlyValue = "{\n  \"source\": \"scan\",\n  \"revision\": \"a1b2c3\"\n}";
}
