@page "/markdown-editor"
@using Tempo.Blazor.Components.Activity
@using Tempo.Blazor.Components.Buttons
@using Tempo.Blazor.Components.Inputs

<PageTitle>Markdown Editor – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">Markdown Editor</h1>
    <p class="text-slate-600 dark:text-slate-400">
        Native WYSIWYG markdown editor. The <code class="px-1 py-0.5 bg-slate-100 dark:bg-slate-800 rounded text-sm font-mono">Value</code>
        binding returns raw Markdown — no HTML conversion needed.
    </p>
</div>

<!-- 5.3  Basic editor with live markdown output -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Basic Editor</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Type and format — the raw Markdown value updates live below</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full">Basic</span>
    </div>

    <div class="showcase-card">
        <TmMarkdownEditor
            @ref="_basicEditor"
            @bind-Value="_basicValue"
            Placeholder="Write something… try **bold**, _italic_, ## heading, - list, > quote" />

        <div class="mt-4 flex items-center space-x-2">
            <TmButton Variant="ButtonVariant.Primary" Size="ButtonSize.Sm" OnClick="OnBasicSubmit">Submit</TmButton>
            <TmButton Variant="ButtonVariant.Ghost"   Size="ButtonSize.Sm" OnClick="ClearBasic">Clear</TmButton>
            <span class="ml-auto text-xs text-slate-400 dark:text-slate-500">Ctrl+Enter to submit</span>
        </div>

        @if (!string.IsNullOrEmpty(_basicSubmitted))
        {
            <div class="mt-4 p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl">
                <p class="text-sm font-medium text-green-800 dark:text-green-200 mb-2">Submitted Markdown:</p>
                <pre class="p-3 bg-white dark:bg-slate-900 rounded-lg text-xs overflow-x-auto text-slate-800 dark:text-slate-200 whitespace-pre-wrap">@_basicSubmitted</pre>
            </div>
        }
    </div>

    <!-- Live markdown output -->
    <div class="mt-4">
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-2 uppercase tracking-wide">Live Markdown Value</p>
        <pre class="p-4 bg-slate-900 dark:bg-slate-950 text-green-400 rounded-xl text-xs overflow-x-auto min-h-[3rem] whitespace-pre-wrap">@(string.IsNullOrEmpty(_basicValue) ? "// empty" : _basicValue)</pre>
    </div>
</section>

<!-- 5.4  Editor with MaxLength -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Character Limit</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Enforces a maximum character count — counter turns red when exceeded</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">MaxLength</span>
    </div>

    <div class="showcase-card">
        <TmMarkdownEditor
            @bind-Value="_limitedValue"
            Placeholder="Limited to 200 characters…"
            MaxLength="200" />

        <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <code class="text-xs text-slate-600 dark:text-slate-400">MaxLength="200"</code>
        </div>
    </div>
</section>

<!-- 5.5  Disabled editor -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Disabled State</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Read-only view — toolbar and content are not interactive</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-full">Disabled</span>
    </div>

    <div class="showcase-card">
        <TmMarkdownEditor
            Value="@_disabledValue"
            IsDisabled="true"
            Placeholder="This editor is disabled" />

        <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <code class="text-xs text-slate-600 dark:text-slate-400">IsDisabled="true"</code>
        </div>
    </div>
</section>

<!-- 5.6  Editor with pre-filled value -->
<section class="demo-section">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Pre-filled Value</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Loading existing markdown content from a bound variable</p>
        </div>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Prefilled</span>
    </div>

    <div class="showcase-card">
        <TmMarkdownEditor
            @bind-Value="_prefilledValue"
            Placeholder="Loaded from a variable…" />

        <div class="mt-4 flex items-center space-x-2">
            <TmButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" OnClick="LoadSample">Load sample</TmButton>
            <TmButton Variant="ButtonVariant.Ghost"     Size="ButtonSize.Sm" OnClick="ClearPrefilled">Clear</TmButton>
        </div>

        <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <code class="text-xs text-slate-600 dark:text-slate-400">@("@bind-Value=\"_prefilledValue\"")</code>
        </div>
    </div>
</section>

<!-- Available formatting -->
<section class="demo-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Available Formatting</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="showcase-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-3 flex items-center">
                <span class="w-2 h-2 bg-blue-500 rounded-full mr-2"></span>
                Inline Formats
            </h3>
            <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Bold</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">**text**</code>
                </li>
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Italic</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">_text_</code>
                </li>
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Strikethrough</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">~~text~~</code>
                </li>
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Inline code</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">`code`</code>
                </li>
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Link</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">[text](url)</code>
                </li>
            </ul>
        </div>

        <div class="showcase-card">
            <h3 class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-3 flex items-center">
                <span class="w-2 h-2 bg-purple-500 rounded-full mr-2"></span>
                Block Formats
            </h3>
            <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Heading 1</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono"># text</code>
                </li>
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Heading 2</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">## text</code>
                </li>
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Heading 3</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">### text</code>
                </li>
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Bullet list</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">- item</code>
                </li>
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Numbered list</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">1. item</code>
                </li>
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Blockquote</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">> text</code>
                </li>
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Code block</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">```</code>
                </li>
                <li class="flex items-center justify-between">
                    <span><span class="text-green-500 mr-2">✓</span> Horizontal rule</span>
                    <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded font-mono">---</code>
                </li>
            </ul>
        </div>
    </div>
</section>

<!-- Keyboard shortcuts -->
<section class="demo-section">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-4">Keyboard Shortcuts</h2>

    <div class="showcase-card">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="p-3 bg-slate-50 dark:bg-slate-800 rounded-lg">
                <kbd class="px-2 py-1 bg-white dark:bg-slate-700 rounded border border-slate-300 dark:border-slate-600 text-xs font-mono">Ctrl+B</kbd>
                <span class="ml-2 text-sm text-slate-600 dark:text-slate-400">Bold</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-800 rounded-lg">
                <kbd class="px-2 py-1 bg-white dark:bg-slate-700 rounded border border-slate-300 dark:border-slate-600 text-xs font-mono">Ctrl+I</kbd>
                <span class="ml-2 text-sm text-slate-600 dark:text-slate-400">Italic</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-800 rounded-lg">
                <kbd class="px-2 py-1 bg-white dark:bg-slate-700 rounded border border-slate-300 dark:border-slate-600 text-xs font-mono">Ctrl+K</kbd>
                <span class="ml-2 text-sm text-slate-600 dark:text-slate-400">Insert link</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-slate-800 rounded-lg">
                <kbd class="px-2 py-1 bg-white dark:bg-slate-700 rounded border border-slate-300 dark:border-slate-600 text-xs font-mono">Ctrl+Enter</kbd>
                <span class="ml-2 text-sm text-slate-600 dark:text-slate-400">Submit</span>
            </div>
        </div>
    </div>
</section>

@code {
    private TmMarkdownEditor? _basicEditor;

    private string _basicValue    = string.Empty;
    private string _basicSubmitted = string.Empty;
    private string _limitedValue  = string.Empty;
    private string _prefilledValue = string.Empty;

    private const string DisabledContent =
        "## Read-only content\n\nThis editor is **disabled** — toolbar buttons and text input are not interactive.\n\n- Item one\n- Item two\n\n> Blockquotes still render correctly.";

    private string _disabledValue = DisabledContent;

    private const string SampleMarkdown =
        "## Project notes\n\n**Goal:** implement the new _markdown editor_ component.\n\n### Features\n\n- Native WYSIWYG editing\n- Raw Markdown output — no HTML\n- Keyboard shortcuts (Ctrl+B, Ctrl+I, Ctrl+K)\n\n> The `Value` binding always returns clean Markdown.\n\nSee the [Markdown spec](https://commonmark.org) for full syntax.";

    private async Task OnBasicSubmit()
    {
        _basicSubmitted = _basicValue;
        if (_basicEditor is not null)
            await _basicEditor.Clear();
    }

    private async Task ClearBasic()
    {
        _basicSubmitted = string.Empty;
        if (_basicEditor is not null)
            await _basicEditor.Clear();
    }

    private void LoadSample()
    {
        _prefilledValue = SampleMarkdown;
    }

    private void ClearPrefilled()
    {
        _prefilledValue = string.Empty;
    }
}
