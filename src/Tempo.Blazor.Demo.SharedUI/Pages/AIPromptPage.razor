@page "/ai-prompt"
@using Tempo.Blazor.Components.AITools
<PageTitle>AI Prompt – Tempo.Blazor</PageTitle>

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">AI Prompt</h1>
    <p class="text-slate-600 dark:text-slate-400">
        A chat-style AI prompt component with quick-action commands, streaming output, copy, and user rating.
    </p>
</div>

<!-- Basic Usage -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Basic Usage</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-full">Core</span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Standard prompt with quick-action commands and simulated AI response.
        </p>
        <TmAIPrompt Commands="_basicCommands"
                    Output="_basicOutput"
                    OnPromptSubmit="HandleBasicSubmit"
                    OnCommandClick="HandleBasicCommand"
                    OnOutputRate="HandleBasicRate" />
    </div>
</section>

<!-- Code Output -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Code Output</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">Code</span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            AI response rendered as a syntax-highlighted code block.
        </p>
        <TmAIPrompt Commands="_codeCommands"
                    Output="_codeOutput"
                    OnPromptSubmit="HandleCodeSubmit"
                    OnOutputCopy="HandleCodeCopy"
                    OnOutputRate="HandleCodeRate" />
    </div>
</section>

<!-- Loading State -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Loading State</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 rounded-full">Async</span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Simulates an in-progress AI generation with spinner and disabled input.
        </p>
        <TmAIPrompt Commands="_loadingCommands"
                    Output="_loadingOutput"
                    Disabled="_isLoading"
                    OnPromptSubmit="HandleLoadingSubmit"
                    OnCommandClick="HandleLoadingCommand" />
    </div>
</section>

<!-- Custom Placeholder -->
<section class="demo-section">
    <div class="flex items-center space-x-2 mb-4">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Custom Placeholder</h2>
        <span class="px-2 py-0.5 text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 rounded-full">UX</span>
    </div>

    <div class="showcase-card">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
            Custom placeholder text tailored to the use case.
        </p>
        <TmAIPrompt Placeholder="Ask me anything about Tempo.Blazor components..."
                    Output="_customOutput"
                    OnPromptSubmit="HandleCustomSubmit" />
    </div>
</section>

@code {
    // ── Basic demo ──────────────────────────────────────────────────────────

    private readonly List<AIPromptCommand> _basicCommands = new()
    {
        new("summarize", "Summarize", "list", "Summarize the selected content"),
        new("translate", "Translate", "language", "Translate to another language"),
        new("rewrite", "Rewrite", "edit", "Rewrite in a different tone"),
        new("explain", "Explain", "help", "Explain how this works"),
    };

    private AIPromptOutput? _basicOutput;

    private async Task HandleBasicSubmit(string prompt)
    {
        _basicOutput = new AIPromptOutput(Guid.NewGuid().ToString(), "", title: prompt, isLoading: true);
        StateHasChanged();
        await Task.Delay(1200);
        _basicOutput = new AIPromptOutput(
            Guid.NewGuid().ToString(),
            $"Here is a simulated response for: \"{prompt}\".\n\nIn a real application, this would be generated by your AI backend (OpenAI, Azure OpenAI, local LLM, etc.). The component is purely presentational and delegates all AI logic to the consuming app via callbacks.",
            title: prompt);
        StateHasChanged();
    }

    private async Task HandleBasicCommand(AIPromptCommand command)
    {
        _basicOutput = new AIPromptOutput(Guid.NewGuid().ToString(), "", title: command.Title, isLoading: true);
        StateHasChanged();
        await Task.Delay(800);
        _basicOutput = new AIPromptOutput(
            Guid.NewGuid().ToString(),
            $"You clicked the \"{command.Title}\" command. This would trigger your AI backend to perform the specific action.",
            title: command.Title);
        StateHasChanged();
    }

    private void HandleBasicRate((AIPromptOutput Output, bool? Rating) args)
    {
        _basicOutput = args.Output with { Rating = args.Rating };
    }

    // ── Code demo ───────────────────────────────────────────────────────────

    private readonly List<AIPromptCommand> _codeCommands = new()
    {
        new("csharp", "C# Example", "code", "Generate C# code sample"),
        new("razor", "Razor Example", "file-code", "Generate Razor component sample"),
        new("css", "CSS Example", "palette", "Generate CSS snippet"),
    };

    private AIPromptOutput? _codeOutput = new(
        Guid.NewGuid().ToString(),
        "<TmButton Variant=\"ButtonVariant.Primary\" OnClick=\"HandleClick\">\n    Click Me\n</TmButton>",
        AIPromptOutputFormat.Code,
        title: "Razor Component Example");

    private async Task HandleCodeSubmit(string prompt)
    {
        _codeOutput = new AIPromptOutput(Guid.NewGuid().ToString(), "", AIPromptOutputFormat.Code, title: prompt, isLoading: true);
        StateHasChanged();
        await Task.Delay(1000);
        _codeOutput = new AIPromptOutput(
            Guid.NewGuid().ToString(),
            $"// Generated code for: {prompt}\npublic class Example\n{{\n    public string Response {{ get; set; }} = \"{prompt}\";\n}}",
            AIPromptOutputFormat.Code,
            title: prompt);
        StateHasChanged();
    }

    private void HandleCodeCopy(AIPromptOutput output)
    {
        // Copy is handled automatically by the component via JS interop.
        // This callback allows the app to track copy events for analytics.
    }

    private void HandleCodeRate((AIPromptOutput Output, bool? Rating) args)
    {
        _codeOutput = args.Output with { Rating = args.Rating };
    }

    // ── Loading demo ────────────────────────────────────────────────────────

    private readonly List<AIPromptCommand> _loadingCommands = new()
    {
        new("generate", "Generate", "sparkles", "Generate content"),
        new("analyze", "Analyze", "bar-chart", "Analyze data"),
    };

    private AIPromptOutput? _loadingOutput;
    private bool _isLoading;

    private async Task HandleLoadingSubmit(string prompt)
    {
        _isLoading = true;
        _loadingOutput = new AIPromptOutput(Guid.NewGuid().ToString(), "", title: prompt, isLoading: true);
        StateHasChanged();
        await Task.Delay(3000);
        _isLoading = false;
        _loadingOutput = new AIPromptOutput(
            Guid.NewGuid().ToString(),
            "This is the final response after a simulated 3-second generation delay.",
            title: prompt);
        StateHasChanged();
    }

    private async Task HandleLoadingCommand(AIPromptCommand command)
    {
        _isLoading = true;
        _loadingOutput = new AIPromptOutput(Guid.NewGuid().ToString(), "", title: command.Title, isLoading: true);
        StateHasChanged();
        await Task.Delay(2500);
        _isLoading = false;
        _loadingOutput = new AIPromptOutput(
            Guid.NewGuid().ToString(),
            $"Command \"{command.Title}\" completed after simulated processing.",
            title: command.Title);
        StateHasChanged();
    }

    // ── Custom placeholder demo ─────────────────────────────────────────────

    private AIPromptOutput? _customOutput;

    private async Task HandleCustomSubmit(string prompt)
    {
        _customOutput = new AIPromptOutput(Guid.NewGuid().ToString(), "", title: prompt, isLoading: true);
        StateHasChanged();
        await Task.Delay(800);
        _customOutput = new AIPromptOutput(
            Guid.NewGuid().ToString(),
            $"Custom placeholder demo response for: \"{prompt}\".",
            title: prompt);
        StateHasChanged();
    }
}
