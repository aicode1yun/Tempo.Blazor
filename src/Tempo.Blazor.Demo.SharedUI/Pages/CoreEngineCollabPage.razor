@page "/core-engine-collab"
@using Tempo.Blazor.Components.DocumentEditor
@using Tempo.Blazor.DocumentEditor.Models
@using Tempo.Blazor.DocumentEditor.Services
@inject SignalRDocumentCollaborationProvider Collab

@*
    R.5.22 — realtime collaboration acceptance demo. Two browser tabs open this page (same
    documentId) and join the same SignalR group via the existing collaboration hub. Typing in
    one tab broadcasts text operations that the other tab applies through the engine's OT
    control, so both converge live.
*@
<h1>Core engine — realtime collaboration</h1>
<p>Open this page in two tabs and type. Edits sync through the SignalR collaboration hub.</p>

<div data-testid="collab-connected">@(_connected ? "true" : "false")</div>
<div data-testid="collab-client-id">@_clientId</div>

<div style="border:1px solid #ccc; padding:8px; position:relative; min-height:320px;">
    <TmDocumentCoreEngineHost @ref="_host"
                              Document="_document"
                              AriaLabel="Collaboration demo"
                              OnReady="HandleReadyAsync" />
</div>

@code {
    private TmDocumentCoreEngineHost? _host;
    private DocumentEditorDocument _document = BuildSampleDocument();
    private bool _connected;
    private readonly string _clientId = Guid.NewGuid().ToString("N");

    private static DocumentEditorDocument BuildSampleDocument()
    {
        var doc = new DocumentEditorDocument { DocumentId = "core-engine-collab-demo" };
        doc.Blocks =
        [
            new DocumentBlock
            {
                Id = "p1",
                Type = DocumentBlockType.Paragraph,
                Content = new ParagraphBlockContent { Inlines = [new TextRun { Id = "p1-r", Text = "Shared" }] },
            },
        ];
        return doc;
    }

    private async Task HandleReadyAsync(TmDocumentCoreEngineHost host)
    {
        var author = new DocumentEditorAuthor { Id = _clientId, DisplayName = "User-" + _clientId[..4] };
        var color = "#" + _clientId[..6];
        await host.ConnectCollaborationAsync(Collab, _document.DocumentId, author, color);
        _connected = true;
        StateHasChanged();
    }
}
