@code {
    private INotionPage? _currentPage;
    private string _statusMessage = "";
    private bool _statusIsError = false;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadEditorDataAsync();
    }

    private async Task LoadEditorDataAsync()
    {
        try
        {
            _isLoading = true;
            _statusMessage = "";

            var httpClient = HttpClientFactory.CreateClient("DemoApi");

            // Get all pages to find the first one
            var pages = await httpClient.GetFromJsonAsync<List<NotionPage>>("/api/notion/pages");
            if (pages?.Count > 0)
            {
                _currentPage = pages[0];
                _statusMessage = "Editor loaded successfully";
            }
            else
            {
                _statusMessage = "No pages found";
                _statusIsError = true;
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
            _statusIsError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadEditorDataAsync();
    }
}
