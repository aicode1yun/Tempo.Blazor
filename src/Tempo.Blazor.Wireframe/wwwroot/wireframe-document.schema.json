{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wireframe-document.schema.json",
  "title": "WireframeDocument",
  "description": "Tempo.Blazor wireframe document – AI-friendly JSON format.",
  "type": "object",
  "required": ["version", "title", "elements"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version. Current: 1.0.",
      "example": "1.0"
    },
    "title": {
      "type": "string",
      "description": "Human-readable wireframe title.",
      "example": "Login page"
    },
    "width": {
      "type": "number",
      "description": "Canvas width in pixels.",
      "default": 1280
    },
    "height": {
      "type": "number",
      "description": "Canvas height in pixels.",
      "default": 800
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "modifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetPacks": {
      "type": "array",
      "description": "Stencil pack ids this document targets. Tempo built-ins remain available; app components require their app:{id} pack.",
      "items": { "type": "string" },
      "default": ["tempo"]
    },
    "targetTheme": {
      "type": "string",
      "description": "Optional theme name selecting a token override set within the target packs."
    },
    "elements": {
      "type": "array",
      "description": "UI elements placed on the canvas.",
      "items": { "$ref": "#/$defs/WireframeElement" }
    },
    "connectors": {
      "type": "array",
      "description": "Directed arrows between elements.",
      "items": { "$ref": "#/$defs/WireframeConnector" }
    }
  },
  "$defs": {
    "WireframeElement": {
      "type": "object",
      "required": ["id", "type", "x", "y", "w", "h"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique element identifier (short Guid).",
          "example": "a3f8c21b"
        },
        "type": {
          "type": "string",
          "description": "Registered component type, e.g. 'TmButton', 'TmDataTable', or a custom type.",
          "example": "TmButton"
        },
        "x": {
          "type": "number",
          "description": "X position of top-left corner in pixels."
        },
        "y": {
          "type": "number",
          "description": "Y position of top-left corner in pixels."
        },
        "w": {
          "type": "number",
          "description": "Width in pixels."
        },
        "h": {
          "type": "number",
          "description": "Height in pixels."
        },
        "zIndex": {
          "type": "integer",
          "description": "Stacking order. Higher = on top.",
          "default": 0
        },
        "groupId": {
          "type": "string",
          "description": "Optional group identifier."
        },
        "isLocked": {
          "type": "boolean",
          "description": "When true, the element cannot be moved, resized, or deleted.",
          "default": false
        },
        "rotation": {
          "type": "number",
          "description": "Rotation angle in degrees. 0 = no rotation.",
          "default": 0
        },
        "layerId": {
          "type": "string",
          "description": "Optional layer identifier. When null, belongs to the default layer."
        },
        "lockedBy": {
          "type": "string",
          "description": "Reserved for collaborative editing."
        },
        "props": {
          "type": "object",
          "description": "Component-specific properties. Keys are camelCase prop names; values are any JSON type.",
          "additionalProperties": true,
          "examples": [
            { "label": "Submit", "variant": "primary", "disabled": false },
            { "title": "Users", "columns": ["Name", "Email"], "showPagination": true }
          ]
        }
      }
    },
    "WireframeConnector": {
      "type": "object",
      "required": ["id", "fromId", "toId"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique connector identifier."
        },
        "fromId": {
          "type": "string",
          "description": "Source element id."
        },
        "toId": {
          "type": "string",
          "description": "Target element id."
        },
        "label": {
          "type": "string",
          "description": "Optional label shown on the connector."
        }
      }
    }
  }
}
