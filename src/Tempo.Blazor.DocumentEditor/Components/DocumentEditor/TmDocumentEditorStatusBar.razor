@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase

<footer class="tm-document-editor__status-bar"
        role="status"
        aria-live="polite"
        aria-label="@Loc["TmDocumentEditor_StatusBarLabel"]"
        data-testid="@TestId("document-status-bar")">
    <div class="tm-document-editor__status-bar-group tm-document-editor__status-bar-group--save">
        @if (PendingCount > 0)
        {
            <span class="tm-document-editor__pending" data-testid="@TestId("document-pending-status")" aria-live="polite">
                @if (!string.IsNullOrWhiteSpace(PendingMessage))
                {
                    @PendingMessage
                }
                else
                {
                    @Loc["TmDocumentEditor_PendingActions", PendingCount]
                }
            </span>
        }
        else if (IsDirty)
        {
            <span class="tm-document-editor__dirty" data-testid="@TestId("document-dirty-status")">@Loc["TmDocumentEditor_UnsavedChanges"]</span>
        }
        @if (!string.IsNullOrWhiteSpace(SaveMessage))
        {
            <span class="tm-document-editor__save-message" data-testid="@TestId("document-save-message")">@SaveMessage</span>
            @if (CanRetrySave)
            {
                <button type="button"
                        class="tm-document-editor__save-retry"
                        data-testid="@TestId("document-save-retry")"
                        @onclick="OnRetrySave">
                    @Loc["TmDocumentEditor_Retry"]
                </button>
            }
        }
        @if (LastSavedAt is not null)
        {
            <span class="tm-document-editor__last-saved" data-testid="@TestId("document-last-saved")">
                @Loc["TmDocumentEditor_LastSavedAt", LastSavedAt.Value.ToLocalTime().ToString("HH:mm:ss")]
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(RuntimeMessage))
        {
            <span class="tm-document-editor__runtime-message @(RuntimeFailed ? "tm-document-editor__runtime-message--failed" : "tm-document-editor__runtime-message--recovered")"
                  data-testid="@TestId("document-runtime-message")"
                  role="alert">@RuntimeMessage</span>
        }
    </div>

    <div class="tm-document-editor__status-bar-group tm-document-editor__status-bar-group--metrics">
        <span data-testid="@TestId("document-status-word-count")">@Loc["TmDocumentEditor_WordCount", WordCount]</span>
        <span data-testid="@TestId("document-status-page-count")">@Loc["TmDocumentEditor_PageCount", PageCount]</span>
        <span data-testid="@TestId("document-status-region")">@Loc["TmDocumentEditor_ActiveRegion", ActiveRegionLabel]</span>
        <span data-testid="@TestId("document-status-zoom")">@Loc["TmDocumentEditor_ZoomStatus", ZoomLabel]</span>
    </div>
</footer>

@code {
    /// <summary>Whether the document has local unsaved changes.</summary>
    [Parameter] public bool IsDirty { get; set; }

    /// <summary>Number of currently pending async operations.</summary>
    [Parameter] public int PendingCount { get; set; }

    /// <summary>Message of the first pending operation, or <c>null</c> when none.</summary>
    [Parameter] public string? PendingMessage { get; set; }

    /// <summary>Optional save status message.</summary>
    [Parameter] public string? SaveMessage { get; set; }

    /// <summary>Whether the latest save failure can be retried.</summary>
    [Parameter] public bool CanRetrySave { get; set; }

    /// <summary>Raised when the user requests retry after a recoverable save failure.</summary>
    [Parameter] public EventCallback OnRetrySave { get; set; }

    /// <summary>Timestamp of the latest successful save.</summary>
    [Parameter] public DateTimeOffset? LastSavedAt { get; set; }

    /// <summary>Current document word count.</summary>
    [Parameter] public int WordCount { get; set; }

    /// <summary>Current document page count.</summary>
    [Parameter] public int PageCount { get; set; } = 1;

    /// <summary>Label for the active editing region.</summary>
    [Parameter] public string ActiveRegionLabel { get; set; } = string.Empty;

    /// <summary>Current zoom label.</summary>
    [Parameter] public string ZoomLabel { get; set; } = "100%";

    /// <summary>Message shown after a JS runtime recovery event, or <c>null</c> when none.</summary>
    [Parameter] public string? RuntimeMessage { get; set; }

    /// <summary>When <c>true</c>, <see cref="RuntimeMessage"/> describes a recovery failure.</summary>
    [Parameter] public bool RuntimeFailed { get; set; }
}
