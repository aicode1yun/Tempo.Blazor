@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.Abstractions.Shared
@using Tempo.Blazor.DocumentEditor.Models
@using Tempo.Blazor.DocumentEditor.Services

<aside class="tm-document-editor__comment-rail"
       data-testid="@TestId("document-comment-rail")"
       aria-label="@Loc["TmDocumentEditor_CommentsLabel"]">
    <header class="tm-document-comment-rail__header">
        <div>
            <h3>@Loc["TmDocumentEditor_Comments"]</h3>
            <span>@Loc["TmDocumentEditor_CommentCountVisible", VisibleComments.Count, Comments.Count]</span>
        </div>
        @if (CanComment)
        {
            <button type="button"
                    data-testid="@TestId("document-comment-new")"
                    disabled="@(!CanStartComment || IsBusy)"
                    @onclick="OnBeginComment">
                @Loc["TmDocumentEditor_NewComment"]
            </button>
        }
    </header>

    <div class="tm-document-comment-rail__controls" data-testid="@TestId("document-comment-controls")">
        <label class="tm-document-comment-rail__field">
            <span>@Loc["TmDocumentEditor_CommentFilter"]</span>
            <select value="@Filter"
                    disabled="@IsBusy"
                    @onchange="HandleFilterChangedAsync"
                    data-testid="@TestId("document-comment-filter")">
                <option value="@DocumentCommentFilter.All">@Loc["TmDocumentEditor_CommentFilterAll"]</option>
                <option value="@DocumentCommentFilter.Open">@Loc["TmDocumentEditor_CommentFilterOpen"]</option>
                <option value="@DocumentCommentFilter.Resolved">@Loc["TmDocumentEditor_CommentFilterResolved"]</option>
                <option value="@DocumentCommentFilter.Mine">@Loc["TmDocumentEditor_CommentFilterMine"]</option>
            </select>
        </label>
        <label class="tm-document-comment-rail__field">
            <span>@Loc["TmDocumentEditor_CommentSort"]</span>
            <select value="@SortMode"
                    disabled="@IsBusy"
                    @onchange="HandleSortChangedAsync"
                    data-testid="@TestId("document-comment-sort")">
                <option value="@DocumentCommentSortMode.Position">@Loc["TmDocumentEditor_CommentSortPosition"]</option>
                <option value="@DocumentCommentSortMode.Time">@Loc["TmDocumentEditor_CommentSortTime"]</option>
            </select>
        </label>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="tm-document-comment-rail__status" data-testid="@TestId("document-comment-status-message")">
            @StatusMessage
        </div>
    }

    @if (Participants.Count > 0)
    {
        <section class="tm-document-comment-legend"
                 data-testid="@TestId("document-comment-legend")"
                 aria-label="@Loc["TmDocumentEditor_CommentLegendTitle"]">
            <h4 class="tm-document-comment-legend__title">@Loc["TmDocumentEditor_CommentLegendTitle"]</h4>
            <ul class="tm-document-comment-legend__list">
                @foreach (var participant in Participants)
                {
                    <li class="tm-document-comment-legend__item" data-testid="@TestId("document-comment-legend-item")">
                        <span class="tm-document-comment-legend__chip tm-document-comment-legend__chip--participant-@participant.ColorIndex"
                              aria-hidden="true"></span>
                        <span class="tm-document-comment-legend__name">@participant.DisplayName</span>
                        @if (participant.IsExternal)
                        {
                            <span class="tm-document-comment-legend__badge"
                                  data-testid="@TestId("document-comment-client-badge")">@Loc["TmDocumentEditor_CommentClientBadge"]</span>
                        }
                    </li>
                }
            </ul>
        </section>
    }

    @if (IsLoading)
    {
        <div class="tm-document-comment-rail__loading" data-testid="@TestId("document-comment-loading")">
            @Loc["TmDocumentEditor_LoadingComments"]
        </div>
    }
    else
    {
        @if (ComposerOpen && DraftAnchor is not null)
        {
            <section class="tm-document-comment-rail__composer" data-testid="@TestId("document-comment-new-composer")">
                <span class="tm-document-comment-rail__anchor">@GetAnchorLabel(DraftAnchor)</span>
                <TmDocumentCommentComposer CanComment="@CanComment"
                                           IsBusy="@IsBusy"
                                           MentionProvider="@MentionProvider"
                                           Placeholder="@Loc["TmDocumentEditor_CommentPlaceholder"]"
                                           SubmitLabel="@Loc["TmDocumentEditor_AddComment"]"
                                           OnSubmit="CreateAsync"
                                           OnCancel="OnCancelComment" />
            </section>
        }

        @if (VisibleComments.Count == 0)
        {
            <div class="tm-document-comment-rail__empty" data-testid="@TestId("document-comment-empty")">
                @Loc["TmDocumentEditor_NoComments"]
            </div>
        }
        else
        {
            <div class="tm-document-comment-rail__list" data-testid="@TestId("document-comment-list")">
                @foreach (var comment in VisibleComments)
                {
                    <TmDocumentCommentThread Comment="@comment"
                                             Participants="@Participants"
                                             IsSelected="@(comment.Id == SelectedCommentId)"
                                             CanComment="@CanComment"
                                             CanResolve="@CanResolve"
                                             CanDeleteOwnComments="@CanDeleteOwnComments"
                                             CurrentAuthorId="@CurrentAuthorId"
                                             IsBusy="@IsBusy"
                                             MentionProvider="@MentionProvider"
                                             OnSelect="OnSelectComment"
                                             OnReply="OnReplyComment"
                                             OnEdit="OnEditComment"
                                             OnResolve="OnResolveComment"
                                             OnReopen="OnReopenComment"
                                             OnDelete="OnDeleteComment" />
                }
            </div>
        }
    }
</aside>

@code {
    /// <summary>Comment threads to display.</summary>
    [Parameter] public IReadOnlyList<DocumentComment> Comments { get; set; } = [];

    /// <summary>Current draft anchor when the new comment composer is open.</summary>
    [Parameter] public DocumentCommentAnchor? DraftAnchor { get; set; }

    /// <summary>Whether the new comment composer is open.</summary>
    [Parameter] public bool ComposerOpen { get; set; }

    /// <summary>Selected comment thread id.</summary>
    [Parameter] public string? SelectedCommentId { get; set; }

    /// <summary>Current comment filter.</summary>
    [Parameter] public DocumentCommentFilter Filter { get; set; } = DocumentCommentFilter.All;

    /// <summary>Raised when the comment filter changes.</summary>
    [Parameter] public EventCallback<DocumentCommentFilter> FilterChanged { get; set; }

    /// <summary>Current comment sort mode.</summary>
    [Parameter] public DocumentCommentSortMode SortMode { get; set; } = DocumentCommentSortMode.Position;

    /// <summary>Raised when the comment sort mode changes.</summary>
    [Parameter] public EventCallback<DocumentCommentSortMode> SortModeChanged { get; set; }

    /// <summary>Whether comments are loading.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Whether a comment operation is running.</summary>
    [Parameter] public bool IsBusy { get; set; }

    /// <summary>Whether the current user can add comments or replies.</summary>
    [Parameter] public bool CanComment { get; set; } = true;

    private IReadOnlyList<DocumentCommentParticipant> Participants
    {
        get
        {
            if (!ReferenceEquals(_participantsSource, Comments))
            {
                _participantsSource = Comments;
                _participants = DocumentCommentParticipants.FromComments(Comments);
            }

            return _participants;
        }
    }

    private IReadOnlyList<DocumentComment>? _participantsSource;
    private IReadOnlyList<DocumentCommentParticipant> _participants = [];

    /// <summary>Whether the current user can resolve or reopen comments.</summary>
    [Parameter] public bool CanResolve { get; set; } = true;

    /// <summary>Whether the current user can delete comment threads they own.</summary>
    [Parameter] public bool CanDeleteOwnComments { get; set; }

    /// <summary>Current author identifier used for ownership checks.</summary>
    [Parameter] public string? CurrentAuthorId { get; set; }

    /// <summary>Whether a new comment can be started from the current selection.</summary>
    [Parameter] public bool CanStartComment { get; set; } = true;

    /// <summary>Optional mention provider reused by comment composers.</summary>
    [Parameter] public ITmPeopleProvider? MentionProvider { get; set; }

    /// <summary>Optional status message.</summary>
    [Parameter] public string? StatusMessage { get; set; }

    /// <summary>Raised when a new comment flow should begin.</summary>
    [Parameter] public EventCallback OnBeginComment { get; set; }

    /// <summary>Raised when a new comment is submitted.</summary>
    [Parameter] public EventCallback<DocumentCommentCreateRequest> OnCreateComment { get; set; }

    /// <summary>Raised when the new comment composer is cancelled.</summary>
    [Parameter] public EventCallback OnCancelComment { get; set; }

    /// <summary>Raised when a reply is submitted.</summary>
    [Parameter] public EventCallback<DocumentEditorCommentReplyRequest> OnReplyComment { get; set; }

    /// <summary>Raised when an existing comment entry is edited.</summary>
    [Parameter] public EventCallback<DocumentEditorCommentEditRequest> OnEditComment { get; set; }

    /// <summary>Raised when a comment should be resolved.</summary>
    [Parameter] public EventCallback<string> OnResolveComment { get; set; }

    /// <summary>Raised when a comment should be reopened.</summary>
    [Parameter] public EventCallback<string> OnReopenComment { get; set; }

    /// <summary>Raised when a comment should be deleted.</summary>
    [Parameter] public EventCallback<string> OnDeleteComment { get; set; }

    /// <summary>Raised when a comment is selected.</summary>
    [Parameter] public EventCallback<string> OnSelectComment { get; set; }

    private IReadOnlyList<DocumentComment> VisibleComments
        => DocumentCommentComparer.Apply(Comments, Filter, SortMode, CurrentAuthorId);

    private Task CreateAsync(string text)
    {
        return DraftAnchor is null
            ? Task.CompletedTask
            : OnCreateComment.InvokeAsync(new DocumentCommentCreateRequest
            {
                Anchor = DraftAnchor,
                Text = text
            });
    }

    private string GetAnchorLabel(DocumentCommentAnchor anchor)
    {
        return anchor.Type switch
        {
            DocumentCommentAnchorType.TextRange => Loc["TmDocumentEditor_TextCommentAnchor"],
            DocumentCommentAnchorType.Block => Loc["TmDocumentEditor_BlockCommentAnchor", anchor.BlockId ?? Loc["TmDocumentEditor_UnknownAnchor"]],
            _ => Loc["TmDocumentEditor_CommentAnchor"]
        };
    }

    private Task HandleFilterChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (!Enum.TryParse<DocumentCommentFilter>(value, out var filter))
        {
            filter = DocumentCommentFilter.All;
        }

        Filter = filter;
        return FilterChanged.InvokeAsync(filter);
    }

    private Task HandleSortChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (!Enum.TryParse<DocumentCommentSortMode>(value, out var sortMode))
        {
            sortMode = DocumentCommentSortMode.Position;
        }

        SortMode = sortMode;
        return SortModeChanged.InvokeAsync(sortMode);
    }
}
