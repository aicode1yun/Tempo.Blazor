@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase

<div class="tm-document-editor__live-region"
     role="status"
     aria-live="@AriaLive"
     aria-atomic="true"
     data-testid="@TestId("document-editor-live-region")">
    @Message
</div>

@code {
    /// <summary>Message announced to assistive technologies.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>Aria-live politeness level. Defaults to polite.</summary>
    [Parameter] public string AriaLive { get; set; } = "polite";
}
