@namespace Tempo.Blazor.Components.DocumentEditor
@inherits Tempo.Blazor.Components.TmComponentBase
@using Tempo.Blazor.DocumentEditor.Models

@if (Inline is DocumentDrawingRun drawing)
{
    <span class="@GetDrawingClass(drawing)"
          style="@GetDrawingFigureStyle(drawing)"
          data-testid="@TestId("document-drawing-object")"
          data-object-id="@drawing.ObjectId"
          data-wrap-mode="@GetDrawingWrapMode(drawing)"
          role="img"
          aria-label="@GetDrawingAriaLabel(drawing)"
          aria-hidden="@(drawing.IsDecorative ? "true" : null)">
        @if (_isResolvingImage)
        {
            <span class="tm-document-image__loading">@Loc["TmDocumentEditor_ImageLoading"]</span>
        }
        else if (!string.IsNullOrWhiteSpace(DrawingImageUrl))
        {
            @if (!string.IsNullOrWhiteSpace(SafeDrawingLinkUrl))
            {
                <a class="tm-document-drawing__link"
                   href="@SafeDrawingLinkUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    <img class="tm-document-image__media"
                         src="@DrawingImageUrl"
                         alt="@GetDrawingAltText(drawing)"
                         style="@GetDrawingImageStyle(drawing)" />
                </a>
            }
            else
            {
                <img class="tm-document-image__media"
                     src="@DrawingImageUrl"
                     alt="@GetDrawingAltText(drawing)"
                     style="@GetDrawingImageStyle(drawing)" />
            }
            @if (!string.IsNullOrWhiteSpace(drawing.Caption))
            {
                <span class="tm-document-image__caption">@drawing.Caption</span>
            }
        }
        else
        {
            <span class="tm-document-image__broken">@Loc["TmDocumentEditor_ImageBroken"]</span>
        }
    </span>
}
else if (Inline is DocumentNoteReferenceRun noteReference)
{
    <sup class="@InlineClass"
         data-note-id="@noteReference.NoteId"
         data-note-type="@noteReference.NoteType"
         data-testid="@GetNoteReferenceTestId(noteReference)"
         title="@GetNoteReferenceTitle(noteReference)">@GetText()</sup>
}
else if (!string.IsNullOrWhiteSpace(SafeHref))
{
    <a class="@InlineClass"
       href="@SafeHref"
       title="@LinkTitle"
       target="_blank"
       rel="noopener noreferrer"
       style="@InlineStyle">@GetText()</a>
}
else
{
    <span class="@InlineClass"
          style="@InlineStyle"
          data-token-key="@TokenKey"
          data-token-type="@TokenType"
          data-comment-id="@CommentId"
          data-revision-id="@RevisionId"
          title="@InlineTitle"
          data-testid="@InlineTestId"
          @onclick="SelectCommentAsync">@GetText()</span>
}
