@page "/admin/permissions"
@inject ReportServerSessionState Session
@inject ReportServerCatalogStore Catalog

<ReportServerShell Title="Permissions" ActiveSection="permissions">
    <div class="rs-page" data-testid="f12-permissions-page">
        <div class="rs-page__heading">
            <div>
                <p class="rs-kicker">Administration</p>
                <h2>Folder permissions</h2>
            </div>
        </div>

        <section class="rs-admin-grid">
            <form class="rs-panel" @onsubmit="AddPermission" @onsubmit:preventDefault>
                <h3>Add ACL entry</h3>
                <label class="rs-field">
                    <span>Folder</span>
                    <select data-testid="permission-folder" value="@_folderPath" @onchange="HandleFolderChange">
                        @foreach (var folder in Folders)
                        {
                            <option value="@folder.Path">@folder.Name (@folder.Path)</option>
                        }
                    </select>
                </label>
                <label class="rs-field">
                    <span>Subject</span>
                    <input data-testid="permission-subject" value="@_subject" @oninput="HandleSubjectInput" />
                </label>
                <label class="rs-field">
                    <span>Role</span>
                    <select data-testid="permission-role" value="@_role" @onchange="HandleRoleChange">
                        <option>Viewer</option>
                        <option>Author</option>
                        <option>TenantAdmin</option>
                    </select>
                </label>
                <label class="rs-check">
                    <input data-testid="permission-deny" type="checkbox" checked="@_isDeny" @onchange="HandleDenyChange" />
                    <span>Explicit deny</span>
                </label>
                <TmButton Variant="ButtonVariant.Primary" Icon="@IconNames.Shield" data-testid="permission-add" OnClick="AddPermission">
                    Add ACL entry
                </TmButton>
            </form>

            <section class="rs-panel rs-table-panel">
                <h3>Effective ACL</h3>
                <div class="rs-table" data-testid="permissions-table">
                    @foreach (var entry in TenantCatalog.Permissions)
                    {
                        <article class="rs-table__row">
                            <div>
                                <strong>@entry.Subject</strong>
                                <span>@entry.FolderPath</span>
                            </div>
                            <span>@entry.Role</span>
                            <span class="@(entry.IsDeny ? "rs-status rs-status--deny" : "rs-status rs-status--ok")">
                                @(entry.IsDeny ? "Deny" : "Allow")
                            </span>
                            <span>Inherited by child folders</span>
                        </article>
                    }
                </div>
            </section>
        </section>
    </div>
</ReportServerShell>

@code {
    private string _folderPath = "/finance";
    private string _subject = "embedded-apps";
    private string _role = "Viewer";
    private bool _isDeny;

    private ReportServerTenantCatalog TenantCatalog => Catalog.GetCatalog(Session.CurrentTenantId);

    private IReadOnlyList<ReportExplorerFolder> Folders => Flatten(TenantCatalog.RootFolder).ToArray();

    private void HandleFolderChange(ChangeEventArgs args)
        => _folderPath = args.Value?.ToString() ?? "/";

    private void HandleSubjectInput(ChangeEventArgs args)
        => _subject = args.Value?.ToString() ?? string.Empty;

    private void HandleRoleChange(ChangeEventArgs args)
        => _role = args.Value?.ToString() ?? "Viewer";

    private void HandleDenyChange(ChangeEventArgs args)
        => _isDeny = bool.TryParse(args.Value?.ToString(), out var value) && value;

    private void AddPermission()
        => Catalog.AddPermission(Session.CurrentTenantId, _folderPath, _subject, _role, _isDeny);

    private static IEnumerable<ReportExplorerFolder> Flatten(ReportExplorerFolder folder)
    {
        yield return folder;
        foreach (var child in folder.Children)
        {
            foreach (var nested in Flatten(child))
            {
                yield return nested;
            }
        }
    }
}
