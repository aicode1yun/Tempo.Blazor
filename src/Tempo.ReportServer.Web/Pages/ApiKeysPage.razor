@page "/admin/api-keys"
@using Microsoft.JSInterop
@using Tempo.ReportServer.Api.Security
@inject ReportServerSessionState Session
@inject IReportApiKeyStore ApiKeys
@inject IReportAuditLog AuditLog
@inject IJSRuntime JS

<ReportServerShell Title="API keys" ActiveSection="apikeys">
    <div class="rs-page" data-testid="f18-api-keys-page">
        <div class="rs-page__heading">
            <div>
                <p class="rs-kicker">Administration</p>
                <h2>API keys &amp; audit</h2>
            </div>
        </div>

        @if (_issuedKey is not null)
        {
            <section class="rs-panel rs-keycard" data-testid="api-key-secret" role="status" aria-live="polite">
                <h3>Store this key now</h3>
                <p class="rs-hint">The plain text key is shown only once and is never stored. You won't be able to view it again.</p>
                <div class="rs-secret-row">
                    <code class="rs-secret" data-testid="api-key-secret-value">@_issuedKey.PlainTextKey</code>
                    <TmButton Variant="ButtonVariant.Secondary"
                              Size="ButtonSize.Sm"
                              Icon="@IconNames.Copy"
                              data-testid="api-key-copy"
                              OnClick="CopySecretAsync">
                        @(_secretCopied ? "Copied" : "Copy")
                    </TmButton>
                </div>
                <span class="rs-hint">Key id: <strong>@_issuedKey.KeyId</strong> · application <strong>@_issuedKey.Descriptor.ApplicationId</strong></span>
            </section>
        }

        <section class="rs-admin-grid">
            <form class="rs-panel" @onsubmit="CreateKeyAsync" @onsubmit:preventDefault>
                <h3>Issue key</h3>
                <label class="rs-field">
                    <span>Application (service account)</span>
                    <input data-testid="api-key-application" value="@_applicationId" @oninput="OnApplicationInput" />
                </label>
                <fieldset class="rs-field">
                    <legend>Scopes</legend>
                    @foreach (var permission in SelectablePermissions)
                    {
                        <label class="rs-check">
                            <input type="checkbox"
                                   data-testid="@($"api-key-scope-{permission}")"
                                   checked="@_scopes.Contains(permission)"
                                   @onchange="args => ToggleScope(permission, args)" />
                            <span>@permission</span>
                        </label>
                    }
                </fieldset>
                <label class="rs-field">
                    <span>Expires in (days, optional)</span>
                    <input data-testid="api-key-expiry-days" type="number" min="1" value="@_expiryDays" @oninput="OnExpiryInput" />
                </label>
                <TmButton Variant="ButtonVariant.Primary" Icon="@IconNames.Key" data-testid="api-key-create" OnClick="CreateKeyAsync">
                    Issue key
                </TmButton>
            </form>

            <section class="rs-panel rs-table-panel">
                <h3>Active &amp; revoked keys</h3>
                <div class="rs-table" data-testid="api-keys-table">
                    @if (_keys.Count == 0)
                    {
                        <p class="rs-hint" data-testid="api-keys-empty">No API keys have been issued for this tenant.</p>
                    }
                    @foreach (var key in _keys)
                    {
                        <article class="rs-table__row" data-testid="@($"api-key-row-{key.KeyId}")">
                            <div>
                                <strong>@key.ApplicationId</strong>
                                <span>@key.KeyId</span>
                            </div>
                            <span>@FormatPermissions(key.Permissions)</span>
                            <span>@FormatExpiry(key)</span>
                            <span class="@StatusClass(key)" data-testid="@($"api-key-status-{key.KeyId}")">@StatusText(key)</span>
                            <div class="rs-row-actions">
                                @if (!IsActive(key))
                                {
                                    <span class="rs-hint">No actions available</span>
                                }
                                else if (_confirming == $"revoke:{key.KeyId}")
                                {
                                    <div class="rs-confirm" data-testid="@($"api-key-revoke-confirm-panel-{key.KeyId}")">
                                        <span class="rs-hint">Revoking is permanent; the key stops working immediately.</span>
                                        <div class="rs-row-actions">
                                            <TmButton Variant="ButtonVariant.Danger"
                                                      Size="ButtonSize.Sm"
                                                      Icon="@IconNames.Ban"
                                                      data-testid="@($"api-key-revoke-confirm-{key.KeyId}")"
                                                      OnClick="() => RevokeKeyAsync(key.KeyId)">
                                                Confirm revoke?
                                            </TmButton>
                                            <TmButton Variant="ButtonVariant.Secondary"
                                                      Size="ButtonSize.Sm"
                                                      data-testid="@($"api-key-revoke-cancel-{key.KeyId}")"
                                                      OnClick="CancelConfirm">
                                                Cancel
                                            </TmButton>
                                        </div>
                                    </div>
                                }
                                else if (_confirming == $"rotate:{key.KeyId}")
                                {
                                    <div class="rs-confirm" data-testid="@($"api-key-rotate-confirm-panel-{key.KeyId}")">
                                        <span class="rs-hint">Rotation issues a NEW secret; the current key stops working immediately.</span>
                                        <div class="rs-row-actions">
                                            <TmButton Variant="ButtonVariant.Primary"
                                                      Size="ButtonSize.Sm"
                                                      Icon="@IconNames.Refresh"
                                                      data-testid="@($"api-key-rotate-confirm-{key.KeyId}")"
                                                      OnClick="() => RotateKeyAsync(key.KeyId)">
                                                Confirm rotate?
                                            </TmButton>
                                            <TmButton Variant="ButtonVariant.Secondary"
                                                      Size="ButtonSize.Sm"
                                                      data-testid="@($"api-key-rotate-cancel-{key.KeyId}")"
                                                      OnClick="CancelConfirm">
                                                Cancel
                                            </TmButton>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <TmButton Variant="ButtonVariant.Secondary"
                                              Size="ButtonSize.Sm"
                                              Icon="@IconNames.Refresh"
                                              data-testid="@($"api-key-rotate-{key.KeyId}")"
                                              OnClick="() => BeginRotate(key.KeyId)">
                                        Rotate
                                    </TmButton>
                                    <TmButton Variant="ButtonVariant.Danger"
                                              Size="ButtonSize.Sm"
                                              Icon="@IconNames.Ban"
                                              data-testid="@($"api-key-revoke-{key.KeyId}")"
                                              OnClick="() => BeginRevoke(key.KeyId)">
                                        Revoke
                                    </TmButton>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        </section>

        <section class="rs-panel rs-table-panel">
            <div class="rs-page__heading">
                <h3>Audit trail</h3>
                <div class="rs-filter-bar">
                    <label class="rs-field">
                        <span>Action</span>
                        <select data-testid="audit-filter-action" value="@_actionFilter" @onchange="OnActionFilterChanged">
                            <option value="">All actions</option>
                            @foreach (var action in Enum.GetValues<ReportAuditAction>())
                            {
                                <option value="@action">@action</option>
                            }
                        </select>
                    </label>
                    <label class="rs-field">
                        <span>Outcome</span>
                        <select data-testid="audit-filter-outcome" value="@_outcomeFilter" @onchange="OnOutcomeFilterChanged">
                            <option value="">All outcomes</option>
                            @foreach (var outcome in Enum.GetValues<ReportAuditOutcome>())
                            {
                                <option value="@outcome">@outcome</option>
                            }
                        </select>
                    </label>
                </div>
            </div>
            <div class="rs-table" data-testid="audit-table">
                @if (_auditEvents.Count == 0)
                {
                    <p class="rs-hint" data-testid="audit-empty">No audit events match the current filter.</p>
                }
                @foreach (var auditEvent in _auditEvents)
                {
                    <article class="rs-table__row" data-testid="audit-row">
                        <div>
                            <strong>@auditEvent.Action</strong>
                            <span>@auditEvent.ResourceId</span>
                        </div>
                        <span>@auditEvent.ActorId</span>
                        <span>@auditEvent.Timestamp.ToString("u", System.Globalization.CultureInfo.InvariantCulture)</span>
                        <span class="@(auditEvent.Outcome == ReportAuditOutcome.Denied ? "rs-status rs-status--deny" : "rs-status rs-status--ok")">
                            @auditEvent.Outcome
                        </span>
                    </article>
                }
            </div>
        </section>
    </div>
</ReportServerShell>

@code {
    private static readonly ReportPermission[] SelectablePermissions =
    [
        ReportPermission.View,
        ReportPermission.Render,
        ReportPermission.Export,
        ReportPermission.EditDefinition,
        ReportPermission.ManageDataSources,
        ReportPermission.ManagePermissions,
    ];

    private string _applicationId = "embedded-app";
    private int? _expiryDays;
    private readonly HashSet<ReportPermission> _scopes = [ReportPermission.View, ReportPermission.Render];
    private ReportApiKeyCreationResult? _issuedKey;
    private bool _secretCopied;

    // Two-step confirm token, e.g. "revoke:rk_..." / "rotate:rk_...", null when nothing is pending.
    private string? _confirming;

    private string _actionFilter = string.Empty;
    private string _outcomeFilter = string.Empty;

    private IReadOnlyList<ReportApiKeyDescriptor> _keys = [];
    private IReadOnlyList<ReportAuditEvent> _auditEvents = [];

    private string TenantId => Session.CurrentTenantId;

    private string ActorId => Session.UserName;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private void OnApplicationInput(ChangeEventArgs args)
        => _applicationId = args.Value?.ToString() ?? string.Empty;

    private void OnExpiryInput(ChangeEventArgs args)
        => _expiryDays = int.TryParse(args.Value?.ToString(), out var days) && days > 0 ? days : null;

    private void ToggleScope(ReportPermission permission, ChangeEventArgs args)
    {
        if (args.Value is bool isChecked && isChecked)
        {
            _scopes.Add(permission);
        }
        else
        {
            _scopes.Remove(permission);
        }
    }

    private async Task CreateKeyAsync()
    {
        if (string.IsNullOrWhiteSpace(_applicationId))
        {
            return;
        }

        var permissions = _scopes.Aggregate(ReportPermission.None, (current, scope) => current | scope);
        var expiresAt = _expiryDays is { } days ? DateTimeOffset.UtcNow.AddDays(days) : (DateTimeOffset?)null;
        _issuedKey = await ApiKeys.CreateAsync(TenantId, _applicationId.Trim(), permissions, expiresAt);
        _secretCopied = false;
        await AuditKeyLifecycleAsync("create-api-key", _issuedKey.KeyId, _issuedKey.Descriptor.ApplicationId);
        await ReloadAsync();
    }

    private void BeginRevoke(string keyId) => _confirming = $"revoke:{keyId}";

    private void BeginRotate(string keyId) => _confirming = $"rotate:{keyId}";

    private void CancelConfirm() => _confirming = null;

    private async Task RotateKeyAsync(string keyId)
    {
        _confirming = null;
        var expiresAt = _expiryDays is { } days ? DateTimeOffset.UtcNow.AddDays(days) : (DateTimeOffset?)null;
        var rotated = await ApiKeys.RotateAsync(keyId, TenantId, ActorId, expiresAt);
        if (rotated is not null)
        {
            _issuedKey = rotated;
            _secretCopied = false;
            await AuditKeyLifecycleAsync("rotate-api-key", rotated.KeyId, rotated.Descriptor.ApplicationId);
        }

        await ReloadAsync();
    }

    private async Task RevokeKeyAsync(string keyId)
    {
        _confirming = null;
        await ApiKeys.RevokeAsync(keyId, TenantId, ActorId);
        await AuditKeyLifecycleAsync("revoke-api-key", keyId, keyId);
        await ReloadAsync();
    }

    private async Task CopySecretAsync()
    {
        if (_issuedKey is null)
        {
            return;
        }

        await JS.InvokeVoidAsync("tempoReportServer.copyToClipboard", _issuedKey.PlainTextKey);
        _secretCopied = true;
    }

    private Task AuditKeyLifecycleAsync(string operation, string keyId, string applicationId)
        => AuditLog.WriteAsync(new ReportAuditEvent
        {
            TenantId = TenantId,
            ActorId = ActorId,
            Action = ReportAuditAction.ChangeAcl,
            ResourceKind = ReportResourceKind.Acl,
            ResourceId = keyId,
            Outcome = ReportAuditOutcome.Allowed,
            Timestamp = DateTimeOffset.UtcNow,
            Details = new Dictionary<string, string>(StringComparer.Ordinal)
            {
                ["operation"] = operation,
                ["applicationId"] = applicationId,
            },
        });

    private void OnActionFilterChanged(ChangeEventArgs args)
    {
        _actionFilter = args.Value?.ToString() ?? string.Empty;
        _ = ReloadAuditAsync();
    }

    private void OnOutcomeFilterChanged(ChangeEventArgs args)
    {
        _outcomeFilter = args.Value?.ToString() ?? string.Empty;
        _ = ReloadAuditAsync();
    }

    private async Task ReloadAsync()
    {
        _keys = await ApiKeys.ListAsync(TenantId);
        await ReloadAuditAsync();
    }

    private async Task ReloadAuditAsync()
    {
        var query = new ReportAuditQuery { TenantId = TenantId };
        if (Enum.TryParse<ReportAuditAction>(_actionFilter, out var action))
        {
            query = query with { Action = action };
        }

        if (Enum.TryParse<ReportAuditOutcome>(_outcomeFilter, out var outcome))
        {
            query = query with { Outcome = outcome };
        }

        _auditEvents = await AuditLog.QueryAsync(query);
        StateHasChanged();
    }

    private static bool IsActive(ReportApiKeyDescriptor key) => key.IsActive(DateTimeOffset.UtcNow);

    private static string StatusText(ReportApiKeyDescriptor key)
        => key.RevokedAt is not null ? "Revoked" : key.IsExpired(DateTimeOffset.UtcNow) ? "Expired" : "Active";

    private static string StatusClass(ReportApiKeyDescriptor key)
        => IsActive(key) ? "rs-status rs-status--ok" : "rs-status rs-status--deny";

    private static string FormatExpiry(ReportApiKeyDescriptor key)
        => key.ExpiresAt is { } expiry
            ? expiry.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
            : "Never";

    private static string FormatPermissions(ReportPermission permissions)
        => permissions == ReportPermission.None ? "None" : permissions.ToString();
}
