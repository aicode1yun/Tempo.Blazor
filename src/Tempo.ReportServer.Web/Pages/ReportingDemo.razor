@page "/reporting"
@inject DemoReportSourceFactory SourceFactory

<main class="report-demo-shell" data-testid="reporting-demo-page">
    <div class="report-demo-title">
        <h1>Sales Register</h1>
    </div>

<TmReportViewer ReportSource="@_source"
                Height="760px"
                ShowParameterPanel="false"
                TenantId="demo"
                UserId="playwright"
                CultureName="en-US" />
</main>

@code {
    private IReportSource? _source;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _source = SourceFactory.CreateSalesRegister();
    }
}
