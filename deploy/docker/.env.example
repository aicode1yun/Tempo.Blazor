# ---------------------------------------------------------------------------
# Tempo Report Server container secrets/config. Copy to `.env` and fill in.
#   cp deploy/docker/.env.example deploy/docker/.env
# `.env` is git-ignored — NEVER commit real secrets.
# Avoid the characters | and $ in secret values (| is the realm-import sed
# delimiter; $ can trip shell expansion).
# ---------------------------------------------------------------------------

# --- SQL Server ------------------------------------------------------------
# Strong SA password (SQL Server policy: >= 8 chars, upper+lower+digit+symbol).
# Bootstraps the demo 'sa' SQL login used by the API connection string.
MSSQL_SA_PASSWORD=Your_Strong_Passw0rd!

# --- Keycloak admin console ------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-change-me

# --- Keycloak realm client secrets -----------------------------------------
# Substituted into the realm export at import time AND used by the Web (BFF) host.
# Must match between the keycloak and web services (both read TEMPO_REPORT_WEB_SECRET).
TEMPO_REPORT_WEB_SECRET=change-me-web-client-secret
TEMPO_REPORT_M2M_SECRET=change-me-m2m-client-secret

# --- Image tag overrides (optional) ----------------------------------------
# Pin the Keycloak tag to match the realm export version (exported from 26.x).
# KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.3
# MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
