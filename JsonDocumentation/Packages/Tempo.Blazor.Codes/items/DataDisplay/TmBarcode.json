{
  "itemName": "TmBarcode",
  "kind": "Component",
  "category": "DataDisplay",
  "description": "Renders a barcode as an SVG element. Supports multiple formats (Code128, Code39, EAN13, UPC, QR) with optional value display below the barcode.",
  "requiredImports": [
    "@using Tempo.Blazor.Components.DataDisplay"
  ],
  "parameters": [
    {
      "name": "Value",
      "type": "string",
      "isRequired": false,
      "default": "Empty",
      "description": "The value to encode."
    },
    {
      "name": "Format",
      "type": "BarcodeFormat",
      "isRequired": false,
      "default": "Code128",
      "description": "The barcode format. Default is Code128."
    },
    {
      "name": "Width",
      "type": "int",
      "isRequired": false,
      "default": "200",
      "description": "The width in pixels."
    },
    {
      "name": "Height",
      "type": "int",
      "isRequired": false,
      "default": "100",
      "description": "The height in pixels."
    },
    {
      "name": "DisplayValue",
      "type": "bool",
      "isRequired": false,
      "description": "Whether to display the value as text below the barcode."
    },
    {
      "name": "CssClass",
      "type": "string?",
      "isRequired": false,
      "description": "Optional CSS class."
    }
  ],
  "cssClasses": [
    "tm-barcode",
    "tm-barcode__error"
  ],
  "examples": [
    {
      "title": "Code 128 barcode",
      "code": "<TmBarcode Value=\"TEST1234\" Format=\"BarcodeFormat.Code128\" DisplayValue=\"true\" />"
    },
    {
      "title": "Custom size barcode",
      "code": "<TmBarcode Value=\"ABC-999\" Format=\"BarcodeFormat.Code39\" Width=\"300\" Height=\"120\" />"
    }
  ],
  "packageId": "Tempo.Blazor.Codes"
}
