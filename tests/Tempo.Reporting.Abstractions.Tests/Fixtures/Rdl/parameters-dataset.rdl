<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>A report with parameters, a data source and a data set.</Description>
  <PageHeight>11in</PageHeight>
  <PageWidth>8.5in</PageWidth>
  <LeftMargin>1in</LeftMargin>
  <RightMargin>1in</RightMargin>
  <TopMargin>1in</TopMargin>
  <BottomMargin>1in</BottomMargin>
  <DataSources>
    <DataSource Name="ErpDb">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=erp;Initial Catalog=Reporting</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Orders">
      <Query>
        <DataSourceName>ErpDb</DataSourceName>
        <CommandText>SELECT Region, Total, OrderDate FROM Orders WHERE Region = @Region</CommandText>
        <QueryParameters>
          <QueryParameter Name="@Region">
            <Value>=Parameters!Region.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="Region">
          <DataField>Region</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Total">
          <DataField>Total</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="OrderDate">
          <DataField>OrderDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Region">
      <DataType>String</DataType>
      <Prompt>Region</Prompt>
      <DefaultValue>
        <Values>
          <Value>All</Value>
        </Values>
      </DefaultValue>
      <ValidValues>
        <ParameterValues>
          <ParameterValue><Value>All</Value><Label>All regions</Label></ParameterValue>
          <ParameterValue><Value>EU</Value><Label>Europe</Label></ParameterValue>
          <ParameterValue><Value>NA</Value><Label>North America</Label></ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="IncludeClosed">
      <DataType>Boolean</DataType>
      <Prompt>Include closed orders</Prompt>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value>false</Value>
        </Values>
      </DefaultValue>
    </ReportParameter>
    <ReportParameter Name="AsOf">
      <DataType>DateTime</DataType>
      <Prompt>As of date</Prompt>
      <Hidden>true</Hidden>
    </ReportParameter>
  </ReportParameters>
  <Body>
    <ReportItems>
      <Textbox Name="Heading">
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun><Value>Orders</Value></TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>0.25in</Top>
        <Left>0.5in</Left>
        <Height>0.4in</Height>
        <Width>4in</Width>
        <Style />
      </Textbox>
    </ReportItems>
    <Height>1in</Height>
  </Body>
</Report>
